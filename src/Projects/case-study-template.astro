---
import Layout from '../layouts/Layout.astro';
import { StickyFooter } from '../components/modules/Footer';
import HeaderPill from '../components/case-study/HeaderPill.astro';
import HeroStrip from '../components/modules/CaseStudy/components/strips/hero-strip/HeroStrip.astro';
import ContentStrip from '../components/modules/CaseStudy/components/strips/content-strip/ContentStrip.astro';
import CommentsStrip from '../components/modules/CaseStudy/components/strips/comments-strip/CommentsStrip.astro';
import ContactStrip from '../components/modules/CaseStudy/components/strips/contact-strip/ContactStrip.astro';
import FAQStrip from '../components/modules/CaseStudy/components/strips/faq-strip/FAQStrip.astro';
import NavigationStrip from '../components/modules/CaseStudy/components/strips/navigation-strip/NavigationStrip.astro';
import ProcessStrip from '../components/modules/CaseStudy/components/strips/process-strip/ProcessStrip.astro';
import SolutionsStrip from '../components/modules/CaseStudy/components/strips/solutions-strip/SolutionsStrip.astro';

// Mock data for template - this will be replaced with Payload CMS data
const mockData = {
  title: "Project Nexus",
  subtitle: "Redefining Digital Experiences Through Innovation",
  heroImage: "/modern-dashboard.png",
  description: "Project Nexus represents a groundbreaking approach to modern web applications, combining cutting-edge technology with user-centric design principles. Our team embarked on a journey to create a platform that not only meets current industry standards but sets new benchmarks for performance and usability.",
  services: [
    "UI/UX Design",
    "Frontend Development", 
    "Backend Architecture",
    "Performance Optimization",
    "User Research",
  ],
  stack: [
    {
      name: "React",
      desc: "Component-based architecture for building dynamic user interfaces with optimal performance",
    },
    {
      name: "Next.js", 
      desc: "Server-side rendering and static site generation for improved SEO and load times",
    },
  ],
  workflow: [
    {
      number: 1,
      title: "Discovery & Research",
      description: "We began with comprehensive stakeholder interviews and competitive analysis to understand the market landscape. Through user surveys and analytics review, we identified key pain points and opportunities for innovation. This phase established our north star metrics and success criteria.",
    },
    {
      number: 2,
      title: "Design & Prototyping", 
      description: "Armed with research insights, we created wireframes and high-fidelity prototypes. Multiple design iterations were tested with real users, allowing us to refine the interface before development. We established a design system to ensure consistency across all touchpoints.",
    },
  ],
  lessons: [
    "Early user testing revealed assumptions that would have been costly to fix later in development",
    "Investing in a robust design system upfront saved countless hours during implementation", 
  ],
  results: [
    {
      number: 45,
      description: "Increase in user engagement",
    },
    {
      number: 60, 
      description: "Faster page load times",
    },
  ],
  images: [
    { src: "/modern-dashboard.png", alt: "Modern Dashboard" },
    { src: "/mobile-app-screens.png", alt: "Mobile App Screens" }, 
  ],
  quote: {
    text: "The team delivered beyond our expectations. Their attention to detail and commitment to excellence transformed our vision into reality.",
    author: "Sarah Chen",
  },
  author: {
      name: 'Karen Ortiz',
      avatar: 'https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/A5A05E33-1DDD-4041-BCF4-4522767BFCEE.jpeg'
  },
  mainTag: 'Web Development',
  publishedDate: '26 Oct, 2025',
  content: [
      { type: 'heading', content: 'The Challenge' },
      { type: 'text', content: 'The main challenge was to create a highly performant and scalable web application that could handle a large number of concurrent users without sacrificing user experience. The existing platform was slow, outdated, and difficult to maintain.' },
      { type: 'image', content: { src: '/modern-dashboard.png', alt: 'Modern Dashboard', caption: 'A snapshot of the new dashboard design.' } },
      { type: 'quote', content: { quote: 'We needed a complete overhaul of our system, and the team delivered exactly that.', author: 'Jane Doe, CTO' } },
      { type: 'imageGrid', content: { images: [{ src: '/mobile-app-screens.png', alt: 'Mobile App' }, { src: '/data-visualization-charts.png', alt: 'Data Viz' }] } }
  ],
  comments: [
      { id: '1', author: 'John Doe', avatar: '/avatars/john.png', date: 'Oct 26, 2025', content: 'This is an amazing project!', isVerified: true, replies: [] },
      { id: '2', author: 'Jane Smith', avatar: '/avatars/jane.png', date: 'Oct 26, 2025', content: 'I love the design.', isVerified: false, replies: [
          { id: '3', author: 'Karen Ortiz', avatar: 'https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/A5A05E33-1DDD-4041-BCF4-4522767BFCEE.jpeg', date: 'Oct 26, 2025', content: 'Thank you!', isVerified: true, replies: [] }
      ] }
  ],
  faqs: [
      { question: 'What was the most challenging part of the project?', answer: 'The most challenging part was integrating the new frontend with the legacy backend system.' },
      { question: 'How long did the project take?', answer: 'The project was completed in 6 months, from initial discovery to final launch.' }
  ],
  previousPost: { title: 'Previous Case Study', slug: 'previous-case-study' },
  nextPost: { title: 'Next Case Study', slug: 'next-case-study' },
  finalThoughts: {
      title: 'Final Toughts',
      paragraphs: ['This project was a great success and we are proud of the results.']
  },
  tags: ['Web Development', 'React', 'Next.js']
};
---

<Layout title="Case Study Template - Karen Ortiz Portfolio">
  <HeaderPill />
  
  <main class="case-study-main">
    <HeroStrip
      title={mockData.title}
      mainTag={mockData.mainTag}
      publishedDate={mockData.publishedDate}
      author={mockData.author}
    />
    <ContentStrip
      description={mockData.description}
      content={mockData.content}
    />
    <ProcessStrip
        title="Our Workflow"
        subtitle="A streamlined process for success"
        steps={mockData.workflow}
    />
    <SolutionsStrip
        title="Solutions"
        dropdowns={mockData.stack}
        achievements={mockData.results}
        finalThoughts={mockData.finalThoughts}
        tags={mockData.tags}
    />
    <FAQStrip faqs={mockData.faqs} />
    <CommentsStrip comments={mockData.comments} />
    <NavigationStrip previousPost={mockData.previousPost} nextPost={mockData.nextPost} />
    <ContactStrip />
  </main>

  <StickyFooter client:visible />
</Layout>

<style>
  .case-study-main {
    min-height: 100vh;
    background: #060314;
    color: white;
  }
</style>