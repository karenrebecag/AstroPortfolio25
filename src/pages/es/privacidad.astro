---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import HeaderPill from '../../components/ui/HeaderPill.astro';
import { TextDisperseBlack } from '../../components/ui/TextDisperseBlack.tsx';
import { InView } from '../../components/ui/InView.tsx';
import { DarkModeContainer } from '../../components/ui/DarkModeContainer.tsx';
import ShareBar from '../../components/ui/ShareBar.astro';
import ProfileCardSection from '../../components/sections/ProfileCardSection.astro';
import { translations } from '../../i18n/translations.js';
import '../../styles/global.css';

// Obtener traducciones en español
const t = translations.es;
const privacyData = t.privacy;
---

<Layout title="Karen Ortiz - Política de Privacidad" lang="es">
	<HeaderPill />

	<DarkModeContainer client:load>
		<!-- Main Content Sections -->
		<main class="main-content" id="main-content">
		<!-- Privacy Policy Section -->
		<section class="content-section privacy-section" id="privacy-policy">
			<div class="section-container">
				<div class="section-header">
					<h2 class="section-title" id="privacy-message">
						<TextDisperseBlack client:idle text={privacyData.title} />
					</h2>
					<div class="section-label">{privacyData.subtitle}</div>
				</div>

				<InView client:idle
					variants={{
						hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
						visible: { opacity: 1, y: 0, filter: "blur(0px)" },
					}}
					viewOptions={{ margin: "0px 0px -100px 0px" }}
					transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94] }}
				>
					<div class="content-grid">
						<div class="content-main">
							<p class="content-description">
								{privacyData.description}
							</p>

							<div class="content-highlights">
								{privacyData.sections.map((section) => (
									<div class="highlight-item">
										<div class="highlight-number">{section.number}</div>
										<div class="highlight-content">
											<h3>{section.title}</h3>
											<p>{section.content}</p>
										</div>
									</div>
								))}
							</div>

							<div class="privacy-details">
								<div class="detail-section">
									<h3>{privacyData.details.title}</h3>
									<p>{privacyData.details.intro}</p>
									
									<h4>{privacyData.details.architecture.title}</h4>
									<p set:html={privacyData.details.architecture.content.replace(/\n/g, '<br>')}></p>
									
									<h4>{privacyData.details.moderation.title}</h4>
									<p>{privacyData.details.moderation.content}</p>
									
									<h4>{privacyData.details.principles.title}</h4>
									<p set:html={privacyData.details.principles.content.replace(/\n/g, '<br>')}></p>
									
									<h4>{privacyData.details.thirdParty.title}</h4>
									<p set:html={privacyData.details.thirdParty.content.replace(/\n/g, '<br>')}></p>
									
									<h4>{privacyData.details.retention.title}</h4>
									<p set:html={privacyData.details.retention.content.replace(/\n/g, '<br>')}></p>
									
									<h4>{privacyData.details.contact.title}</h4>
									<p>{privacyData.details.contact.content}</p>
									
									<p class="last-updated"><strong>{privacyData.details.lastUpdated}</strong></p>
								</div>
							</div>
						</div>
					</div>
				</InView>
			</div>
		</section>

		<ProfileCardSection />

		<!-- Share Bar Section -->
		<ShareBar />

		</main>
	</DarkModeContainer>
</Layout>

<style>
	/* Banner Actions */
	.banner-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
	}

	/* Arc Gallery Container */
	.arc-gallery-container {
		width: 100%;
		height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		z-index: 10;
	}

	/* Low Opacity Background - Reduced to 20% */
	:global(.low-opacity-bg .mega-background-wrapper) {
		opacity: 0.2 !important;
	}

	:global(.low-opacity-bg .mega-background-wrapper img),
	:global(.low-opacity-bg .mega-background-wrapper video) {
		opacity: 1 !important;
		width: 100% !important;
		height: 100% !important;
		object-fit: cover !important;
		object-position: center !important;
	}

	/* Ensure background container matches video behavior */
	:global(.low-opacity-bg .mega-background-container) {
		width: 100% !important;
		height: 100vh !important;
		overflow: hidden !important;
		position: absolute !important;
		top: 0 !important;
		left: 0 !important;
	}

	/* Background Override for ArcGalleryHero */
	:global(.background-override) {
		background: transparent !important;
		backdrop-filter: none !important;
	}

	/* Main Content Layout */
	.main-content {
		background: #ececec;
		width: 100%;
		padding: 0;
	}

	.content-section {
		padding: 6rem 2rem;
		border-bottom: 1px solid #f0f0f0;
		background-image:
			linear-gradient(rgba(0, 0, 0, 0.03) 1px, transparent 1px),
			linear-gradient(90deg, rgba(0, 0, 0, 0.03) 1px, transparent 1px);
		background-size: 20px 20px;
		position: relative;
	}

	.privacy-section {
		padding-top: 8rem;
	}

	.content-section:last-child {
		border-bottom: none;
	}

	.section-container {
		max-width: 1200px;
		margin: 0 auto;
		width: 100%;
	}

	/* Section Headers */
	.section-header {
		margin-bottom: 4rem;
		text-align: center;
	}

	.section-title {
		font-family: var(--font-display, 'Median', serif);
		font-size: clamp(2.5rem, 6vw, 4rem);
		font-weight: 400;
		line-height: 0.9;
		margin-bottom: 1rem;
		color: #1B1B1B;
	}

	.section-label {
		font-family: var(--font-primary, 'InterTight', sans-serif);
		font-size: 0.875rem;
		font-weight: 500;
		color: #666;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	/* Content Grid Layout */
	.content-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 4rem;
		align-items: start;
	}

	.content-main {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.content-description {
		font-family: var(--font-primary, 'InterTight', sans-serif);
		font-size: 1.125rem;
		line-height: 1.6;
		color: #333;
		margin: 0;
	}

	/* Content Highlights */
	.content-highlights {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.highlight-item {
		display: flex;
		gap: 1.5rem;
		align-items: flex-start;
	}

	.highlight-number {
		font-family: var(--font-display, 'Median', serif);
		font-size: 1.5rem;
		font-weight: 400;
		color: #4523AE;
		min-width: 3rem;
		text-align: center;
	}

	.highlight-content h3 {
		font-family: var(--font-primary, 'InterTight', sans-serif);
		font-size: 1.125rem;
		font-weight: 600;
		color: #1B1B1B;
		margin: 0 0 0.5rem 0;
	}

	.highlight-content p {
		font-family: var(--font-primary, 'InterTight', sans-serif);
		font-size: 1rem;
		line-height: 1.5;
		color: #666;
		margin: 0;
	}

	/* Privacy Details Section */
	.privacy-details {
		margin-top: 3rem;
		padding: 2rem;
		background: white;
		border: 1px solid #e9ecef;
		border-radius: 16px;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
	}

	.detail-section h3 {
		font-family: var(--font-primary, 'InterTight', sans-serif);
		font-size: 1.25rem;
		font-weight: 600;
		color: #1B1B1B;
		margin: 0 0 1rem 0;
	}

	.detail-section h4 {
		font-family: var(--font-primary, 'InterTight', sans-serif);
		font-size: 1.125rem;
		font-weight: 600;
		color: #1B1B1B;
		margin: 2rem 0 0.75rem 0;
	}

	.detail-section p {
		font-family: var(--font-primary, 'InterTight', sans-serif);
		font-size: 1rem;
		line-height: 1.6;
		color: #666;
		margin: 0 0 1rem 0;
	}

	.last-updated {
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid #e9ecef;
		font-size: 0.875rem !important;
		color: #999 !important;
	}

	/* Responsive Design */
	@media (max-width: 768px) {
		.banner-actions {
			flex-direction: column;
			gap: 0.75rem;
		}

		.content-section {
			padding: 5.6rem 1.4rem;
		}

		.privacy-section {
			padding-top: 11.2rem;
		}

		.content-grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.section-header {
			margin-bottom: 3rem;
		}

		.highlight-item {
			gap: 1rem;
		}

		.highlight-number {
			min-width: 2rem;
			font-size: 1.25rem;
		}

		.privacy-details {
			padding: 1.5rem;
		}
	}

	@media (max-width: 480px) {
		.content-section {
			padding: 4.2rem 1.4rem;
		}

		.privacy-section {
			padding-top: 11.2rem;
		}

		.section-title {
			font-size: clamp(2rem, 8vw, 3rem);
		}
	}

	/* Dark Mode Styles */
	:global(.dark-mode) {
		color-scheme: dark;
	}

	/* Main Content Dark Mode */
	:global(.dark-mode .main-content) {
		background: #050112;
		color: #ffffff;
	}

	:global(.dark-mode .content-section) {
		border-bottom-color: #333333;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
	}

	:global(.dark-mode .section-title) {
		color: #ffffff;
	}

	:global(.dark-mode .section-label) {
		color: #cccccc;
	}

	:global(.dark-mode .content-description) {
		color: #e5e5e5;
	}

	:global(.dark-mode .highlight-content h3) {
		color: #ffffff;
	}

	:global(.dark-mode .highlight-content p) {
		color: #cccccc;
	}

	:global(.dark-mode .highlight-number) {
		color: #4523AE;
	}

	:global(.dark-mode .privacy-details) {
		background: #0a0816;
		border-color: rgba(51, 51, 51, 0.3);
	}

	:global(.dark-mode .detail-section h3),
	:global(.dark-mode .detail-section h4) {
		color: #ffffff;
	}

	:global(.dark-mode .detail-section p) {
		color: #cccccc;
	}

	:global(.dark-mode .last-updated) {
		border-top-color: #333333;
		color: #999999 !important;
	}

	/* Smooth transitions for theme switching */
	:global(.main-content),
	:global(.content-section),
	:global(.section-title),
	:global(.section-label),
	:global(.content-description),
	:global(.highlight-content h3),
	:global(.highlight-content p),
	:global(.privacy-details),
	:global(.detail-section h3),
	:global(.detail-section h4),
	:global(.detail-section p) {
		transition:
			background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			border-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			box-shadow 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	:global(body) {
		transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	:global(html) {
		transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	/* Profile Card Section Styles */
	.profile-card-section {
		padding: 4rem 2rem;
		background: transparent;
		display: flex;
		justify-content: center;
		align-items: center;
		border-bottom: 1px solid #f0f0f0;
	}

	.profile-card-wrapper {
		width: 100%;
		max-width: 800px;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	/* Dark mode styles for profile card section */
	:global(.dark-mode .profile-card-section) {
		border-bottom-color: #333333;
	}

	/* Responsive adjustments */
	@media (max-width: 768px) {
		.profile-card-section {
			padding: 3rem 1rem;
		}
	}
</style>
