---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import AdvancedSEO from '../components/seo/AdvancedSEO.astro';
import Banner from '../components/Home/Banner/Banner.astro';
import Marquees from '../components/ui/Marquees.astro';
import Me from '../components/Home/Me/Me.astro';
import Services from '../components/ui/Services.astro';
import Projects from '../components/ui/Projects.astro';
import MyStack from '../components/ui/MyStack.astro';
import FAQs from '../components/ui/FAQs.astro';
import GetInTouch from '../components/modules/GetInTouch/components/GetInTouch.astro';
import Footer from "../components/modules/Footer/components/Footer.astro";
import Enterprises from '../components/Home/Enterprises/Enterprises.astro';
import GemSection from '../components/Home/GemSection/GemSection.astro';
import { getMainPageSchema, getFAQSchema } from '../utils/structuredData';
import '../styles/global.css';

import { siteConfig, pageConfigs } from '../config/seo';

// SEO Configuration optimized for LLMs and AI search
const seoConfig = {
  title: siteConfig.title,
  description: siteConfig.description,
  keywords: siteConfig.keywords.join(", "),
  canonical: siteConfig.url,
  ogImage: siteConfig.ogImage,
  structuredData: getMainPageSchema(),
  speakable: pageConfigs.home.speakable,
  alternateLanguages: [
    { hreflang: "en", href: "https://karenortiz.space" },
    { hreflang: "es", href: "https://karenortiz.space/es" }
  ]
};
---

<Layout title={seoConfig.title} lang="en">
  <AdvancedSEO 
    title={seoConfig.title}
    description={seoConfig.description}
    keywords={seoConfig.keywords}
    canonical={seoConfig.canonical}
    ogImage={seoConfig.ogImage}
    structuredData={seoConfig.structuredData}
    speakable={seoConfig.speakable}
    alternateLanguages={seoConfig.alternateLanguages}
  />
	<Banner />
	<Enterprises />
	<GemSection />
	<section id="about">
		<Me />
	</section>
	<section id="services">
		<Services />
	</section>
	<Marquees />

	<MyStack />

	<section id="projects">
		<Projects />
	</section>
	<div class="faqs-responsive-container">
		<FAQs />
	</div>
	<section id="contact">
		<GetInTouch />
	</section>
	<Footer />
</Layout>

<style>
  /* Hide FAQs only on viewport < 480px */
  @media (max-width: 479px) {
    .faqs-responsive-container {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      height: 0 !important;
      overflow: hidden !important;
    }
  }
</style>

