---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Banner from '../components/banner/Banner.astro';
import Marquees from '../components/ui/Marquees.astro';
import Me from '../components/ui/Me.astro';
import Services from '../components/ui/Services.astro';
import Projects from '../components/ui/Projects.astro';
import MyStack from '../components/ui/MyStack.astro';
import FAQs from '../components/ui/FAQs.astro';
import GetInTouch from '../components/ui/GetInTouch.astro';
import Footer from '../components/ui/Footer.astro';
import Enterprises from '../components/ui/Enterprises.astro';
import GemSection from '../components/ui/GemSection.astro';
import '../styles/global.css';
import ScrollPathAnimation from '../components/ui/ScrollPathAnimation.tsx';
---

<Layout title="Karen Ortiz - Portfolio" lang="en">
	<Banner />
	<Enterprises />
	<GemSection />
	<section id="about">
		<Me />
	</section>
	<section id="services">
		<Services />
	</section>
	<Marquees />

	<MyStack />

	<!-- Projects and FAQs Wrapper with ScrollPath Animation -->
	<div class="projects-faqs-wrapper">
		<ScrollPathAnimation client:visible />
		<section id="projects">
			<Projects />
		</section>
		<FAQs />
	</div>
	<section id="contact">
		<div id="reviews"></div>
		<GetInTouch />
	</section>
	<Footer />
</Layout>

<style>
  .projects-faqs-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    z-index: 1;
  }

  .projects-faqs-wrapper :global(.scroll-path-animation) {
    z-index: 0;
  }
</style>
