---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Banner from '../components/banner/Banner.astro';
import Marquees from '../components/ui/Marquees.astro';
import Me from '../components/ui/Me.astro';
import Services from '../components/ui/Services.astro';
import Projects from '../components/ui/Projects.astro';
import MyStack from '../components/ui/MyStack.astro';
import FAQs from '../components/ui/FAQs.astro';
import GetInTouch from '../components/ui/GetInTouch.astro';
import Footer from '../components/ui/Footer.astro';
import Enterprises from '../components/ui/Enterprises.astro';
import GemSection from '../components/ui/GemSection.astro';
import '../styles/global.css';
---

<Layout title="Karen Ortiz - Portfolio" lang="en">
	<Banner />
	<Enterprises />
	<GemSection />
	<section id="about">
		<Me />
	</section>
	<section id="services">
		<Services />
	</section>
	<Marquees />

	<MyStack />

	<section id="projects">
		<Projects />
	</section>
	<div class="faqs-responsive-container">
		<FAQs />
	</div>
	<section id="contact">
		<div id="reviews"></div>
		<GetInTouch />
	</section>
	<Footer />
</Layout>

<style>
  /* Hide FAQs only on viewport < 480px */
  @media (max-width: 479px) {
    .faqs-responsive-container {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      height: 0 !important;
      overflow: hidden !important;
    }
  }
</style>

