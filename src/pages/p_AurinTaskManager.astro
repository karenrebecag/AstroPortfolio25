	/* Smooth transitions for theme switching - Coordinated with Motion.dev */
	:global(.main-content),
	:global(.content-section),
	:global(.section-title),
	:global(.section-label),
	:global(.content-description),
	:global(.highlight-content h4),
	:global(.highlight-content p),
	:global(.info-card),
	:global(.info-value),
	:global(.info-label),
	:global(.feature-card),
	:global(.feature-card h3),
	:global(.feature-card p),
	:global(.tech-category h4),
	:global(.tech-tag),
	:global(.header-pill),
	:global(.logo),
	:global(.nav a),
	:global(.nav a::after),
	:global(.menu-btn span),
	:global(.mobile-menu) {
		transition: 
			background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), 
			color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), 
			border-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			box-shadow 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	/* Enhanced smooth transitions for specific elements */
	:global(.feature-card) {
		transition: 
			background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), 
			color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), 
			border-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			box-shadow 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			transform 0.3s ease;
	}

	:global(.tech-tag) {
		transition: 
			background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), 
			color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), 
			border-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			transform 0.2s ease;
	}

	/* Smooth body and document transitions */
	:global(body) {
		transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
