---
import ResumeLayout from '../layouts/ResumeLayout.astro';
import AdvancedSEO from '../components/seo/AdvancedSEO.astro';
import HeaderPill from '../components/ui/HeaderPill.astro';
import { DarkModeContainer } from '../components/ui/DarkModeContainer.tsx';
import { ResumeSection } from '../components/ui/ResumeSection.tsx';
import { ResumeTag, ResumeTagGroup } from '../components/ui/ResumeTag.tsx';
import { SkillTag, SkillGroup } from '../components/ui/SkillTag.tsx';
import { ResumeHeroBadge, ResumeHeroDescription, ResumeHeroContact, ResumeHeroMain } from '../components/ui/ResumeHeroAnimations.tsx';
import { ResumeFooter } from '../components/ui/ResumeFooter.tsx';
import MainButton from '../components/ui/MainButton.astro';
import SecondaryButton from '../components/ui/SecondaryButton.astro';
import { TextDisperse } from '../components/ui/TextDisperse.tsx';
import { InView } from '../components/ui/InView.tsx';
import { getLangFromUrl, t } from '../i18n/utils.js';
import { getResumePageSchema, getResumeFAQSchema } from '../utils/resumeStructuredData';
import { pageConfigs } from '../config/seo';
import '../styles/global.css';

const lang = getLangFromUrl(Astro.url);

// SEO Configuration optimized for resume/CV searches and recruiters
const resumeSEOConfig = {
  ...pageConfigs.resume,
  structuredData: getResumePageSchema(),
  alternateLanguages: [
    { hreflang: "en", href: "https://karenortiz.space/resume" },
    { hreflang: "es", href: "https://karenortiz.space/es/resume" }
  ],
  publishedTime: "2024-01-01T00:00:00Z",
  modifiedTime: new Date().toISOString(),
  author: "Karen Rebeca Ortiz"
};
---

<ResumeLayout title={resumeSEOConfig.title}>
  <!-- Advanced SEO for Resume Page -->
  <AdvancedSEO 
    title={resumeSEOConfig.title}
    description={resumeSEOConfig.description}
    keywords={resumeSEOConfig.keywords}
    canonical={resumeSEOConfig.canonical}
    ogType={resumeSEOConfig.ogType}
    structuredData={resumeSEOConfig.structuredData}
    speakable={resumeSEOConfig.speakable}
    alternateLanguages={resumeSEOConfig.alternateLanguages}
    publishedTime={resumeSEOConfig.publishedTime}
    modifiedTime={resumeSEOConfig.modifiedTime}
    author={resumeSEOConfig.author}
  />
  
  <!-- FAQ Schema for Resume-related questions -->
  <script type="application/ld+json" set:html={JSON.stringify(getResumeFAQSchema())}></script>
  
  <HeaderPill />

  <DarkModeContainer client:idle>
  
    <main class="resume-main main-content">
    <!-- Hero Section with Original CV Animations -->
    <section class="hero-section" data-semantic-role="hero" data-llm-context="professional-introduction">
        <!-- CSS Background Pattern -->
        <div class="hero-css-background"></div>

      <ResumeHeroMain client:load>
        <div class="hero-container-wrapper">
          <div class="hero-container">
            <div class="hero-grid">
              <div class="hero-content">
                <ResumeHeroBadge client:load>
                  <div class="hero-badge">{t('resume.badge', lang)}</div>
                  <h1 class="hero-title" data-llm-context="candidate-name">
                    Karen Rebeca
                    <br />
                    <span class="hero-subtitle">Ortiz</span>
                  </h1>
                </ResumeHeroBadge>
                
                <ResumeHeroDescription client:load>
                  <div class="hero-description" data-llm-context="professional-summary">
                    <p>
                      {t('resume.description.main', lang)}
                      <span class="highlight">{t('resume.description.highlight', lang)}</span>.
                    </p>
                    
                    <div class="hero-status">
                      <div class="status-indicator">
                        <div class="status-dot"></div>
                        {t('resume.description.status', lang)}
                      </div>
                      <div>{t('resume.description.location', lang)}</div>
                    </div>
                  </div>
                </ResumeHeroDescription>

                <!-- Action Buttons -->
                <div class="hero-actions">
                  <MainButton text={t('resume.buttons.downloadCV', lang)} href="/cv-karen-ortiz.pdf" />
                  <div id="portfolio-button">
                    <SecondaryButton text={t('resume.buttons.portfolio', lang)} variant="glass" />
                  </div>
                </div>
              </div>

              <ResumeHeroContact client:load>
                <div class="hero-contact" data-llm-context="contact-information">
                  <div class="contact-section">
                    <div class="section-label">{t('resume.contact.title', lang)}</div>
                    <div class="contact-links">
                      <a href="mailto:karen.ortizg@yahoo.com" class="contact-link primary">
                        karen.ortizg@yahoo.com
                      </a>
                      <a href="tel:+525660014362" class="contact-link">
                        56 6001 43 62
                      </a>
                      <a href="https://linkedin.com/in/karen-rebeca-ortiz" target="_blank" class="contact-link small">
                        linkedin.com/in/karen-rebeca-ortiz
                      </a>
                    </div>
                  </div>

                  <div class="specialties-section">
                    <div class="section-label">{t('resume.specialties.title', lang)}</div>
                    <ResumeTagGroup client:visible>
                      {t('resume.specialties.items', lang).map((specialty: string, index: number) => (
                        <ResumeTag index={index}>{specialty}</ResumeTag>
                      ))}
                    </ResumeTagGroup>
                  </div>
                </div>
              </ResumeHeroContact>
            </div>
          </div>
        </div>
      </ResumeHeroMain>
    </section>

    <!-- Professional Summary -->
    <ResumeSection client:visible id="summary" index={1} data-semantic-role="about" data-llm-context="professional-summary">
      <div class="section-container">
        <div class="section-header">
          <h2 class="section-title">
            <TextDisperse client:idle text={t('resume.sections.summary.title', lang)} />
          </h2>
          <div class="section-label">{t('resume.sections.summary.label', lang)}</div>
        </div>

        <div class="summary-content">
          <InView client:idle
            variants={{
              hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
              visible: { opacity: 1, y: 0, filter: "blur(0px)" },
            }}
            viewOptions={{ margin: "0px 0px -100px 0px" }}
            transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94] }}
          >
            <div class="summary-item">
              <h3>{t('resume.sections.summary.items.0.title', lang)}</h3>
              <p>
                {t('resume.sections.summary.items.0.content', lang)}
              </p>
            </div>
          </InView>

          <InView client:idle
            variants={{
              hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
              visible: { opacity: 1, y: 0, filter: "blur(0px)" },
            }}
            viewOptions={{ margin: "0px 0px -100px 0px" }}
            transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94], delay: 0.08 }}
          >
            <div class="summary-item">
              <h4>{t('resume.sections.summary.items.1.title', lang)}</h4>
              <p>
                {t('resume.sections.summary.items.1.content', lang)}
              </p>
            </div>
          </InView>

          <InView client:idle
            variants={{
              hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
              visible: { opacity: 1, y: 0, filter: "blur(0px)" },
            }}
            viewOptions={{ margin: "0px 0px -100px 0px" }}
            transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94], delay: 0.16 }}
          >
            <div class="summary-item">
              <h4>{t('resume.sections.summary.items.2.title', lang)}</h4>
              <p>
                {t('resume.sections.summary.items.2.content', lang)}
              </p>
            </div>
          </InView>
        </div>
      </div>
    </ResumeSection>

    <!-- Experience Section -->
    <ResumeSection client:visible id="experience" index={2} data-semantic-role="experience" data-llm-context="work-history">
      <div class="section-container">
        <div class="section-header">
          <h2 class="section-title">
            <TextDisperse client:visible text={t('resume.sections.experience.title', lang)} />
          </h2>
          <div class="section-label">{t('resume.sections.experience.label', lang)}</div>
        </div>

        <div class="experience-content">
          {t('resume.sections.experience.jobs', lang).map((job: any, jobIndex: number) => (
            <InView client:visible
              variants={{
                hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
                visible: { opacity: 1, y: 0, filter: "blur(0px)" },
              }}
              viewOptions={{ margin: "0px 0px -100px 0px" }}
              transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94], delay: jobIndex * 0.08 }}
            >
              <div class="job-section">
                <h3 class="job-title">{job.title}</h3>
                <div class="job-header">
                  <div class="company">{job.company}</div>
                  <div class="location">{job.location}</div>
                </div>

                <div class="projects-grid">
                  {job.projects.map((project: any) => (
                    <div class="project-card">
                      <h4>{project.title}</h4>
                      <p>{project.description}</p>
                    </div>
                  ))}
                </div>
              </div>
            </InView>
          ))}
        </div>
      </div>
    </ResumeSection>

    <!-- Technical Skills -->
    <ResumeSection client:visible id="skills" index={3} data-semantic-role="skills" data-llm-context="technical-competencies">
      <div class="section-container">
        <div class="section-header">
          <h2 class="section-title">
            <TextDisperse client:visible text={t('resume.sections.skills.title', lang)} />
          </h2>
          <div class="section-label">{t('resume.sections.skills.label', lang)}</div>
        </div>

        <div class="skills-container">
          <InView client:visible
            variants={{
              hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
              visible: { opacity: 1, y: 0, filter: "blur(0px)" },
            }}
            viewOptions={{ margin: "0px 0px -100px 0px" }}
            transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94] }}
          >
            <SkillGroup title={t('resume.sections.skills.groups.0.title', lang)} delay={0}>
              {t('resume.sections.skills.groups.0.skills', lang).map((skill: string, index: number) => (
                <SkillTag index={index}>{skill}</SkillTag>
              ))}
            </SkillGroup>
          </InView>

          <InView client:visible
            variants={{
              hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
              visible: { opacity: 1, y: 0, filter: "blur(0px)" },
            }}
            viewOptions={{ margin: "0px 0px -100px 0px" }}
            transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94], delay: 0.08 }}
          >
            <SkillGroup title={t('resume.sections.skills.groups.1.title', lang)} delay={1}>
              {t('resume.sections.skills.groups.1.skills', lang).map((skill: string, index: number) => (
                <SkillTag variant="secondary" index={index}>{skill}</SkillTag>
              ))}
            </SkillGroup>
          </InView>

          <InView client:visible
            variants={{
              hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
              visible: { opacity: 1, y: 0, filter: "blur(0px)" },
            }}
            viewOptions={{ margin: "0px 0px -100px 0px" }}
            transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94], delay: 0.16 }}
          >
            <SkillGroup title={t('resume.sections.skills.groups.2.title', lang)} delay={2}>
              {t('resume.sections.skills.groups.2.skills', lang).map((skill: string, index: number) => (
                <SkillTag variant="accent" index={index}>{skill}</SkillTag>
              ))}
            </SkillGroup>
          </InView>

          <InView client:visible
            variants={{
              hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
              visible: { opacity: 1, y: 0, filter: "blur(0px)" },
            }}
            viewOptions={{ margin: "0px 0px -100px 0px" }}
            transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94], delay: 0.24 }}
          >
            <SkillGroup title={t('resume.sections.skills.groups.3.title', lang)} delay={3}>
              {t('resume.sections.skills.groups.3.skills', lang).map((skill: string, index: number) => (
                <SkillTag index={index}>{skill}</SkillTag>
              ))}
            </SkillGroup>
          </InView>
        </div>
      </div>
    </ResumeSection>

    <!-- Projects Section -->
    <ResumeSection client:visible id="projects" index={4} data-semantic-role="portfolio" data-llm-context="key-projects">
      <div class="section-container">
        <div class="section-header">
          <h2 class="section-title">
            <TextDisperse client:visible text={t('resume.sections.projects.title', lang)} />
          </h2>
          <div class="section-label">{t('resume.sections.projects.label', lang)}</div>
        </div>

        <div class="projects-content">
          {t('resume.sections.projects.items', lang).map((project: any, index: number) => (
            <InView client:visible
              variants={{
                hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
                visible: { opacity: 1, y: 0, filter: "blur(0px)" },
              }}
              viewOptions={{ margin: "0px 0px -100px 0px" }}
              transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94], delay: index * 0.08 }}
            >
              <div class="project-item">
                <div class="project-number">{project.number}</div>
                <div class="project-details">
                  <h3>{project.title}</h3>
                  <div class="project-subtitle">{project.subtitle}</div>
                  <p>{project.description}</p>
                </div>
                <div class="project-benefits">
                  <div class="benefits-label">{t('resume.sections.projects.benefitsLabel', lang)}</div>
                  <p>{project.benefits}</p>
                </div>
              </div>
            </InView>
          ))}
        </div>
      </div>
    </ResumeSection>

    <!-- Education Section -->
    <ResumeSection client:visible id="education" index={5} data-semantic-role="education" data-llm-context="academic-background">
      <div class="section-container">
        <div class="section-header">
          <h2 class="section-title">
            <TextDisperse client:visible text={t('resume.sections.education.title', lang)} />
          </h2>
          <div class="section-label">{t('resume.sections.education.label', lang)}</div>
        </div>
        
        <div class="education-content">
          {t('resume.sections.education.items', lang).map((item: any, index: number) => (
            <InView client:visible
              variants={{
                hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
                visible: { opacity: 1, y: 0, filter: "blur(0px)" },
              }}
              viewOptions={{ margin: "0px 0px -100px 0px" }}
              transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94], delay: index * 0.08 }}
            >
              <div class="education-item">
                <div class="education-number">{item.number}</div>
                <div class="education-details">
                  <h3>{item.title}</h3>
                  <div class="education-duration">{item.duration}</div>
                  <ul class="education-points">
                    {item.points.map((point: string) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </InView>
          ))}
        </div>
        
        <InView client:visible
          variants={{
            hidden: { opacity: 0, y: 100, filter: "blur(4px)" },
            visible: { opacity: 1, y: 0, filter: "blur(0px)" },
          }}
          viewOptions={{ margin: "0px 0px -200px 0px" }}
          transition={{ duration: 0.3, ease: "easeInOut", delay: 0.3 }}
        >
          <div class="learning-badge">
            <div class="badge-title">{t('resume.sections.education.learningBadge.title', lang)}</div>
            <div class="badge-subtitle">{t('resume.sections.education.learningBadge.subtitle', lang)}</div>
          </div>
        </InView>
      </div>
    </ResumeSection>

    </main>

  </DarkModeContainer>

</ResumeLayout>

<style>
  body{
    background-color: #ececec;
  }

  /* Dark Mode Global Styles */
  :global(.dark-mode html) {
    background-color: #050112;
  }

  :global(.dark-mode body) {
    background-color: #050112;
    color: #ffffff;
  }

  :global(.dark-mode) {
    color-scheme: dark;
  }

  :global(.light-mode) {
    color-scheme: light;
  }
  /* Footer Spacer for Sticky Footer */
  .footer-spacer {
    height: 720px;
  }

  /* Main CV Styles - Light Mode */
  .resume-main {
    background: #ececec;
    color: #000000;
    font-family: var(--font-primary);
    padding-top: 80px; /* Account for CV header (no TopMarquee) */
    min-height: 100vh;
    transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark Mode Styles for Main */
  :global(.dark-mode .resume-main) {
    background: #050112;
    color: #ffffff;
  }

  /* Hero Section */

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 3fr 2fr;
      gap: 4rem;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .hero-badge {
    font-size: 0.875rem;
    color: rgb(0, 0, 0);
    font-family: 'Courier New', monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .hero-badge) {
    color: #ffffff;
  }

  .hero-title {
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-family: var(--font-display); /* Median font */
    color: #313131;
    min-height: 4.4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    contain: layout style;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .hero-title) {
    color: #ffffff;
  }

  .hero-subtitle {
    color: #888888;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .hero-subtitle) {
    color: #cccccc;
  }

  /* Hero Description Styles - Following DarkMode.md pattern exactly */
  :global(.hero-description) {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  :global(.hero-description p) {
    font-size: clamp(1.125rem, 3vw, 1.25rem);
    line-height: 1.6;
    color: #000000;
    transition: 
      color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .hero-description p) {
    color: #ffffff;
  }

  :global(.hero-description *) {
    color: #000000;
    transition: 
      color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .hero-description *) {
    color: #ffffff;
  }

  .highlight {
    color: #7a7a7a;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .highlight) {
    color: #cccccc;
  }

  /* Hero Action Buttons */
  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
      gap: 1rem;
    }
  }

  .hero-status {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: #363636;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .hero-status) {
    color: #cccccc;
  }

  @media (min-width: 640px) {
    .hero-status {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: #000000;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .hero-contact {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 2rem;
    margin-top: 2rem;
  }

  @media (min-width: 1024px) {
    .hero-contact {
      margin-top: 0;
    }
  }

  .contact-section, .specialties-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-label {
    font-size: 0.875rem;
    color: #000000;
    font-family: 'Courier New', monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .section-label) {
    color: #ffffff;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-link {
    color: #1d1d1db6;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  :global(.dark-mode .contact-link) {
    color: rgba(255, 255, 255, 0.7);
  }

  .contact-link:hover {
    color: rgb(0, 0, 0);
  }

  :global(.dark-mode .contact-link:hover) {
    color: #ffffff;
  }

  .contact-link.primary {
    font-weight: 500;
  }

  .contact-link.small {
    font-size: 0.75rem;
    color: #222222;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .contact-link.small) {
    color: #cccccc;
  }

  /* Section Styles */
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    margin-bottom: 8rem; /* Increased spacing between sections */
  }

  @media (max-width: 768px) {
    .section-container {
      margin-bottom: 6rem; /* Reduced spacing on mobile */
    }
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 640px) {
    .section-header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 3.5rem;
    }
  }

  @media (min-width: 1024px) {
    .section-header {
      margin-bottom: 4rem;
    }
  }

  .section-title {
    font-size: clamp(2rem, 6vw, 2.5rem);
    font-weight: 300;
    font-family: var(--font-display); /* Median font */
    color: #0c0819;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .section-title) {
    color: #ffffff;
  }

  /* TextDisperse styles for section titles */
  .section-title :global(.relative) {
    color: #0c0819 !important;
    font-size: inherit;
    font-family: inherit;
    font-weight: inherit;
    line-height: inherit;
