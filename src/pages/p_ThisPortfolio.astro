							<CodeBlock 
								code={`// GemStore - Optimized by slices for 3D performance
const useGemStore = create<{
  // Visibility slice - for rendering control
  isVisible: boolean;
  isPaused: boolean;
  quality: 'low' | 'medium' | 'high';

  // Animation slice - scroll-based properties
  scrollRotationX: number;
  scrollRotationY: number;
  scrollRotationZ: number;

  // Performance slice - resource management
  memoryUsage: number;
  frameRate: number;

  // Actions with batch updates
  setVisibility: (visible: boolean) => void;
  setScrollRotation: (x: number, y: number, z: number) => void;
  batchUpdate: (updates: Partial<State>) => void;
  cleanup: () => void;
}>((set, get) => ({
  // Initial state
  isVisible: false,
  isPaused: false,
  quality: 'medium',
  scrollRotationX: 0,
  scrollRotationY: 0,
  scrollRotationZ: 0,

  // Optimized actions
  setVisibility: (visible) => set({ isVisible: visible }),
  
  setScrollRotation: (x, y, z) => set({
    scrollRotationX: x,
    scrollRotationY: y,
    scrollRotationZ: z
  }),

  // Batch updater for multiple changes
  batchUpdate: (updates) => set((state) => ({ 
    ...state, ...updates 
  })),

  // Cleanup for memory management
  cleanup: () => set({
    isVisible: false,
    isPaused: true,
    scrollRotationX: 0,
    scrollRotationY: 0,
    scrollRotationZ: 0
  })
}));

// Optimized selectors prevent re-renders
export const useGemVisibility = () => useGemStore(
  (state) => ({ 
    isVisible: state.isVisible, 
    isPaused: state.isPaused 
  }),
  shallow
);

export const useGemActions = () => useGemStore(
  (state) => ({
    setVisibility: state.setVisibility,
    setScrollRotation: state.setScrollRotation,
    batchUpdate: state.batchUpdate,
    cleanup: state.cleanup
  }),
  shallow
);`}
