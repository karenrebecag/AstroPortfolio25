function drawPixelEnemy(x: number, y: number, frame: number, type: number) {
  const size = 8;
  const isDarkMode = document.documentElement.classList.contains('dark-mode');

  // Color selection based on enemy type and theme
  if (isDarkMode) {
    ctx!.fillStyle = type === 0 ? '#8464ee' : type === 1 ? '#c1b9f9' : '#6431d0';
  } else {
    ctx!.fillStyle = type === 0 ? '#4a3293' : type === 1 ? '#6b46c1' : '#2d1b69';
  }

  // Frame 0 - First animation state
  if (frame === 0) {
    // Top row - 3 pixels wide
    ctx!.fillRect(x + size, y, size * 3, size);
    
    // Body - 5 pixels wide
    ctx!.fillRect(x, y + size, size * 5, size);
    
    // Arms - outer pixels
    ctx!.fillRect(x, y + size * 2, size, size);
    ctx!.fillRect(x + size * 4, y + size * 2, size, size);
    
    // Bottom - 3 pixels wide
    ctx!.fillRect(x + size, y + size * 3, size * 3, size);
  } else {
    // Frame 1 - Second animation state
    // Slightly different arm positions for animation
    ctx!.fillRect(x + size, y, size * 3, size);
    ctx!.fillRect(x, y + size, size * 5, size);
    
    // Animated arms - inward position
    ctx!.fillRect(x + size, y + size * 2, size, size);
    ctx!.fillRect(x + size * 3, y + size * 2, size, size);
    
    ctx!.fillRect(x + size, y + size * 3, size * 3, size);
  }
}

// Game mechanics with authentic timing
function updateEnemies() {
  gameState.moveCounter++;

  // Original arcade timing - enemies move every 60 frames initially
  if (gameState.moveCounter >= gameState.enemyMoveDelay) {
    gameState.moveCounter = 0;
    let shouldMoveDown = false;

    // Check if any enemy hits screen edge
    gameState.enemies.forEach(enemy => {
      if (enemy.alive) {
        const nextX = enemy.gridX + gameState.enemyDirection;
        if (nextX < 0 || nextX >= Math.floor(canvas!.width / GRID_SIZE)) {
          shouldMoveDown = true;
        }
      }
    });

    if (shouldMoveDown) {
      // Move down and reverse direction - authentic behavior
      gameState.enemyDirection *= -1;
      gameState.enemies.forEach(enemy => {
        if (enemy.alive) {
          enemy.gridY += 1;
        }
      });
      
      // Speed up as in original - fewer enemies = faster movement
      const aliveCount = gameState.enemies.filter(e => e.alive).length;
      gameState.enemyMoveDelay = Math.max(10, 60 - (55 - aliveCount) * 2);
    } else {
      // Horizontal movement
      gameState.enemies.forEach(enemy => {
        if (enemy.alive) {
          enemy.gridX += gameState.enemyDirection;
        }
      });
    }
  }
}`}
