	/* Content Highlights */
	.content-highlights {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.highlight-item {
		display: flex;
		gap: 1.5rem;
		align-items: flex-start;
	}

	.highlight-number {
		font-family: var(--font-display, 'Median', serif);
		font-size: 1.5rem;
		font-weight: 400;
		color: #4523AE;
		min-width: 3rem;
		text-align: center;
