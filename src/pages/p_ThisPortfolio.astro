		font-weight: 500;
		padding: 0.5rem 1rem;
		background: #f8f9fa;
		color: #4523AE;
		border: 1px solid #e9ecef;
		border-radius: 20px;
		transition: all 0.2s ease;
	}

	.tech-tag:hover {
		background: #4523AE;
		color: white;
		transform: translateY(-1px);
	}

	/* Responsive Design */
	@media (max-width: 768px) {
		.banner-actions {
			flex-direction: column;
			gap: 0.75rem;
		}

		.content-section {
			padding: 4rem 1rem;
		}

		.content-grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.section-header {
			margin-bottom: 3rem;
		}

		.features-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.feature-card {
			padding: 1.5rem;
		}

		.tech-categories {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.highlight-item {
			gap: 1rem;
		}

		.highlight-number {
			min-width: 2rem;
			font-size: 1.25rem;
		}
