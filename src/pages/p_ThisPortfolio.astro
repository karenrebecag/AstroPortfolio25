							</p>
							<CodeBlock 
								code={`// Fragment shader - Simplex noise implementation
vec3 mod289(vec3 x) { 
  return x - floor(x * (1.0 / 289.0)) * 289.0; 
}

vec4 mod289(vec4 x) { 
  return x - floor(x * (1.0 / 289.0)) * 289.0; 
}

vec4 permute(vec4 x) { 
  return mod289(((x*34.0)+1.0)*x); 
}

float snoise(vec3 v) {
  const vec2 C = vec2(1.0/6.0, 1.0/3.0);
  const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);
  
  // First corner
  vec3 i = floor(v + dot(v, C.yyy));
  vec3 x0 = v - i + dot(i, C.xxx);
  
  // Other corners - mathematical precision
  vec3 g = step(x0.yzx, x0.xyz);
  vec3 l = 1.0 - g;
  vec3 i1 = min(g.xyz, l.zxy);
  vec3 i2 = max(g.xyz, l.zxy);
  
  // Gradient calculations
  vec3 x1 = x0 - i1 + C.xxx;
  vec3 x2 = x0 - i2 + C.yyy;
  vec3 x3 = x0 - D.yyy;
  
  // Final noise value with artistic control
  return 42.0 * dot(m*m, vec4(
    dot(p0,x0), dot(p1,x1), 
    dot(p2,x2), dot(p3,x3)
  ));
}`}
