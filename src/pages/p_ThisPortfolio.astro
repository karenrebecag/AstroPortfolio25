	/* Ensure ALL text elements change color in dark mode */
	:global(.dark-mode),
	:global(.dark-mode *),
	:global(.dark-mode h1),
	:global(.dark-mode h2),
	:global(.dark-mode h3),
	:global(.dark-mode h4),
	:global(.dark-mode h5),
	:global(.dark-mode h6),
	:global(.dark-mode p),
	:global(.dark-mode span),
	:global(.dark-mode div),
	:global(.dark-mode li),
	:global(.dark-mode ul),
	:global(.dark-mode ol),
	:global(.dark-mode td),
	:global(.dark-mode th),
	:global(.dark-mode label),
	:global(.dark-mode input),
	:global(.dark-mode textarea),
	:global(.dark-mode button),
	:global(.dark-mode a) {
