---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import HeaderPill from '../components/ui/HeaderPill.astro';
import ParallaxBanner from '../components/ui/ParallaxBanner.astro';
import MainButton from '../components/ui/MainButton.astro';
import { TextDisperseBlack } from '../components/ui/TextDisperseBlack.tsx';
import { InView } from '../components/ui/InView.tsx';
import { DarkModeContainer } from '../components/ui/DarkModeContainer.tsx';
import { LucideIcon } from '../components/ui/LucideIcon.tsx';
import ShareBar from '../components/ui/ShareBar.astro';
import CommentsSection from '../components/ui/CommentsSection.astro';
import '../styles/global.css';
---

<Layout title="Karen Ortiz - Términos y Condiciones" lang="en">
	<HeaderPill />

	<!-- Parallax Banner Strip -->
	<ParallaxBanner
		title="Términos y Condiciones"
		subtitle="Condiciones de uso, políticas de privacidad y términos legales para el uso de este portafolio"
		backgroundSrc="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/alt-g7Cv2QzqL3k6ey3igjNYkM32d8Fld7.mp4"
		placeholder=""
		height="100vh"
	>
		<div slot="actions" class="banner-actions">
			<MainButton href="#terms-overview" />
		</div>
	</ParallaxBanner>

	<DarkModeContainer client:load>
		<!-- Main Content Sections -->
		<main class="main-content" id="main-content">

		<!-- Terms Overview Section -->
		<section class="content-section" id="terms-overview">
			<div class="section-container">
				<div class="section-header">
					<h2 class="section-title" id="terms-overview">
						<TextDisperseBlack client:idle text="Información Legal" />
					</h2>
					<div class="section-label">Actualizado: Septiembre 2025</div>
				</div>

				<InView client:idle
					variants={{
						hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
						visible: { opacity: 1, y: 0, filter: "blur(0px)" },
					}}
					viewOptions={{ margin: "0px 0px -100px 0px" }}
					transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94] }}
				>
					<div class="content-grid">
						<div class="content-main">
							<p class="content-description">
								Bienvenido al portafolio profesional de Karen Rebeca Ortiz. Al acceder y utilizar este sitio web, aceptas cumplir con los siguientes términos y condiciones. Este documento establece las reglas y regulaciones para el uso de este portafolio personal y profesional.
							</p>

							<div class="content-highlights">
								<div class="highlight-item">
									<div class="highlight-number">01</div>
									<div class="highlight-content">
										<h3>Uso Permitido</h3>
										<p>Este sitio web es un portafolio profesional destinado a mostrar habilidades, proyectos y experiencia profesional con fines informativos y de networking.</p>
									</div>
								</div>

								<div class="highlight-item">
									<div class="highlight-number">02</div>
									<div class="highlight-content">
										<h3>Propiedad Intelectual</h3>
										<p>Todo el contenido, incluyendo código, diseños, textos e imágenes, está protegido por derechos de autor y es propiedad de Karen Rebeca Ortiz.</p>
									</div>
								</div>

								<div class="highlight-item">
									<div class="highlight-number">03</div>
									<div class="highlight-content">
										<h3>Responsabilidad</h3>
										<p>El uso de la información y recursos disponibles en este sitio es bajo tu propia responsabilidad y discreción.</p>
									</div>
								</div>
							</div>
						</div>

						<div class="content-sidebar">
							<div class="info-card">
								<div class="info-label">Última Actualización</div>
								<div class="info-value">Septiembre 2025</div>
							</div>

							<div class="info-card">
								<div class="info-label">Jurisdicción</div>
								<div class="info-value">Internacional</div>
							</div>

							<div class="info-card">
								<div class="info-label">Idioma Principal</div>
								<div class="info-value">Español/English</div>
							</div>

							<div class="info-card">
								<div class="info-label">Estado</div>
								<div class="info-value status-active">
									<div class="status-dot"></div>
									Vigente
								</div>
							</div>
						</div>
					</div>
				</InView>
			</div>
		</section>

		<!-- Terms of Use Section -->
		<section class="content-section" id="terms-of-use">
			<div class="section-container">
				<div class="section-header">
					<h2 class="section-title">
						<TextDisperseBlack client:visible text="Términos de Uso" />
					</h2>
					<div class="section-label">Condiciones Generales</div>
				</div>

				<InView client:visible
					variants={{
						hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
						visible: { opacity: 1, y: 0, filter: "blur(0px)" },
					}}
					viewOptions={{ margin: "0px 0px -100px 0px" }}
					transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94], delay: 0.1 }}
				>
					<div class="terms-content">
						<div class="term-section">
							<div class="term-icon">
								<LucideIcon client:load name="file-text" size={32} />
							</div>
							<div class="term-details">
								<h3>1. Aceptación de Términos</h3>
								<p>Al acceder a este sitio web, aceptas estar sujeto a estos términos y condiciones. Si no estás de acuerdo con alguno de estos términos, no debes usar este sitio.</p>
							</div>
						</div>

						<div class="term-section">
							<div class="term-icon">
								<LucideIcon client:load name="eye" size={32} />
							</div>
							<div class="term-details">
								<h3>2. Uso del Contenido</h3>
								<p>El contenido de este sitio es para uso informativo únicamente. No puedes reproducir, distribuir o crear trabajos derivados sin permiso expreso por escrito.</p>
							</div>
						</div>

						<div class="term-section">
							<div class="term-icon">
								<LucideIcon client:load name="shield-check" size={32} />
							</div>
							<div class="term-details">
								<h3>3. Limitación de Responsabilidad</h3>
								<p>Este sitio se proporciona "tal como está". No garantizamos que esté libre de errores o que satisfaga tus requisitos específicos.</p>
							</div>
						</div>

						<div class="term-section">
							<div class="term-icon">
								<LucideIcon client:load name="users" size={32} />
							</div>
							<div class="term-details">
								<h3>4. Conducta del Usuario</h3>
								<p>Los usuarios deben comportarse de manera respetuosa y profesional al interactuar con este sitio y sus contenidos.</p>
							</div>
						</div>

						<div class="term-section">
							<div class="term-icon">
								<LucideIcon client:load name="refresh-cw" size={32} />
							</div>
							<div class="term-details">
								<h3>5. Modificaciones</h3>
								<p>Nos reservamos el derecho de modificar estos términos en cualquier momento. Los cambios entrarán en vigor inmediatamente después de su publicación.</p>
							</div>
						</div>

						<div class="term-section">
							<div class="term-icon">
								<LucideIcon client:load name="mail" size={32} />
							</div>
							<div class="term-details">
								<h3>6. Contacto</h3>
								<p>Para preguntas sobre estos términos, contacta a: sodioinfo@gmail.com</p>
							</div>
						</div>
					</div>
				</InView>
			</div>
		</section>

		<!-- Privacy Policy Section -->
		<section class="content-section" id="privacy-policy">
			<div class="section-container">
				<div class="section-header">
					<h2 class="section-title">
						<TextDisperseBlack client:visible text="Política de Privacidad" />
					</h2>
					<div class="section-label">Protección de Datos</div>
				</div>

				<InView client:visible
					variants={{
						hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
						visible: { opacity: 1, y: 0, filter: "blur(0px)" },
					}}
					viewOptions={{ margin: "0px 0px -100px 0px" }}
					transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94], delay: 0.2 }}
				>
					<div class="privacy-content">
						<div class="privacy-card">
							<div class="privacy-header">
								<LucideIcon client:load name="lock" size={40} />
								<h3>Recopilación de Información</h3>
							</div>
							<div class="privacy-body">
								<ul>
									<li>No recopilamos información personal identificable sin tu consentimiento</li>
									<li>Podemos usar cookies para mejorar la experiencia del usuario</li>
									<li>Los datos de analytics son anónimos y agregados</li>
									<li>No vendemos ni compartimos información personal con terceros</li>
								</ul>
							</div>
						</div>

						<div class="privacy-card">
							<div class="privacy-header">
								<LucideIcon client:load name="database" size={40} />
								<h3>Uso de la Información</h3>
							</div>
							<div class="privacy-body">
								<ul>
									<li>Mejorar la funcionalidad y experiencia del sitio web</li>
									<li>Responder a consultas y comunicaciones</li>
									<li>Análisis de tráfico y comportamiento del usuario (anónimo)</li>
									<li>Cumplimiento de obligaciones legales cuando sea necesario</li>
								</ul>
							</div>
						</div>

						<div class="privacy-card">
							<div class="privacy-header">
								<LucideIcon client:load name="shield" size={40} />
								<h3>Seguridad de Datos</h3>
							</div>
							<div class="privacy-body">
								<ul>
									<li>Implementamos medidas de seguridad técnicas y organizativas</li>
									<li>Acceso limitado a información personal</li>
									<li>Cifrado de datos sensibles en tránsito y en reposo</li>
									<li>Revisiones regulares de nuestras prácticas de seguridad</li>
								</ul>
							</div>
						</div>

						<div class="privacy-card">
							<div class="privacy-header">
								<LucideIcon client:load name="user-check" size={40} />
								<h3>Tus Derechos</h3>
							</div>
							<div class="privacy-body">
								<ul>
									<li>Derecho de acceso a tu información personal</li>
									<li>Derecho de rectificación de datos incorrectos</li>
									<li>Derecho de eliminación de tus datos</li>
									<li>Derecho de portabilidad de datos</li>
								</ul>
							</div>
						</div>
					</div>
				</InView>
			</div>
		</section>

		<!-- Intellectual Property Section -->
		<section class="content-section" id="intellectual-property">
			<div class="section-container">
				<div class="section-header">
					<h2 class="section-title">
						<TextDisperseBlack client:visible text="Propiedad Intelectual" />
					</h2>
					<div class="section-label">Derechos de Autor</div>
				</div>

				<InView client:visible
					variants={{
						hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
						visible: { opacity: 1, y: 0, filter: "blur(0px)" },
					}}
					viewOptions={{ margin: "0px 0px -100px 0px" }}
					transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94], delay: 0.3 }}
				>
					<div class="ip-content">
						<div class="ip-section">
							<h3>Contenido Original</h3>
							<p>Todo el contenido original de este sitio web, incluyendo pero no limitado a:</p>
							<ul>
								<li>Código fuente y arquitectura de software</li>
								<li>Diseños, layouts y elementos visuales</li>
								<li>Textos, artículos y documentación</li>
								<li>Fotografías y materiales gráficos originales</li>
								<li>Proyectos y casos de estudio presentados</li>
							</ul>
							<p>Están protegidos por derechos de autor y son propiedad exclusiva de Karen Rebeca Ortiz.</p>
						</div>

						<div class="ip-section">
							<h3>Uso Permitido</h3>
							<p>Se permite el uso limitado del contenido para:</p>
							<ul>
								<li>Visualización personal y profesional</li>
								<li>Referencia en procesos de contratación</li>
								<li>Evaluación de habilidades técnicas</li>
								<li>Networking profesional</li>
							</ul>
						</div>

						<div class="ip-section">
							<h3>Uso Prohibido</h3>
							<p>Está estrictamente prohibido:</p>
							<ul>
								<li>Copiar, reproducir o distribuir el contenido sin autorización</li>
								<li>Crear trabajos derivados basados en el contenido</li>
								<li>Usar el contenido con fines comerciales sin permiso</li>
								<li>Remover o alterar avisos de derechos de autor</li>
								<li>Hacerse pasar por el autor original del contenido</li>
							</ul>
						</div>

						<div class="ip-section">
							<h3>Contenido de Terceros</h3>
							<p>Algunos elementos pueden incluir:</p>
							<ul>
								<li>Bibliotecas y frameworks de código abierto (licenciados apropiadamente)</li>
								<li>Íconos y recursos bajo licencias Creative Commons</li>
								<li>Imágenes de stock con licencia apropiada</li>
								<li>Herramientas y servicios de terceros integrados</li>
							</ul>
							<p>Estos elementos mantienen sus licencias originales y derechos de sus respectivos propietarios.</p>
						</div>
					</div>
				</InView>
			</div>
		</section>

		<!-- Disclaimer Section -->
		<section class="content-section" id="disclaimer">
			<div class="section-container">
				<div class="section-header">
					<h2 class="section-title">
						<TextDisperseBlack client:visible text="Descargo de Responsabilidad" />
					</h2>
					<div class="section-label">Información Importante</div>
				</div>

				<InView client:visible
					variants={{
						hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
						visible: { opacity: 1, y: 0, filter: "blur(0px)" },
					}}
					viewOptions={{ margin: "0px 0px -100px 0px" }}
					transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94], delay: 0.4 }}
				>
					<div class="disclaimer-content">
						<div class="disclaimer-card important">
							<div class="disclaimer-header">
								<LucideIcon client:load name="alert-triangle" size={32} />
								<h3>Aviso General</h3>
							</div>
							<p>
								La información en este sitio web se proporciona únicamente con fines informativos y de demostración profesional.
								Aunque nos esforzamos por mantener la información actualizada y precisa, no hacemos declaraciones ni garantías
								de ningún tipo, expresas o implícitas, sobre la integridad, precisión, confiabilidad, idoneidad o disponibilidad
				del sitio web o la información contenida en él.
							</p>
						</div>

						<div class="disclaimer-card">
							<div class="disclaimer-header">
								<LucideIcon client:load name="info" size={32} />
								<h3>Proyectos y Casos de Estudio</h3>
							</div>
							<p>
								Los proyectos presentados en este portafolio son ejemplos de trabajo profesional. Los resultados pasados
								no garantizan resultados futuros similares. Cada proyecto es único y los resultados pueden variar según
								las circunstancias específicas, recursos disponibles y objetivos del cliente.
							</p>
						</div>

						<div class="disclaimer-card">
							<div class="disclaimer-header">
								<LucideIcon client:load name="external-link" size={32} />
								<h3>Enlaces Externos</h3>
							</div>
							<p>
								Este sitio web puede contener enlaces a otros sitios web que no están bajo nuestro control.
								No tenemos control sobre la naturaleza, contenido y disponibilidad de esos sitios. La inclusión
								de cualquier enlace no implica necesariamente una recomendación o respaldo de las opiniones expresadas en ellos.
							</p>
						</div>

						<div class="disclaimer-card">
							<div class="disclaimer-header">
								<LucideIcon client:load name="clock" size={32} />
								<h3>Disponibilidad del Servicio</h3>
							</div>
							<p>
								Aunque nos esforzamos por mantener el sitio web funcionando sin problemas, no somos responsables
				temporales por razones que están fuera de nuestro control, incluyendo pero no limitado a fallas técnicas,
				mantenimiento, actualizaciones o causas de fuerza mayor.
			</p>
						</div>
					</div>
				</InView>
			</div>
		</section>

		<!-- Contact Legal Section -->
		<section class="content-section" id="legal-contact">
			<div class="section-container">
				<div class="section-header">
					<h2 class="section-title">
						<TextDisperseBlack client:visible text="Contacto Legal" />
					</h2>
					<div class="section-label">Consultas y Soporte</div>
				</div>

				<InView client:visible
					variants={{
						hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
						visible: { opacity: 1, y: 0, filter: "blur(0px)" },
					}}
					viewOptions={{ margin: "0px 0px -100px 0px" }}
					transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94], delay: 0.5 }}
				>
					<div class="legal-contact-content">
						<div class="contact-info">
							<h3>Información de Contacto</h3>
							<p>
								Si tienes preguntas sobre estos Términos y Condiciones, Política de Privacidad,
				o cualquier aspecto legal relacionado con este sitio web, no dudes en contactarnos:
			</p>

							<div class="contact-details">
								<div class="contact-item">
									<LucideIcon client:load name="mail" size={20} />
									<div>
										<strong>Email:</strong>
										<a href="mailto:sodioinfo@gmail.com">sodioinfo@gmail.com</a>
									</div>
								</div>

								<div class="contact-item">
									<LucideIcon client:load name="globe" size={20} />
									<div>
										<strong>Sitio Web:</strong>
										<span>karenortiz.dev</span>
									</div>
								</div>

								<div class="contact-item">
									<LucideIcon client:load name="clock" size={20} />
									<div>
										<strong>Tiempo de Respuesta:</strong>
										<span>2-3 días hábiles</span>
									</div>
								</div>
							</div>

							<div class="legal-note">
								<p>
									<strong>Nota:</strong> Este documento constituye un acuerdo legal entre tú y Karen Rebeca Ortiz.
					Al utilizar este sitio web, confirmas que has leído, entendido y aceptado estar sujeto a estos términos.
				</p>
							</div>
						</div>
					</div>
				</InView>
			</div>
		</section>

		<!-- Share Bar Section -->
		<ShareBar />

		<!-- Comments Section -->
		<CommentsSection storyId="terms-and-conditions" />

		</main>
	</DarkModeContainer>
</Layout>

<style>
	/* Banner Actions */
	.banner-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
	}

	/* Main Content Layout */
	.main-content {
		background: #ececec;
		width: 100%;
		padding: 0;
	}

	.content-section {
		padding: 6rem 2rem;
		border-bottom: 1px solid #f0f0f0;
		background-image:
			linear-gradient(rgba(0, 0, 0, 0.03) 1px, transparent 1px),
			linear-gradient(90deg, rgba(0, 0, 0, 0.03) 1px, transparent 1px);
		background-size: 20px 20px;
		position: relative;
	}

	.content-section:last-child {
		border-bottom: none;
	}

	.section-container {
		max-width: 1200px;
		margin: 0 auto;
		width: 100%;
	}

	/* Section Headers */
	.section-header {
		margin-bottom: 4rem;
		text-align: center;
	}

	.section-title {
		font-family: var(--font-display, 'Median', serif);
		font-size: clamp(2.5rem, 6vw, 4rem);
		font-weight: 400;
		line-height: 0.9;
		margin-bottom: 1rem;
		color: #1B1B1B;
	}

	.section-label {
		font-family: var(--font-primary, 'InterTight', sans-serif);
		font-size: 0.875rem;
		font-weight: 500;
		color: #666;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	/* Content Grid Layout */
	.content-grid {
		display: grid;
		grid-template-columns: 2fr 1fr;
		gap: 4rem;
		align-items: start;
	}

	.content-main {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.content-description {
		font-family: var(--font-primary, 'InterTight', sans-serif);
		font-size: 1.125rem;
		line-height: 1.6;
		color: #333;
		margin: 0;
	}

	/* Content Highlights */
	.content-highlights {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.highlight-item {
		display: flex;
		gap: 1.5rem;
		align-items: flex-start;
	}

	.highlight-number {
		font-family: var(--font-display, 'Median', serif);
		font-size: 1.5rem;
		font-weight: 400;
		color: #4523AE;
		min-width: 3rem;
		text-align: center;
	}

	.highlight-content h3 {
		font-family: var(--font-primary, 'InterTight', sans-serif);
		font-size: 1.125rem;
		font-weight: 600;
		color: #1B1B1B;
		margin: 0 0 0.5rem 0;
	}

	.highlight-content p {
		font-family: var(--font-primary, 'InterTight', sans-serif);
		font-size: 1rem;
		line-height: 1.5;
		color: #666;
		margin: 0;
	}

	/* Sidebar Info Cards */
	.content-sidebar {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.info-card {
		padding: 1.5rem;
		background: #f8f9fa;
		border-radius: 12px;
		border: 1px solid #e9ecef;
	}

	.info-label {
		font-family: var(--font-primary, 'InterTight', sans-serif);
		font-size: 0.875rem;
