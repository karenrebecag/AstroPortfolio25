---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Banner from '../../components/Home/Banner/Banner.astro';
import Marquees from '../../components/Home/Marquees/Marquees.astro';
import Me from '../../components/Home/Me/Me.astro';
import Services from '../../components/Home/Services/Services.astro';
import Projects from '../../components/ui/Projects.astro';
import MyStack from '../../components/Home/MyStack/MyStack.astro';
import FAQs from '../../components/ui/FAQs.astro';
import GetInTouch from "../../components/modules/GetInTouch/components/GetInTouch.astro";
import Footer from "../../components/modules/Footer/components/Footer.astro";
import Enterprises from '../../components/Home/Enterprises/Enterprises.astro';
import GemSection from '../../components/Home/GemSection/GemSection.astro';
import WhiteBackground from '../../components/ui/WhiteBackgroundTexture/WhiteBackground.astro';
import '../../styles/global.css';
---

<Layout title="Karen Rebeca Ortiz - 作品集" lang="zh-tw">
	<WhiteBackground>
		<Banner lang="zh-tw" />
	</WhiteBackground>

	<WhiteBackground>
		<Enterprises lang="zh-tw" />
		<GemSection />
		<section id="about">
			<Me />
		</section>
		<Services />
		<Marquees />

		<MyStack lang="zh-tw" />
	</WhiteBackground>

	<section id="projects">
		<Projects />
	</section>
	<div class="faqs-responsive-container">
		<FAQs />
	</div>
	<section id="contact">
		<GetInTouch lang="zh-tw" />
	</section>
	<Footer />
</Layout>

<style>
  /* Hide FAQs only on viewport < 480px */
  @media (max-width: 479px) {
    .faqs-responsive-container {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      height: 0 !important;
      overflow: hidden !important;
    }
  }
</style>