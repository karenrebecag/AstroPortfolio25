---
import CVLayout from '../layouts/CVLayout.astro';
import CVHeader from '../components/ui/CVHeader.astro';
import { CVSection } from '../components/ui/CVSection.tsx';
import { CVTag, CVTagGroup } from '../components/ui/CVTag.tsx';
import { SkillTag, SkillGroup } from '../components/ui/SkillTag.tsx';
import { CVHeroBadge, CVHeroDescription, CVHeroContact, CVHeroMain } from '../components/ui/CVHeroAnimations.tsx';
import { CVFooter } from '../components/ui/CVFooter.tsx';
import { DitheringShader } from '../components/three/DitheringShader.tsx';
import MainButton from '../components/ui/MainButton.astro';
import SecondaryButton from '../components/ui/SecondaryButton.astro';
import { TextDisperse } from '../components/ui/TextDisperse.tsx';
import { InView } from '../components/ui/InView.tsx';
---

<CVLayout title="Karen Rebeca Ortiz - CV Profesional">
  <CVHeader />
  
  <main class="cv-main">
    <!-- Hero Section with Original CV Animations -->
    <section class="hero-section">
        <!-- DitheringShader Background Scene -->
        <div class="hero-dithering-background">
          <DitheringShader 
            client:load
            width={1920}
            height={1800}
            colorBack="#dcdcdc"
            colorFront="#ffffff"
            shape="wave"
            type="8x8"
            pxSize={3}
            speed={0.6}
          />
        </div>

      <CVHeroMain client:load>
        <div class="hero-container-wrapper">
          <div class="hero-container">
            <div class="hero-grid">
              <div class="hero-content">
                <CVHeroBadge client:load>
                  <div class="hero-badge">DESIGN ENGINEER / 2025</div>
                  <h1 class="hero-title">
                    Karen Rebeca
                    <br />
                    <span class="hero-subtitle">Ortiz</span>
                  </h1>
                </CVHeroBadge>
                
                <CVHeroDescription client:load>
                  <div class="hero-description">
                    <p>
                      Passionate technology professional focused on improving quality of life through
                      <span class="highlight"> innovative, sustainable, and scalable digital solutions</span>.
                    </p>
                    
                    <div class="hero-status">
                      <div class="status-indicator">
                        <div class="status-dot"></div>
                        Available for opportunities
                      </div>
                      <div>Mexico City (CDMX)</div>
                    </div>
                  </div>
                </CVHeroDescription>

                <!-- Action Buttons -->
                <div class="hero-actions">
                  <MainButton text="Download CV" href="/cv-karen-ortiz.pdf" />
                  <div id="portfolio-button">
                    <SecondaryButton text="Go Portfolio" variant="glass" />
                  </div>
                </div>
              </div>

              <CVHeroContact client:load>
                <div class="hero-contact">
                  <div class="contact-section">
                    <div class="section-label">CONTACT</div>
                    <div class="contact-links">
                      <a href="mailto:karen.ortizg@yahoo.com" class="contact-link primary">
                        karen.ortizg@yahoo.com
                      </a>
                      <a href="tel:+525660014362" class="contact-link">
                        56 6001 43 62
                      </a>
                      <a href="https://linkedin.com/in/karen-rebeca-ortiz" target="_blank" class="contact-link small">
                        linkedin.com/in/karen-rebeca-ortiz
                      </a>
                    </div>
                  </div>

                  <div class="specialties-section">
                    <div class="section-label">SPECIALTIES</div>
                    <CVTagGroup client:load>
                      <CVTag index={0}>UX/UI Design</CVTag>
                      <CVTag index={1}>Frontend</CVTag>
                      <CVTag index={2}>Fullstack</CVTag>
                      <CVTag index={3}>AI Integration</CVTag>
                      <CVTag index={4}>Project Management</CVTag>
                    </CVTagGroup>
                  </div>
                </div>
              </CVHeroContact>
            </div>
          </div>
        </div>
      </CVHeroMain>
    </section>

    <!-- Professional Summary -->
    <CVSection client:load id="summary" index={1}>
      <div class="section-container">
        <div class="section-header">
          <h2 class="section-title">
            <TextDisperse client:load text="Professional Summary" />
          </h2>
          <div class="section-label">OVERVIEW</div>
        </div>

        <div class="summary-content">
          <InView client:load
            variants={{
              hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
              visible: { opacity: 1, y: 0, filter: "blur(0px)" },
            }}
            viewOptions={{ margin: "0px 0px -100px 0px" }}
            transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94] }}
          >
            <div class="summary-item">
              <h3>Design Engineer & Fullstack Developer</h3>
              <p>
                Passionate technology professional focused on improving quality of life through innovative, 
                sustainable, and scalable digital product design and development. Extensive experience in 
                diverse tech roles including technical UX/UI design, frontend development, 3D animation for 
                web environments, project architecture, and backend development on serverless platforms with AI integrations.
              </p>
            </div>
          </InView>

          <InView client:load
            variants={{
              hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
              visible: { opacity: 1, y: 0, filter: "blur(0px)" },
            }}
            viewOptions={{ margin: "0px 0px -100px 0px" }}
            transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94], delay: 0.08 }}
          >
            <div class="summary-item">
              <h4>Professional Journey</h4>
              <p>
                This journey has enabled me to lead large-scale projects autonomously and collaborate with 
                multidisciplinary international teams, adding value and creativity at every development stage. 
                My approach centers on adopting modern and adaptive technologies, prioritizing agile methodologies 
                and phase-by-phase development to ensure high-quality results in large-scale projects.
              </p>
            </div>
          </InView>

