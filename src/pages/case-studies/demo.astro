---
import Layout from '@/layouts/Layout.astro'
import '@/styles/modules.css'
import { mockCaseStudy } from '@/components/modules/CaseStudy/data/mockCaseStudy'
import HeroStrip from '@/components/modules/CaseStudy/components/HeroStrip.astro'
import ContentStrip from '@/components/modules/CaseStudy/components/ContentStrip.astro'
import ProcessStrip from '@/components/modules/CaseStudy/components/ProcessStrip.astro'
import SolutionsStrip from '@/components/modules/CaseStudy/components/SolutionsStrip.astro'
import NavigationStrip from '@/components/modules/CaseStudy/components/NavigationStrip.astro'
import FAQStrip from '@/components/modules/CaseStudy/components/FAQStrip.astro'

// Existing modules to integrate
import Header from '@/components/modules/Header/Header.astro'
import ShareBar from '@/components/modules/ShareBar/ShareBar.astro'
import { WhiteStickyFooter } from '@/components/modules/Footer/components/WhiteStickyFooter'
import GetInTouch from '@/components/modules/GetInTouch/components/GetInTouch.astro'
import { CommentsWithToast } from '@/components/modules/Comments'

const caseStudy = mockCaseStudy

const pageTitle = `${caseStudy.title} | Case Study`
---

<Layout title={pageTitle}>
    <!-- Header Module -->
    <Header />

    <!-- ShareBar Module (sticky) -->
    <ShareBar
      title={caseStudy.title}
      url={`https://yoursite.com/case-studies/${caseStudy.slug}`}
    />

    <main class="min-h-screen">
      <!-- Hero Section -->
      <HeroStrip
        title={caseStudy.title}
        mainTag={caseStudy.mainTag}
        publishedDate={caseStudy.publishedDate}
        author={caseStudy.author}
        featuredImage={caseStudy.featuredImage}
      />

      <!-- Content Section -->
      <ContentStrip
        description={caseStudy.description}
        content={caseStudy.content}
      />

      <!-- Process Section -->
      {caseStudy.processSteps && caseStudy.processSteps.length > 0 && (
        <ProcessStrip
          title="Our Process"
          subtitle="Business challenges are tough, but we have a proven record of elevating our partners to their next and best selves."
          steps={caseStudy.processSteps}
        />
      )}

      <!-- Solutions & Results Section -->
      {caseStudy.solutions && caseStudy.solutions.length > 0 && (
        <SolutionsStrip
          title="Solutions & Results"
          solutions={caseStudy.solutions}
          achievements={caseStudy.achievements}
          finalThoughts={caseStudy.finalThoughts}
          tags={caseStudy.tags}
        />
      )}

      <!-- Navigation to Other Projects -->
      <NavigationStrip
        previousPost={caseStudy.previousPost}
        nextPost={caseStudy.nextPost}
      />

      <!-- FAQs Section -->
      {caseStudy.faqs && caseStudy.faqs.length > 0 && (
        <FAQStrip faqs={caseStudy.faqs} />
      )}

      <!-- Comments Section -->
      {caseStudy.commentsEnabled && (
        <section class="bg-gray-50 py-16">
          <div class="container mx-auto max-w-6xl px-4">
            <CommentsWithToast client:load pageSlug={caseStudy.slug} />
          </div>
        </section>
      )}

      <!-- Contact/Get in Touch Section -->
      <GetInTouch />
    </main>

    <!-- Footer Module (WhiteStickyFooter with sticky effect) -->
    <WhiteStickyFooter client:load />
</Layout>
