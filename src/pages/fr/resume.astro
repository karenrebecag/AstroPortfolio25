---
import ResumeLayout from '../../layouts/ResumeLayout.astro';
import AdvancedSEO from '../../components/seo/AdvancedSEO.astro';
import Header from '../../components/modules/Header/Header.astro';
import { ResumeSection } from '../../components/Resume/ResumeSection.tsx';
import { ResumeTag, ResumeTagGroup } from '../../components/Resume/ResumeTag.tsx';
import { SkillTag, SkillGroup } from '../../components/Resume/SkillTag.tsx';
import { ResumeHeroBadge, ResumeHeroDescription, ResumeHeroContact, ResumeHeroMain } from '../../components/Resume/ResumeHeroAnimations.tsx';
import MainButton from '../../components/modules/Header/MainButton.astro';
import SecondaryButton from '../../components/ui/SecondaryButton.astro';
import { TextDisperse } from '../../components/ui/TextDisperse.tsx';
import { motion } from 'motion/react';
import { DitheringShader } from "../../components/modules/Footer/shaders/DitheringShader";
import { getLangFromUrl, t } from '../../i18n/utils.js';
import { getResumePageSchema, getResumeFAQSchema } from '../../utils/resumeStructuredData';
import { pageConfigs } from '../../config/seo';
import '../../styles/global.css';

const lang = getLangFromUrl(Astro.url);

// SEO Configuration optimized for resume/CV searches and recruiters
const resumeSEOConfig = {
  ...pageConfigs.resume,
  structuredData: getResumePageSchema(),
  alternateLanguages: [
    { hreflang: "en", href: "https://karenortiz.space/resume" },
    { hreflang: "es", href: "https://karenortiz.space/es/resume" }
  ],
  publishedTime: "2024-01-01T00:00:00Z",
  modifiedTime: new Date().toISOString(),
  author: "Karen Rebeca Ortiz"
};
---

<ResumeLayout title={resumeSEOConfig.title} lang={lang}>
  <!-- Advanced SEO for Resume Page -->
  <AdvancedSEO 
    title={resumeSEOConfig.title}
    description={resumeSEOConfig.description}
    keywords={resumeSEOConfig.keywords}
    canonical={resumeSEOConfig.canonical}
    ogType={resumeSEOConfig.ogType}
    structuredData={resumeSEOConfig.structuredData}
    speakable={resumeSEOConfig.speakable}
    alternateLanguages={resumeSEOConfig.alternateLanguages}
    publishedTime={resumeSEOConfig.publishedTime}
    modifiedTime={resumeSEOConfig.modifiedTime}
    author={resumeSEOConfig.author}
  />
  
  <!-- FAQ Schema for Resume-related questions -->
  <script type="application/ld+json" set:html={JSON.stringify(getResumeFAQSchema())}></script>
  
  <Header lang={lang} />

  <div class="resume-page-container">
  
    <main class="resume-main main-content">
    
    <!-- Fixed Background with DitheringShader -->
    <div class="resume-fixed-background">
      <!-- Light mode DitheringShader (WhiteStickyFooter colors) -->
      <div class="light-mode-shader">
        <DitheringShader
          width={1920}
          height={1080}
          colorBack="#fdfdfd"
          colorFront="#f0f0f0"
          shape="wave"
          type="8x8"
          pxSize={3}
          speed={0.6}
          client:load
        />
      </div>
      
      <!-- Dark mode DitheringShader (StickyFooter colors) -->
      <div class="dark-mode-shader">
        <DitheringShader
          width={1920}
          height={1400}
          colorBack="#010111"
          colorFront="#4523AE"
          shape="wave"
          type="8x8"
          pxSize={3}
          speed={0.6}
          client:load
        />
      </div>
      
      <!-- Fallback decorative elements -->
      <div class="resume-decorative-elements">
        <div class="decorative-circle-1"></div>
        <div class="decorative-circle-2"></div>
      </div>
    </div>
    
    <!-- Main Content Container -->
    <!-- Hero Section with Original CV Animations -->
    <section class="hero-section" data-semantic-role="hero" data-llm-context="professional-introduction">
        <!-- CSS Background Pattern -->
        <div class="hero-css-background"></div>

      <ResumeHeroMain client:load>
        <div class="hero-container-wrapper">
          <div class="hero-container">
            <div class="hero-grid">
              <div class="hero-content">
                <ResumeHeroBadge client:load>
                  <div class="hero-badge">{t('resume.badge', lang)}</div>
                  <h1 class="hero-title" data-llm-context="candidate-name">
                    Karen Rebeca
                    <br />
                    <span class="hero-subtitle">Ortiz</span>
                  </h1>
                </ResumeHeroBadge>
                
                <ResumeHeroDescription client:load>
                  <div class="hero-description" data-llm-context="professional-summary">
                    <p>
                      {t('resume.description.main', lang)}
                      <span class="highlight">{t('resume.description.highlight', lang)}</span>.
                    </p>
                    
                    <div class="hero-status">
                      <div class="status-indicator">
                        <div class="status-dot"></div>
                        {t('resume.description.status', lang)}
                      </div>
                      <div>{t('resume.description.location', lang)}</div>
                    </div>
                  </div>
                </ResumeHeroDescription>

                <!-- Action Buttons -->
                <div class="hero-actions">
                  <MainButton text={t('resume.buttons.downloadCV', lang)} href="/cv-karen-ortiz.pdf" />
                  <div id="portfolio-button">
                    <SecondaryButton text={t('resume.buttons.portfolio', lang)} variant="glass" />
                  </div>
                </div>
              </div>

              <ResumeHeroContact client:load>
                <div class="hero-contact" data-llm-context="contact-information">
                  <div class="contact-section">
                    <div class="section-label">{t('resume.contact.title', lang)}</div>
                    <div class="contact-links">
                      <a href="mailto:karen.ortizg@yahoo.com" class="contact-link primary">
                        karen.ortizg@yahoo.com
                      </a>
                      <a href="tel:+525660014362" class="contact-link">
                        56 6001 43 62
                      </a>
                      <a href="https://linkedin.com/in/karen-rebeca-ortiz" target="_blank" class="contact-link small">
                        linkedin.com/in/karen-rebeca-ortiz
                      </a>
                    </div>
                  </div>

                  <div class="specialties-section">
                    <div class="section-label">{t('resume.specialties.title', lang)}</div>
                    <ResumeTagGroup client:visible>
                      {t('resume.specialties.items', lang).map((specialty: string, index: number) => (
                        <ResumeTag index={index}>{specialty}</ResumeTag>
                      ))}
                    </ResumeTagGroup>
                  </div>
                </div>
              </ResumeHeroContact>
            </div>
          </div>
        </div>
      </ResumeHeroMain>
    </section>

    <!-- Professional Summary -->
    <ResumeSection client:visible id="summary" index={1} data-semantic-role="about" data-llm-context="professional-summary">
      <div class="section-container">
        <div class="section-header">
          <h2 class="section-title">
            <TextDisperse client:idle text={t('resume.sections.summary.title', lang)} />
          </h2>
          <div class="section-label">{t('resume.sections.summary.label', lang)}</div>
        </div>

        <div class="summary-content">
          <motion.div 
            className="content-item"
            initial={{ opacity: 0, y: 30 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true, margin: "-100px" }}
            transition={{ duration: 0.6, ease: "easeOut" }}
            client:load
          >
            <h3 class="content-heading">{t('resume.sections.summary.items.0.title', lang)}</h3>
            <p class="content-text">
              {t('resume.sections.summary.items.0.content', lang)}
            </p>
          </motion.div>

          <motion.div 
            className="content-item"
            initial={{ opacity: 0, y: 30 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true, margin: "-100px" }}
            transition={{ duration: 0.6, ease: "easeOut", delay: 0.1 }}
            client:load
          >
            <h4 class="content-subheading">{t('resume.sections.summary.items.1.title', lang)}</h4>
            <p class="content-text">
              {t('resume.sections.summary.items.1.content', lang)}
            </p>
          </motion.div>

          <motion.div 
            className="content-item"
            initial={{ opacity: 0, y: 30 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true, margin: "-100px" }}
            transition={{ duration: 0.6, ease: "easeOut", delay: 0.2 }}
            client:load
          >
            <h4 class="content-subheading">{t('resume.sections.summary.items.2.title', lang)}</h4>
            <p class="content-text">
              {t('resume.sections.summary.items.2.content', lang)}
            </p>
          </motion.div>
        </div>
      </div>
    </ResumeSection>

    <!-- Experience Section -->
    <ResumeSection client:visible id="experience" index={2} data-semantic-role="experience" data-llm-context="work-history">
      <div class="section-container">
        <div class="section-header">
          <h2 class="section-title">
            <TextDisperse client:visible text={t('resume.sections.experience.title', lang)} />
          </h2>
          <div class="section-label">{t('resume.sections.experience.label', lang)}</div>
        </div>

        <div class="experience-content">
          {t('resume.sections.experience.jobs', lang).map((job: any, jobIndex: number) => (
            <motion.div 
              className="content-item"
              initial={{ opacity: 0, y: 30 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true, margin: "-100px" }}
              transition={{ duration: 0.6, ease: "easeOut", delay: jobIndex * 0.1 }}
              client:load
            >
              <div class="job-section">
                <h3 class="content-heading">{job.title}</h3>
                <div class="job-header">
                  <div class="company">{job.company}</div>
                  <div class="location">{job.location}</div>
                </div>

                <div class="projects-grid">
                  {job.projects.map((project: any) => (
                    <div class="card-item">
                      <h4 class="card-heading">{project.title}</h4>
                      <p class="card-text">{project.description}</p>
                    </div>
                  ))}
                </div>
              </div>
            </motion.div>
          ))}
        </div>
      </div>
    </ResumeSection>

    <!-- Technical Skills -->
    <ResumeSection client:visible id="skills" index={3} data-semantic-role="skills" data-llm-context="technical-competencies">
      <div class="section-container">
        <div class="section-header">
          <h2 class="section-title">
            <TextDisperse client:visible text={t('resume.sections.skills.title', lang)} />
          </h2>
          <div class="section-label">{t('resume.sections.skills.label', lang)}</div>
        </div>

        <div class="skills-container">
          <motion.div 
            className="content-item"
            initial={{ opacity: 0, y: 30 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true, margin: "-100px" }}
            transition={{ duration: 0.6, ease: "easeOut" }}
            client:load
          >
            <SkillGroup title={t('resume.sections.skills.groups.0.title', lang)} delay={0}>
              {t('resume.sections.skills.groups.0.skills', lang).map((skill: string, index: number) => (
                <SkillTag index={index}>{skill}</SkillTag>
              ))}
            </SkillGroup>
          </motion.div>

          <motion.div 
            className="content-item"
            initial={{ opacity: 0, y: 30 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true, margin: "-100px" }}
            transition={{ duration: 0.6, ease: "easeOut", delay: 0.1 }}
            client:load
          >
            <SkillGroup title={t('resume.sections.skills.groups.1.title', lang)} delay={1}>
              {t('resume.sections.skills.groups.1.skills', lang).map((skill: string, index: number) => (
                <SkillTag variant="secondary" index={index}>{skill}</SkillTag>
              ))}
            </SkillGroup>
          </motion.div>

          <motion.div 
            className="content-item"
            initial={{ opacity: 0, y: 30 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true, margin: "-100px" }}
            transition={{ duration: 0.6, ease: "easeOut", delay: 0.2 }}
            client:load
          >
            <SkillGroup title={t('resume.sections.skills.groups.2.title', lang)} delay={2}>
              {t('resume.sections.skills.groups.2.skills', lang).map((skill: string, index: number) => (
                <SkillTag variant="accent" index={index}>{skill}</SkillTag>
              ))}
            </SkillGroup>
          </motion.div>

          <motion.div 
            className="content-item"
            initial={{ opacity: 0, y: 30 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true, margin: "-100px" }}
            transition={{ duration: 0.6, ease: "easeOut", delay: 0.3 }}
            client:load
          >
            <SkillGroup title={t('resume.sections.skills.groups.3.title', lang)} delay={3}>
              {t('resume.sections.skills.groups.3.skills', lang).map((skill: string, index: number) => (
                <SkillTag index={index}>{skill}</SkillTag>
              ))}
            </SkillGroup>
          </motion.div>
        </div>
      </div>
    </ResumeSection>

    <!-- Projects Section -->
    <ResumeSection client:visible id="projects" index={4} data-semantic-role="portfolio" data-llm-context="key-projects">
      <div class="section-container">
        <div class="section-header">
          <h2 class="section-title">
            <TextDisperse client:visible text={t('resume.sections.projects.title', lang)} />
          </h2>
          <div class="section-label">{t('resume.sections.projects.label', lang)}</div>
        </div>

        <div class="projects-content">
          {t('resume.sections.projects.items', lang).map((project: any, index: number) => (
            <motion.div 
              className="content-item project-item"
              initial={{ opacity: 0, y: 30 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true, margin: "-100px" }}
              transition={{ duration: 0.6, ease: "easeOut", delay: index * 0.1 }}
              client:load
            >
              <div class="project-number">{project.number}</div>
              <div class="project-details">
                <h3 class="content-heading">{project.title}</h3>
                <div class="project-subtitle">{project.subtitle}</div>
                <p class="content-text">{project.description}</p>
              </div>
              <div class="project-benefits">
                <div class="benefits-label">{t('resume.sections.projects.benefitsLabel', lang)}</div>
                <p class="content-text">{project.benefits}</p>
              </div>
            </motion.div>
          ))}
        </div>
      </div>
    </ResumeSection>

    <!-- Education Section -->
    <ResumeSection client:visible id="education" index={5} data-semantic-role="education" data-llm-context="academic-background">
      <div class="section-container">
        <div class="section-header">
          <h2 class="section-title">
            <TextDisperse client:visible text={t('resume.sections.education.title', lang)} />
          </h2>
          <div class="section-label">{t('resume.sections.education.label', lang)}</div>
        </div>
        
        <div class="education-content">
          {t('resume.sections.education.items', lang).map((item: any, index: number) => (
            <motion.div 
              className="content-item education-item"
              initial={{ opacity: 0, y: 30 }}
              whileInView={{ opacity: 1, y: 0 }}
              viewport={{ once: true, margin: "-100px" }}
              transition={{ duration: 0.6, ease: "easeOut", delay: index * 0.1 }}
              client:load
            >
              <div class="education-number">{item.number}</div>
              <div class="education-details">
                <h3 class="content-heading">{item.title}</h3>
                <div class="education-duration">{item.duration}</div>
                <ul class="education-points">
                  {item.points.map((point: string) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>
            </motion.div>
          ))}
        </div>
        
        <motion.div 
          className="content-item"
          initial={{ opacity: 0, y: 50 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true, margin: "-100px" }}
          transition={{ duration: 0.6, ease: "easeOut", delay: 0.3 }}
          client:load
        >
          <div class="learning-badge">
            <div class="badge-title">{t('resume.sections.education.learningBadge.title', lang)}</div>
            <div class="badge-subtitle">{t('resume.sections.education.learningBadge.subtitle', lang)}</div>
          </div>
        </motion.div>
      </div>
    </ResumeSection>

    </main>

    <!-- Simple Resume Footer -->
    <footer class="resume-footer">
      <div class="footer-container">
        <!-- Contact & Social Links -->
        <div class="footer-content">
          <div class="footer-section">
            <h3 class="footer-title">Get In Touch</h3>
            <p class="footer-description">
              Ready to collaborate? Let's create something amazing together.
            </p>
            <div class="social-links">
              <a href="https://www.linkedin.com/in/karen-rebeca-ortiz-b5a860282" target="_blank" rel="noopener noreferrer" class="social-link">
                LinkedIn
              </a>
              <a href="https://github.com/karenrebecag" target="_blank" rel="noopener noreferrer" class="social-link">
                GitHub
              </a>
              <a href="https://www.instagram.com/karenrebeca.og/" target="_blank" rel="noopener noreferrer" class="social-link">
                Instagram
              </a>
              <a href="https://dribbble.com/krog11" target="_blank" rel="noopener noreferrer" class="social-link">
                Dribbble
              </a>
            </div>
          </div>
          
          <!-- Professional Info -->
          <div class="footer-section">
            <h3 class="footer-title">Karen Rebeca Ortiz</h3>
            <p class="footer-subtitle">Design Engineer</p>
            <div class="footer-links">
              <a href="/" class="footer-link">Portfolio</a>
              <a href="/privacy" class="footer-link">Privacy Policy</a>
              <a href="mailto:karen.ortizg@yahoo.com" class="footer-link">Contact</a>
            </div>
          </div>
        </div>
        
        <!-- Copyright -->
        <div class="footer-bottom">
          <p class="copyright">
            © {new Date().getFullYear()} Karen Rebeca Ortiz. All rights reserved.
          </p>
          <p class="availability">
            Available for freelance & full-time opportunities
          </p>
        </div>
      </div>
    </footer>

  </div>

</ResumeLayout>

<style>
  body{
    background-color: #ececec;
  }

  /* Dark Mode Global Styles */
  :global(.dark-mode html) {
    background-color: #050112;
  }

  :global(.dark-mode body) {
    background-color: #050112;
    color: #ffffff;
  }

  :global(.dark-mode) {
    color-scheme: dark;
  }

  :global(.light-mode) {
    color-scheme: light;
  }

  /* Resume Page Container */
  .resume-page-container {
    min-height: 100vh;
    transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  

  /* ========================================
     CONSOLIDATED CSS CLASSES SYSTEM
     ======================================== */

  /* Base Container Classes */
  .base-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  @media (max-width: 768px) {
    .base-container {
      padding: 0 1rem;
    }
  }

  /* Base Content Item Class */
  .content-item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Base Heading Classes */
  .content-heading {
    font-size: 1.25rem;
    font-weight: 500;
    color: #0c0819;
    font-family: var(--font-secondary); /* Boysen font */
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .content-heading) {
    color: #ffffff;
  }

  .content-subheading {
    font-size: 1.125rem;
    font-weight: 500;
    color: #0c0819;
    font-family: var(--font-secondary); /* Boysen font */
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .content-subheading) {
    color: #ffffff;
  }

  /* Base Text Classes */
  .content-text {
    color: #0c08198c;
    line-height: 1.6;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .content-text) {
    color: #ffffff;
  }

  /* Base Card Classes */
  :global(.card-item) {
    padding: 1.5rem;
    border: 1px solid #f9f9f941;
    border-radius: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: linear-gradient(#ffffff, rgb(250, 250, 250)), linear-gradient(to bottom, rgba(255, 255, 255, 1), rgba(255, 255, 255, 0));
    overflow: hidden;
    backdrop-filter: blur(10px) brightness(0.8);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.02);
    transition: 
      background 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), 
      color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), 
      border-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .card-item) {
    background: #1f1f1f3b !important;
    color: #ffffff;
    border: 1px solid #393939;
  }

  :global(.card-heading) {
    font-size: 1.125rem;
    font-weight: 500;
    color: #0c0819;
    font-family: var(--font-secondary); /* Boysen font */
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .card-heading) {
    color: #ffffff;
  }

  :global(.card-text) {
    color: #0c08198c;
    line-height: 1.6;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .card-text) {
    color: #ffffff;
  }

  /* Accessibility - Respect user preferences */
  @media (prefers-reduced-motion: reduce) {
    .content-item,
    .content-heading,
    .content-subheading,
    .content-text,
    .card-item,
    .card-heading,
    .card-text {
      animation: none !important;
      transition: none !important;
    }
  }

  /* Fixed Background Styles */
  .resume-fixed-background {
    position: fixed;
    top: 80px; /* Start after header */
    left: 0;
    width: 100vw;
    bottom: 0; /* Extend to bottom of viewport */
    z-index: -1;
    background-color: #fdfdfd; /* WhiteStickyFooter background */
    transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    filter: hue-rotate(12deg) saturate(0.78) brightness(1.0); /* WhiteStickyFooter filter */
  }

  :global(.dark-mode .resume-fixed-background) {
    background-color: #111111; /* StickyFooter background */
    filter: hue-rotate(12deg) saturate(0.78) brightness(1.4); /* StickyFooter filter */
  }

  /* Decorative elements - Light mode (WhiteStickyFooter) */
  .resume-decorative-elements {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0.2; /* WhiteStickyFooter opacity */
    pointer-events: none;
  }

  .decorative-circle-1 {
    position: absolute;
    top: 0;
    left: 0;
    height: 20rem;
    width: 10rem;
    border-radius: 50%;
    opacity: 0.1;
    background: radial-gradient(circle, rgba(69,35,174,0.1) 0%, rgba(69,35,174,0.02) 50%, transparent 100%); /* WhiteStickyFooter colors */
    transform: translateY(-5rem) rotate(-45deg);
  }

  .decorative-circle-2 {
    position: absolute;
    top: 0;
    left: 0;
    height: 20rem;
    width: 15rem;
    border-radius: 50%;
    opacity: 0.1;
    background: radial-gradient(circle, rgba(69,35,174,0.08) 0%, rgba(69,35,174,0.01) 80%, transparent 100%); /* WhiteStickyFooter colors */
    transform: translateX(2rem) translateY(-24rem) rotate(-45deg);
  }

  /* Dark mode decorative elements (StickyFooter) */
  :global(.dark-mode .resume-decorative-elements) {
    opacity: 0.3; /* StickyFooter opacity */
  }

  :global(.dark-mode .decorative-circle-1) {
    background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.02) 50%, transparent 100%); /* StickyFooter colors */
  }

  :global(.dark-mode .decorative-circle-2) {
    background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.01) 80%, transparent 100%); /* StickyFooter colors */
  }

  /* DitheringShader mode switching */
  .light-mode-shader {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 1;
    transition: opacity 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .dark-mode-shader {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .light-mode-shader) {
    opacity: 0;
  }

  :global(.dark-mode .dark-mode-shader) {
    opacity: 1;
  }

  /* Main CV Styles - Light Mode */
  .resume-main {
    position: relative;
    background: transparent; /* Transparent to show background */
    color: #000000;
    font-family: var(--font-primary);
    padding-top: 80px; /* Account for CV header (no TopMarquee) */
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    z-index: 1; /* Above the fixed background */
  }

  /* Dark Mode Styles for Main */
  :global(.dark-mode .resume-main) {
    background: transparent; /* Transparent to show fixed background */
    color: #ffffff;
  }

  /* Hero Section */

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    width: 100%;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 3fr 2fr;
      gap: 4rem;
    }
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .hero-badge {
    font-size: 0.875rem;
    color: rgb(0, 0, 0);
    font-family: 'Courier New', monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .hero-badge) {
    color: #ffffff;
  }

  .hero-title {
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-family: var(--font-display); /* Median font */
    color: #313131;
    min-height: 4.4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    contain: layout style;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .hero-title) {
    color: #ffffff;
  }

  .hero-subtitle {
    color: #888888;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .hero-subtitle) {
    color: #cccccc;
  }

  /* Hero Description Styles - Following DarkMode.md pattern exactly */
  :global(.hero-description) {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  :global(.hero-description p) {
    font-size: clamp(1.125rem, 3vw, 1.25rem);
    line-height: 1.6;
    color: #000000;
    transition: 
      color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .hero-description p) {
    color: #ffffff;
  }

  :global(.hero-description *) {
    color: #000000;
    transition: 
      color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .hero-description *) {
    color: #ffffff;
  }

  .highlight {
    color: #7a7a7a;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .highlight) {
    color: #cccccc;
  }

  /* Hero Action Buttons */
  .hero-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
      gap: 1rem;
    }
  }

  .hero-status {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: #363636;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .hero-status) {
    color: #cccccc;
  }

  @media (min-width: 640px) {
    .hero-status {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: #000000;
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .hero-contact {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 2rem;
    margin-top: 2rem;
  }

  @media (min-width: 1024px) {
    .hero-contact {
      margin-top: 0;
    }
  }

  .contact-section, .specialties-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-label {
    font-size: 0.875rem;
    color: #000000;
    font-family: 'Courier New', monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .section-label) {
    color: #ffffff;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-link {
    color: #1d1d1db6;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  :global(.dark-mode .contact-link) {
    color: rgba(255, 255, 255, 0.7);
  }

  .contact-link:hover {
    color: rgb(0, 0, 0);
  }

  :global(.dark-mode .contact-link:hover) {
    color: #ffffff;
  }

  .contact-link.primary {
    font-weight: 500;
  }

  .contact-link.small {
    font-size: 0.75rem;
    color: #222222;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .contact-link.small) {
    color: #cccccc;
  }

  /* Section Styles */
  .section-container {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
    margin-bottom: 4rem;
    background: transparent; /* No background - show DitheringShader */
    z-index: 10; /* Above the background */
  }

  @media (max-width: 768px) {
    .section-container {
      margin-bottom: 3rem; /* Reduced spacing on mobile */
      padding: 3rem 1rem;
    }
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 640px) {
    .section-header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 3.5rem;
    }
  }

  @media (min-width: 1024px) {
    .section-header {
      margin-bottom: 4rem;
    }
  }

  .section-title {
    font-size: clamp(2rem, 6vw, 2.5rem);
    font-weight: 300;
    font-family: var(--font-display); /* Median font */
    color: #0c0819;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .section-title) {
    color: #ffffff;
  }

  /* TextDisperse styles for section titles */
  .section-title :global(.relative) {
    color: #0c0819 !important;
    font-size: inherit;
    font-family: inherit;
    font-weight: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
  }

  :global(.dark-mode .section-title .relative) {
    color: #ffffff !important;
  }

  /* Summary Styles */
  .summary-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Summary content uses base classes: .content-item, .content-heading, .content-subheading, .content-text */

  /* Experience Styles */
  .experience-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .job-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Job titles use .content-heading class */

  .job-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .job-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }

  .company {
    font-weight: 500;
    color: #0c0819;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .company) {
    color: #ffffff;
  }

  .location {
    font-size: 0.875rem;
    color: #cccccc;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .location) {
    color: #999999;
  }

  .projects-grid {
    display: grid;
    gap: 1.5rem;
  }

  /* Project cards use .card-item, .card-heading, .card-text classes */

  /* Skills Styles */
  .skills-container {
    display: grid;
    gap: 3rem;
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .skills-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .skills-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }
  }

  @media (min-width: 1200px) {
    .skills-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 4rem;
    }
  }

  /* Projects Styles */
  .projects-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Project Item Styles */
  .project-item {
    display: grid;
    gap: 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid #e2e2e2;
    transition: border-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .project-item) {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .project-item:hover {
    border-color: #555555;
  }

  :global(.dark-mode .project-item:hover) {
    border-color: rgba(255, 255, 255, 0.3);
  }

  @media (min-width: 1024px) {
    .project-item {
      grid-template-columns: 2fr 6fr 4fr;
      gap: 2rem;
    }
  }

  /* Project Item Elements */
  .project-number {
    font-size: 1.5rem;
    font-weight: 300;
    color: #0c08198c;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .project-number) {
    color: #ffffff;
  }

  .project-item:hover .project-number {
    color: #0c0819;
  }

  :global(.dark-mode .project-item:hover .project-number) {
    color: #ffffff;
  }

  .project-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project-subtitle {
    color: #0c08198c;
    font-size: 0.875rem;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .project-subtitle) {
    color: #ffffff;
  }

  .project-details .content-text {
    max-width: 32rem;
  }

  .project-benefits {
    margin-top: 0.5rem;
  }

  @media (min-width: 1024px) {
    .project-benefits {
      margin-top: 0;
    }
  }

  .benefits-label {
    font-size: 0.875rem;
    color: #0c08198c;
    font-family: 'Courier New', monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .benefits-label) {
    color: #ffffff;
  }

  .project-benefits .content-text {
    font-size: 0.875rem;
  }

  /* Education Styles */
  .education-content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Education Item Styles */
  .education-item {
    display: grid;
    gap: 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid #e3e3e3;
    transition: border-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .education-item) {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 1024px) {
    .education-item {
      grid-template-columns: 2fr 6fr 4fr;
      gap: 2rem;
    }
  }

  /* Education Item Elements */
  .education-number {
    font-size: 1.5rem;
    font-weight: 300;
    color: #cccccc;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .education-number) {
    color: #ffffff;
  }

  .education-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .education-details .content-heading {
    margin-bottom: 0.5rem;
  }

  .education-duration {
    color: #0c08198c;
    margin-bottom: 1rem;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .education-duration) {
    color: #ffffff;
  }

  :global(.education-points) {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  :global(.education-points li) {
    font-size: 0.875rem;
    color: #0c08198c;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .education-points li) {
    color: #ffffff;
  }

  :global(.education-points li::before) {
    content: '';
    width: 0.25rem;
    height: 0.25rem;
    background: #0c08198c;
    border-radius: 50%;
    margin-top: 0.5rem;
    flex-shrink: 0;
    transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .education-points li::before) {
    background: #ffffff;
  }

  :global(.learning-badge) {
    text-align: center;
    padding: 2rem;
    border: 1px solid #f9f9f941;
    border-radius: 0.5rem;
    margin-top: 2rem;
    background: linear-gradient(#ffffff, rgb(250, 250, 250)), linear-gradient(to bottom, rgba(255, 255, 255, 1), rgba(255, 255, 255, 0));
    overflow: hidden;
    backdrop-filter: blur(10px) brightness(0.8);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.02);
    transition: background 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), border-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .learning-badge) {
    background: #1f1f1f3b !important;
    color: #ffffff;
    border: 1px solid #393939;
  }

  :global(.badge-title) {
    font-size: 1.5rem;
    font-weight: 300;
    margin-bottom: 0.5rem;
    color: #0c0819;
    font-family: var(--font-secondary); /* Boysen font */
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .badge-title) {
    color: #ffffff;
  }

  :global(.badge-subtitle) {
    font-size: 1.125rem;
    color: #cccccc;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .badge-subtitle) {
    color: #999999;
  }

  /* Skill Tags Styles - Following DarkMode.md pattern */
  :global(.skill-group) {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  :global(.skill-group-title) {
    font-size: 16px;
    font-weight: 600;
    color: #1a1a1a;
    font-family: var(--font-secondary);
    margin-bottom: 8px;
    letter-spacing: 0.5px;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .skill-group-title) {
    color: #ffffff;
  }

  :global(.skill-tags-container) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Skill Tag Base Styles */
  :global(.skill-tag) {
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
    font-family: var(--font-primary);
    cursor: default;
    user-select: none;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Primary Variant */
  :global(.skill-tag-primary) {
    background: linear-gradient(#ffffff, rgb(250, 250, 250)), linear-gradient(to bottom, rgba(255, 255, 255, 1), rgba(255, 255, 255, 0));
    overflow: hidden;
    backdrop-filter: blur(10px) brightness(0.8);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.02);
    border: 1px solid rgba(0, 0, 0, 0.15);
    color: #1a1a1a;
  }

  :global(.dark-mode .skill-tag-primary) {
    background: #1f1f1f3b !important;
    color: #ffffff;
    border: 1px solid #393939;
  }

  :global(.skill-tag-primary:hover) {
    background: rgba(0, 0, 0, 0.08);
    border: 1px solid rgba(0, 0, 0, 0.25);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  :global(.dark-mode .skill-tag-primary:hover) {
    background: #2a2a2a;
    border: 1px solid #444444;
    box-shadow: 0 4px 20px rgba(255, 255, 255, 0.1);
  }

  /* Secondary Variant */
  :global(.skill-tag-secondary) {
    background: linear-gradient(#ffffff, rgb(250, 250, 250)), linear-gradient(to bottom, rgba(255, 255, 255, 1), rgba(255, 255, 255, 0));
    overflow: hidden;
    backdrop-filter: blur(10px) brightness(0.8);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.02);
    border: 1px solid rgba(69, 35, 174, 0.2);
    color: #4523AE;
  }

  :global(.dark-mode .skill-tag-secondary) {
    background: #1f1f1f3b !important;
    color: #ffffff;
    border: 1px solid #393939;
  }

  :global(.skill-tag-secondary:hover) {
    background: rgba(69, 35, 174, 0.12);
    border: 1px solid rgba(69, 35, 174, 0.35);
  }

  :global(.dark-mode .skill-tag-secondary:hover) {
    background: rgba(69, 35, 174, 0.25);
    border: 1px solid rgba(69, 35, 174, 0.6);
  }

  /* Accent Variant */
  :global(.skill-tag-accent) {
    background: linear-gradient(#ffffff, rgb(250, 250, 250)), linear-gradient(to bottom, rgba(255, 255, 255, 1), rgba(255, 255, 255, 0));
    overflow: hidden;
    backdrop-filter: blur(10px) brightness(0.8);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.02);
    border: 1px solid rgba(16, 185, 129, 0.2);
    color: #059669;
  }

  :global(.dark-mode .skill-tag-accent) {
    background: #1f1f1f3b !important;
    color: #ffffff;
    border: 1px solid #393939;
  }

  :global(.skill-tag-accent:hover) {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.35);
  }

  :global(.dark-mode .skill-tag-accent:hover) {
    background: rgba(16, 185, 129, 0.25);
    border: 1px solid rgba(16, 185, 129, 0.6);
  }

  /* CV Footer Styles */
  .cv-footer {
    padding: 3rem 0 4rem 0;
    border-top: 1px solid #333333;
    position: relative;
  }

  .cv-footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .cv-footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .cv-footer-content {
      flex-direction: row;
      gap: 2rem;
    }
  }

  .cv-footer-text {
    font-size: 0.875rem;
    color: #cccccc;
    text-align: center;
  }

  .cv-footer-gradient {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 6rem;
    background: linear-gradient(to top, #171523 0%, rgba(23, 21, 35, 0.8) 50%, transparent 100%);
    pointer-events: none;
    z-index: 10;
  }

  /* Hero Section */
  .hero-section {
    display: flex;
    align-items: center;
    position: relative;
    justify-content: center;
    overflow: hidden;
    will-change: transform;
    padding: 4rem 0; /* Add padding instead of min-height */
  }

  /* Hero CSS Background - Disabled (using fixed DitheringShader background) */
  .hero-css-background {
    display: none; /* Disabled since we're using fixed DitheringShader background */
  }

  /* Hero Container Wrapper - Full width for centering */
  .hero-container-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 10;
    contain: layout style paint;
  }
  
  /* Prevent layout shifts during font loading */
  .hero-container-wrapper * {
    font-display: swap;
  }

  /* Hero Container with limited width */
  .hero-container {
    position: relative;
    width: 100%;
    max-width: 1200px;
