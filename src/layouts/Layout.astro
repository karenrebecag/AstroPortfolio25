---
import { getLanguageMetadata } from '../i18n/utils.js';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

export interface Props {
	title: string;
	lang?: string;
}

const { title, lang = 'en' } = Astro.props;
const metadata = getLanguageMetadata(lang);
import '../styles/fonts.css';
import CustomCursor from '../components/ui/CustomCursor.astro';
import ClickBubble from '../components/ui/ClickBubble.astro';
import ScrollIndicator from '../components/ui/ScrollIndicator.astro';
import LenisIsland from '../components/ui/LenisIsland.jsx';
import PageLoader from '../components/ui/PageLoader.astro';
---

<!DOCTYPE html>
<html lang={lang} dir={metadata.dir}>
	<head>
		<meta charset={metadata.charset} />
		<meta name="description" content="Karen Ortiz - Design Engineer specializing in UX/UI design, React development, and AI-driven web solutions. Expert in modern web technologies." />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		
		<!-- Favicon Configuration -->
		<link rel="icon" type="image/x-icon" href="/favicon/favicon.ico" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon/android-chrome-192x192.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon/android-chrome-512x512.png" />
		<link rel="manifest" href="/favicon/site.webmanifest" />
		
		<!-- PWA Meta Tags -->
		<meta name="theme-color" content="#4523AE" />
		<meta name="msapplication-TileColor" content="#060314" />
		<meta name="msapplication-config" content="/favicon/browserconfig.xml" />
		
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- Critical Resource Hints -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preconnect" href="https://guileless-douhua-b2ff53.netlify.app">
		<link rel="preconnect" href="https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev">
		<link rel="preconnect" href="https://owtkwyy0wreozyvg.public.blob.vercel-storage.com">
		<link rel="preconnect" href="https://hebbkx1anhila5yf.public.blob.vercel-storage.com">
		<link rel="dns-prefetch" href="https://www.karenortiz.space">
		
		<!-- Critical CSS Inline - Expanded for LCP optimization -->
		<style>
			/* Critical above-the-fold styles - Optimized for LCP */
			body{font-family:'Inter','Median',sans-serif;width:100vw;margin:0;padding:0;box-sizing:border-box;background:#fff;overflow-x:hidden}
			*{margin:0;padding:0;box-sizing:border-box}
			/* Critical banner styles for faster LCP */
			.banner-section{background:#fff;min-height:100vh;display:flex;align-items:center;justify-content:center;position:relative}
			/* Critical image styles */
			#banner-image{width:520px;height:537px;max-width:600px;object-fit:contain;display:block}
			/* Critical text styles */
			h1,h2,h3{font-family:'Median','Boysen',serif;margin:0}
			/* Critical layout containers */
			.container{max-width:1200px;margin:0 auto;padding:0 24px}
			.header-wrapper{position:fixed;top:32px;left:0;right:0;z-index:100;background:white;backdrop-filter:blur(15px);-webkit-backdrop-filter:blur(15px)}
			.header{display:flex;justify-content:space-between;align-items:center;padding:12px 24px;max-width:1200px;margin:0 auto}
			.logo{color:#060314;font-size:clamp(17px,3.5vw,28px);cursor:pointer}
			.nav{display:flex;gap:32px}
			.nav a{color:#131019;text-decoration:none;font-size:clamp(11px,2.1vw,17px)}
			#banner-image{width:520px;height:537px;max-width:600px;object-fit:contain}
			.cube-3d-container,.model-3d-container,.three-js-container{width:100%;height:100%;min-height:inherit;contain:layout style paint}
			/* Marquee optimization - Fixed dimensions to prevent layout shifts */
			#left-marquee,#right-marquee{height:clamp(163px,32.6vw,326px);line-height:1;will-change:transform;contain:layout style paint;overflow:hidden}
			.marquee-content{display:inline-block;width:max-content;min-width:100vw}
			/* Fix ARIA role for Splide slides */
			.splide__slide{role:tabpanel!important}
			/* Font loading optimization */
			.font-display{font-family:'Median','Boysen',serif}
			.font-primary{font-family:'InterTight','Inter',system-ui,sans-serif}
			/* Prevent layout shifts - Enhanced */
			img{max-width:100%;height:auto}
			.reviews-slider-container{contain:layout style}
			/* ParallaxBanner optimization - Fixed dimensions */
			.parallax-banner-section{min-height:100vh;contain:layout style paint}
			.parallax-title{min-height:clamp(3rem,8vw,6rem);display:flex;align-items:center;justify-content:center}
			.parallax-subtitle{min-height:clamp(1rem,2.5vw,1.5rem);display:flex;align-items:center;justify-content:center}
			/* Executive summary image container */
			.executive-summary-image{min-height:400px;display:flex;align-items:center;justify-content:center}
			.executive-summary-image img{width:100%;max-width:1200px;height:auto}
			/* Header pill optimization */
			.header-pill{height:80px;contain:layout style}
			.header-wrapper{height:80px}
			/* Code blocks optimization */
			.code-section{contain:layout style}
			/* Features grid optimization */
			.features-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:2rem;contain:layout}
			.feature-card{min-height:200px;contain:layout style}
			/* Prevent forced reflows with GPU acceleration */
			.parallax-banner-section,.executive-summary-image,.content-section{will-change:transform;transform:translateZ(0)}
			.motion-container{contain:layout style paint;will-change:transform}
		</style>
		
		<!-- Resource Hints - Optimized for LCP -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link rel="preconnect" href="https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev" crossorigin>
		<link rel="preconnect" href="https://pub-2e7dc04d482146c59f472ab28fba09a9.r2.dev" crossorigin>
		<link rel="preconnect" href="https://guileless-douhua-b2ff53.netlify.app">
		<link rel="preconnect" href="https://hebbkx1anhila5yf.public.blob.vercel-storage.com">
		<link rel="preload" href="https://pub-2e7dc04d482146c59f472ab28fba09a9.r2.dev/MePortfolio.png" as="image" type="image/png" fetchpriority="high">
		<link rel="preload" href="https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/Median.woff2" as="font" type="font/woff2" crossorigin fetchpriority="high">
		<link rel="preload" href="https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/Boysen.woff2" as="font" type="font/woff2" crossorigin>
		
		<!-- Font Loading - Optimized for performance -->
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'">
		<noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet"></noscript>
		
		<!-- Font fallback to prevent layout shifts -->
		<style>
			@font-face {
				font-family: 'Inter-fallback';
				src: local('Arial'), local('Helvetica'), local('sans-serif');
				font-display: swap;
				ascent-override: 90%;
				descent-override: 22%;
				line-gap-override: 0%;
			}
		</style>

		<!-- Defer non-critical JavaScript -->
		<script>
			// Defer heavy JavaScript until after LCP
			window.addEventListener('load', () => {
				// Defer Motion.dev and other heavy libraries
				setTimeout(() => {
					document.querySelectorAll('astro-island[client\\:idle]').forEach(island => {
						island.setAttribute('client:load', '');
					});
				}, 100);
			});
		</script>

		<!-- Conditional Language-Specific Fonts - Optimized -->
		{(lang === 'hi') &&
			<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" />
		}
		{(lang === 'ja') &&
			<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700&display=swap" rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" />
		}
		{(lang === 'zh-cn') &&
			<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600;700&display=swap" rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" />
		}
		{(lang === 'zh-tw') &&
			<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="preload" as="style" onload="this.onload=null;this.rel='stylesheet'" />
		}

		<!-- SEO and Language Meta -->
		<meta property="og:locale" content={`${lang}_${metadata.region}`} />
		<link rel="alternate" hreflang={lang} href={Astro.url.href} />
		
		<!-- LLM and AI Optimization Meta -->
		<meta name="AI-optimized" content="true" />
		<meta name="LLM-friendly" content="structured-content, semantic-markup, comprehensive-data" />
		<meta name="content-type" content="portfolio, design-engineering, web-development" />
		<meta name="expertise" content="UX/UI Design, Frontend Development, React, TypeScript, Three.js, AI Integration" />
		<meta name="availability" content="freelance, full-time, consulting" />
		<meta name="location" content="Mexico, Remote, Global" />
		
		<!-- Enhanced Open Graph for better AI understanding -->
		<meta property="og:site_name" content="Karen Ortiz - Design Engineer Portfolio" />
		<meta property="og:type" content="profile" />
		<meta property="profile:first_name" content="Karen" />
		<meta property="profile:last_name" content="Ortiz" />
		<meta property="profile:username" content="karenortiz" />
	</head>
	<body>
		<PageLoader lang={lang} />
		<CustomCursor />
		<!-- <ClickBubble /> -->
		<ScrollIndicator />
		<slot />
		<!-- Lenis Smooth Scroll Island - Se carga solo en el cliente para optimizar performance -->
		<LenisIsland client:idle />
		<Analytics />
		<SpeedInsights />
	</body>
</html>

<style is:global>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	body {
		font-family: 'Inter', 'Median', sans-serif;
		width: 100vw;
	}

	:root {
		--bgBlue: #060314;
		--BgLayer1: #131019;
	}

	/* Prevent layout shifts */
	img {
		max-width: 100%;
		height: auto;
	}

	/* Ensure consistent sizing for dynamic content */
	.cube-3d-container,
	.model-3d-container,
	.three-js-container {
		width: 100%;
		height: 100%;
		min-height: inherit;
		contain: layout style paint;
	}

	/* Prevent reflow during animations */
	.motion-div,
	[data-motion-component] {
		will-change: transform, opacity;
	}

	/* Optimize rendering for marquees */
	.marquee-container,
	.reviews-marquee-wrapper,
	.experience-marquee-wrapper {
		contain: layout style paint;
		will-change: transform;
	}
</style>
