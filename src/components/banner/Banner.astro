---
// Banner component integrating Header, BannerButtonsWrapper and Marquees
import Header from '../ui/Header.astro';
import BannerButtonsWrapper from './BannerButtonsWrapper.astro';
import BannerMarqueesWrapper from './BannerMarqueesWrapper.astro';
---

<div class="banner-container w-full h-screen overflow-hidden relative flex flex-col justify-between items-center">
  <h1 class="sr-only">Karen Ortiz - Design Engineer Portfolio</h1>
  
  <!-- Dark mode overlay gradient -->
  <div class="dark-overlay"></div>
  
  <div class="w-full">
    <Header />
  </div>
  <BannerMarqueesWrapper />
  <div id="banner-image-container" style="position: absolute; bottom: 0; left: 0; right: 0; width: 100%; z-index: 10; pointer-events: none; display: flex; justify-content: center; align-items: flex-end; height: 537px;">
    <img 
      id="banner-image" 
      src="https://pub-2e7dc04d482146c59f472ab28fba09a9.r2.dev/MePortfolio.png" 
      data-light-src="https://pub-2e7dc04d482146c59f472ab28fba09a9.r2.dev/MePortfolio.png"
      data-dark-src="https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/MePortfolioDark.png"
      alt="Banner Image" 
      fetchpriority="high" 
      loading="eager" 
      width="520"
      height="537"
      style="max-width: 600px; height: auto; object-fit: contain; object-position: bottom; mix-blend-mode: multiply; display: block;" 
    />
  </div>
  <div id="banner-buttons-container" class="w-full flex justify-center relative z-20">
    <BannerButtonsWrapper />
  </div>
</div>


<style>
  .banner-container {
    /* Light mode background with grid */
    background: white;
    background-image: 
      linear-gradient(to right, rgba(0, 0, 0, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 0, 0, .05) 1px, transparent 1px);
    background-size: 40px 40px, 40px 40px;
    background-position: center;
    background-repeat: repeat;
    max-height: 85vh;
    transition: 
      background 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      background-image 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark mode styles - Minimized grid opacity */
  :global(.dark-mode) .banner-container {
    background: linear-gradient(135deg, #07001e 0%, #2c20a6 100%);
    background-image: 
      linear-gradient(to right, rgba(71,85,105,0.15) 1px, transparent 1px),
     linear-gradient(to bottom, rgba(71,85,105,0.15) 1px, transparent 1px),
     radial-gradient(circle at 50% 60%, rgba(236, 72, 154, 0.04) 0%, rgba(168,85,247,0.05) 40%, transparent 70%);
    background-size: 40px 40px, 40px 40px;
    background-position: center;
    background-repeat: repeat;
  }

  #banner-image {
    transform: translateY(30px);
    animation: slideUp 0.8s ease-out 0.5s forwards;
    transition: filter 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark mode overlay gradient */
  .dark-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to right, rgba(0, 0, 0, 0.55) 0%, transparent 60%);
    z-index: 25;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Show overlay only in dark mode */
  :global(.dark-mode) .dark-overlay {
    opacity: 1;
  }

  /* Dark mode - Neon glow backdrop effect */
  :global(.dark-mode) #banner-image {
    filter: drop-shadow(0 0 60px #c31e9225) 
            drop-shadow(0 0 80px rgba(195, 30, 146, 0.06)) 
            drop-shadow(0 0 180px rgba(195, 30, 146, 0.02));
  }

  @keyframes slideUp {
    to {
      transform: translateY(0px);
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Mobile optimization - 30% smaller image and hide buttons */
  @media (max-width: 768px) {
    #banner-image {
      max-width: 420px !important; /* 600px - 30% = 420px - Force override inline styles */
    }

    #banner-buttons-container {
      display: none !important;
    }
  }
</style>

<script>
  // Function to update banner image based on dark mode
  function updateBannerImage() {
    const bannerImage = document.getElementById('banner-image') as HTMLImageElement;
    if (!bannerImage) return;
    
    const isDarkMode = document.documentElement.classList.contains('dark-mode');
    const lightSrc = bannerImage.getAttribute('data-light-src');
    const darkSrc = bannerImage.getAttribute('data-dark-src');
    
    if (isDarkMode && darkSrc) {
      bannerImage.src = darkSrc;
    } else if (!isDarkMode && lightSrc) {
      bannerImage.src = lightSrc;
    }
  }
  
  // Update image on initial load
  document.addEventListener('DOMContentLoaded', updateBannerImage);
  
  // Listen for dark mode changes
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
        updateBannerImage();
      }
    });
  });
  
  // Observe changes to the html element's class attribute
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class']
  });
</script>
