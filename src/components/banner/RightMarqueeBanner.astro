---
// RightMarqueeBanner - Large animated text moving from left to right
---

<!-- Wrapper para prevenir layout shift -->
<div class="right-marquee-container">
  <div class="right-marquee-wrapper">
    <div 
      id="right-marquee" 
      class="whitespace-nowrap font-display font-bold text-gray-1000/50 select-none text-left" 
      style="font-size: clamp(163px, 32.6vw, 326px); width: max-content; text-shadow: 0px 4px 8px rgba(2, 2, 2, 0.398); height: clamp(163px, 32.6vw, 326px); line-height: 1; will-change: transform; contain: layout style paint;"
    >
      <span class="marquee-content">
        FRONTEND • BACKEND • FULLSTACK • PROJECTS • 
      </span>
      <span class="marquee-content">
        FRONTEND • BACKEND • FULLSTACK • PROJECTS • 
      </span>
    </div>
  </div>
</div>

<style>
  .right-marquee-container {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .right-marquee-wrapper {
    /* Reserve space to prevent layout shift */
    width: 100%;
    max-width: 1800px;
    height: clamp(163px, 32.6vw, 326px);
    min-height: 163px;
    overflow: hidden;
    position: relative;
    contain: layout style paint;
  }
  
  #right-marquee {
    position: absolute;
    top: 0;
    left: 0;
    /* Allow infinite width for marquee animation */
    width: max-content !important;
  }

  /* Gradientes laterales para pantallas grandes */
  @media (min-width: 2560px) {
    .right-marquee-wrapper::before,
    .right-marquee-wrapper::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 120px;
      z-index: 2;
      pointer-events: none;
    }

    .right-marquee-wrapper::before {
      left: 0;
      background: linear-gradient(to right, white, transparent);
    }

    .right-marquee-wrapper::after {
      right: 0;
      background: linear-gradient(to left, white, transparent);
    }
  }
</style>

<script>
  // JavaScript para animación infinita fluida del marquee derecho
  function initRightMarquee() {
    const rightMarquee = document.getElementById('right-marquee');
    if (!rightMarquee) return;
    
    const rightContent = rightMarquee.querySelectorAll('.marquee-content');
    if (rightContent.length === 0) return;
    
    // Obtener el ancho del contenido una vez
    const firstElement = rightContent[0] as HTMLElement;
    const contentWidth = firstElement.offsetWidth;
    
    // Empezar desde el final del texto (posición negativa)
    let rightPosition = -contentWidth;
    const speed = 1; // Velocidad en píxeles por frame
    
    function animateRightMarquee() {
      rightPosition += speed;
      
      // Resetear posición cuando el texto sale completamente por la derecha
      // Volver a empezar desde la izquierda (fuera del viewport)
      if (rightPosition >= contentWidth) {
        rightPosition = -contentWidth;
      }
      
      // Aplicar transformación
      (rightMarquee as HTMLElement).style.transform = `translateX(${rightPosition}px)`;
      
      requestAnimationFrame(animateRightMarquee);
    }
    
    animateRightMarquee();
  }
  
  // Iniciar animación cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRightMarquee);
  } else {
    initRightMarquee();
  }
</script>