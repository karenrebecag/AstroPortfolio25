---
// RightMarqueeBanner - Large animated text moving from left to right
---

<!-- Wrapper para prevenir layout shift -->
<div class="right-marquee-container">
  <div class="right-marquee-wrapper">
    <div 
      id="right-marquee" 
      class="whitespace-nowrap font-display font-bold text-gray-1000/50 select-none text-left" 
      style="font-size: clamp(163px, 32.6vw, 326px); width: max-content; text-shadow: 0px 4px 8px rgba(2, 2, 2, 0.398); height: clamp(163px, 32.6vw, 326px); line-height: 1; will-change: transform; contain: layout style paint;"
    >
      <span class="marquee-content">
        FRONTEND • BACKEND • FULLSTACK • PROJECTS • 
      </span>
      <span class="marquee-content">
        FRONTEND • BACKEND • FULLSTACK • PROJECTS • 
      </span>
      <span class="marquee-content">
        FRONTEND • BACKEND • FULLSTACK • PROJECTS • 
      </span>
      <span class="marquee-content">
        FRONTEND • BACKEND • FULLSTACK • PROJECTS • 
      </span>
      <span class="marquee-content">
        FRONTEND • BACKEND • FULLSTACK • PROJECTS • 
      </span>
      <span class="marquee-content">
        FRONTEND • BACKEND • FULLSTACK • PROJECTS • 
      </span>
    </div>
  </div>
</div>

<style>
  .right-marquee-container {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .right-marquee-wrapper {
    /* Reserve space to prevent layout shift */
    width: 100%;
    max-width: 1800px;
    height: clamp(163px, 32.6vw, 326px);
    min-height: 163px;
    overflow: hidden;
    position: relative;
    contain: layout style paint;
  }
  
  #right-marquee {
    position: absolute;
    top: 0;
    /* Start from left edge for right-to-left movement */
    right: 100%;
    /* Allow infinite width for marquee animation */
    width: max-content !important;
  }

  /* Dark mode styles - Intense cyan illumination stroke text */
  :global(.dark-mode) #right-marquee {
    color: transparent !important;
    -webkit-text-stroke: 1px rgb(221, 255, 255);
    -webkit-text-fill-color: transparent;
    text-shadow: 
      /* Core white illumination */
      0 0 2px rgba(255, 255, 255, 1),
      0 0 5px rgba(255, 255, 255, 0.9),
      0 0 10px rgba(255, 255, 255, 0.8),
      /* Cyan neon illumination layers */
      0 0 20px rgba(0, 255, 255, 1),
      0 0 40px rgba(0, 255, 255, 0.9),
      0 0 60px rgba(0, 255, 255, 0.8),
      0 0 80px rgba(0, 255, 255, 0.7),
      0 0 100px rgba(0, 255, 255, 0.6),
      0 0 120px rgba(0, 255, 255, 0.5);
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    filter: brightness(1.2) saturate(1.3)
            drop-shadow(0 0 40px rgba(0, 255, 255, 0.15))
            drop-shadow(0 0 80px rgba(0, 255, 255, 0.08))
            drop-shadow(0 0 120px rgba(0, 255, 255, 0.04));
  }

  /* Hover effect - Maximum cyan illumination with flicker */
  :global(.dark-mode) .right-marquee-wrapper:hover #right-marquee {
    -webkit-text-stroke: 1px rgb(237, 248, 248);
    text-shadow: 
      /* Intense core illumination */
      0 0 3px rgba(255, 255, 255, 1),
      0 0 8px rgba(255, 255, 255, 1),
      0 0 15px rgba(255, 255, 255, 0.9),
      /* Maximum cyan neon illumination */
      0 0 25px rgba(0, 255, 255, 1),
      0 0 50px rgba(0, 255, 255, 1),
      0 0 75px rgba(0, 255, 255, 0.9),
      0 0 100px rgba(0, 255, 255, 0.8),
      0 0 125px rgba(0, 255, 255, 0.7),
      0 0 150px rgba(0, 255, 255, 0.6),
      0 0 175px rgba(0, 255, 255, 0.5);
    filter: brightness(1.5) saturate(1.5)
            drop-shadow(0 0 60px rgba(0, 255, 255, 0.25))
            drop-shadow(0 0 120px rgba(0, 255, 255, 0.15))
            drop-shadow(0 0 180px rgba(0, 255, 255, 0.08));
    animation: intenseCyanFlicker 2s ease-in-out infinite alternate;
  }

  /* Intense cyan flicker animation - realistic neon effect */
  @keyframes intenseCyanFlicker {
    0%, 19%, 21%, 23%, 25%, 54%, 56%, 100% {
      text-shadow: 
        /* Core white illumination */
        0 0 3px rgba(255, 255, 255, 1),
        0 0 8px rgba(255, 255, 255, 1),
        0 0 15px rgba(255, 255, 255, 0.9),
        /* Maximum cyan neon illumination */
        0 0 25px rgba(0, 255, 255, 1),
        0 0 50px rgba(0, 255, 255, 1),
        0 0 75px rgba(0, 255, 255, 0.9),
        0 0 100px rgba(0, 255, 255, 0.8),
        0 0 125px rgba(0, 255, 255, 0.7),
        0 0 150px rgba(0, 255, 255, 0.6),
        0 0 175px rgba(0, 255, 255, 0.5);
      filter: brightness(1.5) saturate(1.5);
    }
    20%, 22%, 24%, 55% {
      text-shadow: 
        /* Dimmed flicker state */
        0 0 1px rgba(255, 255, 255, 0.6),
        0 0 3px rgba(255, 255, 255, 0.4),
        0 0 8px rgba(0, 255, 255, 0.6),
        0 0 15px rgba(0, 255, 255, 0.4),
        0 0 25px rgba(0, 255, 255, 0.3);
      filter: brightness(0.8) saturate(0.8);
    }
  }

  /* Performance optimizations */
  :global(.dark-mode) #right-marquee {
    /* GPU acceleration for smooth animations */
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  /* Accessibility: Respect user's motion preferences */
  @media (prefers-reduced-motion: reduce) {
    :global(.dark-mode) .right-marquee-wrapper:hover #right-marquee {
      animation: none !important;
    }
  }

  /* Gradientes laterales para pantallas grandes */
  @media (min-width: 2560px) {
    .right-marquee-wrapper::before,
    .right-marquee-wrapper::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 120px;
      z-index: 2;
      pointer-events: none;
    }

    .right-marquee-wrapper::before {
      left: 0;
      background: linear-gradient(to right, white, transparent);
    }

    .right-marquee-wrapper::after {
      right: 0;
      background: linear-gradient(to left, white, transparent);
    }

    /* Dark mode gradients */
    :global(.dark-mode) .right-marquee-wrapper::before {
      background: linear-gradient(to right, #050112, transparent);
    }

    :global(.dark-mode) .right-marquee-wrapper::after {
      background: linear-gradient(to left, #050112, transparent);
    }
  }
</style>

<script>
  // JavaScript para animación infinita fluida del marquee derecho
  function initRightMarquee() {
    const rightMarquee = document.getElementById('right-marquee');
    if (!rightMarquee) return;
    
    const rightContent = rightMarquee.querySelectorAll('.marquee-content');
    if (rightContent.length === 0) return;
    
    let rightPosition = 0;
    const speed = 1; // Velocidad en píxeles por frame (positiva para ir hacia la derecha)
    
    function animateRightMarquee() {
      rightPosition += speed;
      
      // Obtener el ancho del contenido
      const firstElement = rightContent[0] as HTMLElement;
      const contentWidth = firstElement.offsetWidth;
      
      // Resetear posición cuando el primer elemento sale completamente
      if (rightPosition >= contentWidth) {
        rightPosition = 0;
      }
      
      // Aplicar transformación
      (rightMarquee as HTMLElement).style.transform = `translateX(${rightPosition}px)`;
      
      requestAnimationFrame(animateRightMarquee);
    }
    
    animateRightMarquee();
  }
  
  // Iniciar animación cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRightMarquee);
  } else {
    initRightMarquee();
  }
</script>