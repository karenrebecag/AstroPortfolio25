---
// BannerButtonsWrapper component - Contains both MainButton and SecondaryButton
import MainButton from '../ui/MainButton.astro';
import SecondaryButton from '../ui/SecondaryButton.astro';
---

<div class="banner-buttons-container">
  <div class="button-wrapper">
    <SecondaryButton text="Projects" />
  </div>
  <div class="button-wrapper">
    <MainButton text="Get my Resume" href="/resume" />
  </div>
</div>

<style>
  .banner-buttons-container {
    width: 100%;
    height: 100%;
    padding: 30px 0;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 48px;
    contain: layout style;
  }

  .button-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 2.5rem;
    min-height: 60px;
    align-items: center;
    contain: layout style;
  }

  @media (max-width: 768px) {
    .banner-buttons-container {
      flex-direction: column;
      gap: 24px;
      align-items: center;
    }
    
    .button-wrapper {
      margin-bottom: 1rem;
      width: 100%;
      max-width: 280px;
    }
  }
</style>
