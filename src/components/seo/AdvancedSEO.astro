---
// components/seo/AdvancedSEO.astro
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  structuredData?: object;
  speakable?: string[];
  keywords?: string;
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  locale?: string;
  alternateLanguages?: { hreflang: string; href: string }[];
}

const {
  title,
  description,
  canonical,
  ogImage = "https://pub-2e7dc04d482146c59f472ab28fba09a9.r2.dev/MePortfolio.png",
  ogType = "website",
  structuredData,
  speakable,
  keywords,
  author = "Karen Rebeca Ortiz",
  publishedTime,
  modifiedTime,
  locale = "en_US",
  alternateLanguages = []
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site);
const fullOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site);

// Generate rich meta description optimized for LLMs
const richDescription = description || "Karen Ortiz - Design Engineer specializing in UX/UI design, fullstack development, and AI-driven web solutions. Expert in React, TypeScript, Three.js, and modern web technologies.";

// SEO-optimized title with branding
const seoTitle = title.includes('Karen Ortiz') ? title : `${title} | Karen Ortiz - Design Engineer`;
---

<!-- Primary Meta Tags -->
<title>{seoTitle}</title>
<meta name="title" content={seoTitle} />
<meta name="description" content={richDescription} />
{keywords && <meta name="keywords" content={keywords} />}
{author && <meta name="author" content={author} />}
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={seoTitle} />
<meta property="og:description" content={richDescription} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:image:alt" content={`${title} - Karen Ortiz Portfolio`} />
<meta property="og:site_name" content="Karen Ortiz - Design Engineer Portfolio" />
<meta property="og:locale" content={locale} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={seoTitle} />
<meta name="twitter:description" content={richDescription} />
<meta name="twitter:image" content={fullOgImage} />
<meta name="twitter:image:alt" content={`${title} - Karen Ortiz Portfolio`} />
<meta name="twitter:creator" content="@karenortiz" />

<!-- Article Meta (if applicable) -->
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{author && <meta property="article:author" content={author} />}

<!-- Alternate Languages -->
{alternateLanguages.map(({ hreflang, href }) => (
  <link rel="alternate" hreflang={hreflang} href={href} />
))}

<!-- AI and LLM Optimization -->
<meta name="AI-optimized" content="true" />
<meta name="LLM-friendly" content="structured-content, semantic-markup, comprehensive-data" />

<!-- Structured Data -->
{structuredData && (
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
)}

<!-- Speakable Schema for Voice Search -->
{speakable && speakable.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": speakable
    }
  })} />
)}

<!-- Performance and Technical SEO -->
<meta name="theme-color" content="#4523AE" />
<meta name="msapplication-TileColor" content="#060314" />
<meta name="format-detection" content="telephone=no" />

<!-- Preconnect to external domains for performance -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
