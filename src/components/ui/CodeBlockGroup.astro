---
// CodeBlockGroup.astro - Contenedor para headers y metadatos de grupos de código
export interface Props {
  title?: string;
  description?: string;
  className?: string;
}

const {
  title,
  description,
  className = '',
} = Astro.props;
---

<div class={`codeblock-group ${className}`}>
  {(title || description) && (
    <div class="codeblock-group-header">
      {title && <h3 class="codeblock-group-title">{title}</h3>}
      {description && <p class="codeblock-group-description">{description}</p>}
    </div>
  )}
  
  <div class="codeblock-group-content">
    <slot />
  </div>
</div>

<style>
  .codeblock-group {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .codeblock-group-header {
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .codeblock-group-title {
    font-family: var(--font-primary, 'InterTight', sans-serif);
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    font-weight: 600;
    color: #1B1B1B;
    margin: 0 0 clamp(0.5rem, 1vw, 0.75rem) 0;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .codeblock-group-description {
    font-family: var(--font-primary, 'InterTight', sans-serif);
    font-size: clamp(0.8rem, 1.8vw, 0.9rem);
    line-height: 1.5;
    color: #666;
    margin: 0;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .codeblock-group-content {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  /* Dark mode styles */
  :global(.dark-mode) .codeblock-group-title {
    color: #ffffff;
  }

  :global(.dark-mode) .codeblock-group-description {
    color: #cccccc;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .codeblock-group {
      margin-bottom: 3rem;
    }

    .codeblock-group-title {
      font-size: 1.25rem;
    }

    .codeblock-group-description {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .codeblock-group {
      margin-bottom: 2rem;
    }

    .codeblock-group-title {
      font-size: 1.125rem;
    }
  }
</style>
