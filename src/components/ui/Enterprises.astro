---
const logos = [
  { src: 'https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/AncientLogo-1.png', alt: 'Ancient' },
  { src: 'https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/AthenisAILogo.png', alt: 'Athenis AI' },
  { src: 'https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/OpinatorLogo.png', alt: 'Opinator' },
  { src: 'https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/SodioWhite.png', alt: 'Sodio' },
  { src: 'https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/SpilLogo.png', alt: 'Spil' },
  { src: 'https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/WebCraftersLogo.png', alt: 'WebCrafters' },
  { src: 'https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/ZoekLogo.png', alt: 'Zoek' }
];

---

<section class="enterprises">
  <div class="enterprises-container">
    <div class="enterprises-wrapper">
      <div class="container">
        <h2 class="title">Trusted by Leading Brands to Deliver Exceptional Design Solutions</h2>
        <div class="slider">
          {[...logos, ...logos].map((logo) => (
            <img src={logo.src} alt={logo.alt} class="logo" width="90" height="12" loading="lazy" />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>


<style>
  .enterprises {
    background: #000;
    padding: 44px 0;
    overflow: hidden;
    transition: background 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark mode styles - Purple tones */
  :global(.dark-mode) .enterprises {
    background: linear-gradient(145deg, #020009 0%, #0c0115 100%);
  }

  .enterprises-container {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .enterprises-wrapper {
    width: 100%;
    max-width: 1200px;
    position: relative;
    overflow: hidden;
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  .title {
    font-family: 'Median', serif;
    font-size: clamp(12px, 1vw, 12px);
    color: #fff;
    margin: 0 0 32px;
    font-weight: 500;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark mode title - Purple accent */
  :global(.dark-mode) .title {
    color: #e6d9f0;
  }

  .slider {
    display: flex;
    gap: 80px;
    animation: scroll 30s linear infinite;
    width: max-content;
  }

  .logo {
    filter: grayscale(1) brightness(1.2);
    opacity: 0.8;
    object-fit: contain;
  }

  @keyframes scroll {
    to { transform: translateX(-50%); }
  }

  /* Gradientes laterales para pantallas grandes */
  @media (min-width: 2560px) {
    .enterprises-wrapper::before,
    .enterprises-wrapper::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 120px;
      z-index: 2;
      pointer-events: none;
    }

    .enterprises-wrapper::before {
      left: 0;
      background: linear-gradient(to right, #000, transparent);
      transition: background 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .enterprises-wrapper::after {
      right: 0;
      background: linear-gradient(to left, #000, transparent);
      transition: background 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    /* Dark mode gradients - Purple tones */
    :global(.dark-mode) .enterprises-wrapper::before {
      background: linear-gradient(to right, #2a0845, transparent);
    }

    :global(.dark-mode) .enterprises-wrapper::after {
      background: linear-gradient(to left, #2a0845, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slider { animation: none; justify-content: center; flex-wrap: wrap; }
  }
</style>
