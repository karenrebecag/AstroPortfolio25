---
/**
 * RichText Component
 * Renders Payload CMS rich text (Lexical format) as HTML
 */

export interface Props {
  content: any;
  className?: string;
}

const { content, className = '' } = Astro.props;

// Helper to render rich text nodes recursively
function renderRichText(node: any): string {
  if (!node) return '';

  // Handle string content
  if (typeof node === 'string') return node;

  // Handle root node
  if (node.root) {
    return renderChildren(node.root.children || []);
  }

  // Handle array of nodes
  if (Array.isArray(node)) {
    return renderChildren(node);
  }

  return '';
}

function renderChildren(children: any[]): string {
  if (!Array.isArray(children)) return '';

  return children.map(child => renderNode(child)).join('');
}

function renderNode(node: any): string {
  if (!node) return '';

  // Text node
  if (node.text !== undefined) {
    let text = node.text;

    // Apply formatting
    if (node.bold) text = `<strong>${text}</strong>`;
    if (node.italic) text = `<em>${text}</em>`;
    if (node.underline) text = `<u>${text}</u>`;
    if (node.strikethrough) text = `<s>${text}</s>`;
    if (node.code) text = `<code>${text}</code>`;

    return text;
  }

  // Block nodes
  switch (node.type) {
    case 'paragraph':
      return `<p>${renderChildren(node.children || [])}</p>`;

    case 'heading':
      const level = node.tag || 'h2';
      return `<${level}>${renderChildren(node.children || [])}</${level}>`;

    case 'list':
      const listTag = node.listType === 'number' ? 'ol' : 'ul';
      return `<${listTag}>${renderChildren(node.children || [])}</${listTag}>`;

    case 'listitem':
      return `<li>${renderChildren(node.children || [])}</li>`;

    case 'quote':
      return `<blockquote>${renderChildren(node.children || [])}</blockquote>`;

    case 'link':
      const url = node.url || node.linkType === 'custom' ? node.url : '#';
      const target = node.newTab ? ' target="_blank" rel="noopener noreferrer"' : '';
      return `<a href="${url}"${target}>${renderChildren(node.children || [])}</a>`;

    case 'linebreak':
      return '<br/>';

    default:
      // For unknown types, try to render children
      if (node.children) {
        return renderChildren(node.children);
      }
      return '';
  }
}

const html = renderRichText(content);
---

<div class={`rich-text ${className}`} set:html={html} />

<style>
  .rich-text {
    color: inherit;
    line-height: 1.8;
    word-wrap: break-word;
    overflow-wrap: break-word;
    word-break: break-word;
    max-width: 100%;
  }

  .rich-text p {
    margin-bottom: 1.5em;
    word-wrap: break-word;
    overflow-wrap: break-word;
    word-break: break-word;
    max-width: 100%;
  }

  .rich-text p:last-child {
    margin-bottom: 0;
  }

  .rich-text strong {
    font-weight: 600;
  }

  .rich-text em {
    font-style: italic;
  }

  .rich-text u {
    text-decoration: underline;
  }

  .rich-text s {
    text-decoration: line-through;
  }

  .rich-text code {
    background: rgba(0, 0, 0, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-size: 0.9em;
  }

  .rich-text h1,
  .rich-text h2,
  .rich-text h3,
  .rich-text h4,
  .rich-text h5,
  .rich-text h6 {
    margin-top: 2em;
    margin-bottom: 1em;
    font-weight: 600;
    line-height: 1.3;
  }

  .rich-text h1 { font-size: 2em; }
  .rich-text h2 { font-size: 1.75em; }
  .rich-text h3 { font-size: 1.5em; }
  .rich-text h4 { font-size: 1.25em; }
  .rich-text h5 { font-size: 1.1em; }
  .rich-text h6 { font-size: 1em; }

  .rich-text ul,
  .rich-text ol {
    margin-bottom: 1.5em;
    padding-left: 2em;
  }

  .rich-text li {
    margin-bottom: 0.5em;
  }

  .rich-text blockquote {
    margin: 2em 0;
    padding-left: 1.5em;
    border-left: 4px solid rgba(157, 127, 193, 0.5);
    font-style: italic;
    color: rgba(255, 255, 255, 0.8);
  }

  .rich-text a {
    color: #9D7FC1;
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .rich-text a:hover {
    color: #B399D4;
  }
</style>
