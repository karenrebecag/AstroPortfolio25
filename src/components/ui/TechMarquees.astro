---
// TechMarquees.astro
import TechMarqueesIsland from './TechMarqueesIsland.tsx';
---

<section class="tech-marquees-section">
  <TechMarqueesIsland client:visible />
</section>

<style>
  :global(.tech-marquees-section) {
    width: 100%;
    height: 480px;
    overflow: hidden;
    position: relative;
    transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.tech-marquees-container) {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 15px;
    z-index: 1;
  }

  :global(.tech-marquee-wrapper) {
    width: 100%;
    height: 60px;
    display: flex;
    align-items: center;
    overflow: hidden;
    position: relative;
    opacity: 0.2;
    transition: opacity 0.3s ease-in-out;
  }

  :global(.tech-marquee-wrapper:hover) {
    opacity: 1;
  }

  :global(.tech-marquee-wrapper:nth-child(1)) {
    /* Primer marquee - dirección derecha */
  }

  :global(.tech-marquee-wrapper:nth-child(2)) {
    /* Segundo marquee - dirección izquierda */
  }

  :global(.tech-marquee-wrapper:nth-child(3)) {
    /* Tercer marquee - dirección derecha */
  }

  :global(.tech-marquee-wrapper:nth-child(4)) {
    /* Cuarto marquee - dirección izquierda */
  }

  :global(.tech-marquee-wrapper:nth-child(5)) {
    /* Quinto marquee - dirección derecha */
  }

  :global(.tech-marquee-wrapper:nth-child(6)) {
    /* Sexto marquee - dirección izquierda */
  }

  @media (max-width: 768px) {
    .tech-marquees-section {
      height: 360px;
    }
    
    :global(.tech-marquees-container) {
      height: 360px;
      gap: 10px;
    }
    
    :global(.tech-marquee-wrapper) {
      height: 50px;
    }
  }

  /* Accessibility: Respect user's motion preferences */
  @media (prefers-reduced-motion: reduce) {
    :global(.tech-marquee-wrapper) {
      animation: none;
    }
    
    :global(.tech-marquees-container) {
      overflow: hidden;
    }
  }

  /* Dark Mode Styles - Following Documentation Pattern */
  :global(.dark-mode .tech-marquees-section) {
    background-color: #020009;
  }

  /* Tech marquee text dark mode - Video Game Font remains black for contrast */
  :global(.dark-mode .tech-marquee-wrapper) {
    /* Keep opacity and hover effects the same */
    opacity: 0.2;
  }

  :global(.dark-mode .tech-marquee-wrapper:hover) {
    opacity: 1;
  }

  /* The text inside marquees uses Video Game Font and should remain black for readability */
  /* This creates a nice contrast effect against the dark background */
</style>
