---
// Services.astro - Sección de servicios con funcionalidad colapsable optimizada
import ServicesIsland from './ServicesIsland.tsx';
---

<section class="services-section">
  <div class="services-container">
    <div class="services-content">
      <!-- Header Section -->
      <div class="services-header">
        <h2 class="services-title">Services</h2>
        <p class="services-description">
          I'm a digital designer that design and development high-end projects with affordable price
        </p>
      </div>

      <!-- Services List - Optimized Island Component -->
      <ServicesIsland client:load />

    </div>
  </div>
</section>

<style>
  .services-section {
    width: 100%;
    min-height: 100vh;
    padding: 65px 60px;
    background:
      linear-gradient(to right, rgba(0, 0, 0, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.03) 1px, transparent 1px),
      white;
    background-size: 40px 40px, 40px 40px, 100% 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
  }

  .services-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .services-content {
    width: 100%;
    padding-bottom: 200px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    gap: 80px;
  }

  /* Header Styles */
  .services-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
  }

  .services-title {
    color: #808080;
    font-family: var(--font-display);
    font-size: clamp(32px, 6vw, 48px);
    font-weight: 400;
    line-height: clamp(40px, 7vw, 56px);
    margin: 0;
  }

  .services-description {
    width: 100%;
    max-width: 424px;
    color: #111111;
    font-family: var(--font-primary);
    font-size: clamp(16px, 2.5vw, 20px);
    font-weight: 500;
    line-height: clamp(24px, 3.5vw, 30px);
    margin: 0;
  }

  /* Services List */
  :global(.services-list) {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  :global(.service-item) {
    width: 100%;
    padding-top: 24px;
    border-top: 1px solid rgba(17, 17, 17, 0.20);
    display: flex;
    flex-direction: column;
    gap: 54px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  :global(.service-number) {
    color: black;
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    transition: color 0.3s ease;
  }

  :global(.service-number.inactive) {
    color: rgba(17, 17, 17, 0.30);
  }

  :global(.service-content) {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 54px;
  }

  :global(.service-title-container) {
    width: 100%;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: clamp(20px, 4vw, 30px);
    flex-wrap: wrap;
  }

  :global(.service-title) {
    color: #111111;
    margin: 0;
    transition: color 0.3s ease;
  }

  :global(.service-title.inactive) {
    color: rgba(17, 17, 17, 0.30);
  }

  /* FlipText hover activation via parent */
  .service-item:hover .service-title :global(.flip-text-container) > div:first-child span {
    transform: translateY(-110%);
  }

  .service-item:hover .service-title :global(.flip-text-container) > div.absolute span {
    transform: translateY(0);
  }

  /* Ensure FlipText inherits the color from service-title */
  .service-title :global(.flip-text-container) {
    color: inherit;
  }

  /* Override some Tailwind styles to make sure our transitions work */
  .service-title :global(.flip-text-container) span {
    transition-property: transform;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 300ms;
  }

  :global(.service-details) {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    opacity: 1;
    max-height: 200px;
    overflow: hidden;
    transition: all 0.4s ease;
  }

  :global(.service-info) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 21px;
    width: 60%;
    max-width: 60%;
  }

  :global(.service-tags) {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
  }

  :global(.tag) {
    padding: 8px 11px;
    border-radius: 924px;
    border: 0.55px solid rgba(17, 17, 17, 0.20);
    color: #151515;
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 400;
    text-transform: uppercase;
    line-height: 16px;
    white-space: nowrap;
    display: inline-block;
    transition: all 0.2s ease;
  }

  :global(.tag:hover) {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  :global(.service-description) {
    color: #808080;
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    margin: 0;
  }

  :global(.service-images) {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 140px;
    width: 40%;
    max-width: 40%;
    flex-shrink: 0;
  }

  /* Collapsed State */
  :global(.service-item:not(.active) .service-details) {
    opacity: 0;
    max-height: 0;
    margin-top: -54px;
  }

  :global(.service-item:not(.active):hover .service-details) {
    opacity: 1;
    max-height: 200px;
    margin-top: 0;
  }

  :global(.service-item:not(.active):hover .service-number) {
    color: black;
  }

  :global(.service-item:not(.active):hover .service-title) {
    color: #111111;
  }


  /* Responsive Design */
  @media (max-width: 768px) {
    .services-section {
      padding: 40px 20px;
    }

    .services-header {
      flex-direction: column;
      gap: 20px;
    }

    .services-description {
      max-width: 100%;
    }

    :global(.service-title-container) {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    :global(.service-details) {
      flex-direction: column;
      gap: 20px;
    }

    :global(.service-images) {
      width: 100%;
      justify-content: center;
    }

  }

  @media (max-width: 480px) {
    .services-content {
      gap: 40px;
      padding-bottom: 100px;
    }

    :global(.services-list) {
      gap: 32px;
    }

    :global(.service-item) {
      gap: 30px;
    }

    :global(.service-content) {
      gap: 30px;
    }
  }
</style>

