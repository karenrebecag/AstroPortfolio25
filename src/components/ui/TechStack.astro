---
// TechStack.astro - Tech Stack section component with scrolling content
import { AnimatedTechStackHeader, AnimatedTechSection, AnimatedTechItem } from './AnimatedTechStackWrapper.tsx';
---

<!-- Tech Stack Scroll Container -->
<div class="tech-stack-scroll-container">
  <div class="tech-story-grid">

    <!-- Left Column: Fixed Tech Stack Title -->
    <AnimatedTechStackHeader client:visible>
      <div class="w-full relative">
        <div class="relative z-10">
          <div class="relative">
            <!-- Purple circle positioned behind the heading -->
            <h2 class="tech-stack-title">
              <span class="tech-stack-title-primary">Tech</span><br />
              <span class="tech-stack-title-accent">Stack</span>
            </h2>
          </div>
          <p class="tech-stack-description">
            The technologies and tools powering Aurin Task Manager's robust architecture.
          </p>
        </div>
      </div>
    </AnimatedTechStackHeader>
    
    <!-- Right Column: Scrolling Tech Content -->
    <div class="scrolling-tech-column">
      
      <!-- Tech Section 1: Frontend -->
      <AnimatedTechSection client:visible delay={0.1}>
        <div class="relative z-10">
          <h2 class="tech-section-title">
            <span class="tech-section-title-accent">Frontend</span><br />
            <span class="tech-section-title-primary">Technologies</span>
          </h2>
          <div class="tech-list">
            <AnimatedTechItem client:visible delay={0.2}>
              <h3 class="tech-name">Next.js 15.3.3</h3>
              <p class="tech-description">React framework with App Router, server components, and optimized performance for production-ready applications.</p>
            </AnimatedTechItem>
            <AnimatedTechItem client:visible delay={0.25}>
              <h3 class="tech-name">React 19</h3>
              <p class="tech-description">Latest React with concurrent features, automatic batching, and enhanced developer experience.</p>
            </AnimatedTechItem>
            <AnimatedTechItem client:visible delay={0.3}>
              <h3 class="tech-name">TypeScript</h3>
              <p class="tech-description">100% type safety ensuring robust, maintainable code with strict configuration and comprehensive type coverage.</p>
            </AnimatedTechItem>
          </div>
        </div>
      </AnimatedTechSection>

      <!-- Tech Section 2: Backend & Database -->
      <AnimatedTechSection client:visible delay={0.15}>
        <div class="relative z-10">
          <h2 class="tech-section-title">
            <span class="tech-section-title-primary">Backend &</span><br />
            <span class="tech-section-title-accent">Database</span>
          </h2>
          <div class="tech-list">
            <AnimatedTechItem client:visible delay={0.35}>
              <h3 class="tech-name">Firebase Firestore</h3>
              <p class="tech-description">NoSQL database with real-time synchronization, offline support, and granular security rules for scalable data management.</p>
            </AnimatedTechItem>
            <AnimatedTechItem client:visible delay={0.4}>
              <h3 class="tech-name">Vercel Edge Functions</h3>
              <p class="tech-description">Serverless functions deployed globally for optimal performance and automatic scaling.</p>
            </AnimatedTechItem>
            <AnimatedTechItem client:visible delay={0.45}>
              <h3 class="tech-name">Nodemailer</h3>
              <p class="tech-description">Professional email system with smart notification queuing, retry logic, and batch processing capabilities.</p>
            </AnimatedTechItem>
          </div>
        </div>
      </AnimatedTechSection>

      <!-- Tech Section 3: State Management -->
      <AnimatedTechSection client:visible delay={0.2}>
        <div class="relative z-10">
          <h2 class="tech-section-title">
            <span class="tech-section-title-accent">State</span><br />
            <span class="tech-section-title-primary">Management</span>
          </h2>
          <div class="tech-list">
            <AnimatedTechItem client:visible delay={0.5}>
              <h3 class="tech-name">Zustand</h3>
              <p class="tech-description">Lightweight state management with optimistic updates, ensuring UI responds instantly while Firestore syncs afterward.</p>
            </AnimatedTechItem>
            <AnimatedTechItem client:visible delay={0.55}>
              <h3 class="tech-name">Custom Hooks</h3>
              <p class="tech-description">Specialized hooks for encryption, message pagination, drag interactions, and timer management.</p>
            </AnimatedTechItem>
            <AnimatedTechItem client:visible delay={0.6}>
              <h3 class="tech-name">React Context</h3>
              <p class="tech-description">Global state management for user authentication, theme preferences, and application-wide settings.</p>
            </AnimatedTechItem>
          </div>
        </div>
      </AnimatedTechSection>

      <!-- Tech Section 4: Authentication & Security -->
      <AnimatedTechSection client:visible delay={0.25}>
        <div class="relative z-10">
          <h2 class="tech-section-title">
            <span class="tech-section-title-primary">Authentication</span><br />
            <span class="tech-section-title-accent">& Security</span>
          </h2>
          <div class="tech-list">
            <AnimatedTechItem client:visible delay={0.65}>
              <h3 class="tech-name">Clerk</h3>
              <p class="tech-description">Complete user management with social logins, MFA, and role-based access control for enterprise security.</p>
            </AnimatedTechItem>
            <AnimatedTechItem client:visible delay={0.7}>
              <h3 class="tech-name">Firebase Auth</h3>
              <p class="tech-description">Backend security layer with custom claims, secure token validation, and granular permission management.</p>
            </AnimatedTechItem>
            <AnimatedTechItem client:visible delay={0.75}>
              <h3 class="tech-name">Encryption</h3>
              <p class="tech-description">End-to-end message encryption using custom useEncryption hook for secure team communications.</p>
            </AnimatedTechItem>
          </div>
        </div>
      </AnimatedTechSection>

    </div>
  </div>
</div>

<style>
  /* Tech Stack Scroll Container */
  .tech-stack-scroll-container {
		background: hsl(0, 0%, 99%);
    position: relative;
  }

  .tech-story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr; /* Two column layout on desktop */
    gap: 3rem;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 3.75rem;
  }

  /* Left Column: Sticky Tech Title */
  .sticky-tech-column {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
  }

  /* Right Column: Scrolling Tech Content */
  .scrolling-tech-column {
    display: flex;
    flex-direction: column;
    gap: 10rem;
  }

  .tech-content-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    flex-direction: column;
    gap: 2rem;;
    padding: 2rem 0;
  }

  /* Tech List Styles */
  .tech-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .tech-item {
    padding: 1.5rem;
		backdrop-filter: blur(10px) brightness(0.8);
		border-radius: 12px;
		border: 1px solid transparent;
		background-image: linear-gradient(#ffffff, rgb(250, 250, 250)), linear-gradient(to bottom, rgba(255, 255, 255, 1), rgba(255, 255, 255, 0));
		background-origin: border-box;
		background-clip: padding-box, border-box;
  }

 
  .tech-name {
    font-family: var(--font-display, 'Median', serif);
    font-size: 1.5rem;
    font-weight: 400;
    color: #7350cc;
    margin: 0 0 0.75rem 0;
    line-height: 1.2;
  }

  .tech-description {
    font-family: var(--font-primary, 'InterTight', sans-serif);
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(8, 8, 8, 0.7);
    margin: 0;
  }

  /* Tech Stack Title Styles */
  .tech-stack-title {
    font-family: var(--font-display, 'Median', serif);
    font-size: clamp(48px, 8vw, 96px);
    line-height: 0.75;
    margin-bottom: 0.5rem;
    position: relative;
    z-index: 10;
  }

  .tech-stack-title-primary {
    color: #080808;
  }

  .tech-stack-title-accent {
    color: #7350cc;
  }

  .tech-stack-description {
    font-family: var(--font-primary, 'InterTight', sans-serif);
    font-size: 20px;
    line-height: 1.5;
    font-weight: 500;
    color: rgba(8, 8, 8, 0.6);
    margin-top: 1.5rem;
  }

  /* Tech Section Title Styles */
  .tech-section-title {
    font-family: var(--font-display, 'Median', serif);
    font-size: clamp(36px, 6vw, 72px);
    line-height: 0.9;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
  }

  .tech-section-title-primary {
    color: #080808;
  }

  .tech-section-title-accent {
    color: #7350cc;
  }

  /* Grid pattern overlay */
  .tech-stack-scroll-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      linear-gradient(rgba(0, 0, 0, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.02) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
    z-index: 1;
  }

  .tech-story-grid {
    position: relative;
    z-index: 2;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .tech-story-grid {
      gap: 2rem;
      padding: 0 2rem;
    }
  }

  @media (max-width: 768px) {
    .tech-story-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 0 1.5rem;
      text-align: center;
    }

    .sticky-tech-column {
      display: none;
    }

    .tech-content-section {
      min-height: 60vh;
    }

    .tech-item {
      padding: 1.25rem;
    }

    .tech-name {
      font-size: 1.25rem;
    }

    .tech-description {
      font-size: 0.9rem;
    }

    .tech-stack-title {
      font-size: clamp(36px, 10vw, 64px);
    }

    .tech-stack-description {
      font-size: 18px;
    }

    .tech-section-title {
      font-size: clamp(28px, 8vw, 48px);
    }
  }

  @media (max-width: 480px) {
    .tech-story-grid {
      padding: 0 1rem;
    }

    .tech-content-section {
      min-height: 50vh;
      padding: 1.5rem 0;
    }

    .tech-item {
      padding: 1rem;
    }

    .tech-name {
      font-size: 1.125rem;
    }

    .tech-description {
      font-size: 0.875rem;
    }

    .tech-stack-title {
      font-size: clamp(32px, 12vw, 56px);
    }

    .tech-stack-description {
      font-size: 16px;
    }

    .tech-section-title {
      font-size: clamp(24px, 10vw, 40px);
    }
  }
</style>
