---
import { getLangFromUrl, languageOptions, useTranslatedPath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const currentLanguage = languageOptions.find(l => l.code === lang);
---

<div class="final-lang-selector">
  <button
    class="final-trigger"
    id="finalLangToggle"
    onclick="event.preventDefault(); event.stopPropagation(); window.toggleLanguageDropdown && window.toggleLanguageDropdown()"
  >
    <span class="lang-code">{lang.toUpperCase()}</span>
    <span class="arrow">▼</span>
  </button>

  <div class="final-dropdown" id="finalLangDropdown">
    {languageOptions.map((language) => (
      <a
        href={useTranslatedPath(language.code, Astro.url.pathname)}
        class={`final-option ${lang === language.code ? 'active' : ''}`}
      >
        <span class="name">{language.name}</span>
        <span class="code">({language.code.toUpperCase()})</span>
      </a>
    ))}
  </div>
</div>

<style is:global>
.final-lang-selector {
  position: relative;
  display: inline-block;
  z-index: 1000;
}

.final-trigger {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  border: 1px solid rgba(204, 204, 204, 0.3);
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.9) !important;
  cursor: pointer !important;
  font-family: var(--font-display);
  font-size: 14px;
  color: #131019;
  transition: all 0.2s ease;
}

.final-trigger:hover {
  border-color: #060314;
  background: rgba(255, 255, 255, 0.95) !important;
}


.final-trigger .lang-code {
  font-weight: 600;
  letter-spacing: 0.5px;
}

.final-trigger .arrow {
  font-size: 10px;
  transition: transform 0.2s ease;
}

.final-trigger.open .arrow {
  transform: rotate(180deg);
}

.final-dropdown {
  position: absolute !important;
  top: calc(100% + 8px) !important;
  right: 0 !important;
  min-width: 200px !important;
  background: white !important;
  border: 1px solid rgba(204, 204, 204, 0.2) !important;
  border-radius: 8px !important;
  box-shadow: 0 8px 32px rgba(0,0,0,0.12) !important;
  z-index: 9999 !important;
  display: none !important;
  overflow: hidden !important;
  backdrop-filter: blur(15px) !important;
}

.final-dropdown.show {
  display: block !important;
}

.final-option {
  display: flex !important;
  align-items: center !important;
  gap: 12px !important;
  padding: 12px 16px !important;
  color: #131019 !important;
  text-decoration: none !important;
  transition: background 0.2s ease !important;
  border-bottom: 1px solid rgba(204, 204, 204, 0.1) !important;
}

.final-option:last-child {
  border-bottom: none !important;
}

.final-option:hover {
  background: rgba(247, 248, 249, 0.8) !important;
}

.final-option.active {
  background: rgba(6, 3, 20, 0.05) !important;
  border-left: 3px solid #060314 !important;
}

.final-option .name {
  font-weight: 500;
  font-size: 14px;
  flex: 1;
}

.final-option .code {
  font-size: 12px;
  color: #666;
  font-weight: 400;
}
</style>

<script is:inline>
// Global function that definitely works
window.toggleLanguageDropdown = function() {
  const trigger = document.getElementById('finalLangToggle');
  const dropdown = document.getElementById('finalLangDropdown');

  if (!trigger || !dropdown) return;

  const isOpen = dropdown.classList.contains('show');

  if (isOpen) {
    // Close with animation
    trigger.classList.remove('open');

    // Motion.dev close animation
    if (window.Motion && window.Motion.animate) {
      window.Motion.animate(dropdown,
        {
          opacity: 0,
          transform: 'translateY(-10px) scale(0.95)',
        },
        {
          duration: 0.2,
          ease: [0.4, 0.0, 0.2, 1],
          onComplete: () => {
            dropdown.classList.remove('show');
            dropdown.style.display = 'none';
          }
        }
      );
    } else {
      dropdown.classList.remove('show');
      dropdown.style.display = 'none';
    }
  } else {
    // Open with animation
    trigger.classList.add('open');
    dropdown.classList.add('show');
    dropdown.style.display = 'block';

    // Motion.dev open animation
    if (window.Motion && window.Motion.animate) {
      dropdown.style.opacity = '0';
      dropdown.style.transform = 'translateY(-10px) scale(0.95)';

      window.Motion.animate(dropdown,
        {
          opacity: 1,
          transform: 'translateY(0px) scale(1)',
        },
        {
          duration: 0.3,
          ease: [0.25, 0.46, 0.45, 0.94]
        }
      );
    }
  }
};

// Listen for clicks outside to close
document.addEventListener('click', function(e) {
  const trigger = document.getElementById('finalLangToggle');
  const dropdown = document.getElementById('finalLangDropdown');

  if (!trigger || !dropdown) return;

  // Only close if clicking outside AND dropdown is open
  if (dropdown.classList.contains('show') &&
      !dropdown.contains(e.target) &&
      !trigger.contains(e.target)) {

    // Use the same animation logic
    trigger.classList.remove('open');

    if (window.Motion && window.Motion.animate) {
      window.Motion.animate(dropdown,
        {
          opacity: 0,
          transform: 'translateY(-10px) scale(0.95)',
        },
        {
          duration: 0.2,
          ease: [0.4, 0.0, 0.2, 1],
          onComplete: () => {
            dropdown.classList.remove('show');
            dropdown.style.display = 'none';
          }
        }
      );
    } else {
      dropdown.classList.remove('show');
      dropdown.style.display = 'none';
    }
  }
});
</script>