---
import { getLangFromUrl, languageOptions, useTranslatedPath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const currentLanguage = languageOptions.find(l => l.code === lang);
---

<div class="working-lang-selector">
  <button class="working-trigger" id="workingLangToggle">
    <span class="flag">{currentLanguage?.flag}</span>
    <span class="lang-code">{lang.toUpperCase()}</span>
    <span class="arrow">▼</span>
  </button>

  <div class="working-dropdown" id="workingLangDropdown">
    {languageOptions.map((language) => (
      <a
        href={useTranslatedPath(language.code, Astro.url.pathname)}
        class={`working-option ${lang === language.code ? 'active' : ''}`}
      >
        <span class="flag">{language.flag}</span>
        <span class="name">{language.name}</span>
      </a>
    ))}
  </div>
</div>

<style>
.working-lang-selector {
  position: relative;
  display: inline-block;
  z-index: 1000;
}

.working-trigger {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  border: 1px solid rgba(204, 204, 204, 0.3);
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.9);
  cursor: pointer;
  font-family: var(--font-display);
  font-size: 14px;
  color: #131019;
  transition: all 0.2s ease;
}

.working-trigger:hover {
  border-color: #060314;
  background: rgba(255, 255, 255, 0.95);
}

.flag {
  font-size: 16px;
}

.lang-code {
  font-weight: 600;
  letter-spacing: 0.5px;
}

.arrow {
  font-size: 10px;
  transition: transform 0.2s ease;
}

.working-trigger.open .arrow {
  transform: rotate(180deg);
}

.working-dropdown {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  min-width: 220px;
  background: white;
  border: 1px solid rgba(204, 204, 204, 0.2);
  border-radius: 8px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.12);
  z-index: 1001;
  display: none;
  overflow: hidden;
}

.working-dropdown.show {
  display: block;
}

.working-option {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  color: #131019;
  text-decoration: none;
  transition: background 0.2s ease;
  border-bottom: 1px solid rgba(204, 204, 204, 0.1);
}

.working-option:last-child {
  border-bottom: none;
}

.working-option:hover {
  background: rgba(247, 248, 249, 0.8);
}

.working-option.active {
  background: rgba(6, 3, 20, 0.05);
  border-left: 3px solid #060314;
}

.working-option .name {
  font-weight: 500;
  font-size: 14px;
}
</style>

<script>
// Use the global click method that we know works
let isDropdownOpen = false;

document.addEventListener('click', function(e) {
  const trigger = document.getElementById('workingLangToggle');
  const dropdown = document.getElementById('workingLangDropdown');

  if (!trigger || !dropdown) return;

  // Check if click was on the trigger
  if (trigger.contains(e.target)) {
    e.preventDefault();
    e.stopPropagation();

    console.log('🎯 Language selector clicked!');

    isDropdownOpen = !isDropdownOpen;

    if (isDropdownOpen) {
      console.log('📂 Opening dropdown');
      trigger.classList.add('open');
      dropdown.classList.add('show');
    } else {
      console.log('📁 Closing dropdown');
      trigger.classList.remove('open');
      dropdown.classList.remove('show');
    }
  }
  // Check if click was outside
  else if (isDropdownOpen && !dropdown.contains(e.target)) {
    console.log('📁 Closing dropdown (click outside)');
    isDropdownOpen = false;
    trigger.classList.remove('open');
    dropdown.classList.remove('show');
  }
});

console.log('✅ Working language selector initialized');
</script>