---
// MegaBanner.astro - Banner strip sin efectos exagerados de padding
import MegaBackgroundIsland from './MegaBackgroundIsland.tsx';

export interface Props {
  title?: string;
  subtitle?: string;
  backgroundSrc?: string;
  placeholder?: string;
  height?: string;
  className?: string;
}

const {
  title = "Aurin Task Manager",
  subtitle = "Streamline your workflow with AI-powered task management and intelligent automation",
  backgroundSrc = "https://pub-2e7dc04d482146c59f472ab28fba09a9.r2.dev/MePortfolio.png",
  placeholder = "",
  height = "100vh",
  className = ""
} = Astro.props;
---

<section class={`mega-banner-section ${className}`} style={`--banner-height: ${height}`}>
  <div class="mega-banner-container">
    <!-- Background Island sin efectos exagerados -->
    <div class="mega-background-wrapper">
      <MegaBackgroundIsland
        backgroundSrc={backgroundSrc}
        placeholder={placeholder}
        client:visible
      />
      <!-- Fallback mientras carga el componente -->
      <div class="mega-background-fallback">
        <div class="loading-placeholder"></div>
      </div>
    </div>

    <!-- Contenido del banner -->
    <div class="mega-content">
      <div class="mega-content-inner">
        <h1 class="mega-title">{title}</h1>
        <p class="mega-subtitle">{subtitle}</p>
        
        <!-- Botones de acción opcionales -->
        <div class="mega-actions">
          <slot name="actions" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .mega-banner-section {
    position: relative;
    width: 100%;
    height: var(--banner-height, 100vh);
    min-height: 600px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    box-sizing: border-box;
  }

  .mega-banner-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mega-background-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
    background: hsl(var(--background));
    transition: filter 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark Mode: Apply grayscale filter */
  :global(.dark-mode) .mega-background-wrapper {
    filter: grayscale(100);
  }

  .mega-bottom-image {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    max-width: 800px;
    filter: drop-shadow(0 10px 15px rgba(0, 0, 0, 0.1)) drop-shadow(0 4px 6px rgba(0, 0, 0, 0.05));
    height: auto;
    z-index: 5;
    opacity: 0.9;
    pointer-events: none;
    overflow: hidden;
  }

  .mega-bottom-image img {
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: bottom center;
    display: block;
  }

  .mega-content {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    box-sizing: border-box;
    gap: 1rem;
  }

  .mega-content-inner {
    text-align: center;
    max-width: 1500px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .mega-title {
    font-family: var(--font-display, 'Median', serif);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: white;
    margin: 0;
    font-style: italic;
  }

  .mega-subtitle {
    font-family: var(--font-primary, 'InterTight', sans-serif);
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    font-weight: 500;
    line-height: 1.1;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.2);
    max-width: 600px;
    text-align: center;
  }

  .mega-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .mega-banner-section {
      min-height: 500px;
      padding: 0;
    }

    .mega-content {
      padding: 1rem;
    }

    .mega-actions {
      flex-direction: column;
      gap: 0.75rem;
    }

    .mega-bottom-image {
      width: 80%;
      max-width: 400px;
    }
  }

  @media (max-width: 480px) {
    .mega-banner-section {
      min-height: 400px;
    }

    .mega-bottom-image {
      width: 90%;
      max-width: 300px;
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .mega-background-wrapper {
      transform: none !important;
    }
  }

  /* Performance optimizations */
  .mega-background-wrapper {
    will-change: transform;
    backface-visibility: hidden;
    perspective: 1000px;
  }

  /* Fallback loading placeholder */
  .mega-background-fallback {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    z-index: -1;
  }

  .loading-placeholder {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    border: 3px solid #f3f3f3;
    border-top: 3px solid #4523AE;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: translate(-50%, -50%) rotate(0deg); }
    100% { transform: translate(-50%, -50%) rotate(360deg); }
  }
</style>
