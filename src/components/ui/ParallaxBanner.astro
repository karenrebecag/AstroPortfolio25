---
// ParallaxBanner.astro - Banner strip con efecto parallax basado en v0newslettertemplate
import ParallaxBackgroundIsland from './ParallaxBackgroundIsland.tsx';

export interface Props {
  title?: string;
  subtitle?: string;
  backgroundSrc?: string;
  placeholder?: string;
  height?: string;
  className?: string;
}

const {
  title = "Aurin Task Manager",
  subtitle = "Streamline your workflow with AI-powered task management and intelligent automation",
  backgroundSrc = "/images/BannerImage.webp",
  placeholder = "/images/BGTexture.webp",
  height = "100vh",
  className = ""
} = Astro.props;
---

<section class={`parallax-banner-section ${className}`} style={`--banner-height: ${height}`}>
  <div class="parallax-banner-container">
    <!-- Background Island con efecto parallax -->
    <div class="parallax-background-wrapper">
      <ParallaxBackgroundIsland
        backgroundSrc={backgroundSrc}
        placeholder={placeholder}
        client:visible
      />
    </div>


    <!-- Contenido del banner -->
    <div class="parallax-content">
      <div class="parallax-content-inner">
        <h1 class="parallax-title">{title}</h1>
        <p class="parallax-subtitle">{subtitle}</p>
        
        <!-- Botones de acción opcionales -->
        <div class="parallax-actions">
          <slot name="actions" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .parallax-banner-section {
    position: relative;
    width: 100%;
    height: var(--banner-height, 100vh);
    min-height: 600px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    box-sizing: border-box;
  }

  .parallax-banner-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .parallax-background-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    overflow: hidden;
    background: hsl(var(--background));
    transition: filter 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark Mode: Apply grayscale filter */
  :global(.dark-mode) .parallax-background-wrapper {
    filter: grayscale(100);
  }

  .parallax-bottom-image {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    max-width: 800px;
    filter: drop-shadow(0 10px 15px rgba(0, 0, 0, 0.1)) drop-shadow(0 4px 6px rgba(0, 0, 0, 0.05));
    height: auto;
    z-index: 5;
    opacity: 0.9;
    pointer-events: none;
    overflow: hidden;
  }

  .parallax-bottom-image img {
    width: 100%;
    height: auto;
    object-fit: contain;
    object-position: bottom center;
    display: block;
  }

  .parallax-content {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    box-sizing: border-box;
    gap: 1rem;
  }

  .parallax-content-inner {
    text-align: center;
    max-width: 1500px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .parallax-title {
    font-family: var(--font-display, 'Median', serif);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: white;
    margin: 0;
    font-style: italic;
  }

  .parallax-subtitle {
    font-family: var(--font-primary, 'InterTight', sans-serif);
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    font-weight: 500;
    line-height: 1.1;
    color: rgba(255, 255, 255, 0.9);
    margin: 0;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.2);
    max-width: 600px;
    text-align: center;
  }

  .parallax-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .parallax-banner-section {
      min-height: 500px;
      padding: 0;
    }

    .parallax-content {
      padding: 1rem;
    }

    .parallax-actions {
      flex-direction: column;
      gap: 0.75rem;
    }

    .parallax-bottom-image {
      width: 80%;
      max-width: 400px;
    }
  }

  @media (max-width: 480px) {
    .parallax-banner-section {
      min-height: 400px;
    }

    .parallax-bottom-image {
      width: 90%;
      max-width: 300px;
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .parallax-background-wrapper {
      transform: none !important;
    }
  }

  /* Performance optimizations */
  .parallax-background-wrapper {
    will-change: transform;
    backface-visibility: hidden;
    perspective: 1000px;
  }
</style>
