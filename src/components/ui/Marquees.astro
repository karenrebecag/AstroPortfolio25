---
// Marquees.astro
import MarqueesIsland from './MarqueesIsland.tsx';
---

<section class="marquees-section">
  <div class="marquees-section-container">
    <div class="marquees-section-wrapper">
      <MarqueesIsland client:visible />
    </div>
  </div>
</section>

<style>
  .marquees-section {
    width: 100%;
    background: #FEFEFE;
    background-image: 
      linear-gradient(rgba(0, 0, 0, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.05) 1px, transparent 1px);
    background-size: 40px 40px;
    overflow: hidden;
    position: relative;
  }

  .marquees-section-container {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .marquees-section-wrapper {
    width: 100%;
    max-width: 1800px;
    position: relative;
    overflow: hidden;
  }

  /* Gradientes laterales para pantallas grandes */
  @media (min-width: 2560px) {
    .marquees-section-wrapper::before,
    .marquees-section-wrapper::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 120px;
      z-index: 10;
      pointer-events: none;
    }

    .marquees-section-wrapper::before {
      left: 0;
      background: linear-gradient(to right, #FEFEFE, transparent);
    }

    .marquees-section-wrapper::after {
      right: 0;
      background: linear-gradient(to left, #FEFEFE, transparent);
    }
  }

  :global(.marquees-container) {
    position: relative;
    width: 100%;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.marquee-wrapper) {
    position: absolute;
    width: 200%;
    height: 80px;
    display: flex;
    align-items: center;
    transform-origin: center;
    overflow: hidden;
  }

  :global(.first-marquee) {
    background: #7256c6;
    transform: rotate(5deg);
    z-index: 1;
  }

  :global(.second-marquee) {
    background: #000000;
    transform: rotate(-5deg);
    z-index: 2;
  }

  @media (max-width: 768px) {
    .marquees-section {
      background-size: 20px 20px;
    }
    
    :global(.marquees-container) {
      height: 150px;
    }
    
    :global(.marquee-wrapper) {
      height: 60px;
      width: 300%;
    }
    
    :global(.first-marquee) {
      transform: rotate(5deg);
    }

    :global(.second-marquee) {
      transform: rotate(-5deg);
    }
  }

  /* Accessibility: Respect user's motion preferences */
  @media (prefers-reduced-motion: reduce) {
    :global(.marquee-wrapper) {
      animation: none;
    }
    
    :global(.marquees-container) {
      /* Provide static fallback when motion is reduced */
      overflow: hidden;
    }
  }
</style>
