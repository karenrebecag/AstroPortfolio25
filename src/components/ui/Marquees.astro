---
// Marquees.astro
import MarqueesIsland from './MarqueesIsland.tsx';
---

<section class="marquees-section">
  <MarqueesIsland client:visible />
</section>

<style>
  .marquees-section {
    width: 100%;
    background: white;
    background-image: 
      linear-gradient(rgba(0, 0, 0, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.05) 1px, transparent 1px);
    background-size: 40px 40px;
    overflow: hidden;
    position: relative;
  }

  :global(.marquees-container) {
    position: relative;
    width: 100%;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.marquee-wrapper) {
    position: absolute;
    width: 200%;
    height: 80px;
    display: flex;
    align-items: center;
    transform-origin: center;
    overflow: hidden;
  }

  :global(.first-marquee) {
    background: #7256c6;
    transform: rotate(5deg);
    z-index: 1;
  }

  :global(.second-marquee) {
    background: #000000;
    transform: rotate(-5deg);
    z-index: 2;
  }

  @media (max-width: 768px) {
    .marquees-section {
      background-size: 20px 20px;
    }
    
    :global(.marquees-container) {
      height: 150px;
    }
    
    :global(.marquee-wrapper) {
      height: 60px;
      width: 300%;
    }
    
    :global(.first-marquee) {
      transform: rotate(5deg);
    }

    :global(.second-marquee) {
      transform: rotate(-5deg);
    }
  }

  /* Accessibility: Respect user's motion preferences */
  @media (prefers-reduced-motion: reduce) {
    :global(.marquee-wrapper) {
      animation: none;
    }
    
    :global(.marquees-container) {
      /* Provide static fallback when motion is reduced */
      overflow: hidden;
    }
  }
</style>
