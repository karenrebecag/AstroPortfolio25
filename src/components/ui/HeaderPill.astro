---
import MainButton from './MainButton.astro';
import LanguageSelectorWrapper from './LanguageSelectorWrapper.astro';
import { getLangFromUrl, t, languageOptions, useTranslatedPath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
---

<div class="header-pill">


  <div class="header-wrapper" id="headerWrapper">
    <header class="header" id="mainHeader">
      <div class="logo-section">
        <button class="back-btn" id="backBtn">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
        </button>
        <div class="logo" id="logoBtn">KAREN ORTIZ</div>
      </div>

      <div class="header-actions-wrapper">
        <div class="contact-btn-wrapper">
          <a href="#contact" class="contact-link">
            <MainButton text={t('nav.contact', lang)} />
          </a>
        </div>
        <LanguageSelectorWrapper />
        <div class="dark-mode-toggle-wrapper">
          <div id="darkModeToggle"></div>
        </div>
      </div>

      <button class="menu-btn" id="menuBtn">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </header>
  </div>
</div>

<div class="mobile-menu" id="mobileMenu">
  <div class="mobile-menu-content">
    <button class="mobile-close-btn" id="mobileCloseBtn">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x">
        <path d="m18 6-12 12"/>
        <path d="m6 6 12 12"/>
      </svg>
    </button>

  
  </div>
</div>

<style>
  .header-pill {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    width: calc(100% - 4rem);
    max-width: 800px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border-radius: 50px;
    transition: all 0.3s cubic-bezier(0.4, 0.0, 0.2, 1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
   
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .top-marquee-container {
    width: 100%;
    height: 24px;
    background-color: #7754cd;
    overflow: hidden;
    border-radius: 50px 50px 0 0;
  }

  .top-marquee {
    display: flex;
    white-space: nowrap;
    width: max-content;
    height: 100%;
    align-items: center;
    animation: marquee-scroll 20s linear infinite;
  }

  @keyframes marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .marquee-text {
    font-family: 'Boysen', var(--font-primary);
    font-size: 12px;
    font-weight: 400;
    color: white;
    letter-spacing: 0.5px;
    padding-right: 0;
  }

  .header-wrapper {
    width: 100%;
    background: transparent;
        border-radius: 50px;

    border-radius: 0 0 50px 50px;
  }

  .header-pill.scrolled {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
    border-color: rgba(204, 204, 204, 0.4);
  }

  :global(.header-pill.hidden) {
    transform: translateX(-50%) translateY(-100%) !important;
    pointer-events: none !important;
  }

  .header-pill:hover {
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0px 24px;
    position: relative;
    width: 100%;
  }

  @media (max-width: 768px) {
    .header-pill {
      top: 16px;
      width: calc(100% - 2rem);
      border-radius: 40px;
    }

    .top-marquee-container {
      height: 24px;
      border-radius: 40px 40px 0 0;
    }

    .header-wrapper {
      border-radius: 0 0 40px 40px;
    }

    .header {
      padding: 12px 24px;
    }

    .marquee-text {
      font-size: 11px;
    }
  }

  @media (max-width: 480px) {
    .header-pill {
      top: 12px;
      width: calc(100% - 1rem);
      border-radius: 30px;
    }

    .top-marquee-container {
      height: 22px;
      border-radius: 30px 30px 0 0;
    }

    .header-wrapper {
      border-radius: 0 0 30px 30px;
    }

    .header {
      padding: 10px 20px;
    }

    .marquee-text {
      font-size: 10px;
    }
  }

  .logo-section {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .back-btn {
    background: none;
    border: none;
    color: #060314;
    cursor: pointer;
    padding: 6px;
    border-radius: 50%;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .back-btn:hover {
    background: rgba(0, 0, 0, 0.05);
    color: #131019;
    transform: translateX(-2px);
  }

  .logo {
    color: #060314;
    font-family: var(--font-display);
    font-size: clamp(14px, 3vw, 20px);
    font-weight: 500;
    transition: color 0.3s ease, transform 0.2s ease;
    cursor: pointer;
  }

  .logo:hover {
    color: #131019;
    transform: scale(1.02);
  }

  .nav {
    display: flex;
    gap: 20px;
  }

  .nav a {
    color: #131019;
    font-family: var(--font-display);
    text-decoration: none;
    font-size: clamp(10px, 1.8vw, 13px);
    font-weight: 400;
    transition: color 0.3s ease, transform 0.2s ease;
    position: relative;
  }

  .nav a:hover {
    color: #060314;
    transform: translateY(-1px);
  }

  .nav a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background: #060314;
    border-radius: 1px;
    transition: width 0.3s ease;
  }

  .nav a:hover::after {
    width: 100%;
  }

  .header-actions-wrapper {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .contact-btn-wrapper {
    display: flex;
    align-items: center;
    scale: 0.65;
    transform-origin: center;
  }

  .contact-link {
    text-decoration: none;
    display: block;
  }

  .dark-mode-toggle-wrapper {
    display: flex;
    align-items: center;
    margin-left: 8px;
  }

  .dark-mode-toggle-btn {
    background: none;
    border: none;
    padding: 8px;
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dark-mode-toggle-btn:hover {
    background: rgba(0, 0, 0, 0.05);
    transform: scale(1.1);
  }

  .dark-mode-toggle-btn svg {
    width: 18px;
    height: 18px;
    color: #060314;
    transition: all 0.3s ease;
  }

  /* Dark mode styles for the toggle button */
  :global(.dark-mode .dark-mode-toggle-btn:hover) {
    background: rgba(255, 255, 255, 0.1);
  }

  :global(.dark-mode .dark-mode-toggle-btn svg) {
    color: #ffffff;
  }

  .menu-btn {
    display: none;
    flex-direction: column;
    gap: 2px;
    background: none;
    border: none;
    cursor: pointer;
    transition: transform 0.2s ease;
    padding: 6px;
  }

  .menu-btn:hover {
    transform: scale(1.1);
  }

  .menu-btn span {
    width: 16px;
    height: 2px;
    background: #060314;
    border-radius: 1px;
    transition: all 0.3s ease;
  }

  .menu-btn:hover span {
    background: #131019;
  }

  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(10px);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .mobile-menu.open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu-content {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
    width: 100%;
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 32px;
    text-align: center;
    transform: translateY(30px);
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .mobile-menu.open .mobile-nav {
    transform: translateY(0);
  }

  .mobile-nav a {
    color: white;
    font-family: var(--font-display);
    text-decoration: none;
    font-size: clamp(18px, 4vw, 24px);
    font-weight: 300;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    position: relative;
    opacity: 0;
    transform: translateY(20px);
  }

  .mobile-menu.open .mobile-nav a {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-nav a:nth-child(1) { transition-delay: 0.1s; }
  .mobile-nav a:nth-child(2) { transition-delay: 0.2s; }
  .mobile-nav a:nth-child(3) { transition-delay: 0.3s; }
  .mobile-nav a:nth-child(4) { transition-delay: 0.4s; }

  .mobile-nav a:hover {
    color: #ffffff;
    transform: scale(1.05);
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.5);
  }

  .mobile-nav a::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, white, transparent);
    transition: width 0.4s ease;
  }

  .mobile-nav a:hover::after {
    width: 100%;
  }

  .mobile-contact-btn {
    background: transparent;
    border: 2px solid white;
    color: white;
    padding: 12px 24px;
    font-family: var(--font-display);
    font-size: clamp(14px, 3vw, 16px);
    cursor: pointer;
    transition: color 0.1s ease, transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    overflow: hidden;
    margin-top: 24px;
    border-radius: 4px;
    opacity: 0;
    transform: translateY(20px);
    text-decoration: none;
    display: inline-block;
  }

  .mobile-menu.open .mobile-contact-btn {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.5s;
  }

  .mobile-contact-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: white;
    transition: left 0.3s ease;
    z-index: -1;
  }

  .mobile-contact-btn:hover::before {
    left: 0;
  }

  .mobile-menu .mobile-nav .mobile-contact-btn:hover {
    color: #000000 !important;
    position: relative;
    z-index: 1;
    transition: color 0.1s ease !important;
  }

  .mobile-contact-btn:hover,
  .mobile-nav a.mobile-contact-btn:hover {
    color: #000000 !important;
    transform: scale(1.05);
    box-shadow: 0 8px 25px rgba(255, 255, 255, 0.2);
    transition: color 0.1s ease, transform 0.3s ease, box-shadow 0.3s ease !important;
  }

  .mobile-menu .mobile-nav a.mobile-contact-btn:hover {
    color: #000000 !important;
  }

  .mobile-language-section {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.3s ease;
    transition-delay: 0.6s;
  }

  .mobile-menu.open .mobile-language-section {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-language-title {
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-display);
    font-size: 12px;
    text-align: center;
    margin-bottom: 16px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .mobile-language-list {
    max-height: 200px;
    overflow-y: auto;
    padding: 8px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.3) transparent;
  }

  .mobile-language-list::-webkit-scrollbar {
    width: 4px;
  }

  .mobile-language-list::-webkit-scrollbar-track {
    background: transparent;
  }

  .mobile-language-list::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 2px;
  }

  .mobile-language-option {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    color: white;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.2s ease;
    font-family: var(--font-display);
    font-size: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .mobile-language-option:last-child {
    border-bottom: none;
  }

  .mobile-language-option:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateX(4px);
  }

  .mobile-language-option.active {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    font-weight: 500;
  }

  .mobile-language-option .flag {
    font-size: 18px;
    line-height: 1;
  }

  .mobile-language-option .name {
    flex: 1;
    font-weight: 400;
  }

  .mobile-close-btn {
    position: absolute;
    top: 24px;
    right: 24px;
    background: none;
    border: none;
    color: white;
    cursor: pointer;
    padding: 8px;
    border-radius: 50%;
    transition: all 0.3s ease;
    opacity: 0;
    transform: rotate(-90deg) scale(0.8);
    z-index: 10;
  }

  .mobile-menu.open .mobile-close-btn {
    opacity: 1;
    transform: rotate(0deg) scale(1);
    transition-delay: 0.3s;
  }

  .mobile-close-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: rotate(90deg) scale(1.1);
    color: #ffffff;
  }

  .mobile-close-btn:active {
    transform: rotate(90deg) scale(0.95);
  }

  .mobile-close-btn svg {
    width: 24px;
    height: 24px;
    transition: all 0.2s ease;
  }

  @media (max-width: 480px) {
    .mobile-close-btn {
      top: 16px;
      right: 16px;
      padding: 6px;
    }

    .mobile-close-btn svg {
      width: 20px;
      height: 20px;
    }
  }

  @media (max-width: 1200px) {
    .nav {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .header-actions-wrapper {
      display: none;
    }

    .menu-btn {
      display: flex;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const headerPill = document.querySelector('.header-pill');
    let lastScrollY = window.scrollY;
    let isScrolling = false;

    const handleScroll = () => {
      if (!isScrolling) {
        window.requestAnimationFrame(() => {
          const currentScrollY = window.scrollY;
          const scrollDifference = currentScrollY - lastScrollY;

          if (!headerPill) return;

          if (currentScrollY > 80) {
            headerPill.classList.add('scrolled');
          } else {
            headerPill.classList.remove('scrolled');
          }

          if (scrollDifference > 5 && currentScrollY > 100) {
            if (!headerPill.classList.contains('hidden')) {
              headerPill.classList.add('hidden');

              const allHeaders = document.querySelectorAll('.header-pill');
              allHeaders.forEach((header) => {
                (header as HTMLElement).style.transition = 'transform 0.4s cubic-bezier(0.4, 0.0, 0.2, 1), opacity 0.4s cubic-bezier(0.4, 0.0, 0.2, 1)';
                (header as HTMLElement).style.transform = 'translateX(-50%) translateY(-100%)';
                (header as HTMLElement).style.opacity = '0';
              });

              setTimeout(() => {
                allHeaders.forEach((header) => {
                  (header as HTMLElement).style.display = 'none';
                });
              }, 400);
            }
          } else if (scrollDifference < -2 || currentScrollY < 80) {
            if (headerPill.classList.contains('hidden')) {
              headerPill.classList.remove('hidden');

              const allHeaders = document.querySelectorAll('.header-pill');
              allHeaders.forEach((header) => {
                (header as HTMLElement).style.display = '';
                (header as HTMLElement).style.transition = 'transform 0.5s cubic-bezier(0.23, 1, 0.32, 1), opacity 0.5s cubic-bezier(0.23, 1, 0.32, 1)';
                (header as HTMLElement).style.transform = 'translateX(-50%) translateY(-60px)';
                (header as HTMLElement).style.opacity = '0';
              });

              requestAnimationFrame(() => {
                requestAnimationFrame(() => {
                  allHeaders.forEach((header) => {
                    (header as HTMLElement).style.transform = 'translateX(-50%) translateY(0%)';
                    (header as HTMLElement).style.opacity = '1';
                  });
                });
              });
            }
          }

          lastScrollY = currentScrollY;
          isScrolling = false;
        });
      }
      isScrolling = true;
    };

    window.addEventListener('scroll', handleScroll, { passive: true });

    const allMenuBtns = document.querySelectorAll('.menu-btn');
    const mobileMenu = document.querySelector('.mobile-menu');
    const mobileNav = document.querySelector('.mobile-nav');
    const mobileNavLinks = document.querySelectorAll('.mobile-nav a');
    const contactBtn = document.querySelector('.mobile-contact-btn');

    let isOpen = false;

    const openMenu = () => {
      isOpen = true;
      mobileMenu?.classList.add('open');

      document.body.style.overflow = 'hidden';
      document.body.style.position = 'fixed';
      document.body.style.width = '100%';

      if (mobileNav) (mobileNav as HTMLElement).style.transform = 'translateY(30px)';
      mobileNavLinks.forEach(link => {
        const linkEl = link as HTMLElement;
        linkEl.style.opacity = '0';
        linkEl.style.transform = 'translateY(20px)';
      });
      if (contactBtn) {
        (contactBtn as HTMLElement).style.opacity = '0';
        (contactBtn as HTMLElement).style.transform = 'translateY(20px)';
      }

      setTimeout(() => {
        if (mobileNav) (mobileNav as HTMLElement).style.transform = 'translateY(0px)';
        mobileNavLinks.forEach((link, index) => {
          const linkEl = link as HTMLElement;
          setTimeout(() => {
            linkEl.style.opacity = '1';
            linkEl.style.transform = 'translateY(0px)';
          }, 100 + (index * 100));
        });
        if (contactBtn) {
          setTimeout(() => {
            (contactBtn as HTMLElement).style.opacity = '1';
            (contactBtn as HTMLElement).style.transform = 'translateY(0px)';
          }, 500);
        }
      }, 100);
    };

    const closeMenu = () => {
      isOpen = false;

      mobileNavLinks.forEach((link, index) => {
        const linkEl = link as HTMLElement;
        setTimeout(() => {
          linkEl.style.opacity = '0';
          linkEl.style.transform = 'translateY(-20px)';
        }, index * 50);
      });

      if (contactBtn) {
        setTimeout(() => {
          (contactBtn as HTMLElement).style.opacity = '0';
          (contactBtn as HTMLElement).style.transform = 'translateY(-20px)';
        }, 100);
      }

      if (mobileNav) {
        setTimeout(() => {
          (mobileNav as HTMLElement).style.transform = 'translateY(30px)';
        }, 200);
      }

      setTimeout(() => {
        mobileMenu?.classList.remove('open');

        document.body.style.overflow = '';
        document.body.style.position = '';
        document.body.style.width = '';
      }, 500);
    };

    allMenuBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      });
    });

    const mobileCloseBtn = document.querySelector('.mobile-close-btn');
    mobileCloseBtn?.addEventListener('click', () => {
      if (isOpen) {
        closeMenu();
      }
    });

    mobileMenu?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target && (target.tagName === 'A' || target.classList.contains('mobile-contact-btn'))) {
        closeMenu();
      }
    });

    mobileMenu?.addEventListener('click', (e) => {
      if (e.target === mobileMenu) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeMenu();
      }
    });

    const smoothScrollTo = (targetId: string) => {
      let target = document.getElementById(targetId);

      if (!target) {
        setTimeout(() => {
          target = document.getElementById(targetId);
          if (target) {
            const headerHeight = (headerPill as HTMLElement)?.offsetHeight || 0;
            const targetPosition = (target as HTMLElement).offsetTop - headerHeight - 20;

            window.scrollTo({
              top: targetPosition,
              behavior: 'smooth'
            });
          }
        }, 100);
        return;
      }

      const headerHeight = (headerPill as HTMLElement)?.offsetHeight || 0;
      const targetPosition = (target as HTMLElement).offsetTop - headerHeight - 20;

      window.scrollTo({
        top: targetPosition,
        behavior: 'smooth'
      });
    };

    const logoBtn = document.querySelector('.logo');
    logoBtn?.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });

    const backBtn = document.querySelector('.back-btn');
    backBtn?.addEventListener('click', () => {
      window.location.href = '/';
    });

    const desktopNavLinks = document.querySelectorAll('.nav a');
    desktopNavLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          const targetId = href.substring(1);
          smoothScrollTo(targetId);
        }
      });
    });

    const mobileScrollLinks = document.querySelectorAll('.mobile-nav a');
    mobileScrollLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          const targetId = href.substring(1);
          smoothScrollTo(targetId);
          closeMenu();
        }
      });
    });

    const contactLink = document.querySelector('.contact-link');
    contactLink?.addEventListener('click', (e) => {
      e.preventDefault();
      smoothScrollTo('contact');
    });

    // Dark Mode Toggle Functionality
    const createDarkModeToggle = () => {
      const toggleContainer = document.getElementById('darkModeToggle');
      if (!toggleContainer) return;

      let isDark = localStorage.getItem('aurin-theme') === 'dark';

      const updateUI = () => {
        if (isDark) {
          document.documentElement.classList.add('dark-mode');
          document.documentElement.classList.remove('light-mode');
        } else {
          document.documentElement.classList.add('light-mode');
          document.documentElement.classList.remove('dark-mode');
        }

        // Update button content
        toggleContainer.innerHTML = `
          <button class="dark-mode-toggle-btn" title="${isDark ? 'Switch to Light Mode' : 'Switch to Dark Mode'}">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              ${isDark ?
                '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>' :
                '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>'
              }
            </svg>
          </button>
        `;

        // Add click listener to new button
        const toggleBtn = toggleContainer.querySelector('.dark-mode-toggle-btn');
        toggleBtn?.addEventListener('click', toggleDarkMode);
      };

      const toggleDarkMode = () => {
        isDark = !isDark;
        localStorage.setItem('aurin-theme', isDark ? 'dark' : 'light');
        updateUI();

        // Trigger dark mode change for DarkModeContainer
        const event = new CustomEvent('darkModeChange', { detail: { isDark } });
        window.dispatchEvent(event);
      };

      // Initialize
      updateUI();
    };

    // Initialize dark mode toggle
    createDarkModeToggle();
  });
</script>