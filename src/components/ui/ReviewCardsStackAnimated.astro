---
// ReviewCardsStackAnimated.astro - Animated version with GSAP scroll animations
// Uses React Island for GSAP functionality

import ReviewCardsStackIsland from './ReviewCardsStackIsland.tsx';

export interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<ReviewCardsStackIsland 
  className={className}
  client:visible
/>

<style>
  /* Import island styles */
  @import '../../styles/review-cards-stack-island.css';

  /* Additional global styles if needed */
  :global(.review-cards-stack-island) {
    /* Ensure proper font loading */
    font-display: swap;
  }

  /* Font family utilities for the Island */
  :global(.font-display) {
    font-family: var(--font-display);
  }

  :global(.font-secondary) {
    font-family: var(--font-secondary);
  }

  :global(.font-primary) {
    font-family: var(--font-primary);
  }

  :global(.font-game) {
    font-family: var(--font-game);
  }
</style>
