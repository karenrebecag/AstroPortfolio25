---
// AurinWorkflow.astro - Process Workflow section with marquee cards
import WorkflowMarqueeIsland from './WorkflowMarqueeIsland.tsx';
---

<!-- Aurin Workflow Section -->
<section class="aurin-workflow-section">
  <div class="workflow-container">
    
    <!-- Header Section -->
    <div class="workflow-header">
      <div class="header-title">
        <div class="title-part-1 playfair-display-italic">Process</div>
        <div class="title-part-2">Workflow</div>
      </div>
      <div class="header-description">
        Business challenges are tough, but we have a proven record of elevating our partners to their next and best selves.
      </div>
    </div>

    <!-- Workflow Cards Marquee -->
    <div class="workflow-marquee-container">
      <div class="workflow-marquee-wrapper">
        <WorkflowMarqueeIsland client:visible />
      </div>
    </div>

  </div>
</section>

<style>
  /* Aurin Workflow Section */
  .aurin-workflow-section {
    width: 100%;
    background: #151515;
    padding: 95px 0;
    position: relative;
    overflow: hidden;
  }

  .workflow-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 45px;
  }

  /* Header Section */
  .workflow-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 64px;
    padding: 25px 80px;
    flex-wrap: wrap;
  }

  .header-title {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 20px;
    width: 531.66px;
  }

  .title-part-1 {
    color: white;
    font-size: clamp(32px, 5vw, 64px);
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 400;
    line-height: 1;
    word-wrap: break-word;
  }

  .title-part-2 {
    color: white;
    font-size: clamp(32px, 5vw, 64px);
    font-family: var(--font-primary, 'InterTight', sans-serif);
    font-weight: 400;
    line-height: 1;
    word-wrap: break-word;
  }

  .header-description {
    flex: 1;
    max-width: 688.84px;
    color: #BBBBBB;
    font-size: clamp(16px, 2vw, 20px);
    font-family: var(--font-primary, 'InterTight', sans-serif);
    font-weight: 400;
    line-height: 1.4;
    word-wrap: break-word;
  }

  /* Workflow Marquee Container */
  .workflow-marquee-container {
    width: 100%;
    padding: 0 80px;
  }

  .workflow-marquee-wrapper {
    width: 100%;
    overflow: hidden;
    position: relative;
    mask: linear-gradient(
      to right,
      transparent 0%,
      black 5%,
      black 95%,
      transparent 100%
    );
    -webkit-mask: linear-gradient(
      to right,
      transparent 0%,
      black 5%,
      black 95%,
      transparent 100%
    );
  }

  /* Workflow Card Styles */
  :global(.workflow-marquee) {
    display: flex;
    animation: workflowMarqueeScroll 60s linear infinite;
    will-change: transform;
  }

  :global(.workflow-set) {
    display: flex;
    gap: 40px;
    flex-shrink: 0;
  }

  :global(.workflow-card) {
    width: 556px;
    min-height: 268px;
    padding: 35px 25px;
    background: #212121;
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 20px;
    flex-shrink: 0;
    position: relative;
  }

  :global(.workflow-header) {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  :global(.workflow-title) {
    flex: 1;
    color: white;
    font-size: clamp(24px, 3vw, 40px);
    font-family: var(--font-display, 'Median', serif);
    font-weight: 400;
    line-height: 1.3;
    word-wrap: break-word;
  }

  :global(.workflow-number) {
    color: #808080;
    font-size: clamp(24px, 3vw, 40px);
    font-family: var(--font-display, 'Median', serif);
    font-weight: 400;
    line-height: 1.3;
    text-align: right;
    word-wrap: break-word;
  }

  :global(.workflow-content) {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    width: 100%;
    height: 180px;
    position: relative;
  }

  :global(.workflow-gravity-container) {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  :global(.workflow-gravity-container canvas) {
    position: absolute !important;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    pointer-events: none;
  }

  :global(.workflow-task-gravity) {
    transition: all 0.2s ease;
    will-change: transform;
  }

  :global(.workflow-task-gravity:hover) {
    transform: scale(1.05);
    cursor: grab !important;
  }

  :global(.workflow-task-gravity:active) {
    cursor: grabbing !important;
    transform: scale(0.95);
  }

  :global(.workflow-gravity-container canvas) {
    cursor: default !important;
  }

  :global(.workflow-gravity-container:hover) {
    cursor: default !important;
  }

  /* Marquee Animation */
  @keyframes workflowMarqueeScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .workflow-header {
      gap: 3rem;
      padding: 25px 40px;
    }

    .header-title {
      width: auto;
      flex-direction: column;
      gap: 10px;
    }

    :global(.workflow-card) {
      width: 480px;
      padding: 30px 20px;
    }

    .workflow-marquee-container {
      padding: 0 40px;
    }
  }

  @media (max-width: 768px) {
    .aurin-workflow-section {
      padding: 60px 0;
    }

    .workflow-header {
      flex-direction: column;
      gap: 2rem;
      padding: 25px 20px;
    }

    .header-title {
      width: 100%;
      text-align: center;
    }

    .header-description {
      max-width: 100%;
      text-align: center;
    }

    .workflow-marquee-container {
      padding: 0 20px;
    }

    :global(.workflow-card) {
      width: 320px;
      min-height: 240px;
      padding: 25px 20px;
    }

    :global(.workflow-content) {
      gap: 40px;
    }

    :global(.workflow-task) {
      width: 240px;
      font-size: clamp(11px, 1.4vw, 14px);
    }

    :global(.workflow-marquee) {
      animation-duration: 45s;
    }

    :global(.workflow-set) {
      gap: 30px;
    }
  }

  @media (max-width: 480px) {
    .aurin-workflow-section {
      padding: 40px 0;
    }

    .workflow-header {
      padding: 20px 15px;
    }

    .workflow-marquee-container {
      padding: 0 15px;
    }

    :global(.workflow-card) {
      width: 280px;
      min-height: 220px;
      padding: 20px 15px;
    }

    :global(.workflow-task) {
      width: 200px;
      font-size: 12px;
    }

    :global(.workflow-marquee) {
      animation-duration: 35s;
    }

    :global(.workflow-set) {
      gap: 20px;
    }
  }

  /* Reduce motion for accessibility */
  @media (prefers-reduced-motion: reduce) {
    :global(.workflow-marquee) {
      animation: none;
    }
    
    .workflow-marquee-wrapper {
      overflow-x: auto;
      scroll-behavior: smooth;
    }
    
    :global(.workflow-marquee) {
      justify-content: flex-start;
      gap: 40px;
    }
  }
</style>
