---
import ReviewsIsland from './ReviewsIsland.tsx';
---

<section class="reviews-section">
  <!-- Reviews content -->
  <div class="reviews-content">
    <ReviewsIsland client:visible />
  </div>
</section>

<style>
  .reviews-section {
    width: 100%;
    background: transparent;
    position: relative;
    padding: 80px 0 120px 0;
  }

  .reviews-content {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Reviews Marquee */
  :global(.reviews-marquee-wrapper) {
    width: 100%;
    overflow: hidden;
    position: relative;
    mask: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    -webkit-mask: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  :global(.reviews-marquee) {
    display: flex;
    animation: marqueeScroll 60s linear infinite;
    will-change: transform;
  }

  :global(.reviews-set) {
    display: flex;
    gap: 2rem;
    flex-shrink: 0;
  }

  /* Review Card Marquee */
  :global(.review-card-marquee) {
    width: 400px;
    flex-shrink: 0;
  }

  :global(.card-inner) {
    position: relative;
    border: 2px solid transparent;
    padding-bottom: 50px;
    border-radius: 45px;
    padding: 2.5rem;
    background: linear-gradient(135deg, #141022 0%, #141022 50%, #141022 100%);
    background-clip: padding-box;
  }

  /* Gradient border */
  :global(.gradient-border) {
    position: absolute;
    inset: -2px;
    border-radius: 45px;
    background: linear-gradient(71deg, #333333, #ffffff, #333333);
    z-index: -1;
  }

  /* Profile Section */
  :global(.profile-section) {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  :global(.profile-pic) {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid #ffffff;
    flex-shrink: 0;
  }

  :global(.profile-pic img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.reviewer-name) {
    font-family: var(--font-display); /* Median */
    font-size: 1.5rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.02em;
  }

  /* Review Description */
  :global(.review-description) {
    font-family: var(--font-primary); /* InterTight */
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    max-width: 100%;
  }

  /* Marquee Animation */
  @keyframes marqueeScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Reduce motion for accessibility */
  @media (prefers-reduced-motion: reduce) {
    :global(.reviews-marquee) {
      animation: none;
    }
    
    :global(.reviews-marquee-wrapper) {
      overflow-x: auto;
      scroll-behavior: smooth;
    }
    
    :global(.reviews-marquee) {
      justify-content: flex-start;
      gap: 2rem;
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .reviews-section {
      padding: 60px 0 80px 0;
    }
    
    .reviews-content {
      padding: 0 1rem;
    }

    :global(.review-card-marquee) {
      width: 350px;
    }

    :global(.reviews-set) {
      gap: 1.5rem;
    }

    :global(.reviews-marquee) {
      animation-duration: 45s;
    }

    :global(.card-inner) {
      padding: 2rem;
    }

    :global(.reviewer-name) {
      font-size: 1.25rem;
    }

    :global(.review-description) {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    :global(.review-card-marquee) {
      width: 300px;
    }

    :global(.reviews-set) {
      gap: 1rem;
    }

    :global(.reviews-marquee) {
      animation-duration: 35s;
    }

    :global(.card-inner) {
      padding: 1.5rem;
    }

    :global(.profile-pic) {
      width: 50px;
      height: 50px;
    }

    :global(.profile-section) {
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }

    :global(.reviewer-name) {
      font-size: 1.1rem;
    }

    :global(.review-description) {
      font-size: 0.85rem;
    }
  }
</style>
