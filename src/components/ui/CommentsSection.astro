---
// CommentsSection.astro - Wrapper component for comments
import CommentsWithToast from './CommentsWithToast.tsx';
import { TextDisperseBlack } from './TextDisperseBlack.tsx';
import { AnimatedCommentsWrapper, AnimatedCommentsHeader, AnimatedCommentsContent } from './AnimatedCommentsWrapper.tsx';
import { getLangFromUrl } from '../../i18n/utils.js';
import { translations } from '../../i18n/translations.js';

export interface Props {
  className?: string;
  title?: string;
  subtitle?: string;
  storyId: string;
}

// Get current language and translations
const lang = getLangFromUrl(Astro.url);
const t = translations[lang as keyof typeof translations]?.commentsSection || translations.en.commentsSection;

const { 
  className = '',
  title = t.title,
  subtitle = t.subtitle,
  storyId
} = Astro.props;
---

<!-- Comments Section with standardized styling -->
<section class={`content-section comments-section ${className}`} id="comments">
  <!-- Astro Islands Architecture: React Island for animations -->
  <AnimatedCommentsWrapper client:visible>
    <AnimatedCommentsHeader client:visible>
      <h2 class="section-title">
        <TextDisperseBlack text={title} client:load />
      </h2>
      <p class="section-subtitle">{subtitle}</p>
    </AnimatedCommentsHeader>
    
    <!-- Reddit-style Comments Island - loads only when visible -->
    <AnimatedCommentsContent client:visible>
      <CommentsWithToast client:visible storyId={storyId} />
    </AnimatedCommentsContent>
  </AnimatedCommentsWrapper>
</section>

<style>
  .comments-section {
    /* Use the same background pattern as other sections */
    background: #fdfdfd;
    position: relative;
    overflow: hidden;
  }

  .section-container {
    padding: 3em 0px;
    position: relative;
    background-color: #fdfdfd;
    background-image: 
      linear-gradient(rgba(0, 0, 0, 0.020) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.020) 1px, transparent 1px);
    background-size: 20px 20px;
    transition: 
      background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      background-image 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark Mode Styles */
  :global(.dark-mode .section-container) {
    background-color: #050112;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
  }

  :global(.dark-mode .comments-section) {
    background: #050112;
  }

  .section-header {
    text-align: center;
    margin-bottom: clamp(40px, 6vw, 80px);
    padding-top: clamp(60px, 8vw, 120px);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 6vw, 48px);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-tight);
    color: #1a1a1a;
    margin-bottom: 16px;
    letter-spacing: var(--tracking-tight);
  }

  .section-subtitle {
    font-family: var(--font-primary);
    font-size: clamp(16px, 3vw, 20px);
    font-weight: var(--font-weight-normal);
    line-height: var(--leading-relaxed);
    color: #666666;
    max-width: 600px;
    margin: 0 auto;
  }

  .comments-island-wrapper {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 60px 0;
  }

  @media (max-width: 768px) {
    .comments-island-wrapper {
      padding-left: 0;
      padding-right: 0;
      padding-top: 40px;
      padding-bottom: 40px;
    }
  }

  /* Center Discussion title in all viewports */
  :global(.comments-island-wrapper .relative.flex.cursor-pointer) {
    justify-content: center !important;
  }

  /* Dark mode support */
  @media (prefers-color-scheme: dark) {
    .comments-section {
      background: #171523;
    }

    .comments-section::before {
      background-image: 
        linear-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    }

    .section-title {
      color: #111111;
    }

    .section-subtitle {
      color: #111111;
    }
  }

  /* Mobile optimizations */
  @media (max-width: 768px) {
    .section-header {
      margin-bottom: clamp(30px, 8vw, 50px);
    }
  }
  .comments-island-wrapper:empty::before {
    content: '';
    display: block;
    width: 100%;
    height: 200px;
    background: linear-gradient(90deg, 
      rgba(156, 163, 175, 0.1) 25%, 
      rgba(156, 163, 175, 0.2) 50%, 
      rgba(156, 163, 175, 0.1) 75%
    );
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
    border-radius: 8px;
  }

  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

  /* Ensure proper spacing with other sections */
  .comments-section + section,
  section + .comments-section {
    margin-top: 0;
  }

  /* Typography consistency */
  .comments-section {
    font-family: var(--font-primary);
  }

  /* Animation support */
  .comments-section * {
    box-sizing: border-box;
  }

  /* Accessibility improvements */
  .comments-section:focus-within {
    outline: none;
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .comments-section {
      border-top: 1px solid currentColor;
      border-bottom: 1px solid currentColor;
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .comments-island-wrapper:empty::before {
      animation: none;
    }
  }
</style>

<script>
  // Register the component for client-side hydration
  if (typeof window !== 'undefined') {
    // Component will be hydrated by Astro's client:visible directive
    console.log('Comments section loaded');
  }
</script>
