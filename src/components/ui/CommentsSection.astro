---
// CommentsSection.astro - Wrapper component for comments
import { CommentsWithToast } from '../modules/Comments';
import { TextDisperseBlack } from './TextDisperseBlack.tsx';
import { AnimatedCommentsWrapper, AnimatedCommentsHeader, AnimatedCommentsContent } from '../modules/Comments/components/AnimatedCommentsWrapper.tsx';
import { getLangFromUrl } from '../../i18n/utils.js';
import { translations } from '../../i18n/translations.js';

export interface Props {
  className?: string;
  title?: string;
  subtitle?: string;
  storyId: string;
}

// Get current language and translations
const lang = getLangFromUrl(Astro.url);
const t = translations[lang as keyof typeof translations]?.commentsSection || translations.en.commentsSection;

const { 
  className = '',
  title = t.title,
  subtitle = t.subtitle,
  storyId
} = Astro.props;
---

<!-- Comments Section with standardized styling -->
<section class={`content-section comments-section ${className}`} id="comments">
  <!-- Astro Islands Architecture: React Island for animations -->
  <AnimatedCommentsWrapper client:visible>
    <AnimatedCommentsHeader client:visible>
      <h2 class="section-title">
        <TextDisperseBlack text={title} client:load />
      </h2>
      <p class="section-subtitle">{subtitle}</p>
    </AnimatedCommentsHeader>
    
    <!-- Reddit-style Comments Island - loads only when visible -->
    <AnimatedCommentsContent client:visible>
      <CommentsWithToast client:visible storyId={storyId} />
    </AnimatedCommentsContent>
  </AnimatedCommentsWrapper>
</section>

<style>
  /* ==============================================
     COMMENTS SECTION - CENTRALIZED STYLES
     Following Dark Mode Standards from DarkMode.md
     ============================================== */


        :global(.section-header) {
          margin-bottom: 1rem;
          text-align: center;

      }
  /* Main Comments Section Container */
  :global(.comments-section) {
    position: relative;
    overflow: hidden;
    padding: 6rem 10rem;
    font-family: var(--font-primary);
  }

  :global(.dark-mode .comments-section) {
    background: #111111;
  }

  /* Content Section Background */
  :global(.content-section) {
    background-size: 20px 20px;
  }

  :global(.dark-mode .content-section) {
    border-bottom-color: #333333;
  }

  /* Reddit Comments Container */
  :global(.reddit-comments-container) {
    margin: 0 auto;
    background-color: #ffffff;
    border-radius: 50px;
    padding: 50px;
    font-family: var(--font-primary);
    position: relative;
    transition: 
      background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      border-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .reddit-comments-container) {
    background-color: #e6eaff04;
    border: 1px solid rgba(51, 51, 51, 0.617)
  }

  /* ==============================================
     COMMENT ITEMS & STRUCTURE
     ============================================== */

  /* Comment Item */
  :global(.comment-item) {
    margin-bottom: 0.75rem;
  }

  :global(.comment-item.nested) {
    margin-left: 1.25rem;
    padding-left: 1rem;
    border-left: 2px solid #e5e7eb;
    position: relative;
  }

  :global(.dark-mode .comment-item.nested) {
    border-left-color: #333333;
  }

  :global(.comment-item.nested::before) {
    content: '';
    position: absolute;
    left: -1px;
    top: 0;
    bottom: 0;
    width: 2px;
  }


  /* Comment Card */
  :global(.comment-card) {
    background: transparent;
    border-radius: 12px;
    padding: 1rem;
    transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.comment-card:hover) {
    background: rgba(0, 0, 0, 0.02);
  }

  :global(.dark-mode .comment-card:hover) {
    background: rgba(255, 255, 255, 0.05);
  }

  /* ==============================================
     AVATARS
     ============================================== */

  /* Comment Avatar */
  :global(.comment-avatar) {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-family: var(--font-secondary);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-xs);
    flex-shrink: 0;
    border: 2px solid #ffffff;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: all 0.2s ease;
  }

  :global(.dark-mode .comment-avatar) {
    border-color: #333333;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  :global(.comment-avatar.clickable) {
    cursor: pointer;
    border: 2px dashed #9D7FC1;
  }

  :global(.comment-avatar.clickable:hover) {
    border-color: #4523AE;
    transform: scale(1.05);
  }

  :global(.comment-avatar.comment-avatar-empty) {
    background: #f3f4f6 !important;
    border: 2px dashed #d1d5db !important;
  }

  :global(.dark-mode .comment-avatar.comment-avatar-empty) {
    background: #333333 !important;
    border: 2px dashed #555555 !important;
  }

  :global(.comment-avatar.comment-avatar-empty:hover) {
    border-color: #4523AE !important;
    background: #f9fafb !important;
  }

  :global(.dark-mode .comment-avatar.comment-avatar-empty:hover) {
    border-color: #4523AE !important;
    background: #444444 !important;
  }

  :global(.upload-icon) {
    width: 16px;
    height: 16px;
    color: #9ca3af;
    transition: all 0.2s ease;
  }

  :global(.dark-mode .upload-icon) {
    color: #666666;
  }

  :global(.comment-avatar.comment-avatar-empty:hover .upload-icon) {
    color: #4523AE;
    transform: scale(1.1);
  }

  /* Avatar Upload Components */
  :global(.avatar-upload-container) {
    position: relative;
    width: 60px;
    height: 60px;
    flex-shrink: 0;
  }

  :global(.avatar-file-input) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  :global(.avatar-upload-label) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    border: 2px solid #e5e7eb;
  }

  :global(.dark-mode .avatar-upload-label) {
    border-color: #333333;
  }

  :global(.avatar-upload-label:hover) {
    transform: scale(1.05);
    border-color: #9D7FC1;
  }

  :global(.avatar-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  :global(.avatar-placeholder) {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #f9fafb;
    color: #6b7280;
    font-size: 0.75rem;
    font-weight: 500;
    gap: 0.25rem;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .avatar-placeholder) {
    background: #333333;
    color: #999999;
  }

  :global(.avatar-upload-label:hover .avatar-placeholder) {
    background: #f3f4f6;
    color: #9D7FC1;
  }

  :global(.dark-mode .avatar-upload-label:hover .avatar-placeholder) {
    background: #444444;
    color: #9D7FC1;
  }

  /* ==============================================
     COMMENT HEADER, CONTENT & ACTIONS
     ============================================== */

  /* Comment Header */
  :global(.comment-header) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    flex-wrap: wrap;
  }

  :global(.comment-author) {
    font-family: 'Median', var(--font-display);
    font-weight: var(--font-weight-semibold);
    font-size: var(--text-sm);
    color: #1f2937;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .comment-author) {
    color: #ffffff;
  }

  :global(.comment-timestamp) {
    font-size: var(--text-xs);
    color: #6b7280;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .comment-timestamp) {
    color: #999999;
  }

  :global(.comment-separator) {
    font-size: var(--text-xs);
    color: #9ca3af;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .comment-separator) {
    color: #666666;
  }

  :global(.comment-badge) {
    background: linear-gradient(135deg, #9D7FC1, #4523AE);
    color: white;
    padding: 0.125rem 0.5rem;
    border-radius: 12px;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    font-family: var(--font-primary);
  }

  /* Comment Content */
  :global(.comment-content) {
    font-family: var(--font-primary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: #374151;
    margin-bottom: 0.75rem;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .comment-content) {
    color: #e5e5e5;
  }

  /* Comment Actions */
  :global(.comment-actions) {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  :global(.comment-action-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-primary);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    color: #6b7280;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: 32px;
  }

  :global(.dark-mode .comment-action-btn) {
    color: #999999;
  }

  :global(.comment-action-btn:hover) {
    background: rgba(0, 0, 0, 0.05);
    border: 1px solid transparent;
    color: #374151;
    transform: translateY(-1px);
  }

  :global(.dark-mode .comment-action-btn:hover) {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  :global(.comment-action-btn.liked) {
    color: #dc2626;
  }

  :global(.comment-action-btn.liked:hover) {
    background: #fee2e243;
    color: #dc2626;
  }

  :global(.comment-action-btn.icon-only) {
    width: 32px;
    height: 32px;
    padding: 0;
    justify-content: center;
  }

  :global(.comment-action-btn svg) {
    width: 14px;
    height: 14px;
  }

  :global(.comment-collapse-btn) {
    margin-left: auto;
  }

  :global(.section-header) {
    text-align: center;
    margin-bottom: clamp(40px, 6vw, 80px);
    padding-top: clamp(60px, 8vw, 120px);
    background: transparent;
    transition: 
      background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .section-header) {
    background: transparent;
  }

  /* ==============================================
     FORM STYLES & INPUTS
     ============================================== */

  /* Add Comment Title */
  :global(.add-comment-title) {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: #1f2937;
    margin-bottom: 1rem;
    padding: 0 0.5rem;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .add-comment-title) {
    color: #ffffff;
  }

  :global(.add-comment-hint) {
    font-family: 'InterTight', var(--font-primary);
    font-weight: 300;
    font-size: var(--text-sm);
    color: #6b7280;
    margin-top: 0.5rem;
    margin-bottom: 0;
    line-height: var(--leading-relaxed);
    opacity: 0.9;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .add-comment-hint) {
    color: #999999;
  }

  /* Form Cards */
  :global(.comment-form-card) {
    background: #ffffff0f;
    border: 1px solid #e5e7eb9e;
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    transition: 
      background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      border-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .comment-form-card) {
    background-color: #e6eaff04;
    border-color: #33333324;
  }

  :global(.comment-form-row) {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  :global(.comment-form-content) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Input Styles */
  :global(.comment-input) {
    width: 100%;
    font-family: 'InterTight', var(--font-primary);
    font-weight: 300;
    font-size: var(--text-sm);
    border: 1px solid #d1d5db4a;
    background: #ffffff;
    color: #1f2937;
    border-radius: 5px;
    padding: 10px;
    transition: all 0.2s ease;
  }

  :global(.dark-mode .comment-input) {
    background-color: #e6eaff04;
    color: #ffffff;
    border-color: hsla(0, 0%, 33%, 0.355);
  }

  :global(.comment-input:focus) {
    outline: none;
    border-color: #bfb8d6;
    box-shadow: 0 0 0 3px rgba(69, 35, 174, 0.1);
  }

  :global(.dark-mode .comment-input:focus) {
    border-color: #9D7FC1;
  }

  :global(.comment-textarea) {
    min-height: 100px;
    resize: vertical;
    padding: 10px;
    font-family: var(--font-primary);
    line-height: var(--leading-relaxed);
  }

  /* Reply Form */
  :global(.reply-form) {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #e5e7eb;
    transition: border-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .reply-form) {
    border-top-color: #333333;
  }

  :global(.reply-form-row) {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  :global(.reply-form-content) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  :global(.reply-textarea) {
    min-height: 80px;
    resize: vertical;
  }

  :global(.reply-buttons) {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: flex-end;
  }

  /* Submit Buttons */
  :global(.comment-submit-buttons) {
    display: flex;
    gap: 0.75rem;
    align-items: end;
    justify-content: flex-end;
  }

  /* ==============================================
     MAINBUTTON COMPONENT STYLES
     From MainButton.astro - Realistic Design with Magnetic Effect
     ============================================== */

  :global(.realism-button-wrapper) {
    position: relative;
    display: inline-block;
    opacity: 1;
    transform: translateY(0) scale(0.7);
    transition: transform 0.2s ease-out;
  }

  :global(.realism-button) {
    position: relative;
    padding: 2px;
    border-radius: 16px;
    border: none;
    cursor: pointer;
    background: radial-gradient(circle 80px at 80% -10%, #ffffff, #181b1b);
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    font-size: clamp(16px, 2.8vw, 22px);
    overflow: visible;
    text-decoration: none;
    display: inline-block;
    color: inherit;
  }

  :global(.realism-button:visited) {
    color: inherit;
  }

  :global(.realism-button:disabled) {
    opacity: 0.6;
    cursor: not-allowed;
    pointer-events: none;
  }

  :global(.button-glow) {
    position: absolute;
    top: 0;
    right: 0;
    width: 65%;
    height: 60%;
    border-radius: 120px;
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.22);
    transition: all 0.3s ease-out;
    z-index: -1;
  }

  :global(.dark-mode .button-glow) {
    box-shadow: 0 0 20px rgba(255, 245, 250, 0.22);
  }

  :global(.button-blob) {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 50px;
    height: 50%;
    border-radius: 17px;
    background: radial-gradient(circle 60px at 0% 100%, #3fff75, rgba(0, 255, 128, 0.31), transparent);
    box-shadow: -2px 9px 40px rgba(0, 255, 45, 0.25);
    transition: all 0.3s ease-out;
    z-index: 1;
  }

  :global(.dark-mode .button-blob) {
    background: radial-gradient(circle 60px at 0% 100%, #ff75c3, rgba(255, 128, 192, 0.31), transparent);
    box-shadow: -2px 9px 40px rgba(255, 45, 150, 0.25);
  }

  :global(.button-content) {
    position: relative;
    padding: clamp(12px, 2.2vw, 16px) clamp(20px, 4vw, 28px);
    border-radius: 14px;
    color: white;
    background: radial-gradient(circle 80px at 80% -50%, #777777, #0f1111);
    z-index: 10;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
  }

  :global(.button-text) {
    font-family: var(--font-display);
    font-weight: 500;
    text-shadow: 0px 2px 8px rgba(0, 0, 0, 0.6);
    letter-spacing: -0.025em;
    position: relative;
    z-index: 2;
  }

  :global(.inner-glow) {
    position: absolute;
    inset: 0;
    border-radius: 14px;
    background: radial-gradient(circle 60px at 0% 100%, rgba(0, 225, 255, 0.1), rgba(0, 0, 255, 0.067), transparent);
    z-index: 1;
    transition: opacity 0.3s ease;
  }

  :global(.dark-mode .inner-glow) {
    background: radial-gradient(circle 60px at 0% 100%, rgba(255, 150, 225, 0.1), rgba(255, 100, 200, 0.067), transparent);
  }

  /* MainButton Hover Effects */
  :global(.realism-button:hover .button-glow) {
    box-shadow: 0 0 40px rgba(255, 255, 255, 0.38);
  }

  :global(.dark-mode .realism-button:hover .button-glow) {
    box-shadow: 0 0 40px rgba(255, 240, 245, 0.38);
  }

  :global(.realism-button:hover .button-blob) {
    width: 90px;
    box-shadow: -4px 1px 45px rgba(0, 255, 45, 0.38);
  }

  :global(.dark-mode .realism-button:hover .button-blob) {
    box-shadow: -4px 1px 45px rgba(255, 45, 150, 0.38);
  }

  :global(.realism-button:hover .button-content) {
    transform: scale(1.09);
  }

  :global(.realism-button:hover .inner-glow) {
    opacity: 1.5;
    background: radial-gradient(circle 80px at 0% 100%, rgba(0, 225, 255, 0.15), rgba(0, 0, 255, 0.1), transparent);
  }

  :global(.dark-mode .realism-button:hover .inner-glow) {
    background: radial-gradient(circle 80px at 0% 100%, rgba(255, 150, 225, 0.15), rgba(255, 100, 200, 0.1), transparent);
  }

  :global(.realism-button:hover .button-text) {
    text-shadow: 0px 2px 12px rgba(0, 0, 0, 0.8);
  }

  :global(.realism-button:active) {
    transform: scale(0.98);
    transition: all 0.1s ease-out;
  }

  :global(.realism-button:active .button-content) {
    transform: scale(1.08);
  }

  :global(.realism-button:focus-visible) {
    outline: 2px solid rgba(63, 255, 117, 0.5);
    outline-offset: 4px;
  }

  :global(.dark-mode .realism-button:focus-visible) {
    outline: 2px solid rgba(255, 117, 200, 0.5);
  }

  /* MainButton Enhanced glow effects */
  :global(.realism-button::before) {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 18px;
    background: linear-gradient(45deg, 
      rgba(255, 255, 255, 0.1), 
      transparent, 
      rgba(63, 255, 117, 0.1));
    z-index: -2;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  :global(.dark-mode .realism-button::before) {
    background: linear-gradient(45deg, 
      rgba(255, 245, 250, 0.1), 
      transparent, 
      rgba(255, 117, 200, 0.1));
  }

  :global(.realism-button:hover::before) {
    opacity: 1;
  }

  /* ==============================================
     SECONDARYBUTTON COMPONENT STYLES
     From SecondaryButton.astro - Modern Glass Design
     ============================================== */

  :global(.glass-button-wrap) {
    position: relative;
    display: inline-block;
    cursor: pointer;
    border-radius: 10px;
    opacity: 1;
    transform: translateY(0) scale(0.7);
    transition: transform 0.2s ease-out;
  }

  :global(.glass-button) {
    position: relative;
    isolation: isolate;
    all: unset;
    cursor: pointer;
    border-radius: 15px;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    overflow: hidden;
    font-size: clamp(16px, 2.8vw, 22px);
    font-weight: 500;
    background: rgba(255, 255, 255, 0.05);
    box-shadow: 
      0 8px 32px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  :global(.glass-button:disabled) {
    opacity: 0.6;
    cursor: not-allowed;
    pointer-events: none;
  }

  :global(.glass-button-text) {
    position: relative;
    display: block;
    user-select: none;
    letter-spacing: -0.025em;
    color: white;
    font-family: var(--font-display);
    text-shadow: 0px 2px 8px rgba(0, 0, 0, 0.6);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: clamp(12px, 2.2vw, 16px) clamp(20px, 4vw, 28px);
  }

  :global(.glass-button-shadow) {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: 9999px;
    background: linear-gradient(135deg, 
      rgba(255, 255, 255, 0.1) 0%, 
      transparent 50%, 
      rgba(0, 0, 0, 0.1) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
