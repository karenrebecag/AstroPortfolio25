---
export interface Props {
  loadingText?: string;
}

const { loadingText = "Loading" } = Astro.props;
---

<div id="preloader" class="preloader">
  <svg viewBox="0 0 1000 1000" preserveAspectRatio="none">
    <path
      id="curve-path"
      d="M0,1005S175,995,500,995s500,5,500,5V0H0Z"
    />
  </svg>
  <div class="preloader-heading">
    <div class="load-text">
      {loadingText.split('').map((letter, index) => (
        <span style={`animation-delay: ${index * 0.1}s`}>{letter}</span>
      ))}
    </div>
  </div>
</div>

<style>
  @font-face {
    font-family: 'VideoGameFont';
    src: url('/fonts/Video Game Font.otf') format('opentype');
    font-display: swap;
  }

  /* Block scroll during preloader */
  body.preloader-active {
    overflow: hidden;
    height: 100vh;
  }

  .preloader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    animation: slidePreloader 0.8s ease-in-out 2.5s forwards;
  }

  .preloader svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .preloader path {
    fill: #000;
    animation:
      morphToCurve 0.5s ease-in 1.5s forwards,
      morphToFlat 0.5s ease-out 2s forwards;
  }

  .preloader-heading {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .load-text {
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 400;
    color: white;
    font-family: 'VideoGameFont', monospace;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    animation: textFadeOut 0.5s ease-in 1.5s forwards;
  }

  .load-text span {
    display: inline-block;
    opacity: 0;
    transform: translateY(20px);
    animation: letterFadeIn 0.5s ease-out forwards;
  }

  /* Keyframe animations */
  @keyframes letterFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes textFadeOut {
    to {
      opacity: 0;
      transform: translateY(-100px);
    }
  }

  @keyframes morphToCurve {
    to {
      d: path("M0 502S175 272 500 272s500 230 500 230V0H0Z");
    }
  }

  @keyframes morphToFlat {
    to {
      d: path("M0 2S175 1 500 1s500 1 500 1V0H0Z");
    }
  }

  @keyframes slidePreloader {
    to {
      transform: translateY(-100vh);
    }
  }

  /* Hide preloader completely after animation */
  @keyframes hidePreloader {
    to {
      display: none;
      z-index: -1;
    }
  }

  .preloader::after {
    content: '';
    position: absolute;
    animation: hidePreloader 0.1s linear 3.3s forwards;
  }

  /* Mobile optimization */
  @media (max-width: 768px) {
    .load-text {
      font-size: clamp(1.5rem, 8vw, 3rem);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const preloader = document.getElementById('preloader');
    const body = document.body;

    if (preloader) {
      // Block scroll immediately
      body.classList.add('preloader-active');

      // Remove the preloader from DOM and restore scroll after all animations complete
      setTimeout(() => {
        body.classList.remove('preloader-active');
        preloader.remove();
      }, 3400);
    }
  });
</script>