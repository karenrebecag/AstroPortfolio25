---

<section class="projects-section">
  
  <div class="projects-container">
    <!-- Giant Heading with TextDisperse -->
    <div class="giant-heading-wrapper">
      <motion.div
        className="giant-heading-container"
        initial={{ opacity: 0, y: 50 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true, margin: "-100px" }}
        transition={{ duration: 0.8, ease: "easeOut" }}
        client:idle
      >
        <TextDisperse text="CASE STUDIES" className="giant-heading-disperse" client:idle />
      </motion.div>
      
      <motion.p
        className="giant-heading-subtitle"
        initial={{ opacity: 0, y: 20 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true, margin: "-100px" }}
        transition={{ duration: 0.6, delay: 0.4, ease: "easeOut" }}
        client:idle
      >
Showcasing my latest work and creative solutions
      </motion.p>
    </div>
    
    <div class="projects-content">
      
   

      <!-- Case Studies List - Optimized Island Component with scroll animation -->
      <motion.div
        initial={{ opacity: 0, y: 40 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true, margin: "-100px" }}
        transition={{ duration: 0.7, delay: 0.3, ease: "easeOut" }}
        client:visible
      >
        <ProjectsIsland client:visible />
      </motion.div>

      <!-- Project Image Cursor Component -->
      <ProjectImageCursor client:load />

    </div>
  </div>
  
  <!-- Quick Projects Section - Dual System: Marquee (Desktop) + Slider (Mobile) -->
  <div class="quick-projects-container">
    <!-- Text Above Project Cards -->
    <div class="quick-projects-text-container">
      <motion.div
        className="quick-projects-text-wrapper"
        initial={{ opacity: 0, y: 30 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true, margin: "-100px" }}
        transition={{ duration: 0.8, ease: "easeOut" }}
        client:idle
      >
        <h3 class="quick-projects-subtitle">Quick Projects</h3>
        <p class="quick-projects-description-text">
          Explore my collection of landing pages, no-code solutions, and creative experiments.
        </p>
      </motion.div>
    </div>
    
    <!-- Desktop: Marquee Infinito (visible en vp >= 768px) -->
    <div class="project-marquee-desktop">
      <ProjectMarqueeIsland client:visible />
    </div>
    
    <!-- Mobile: Slider Manual (visible en vp < 768px) -->
    <div class="project-slider-mobile">
      <ProjectSlider projectData={projectData} client:visible />
    </div>
  </div>
</section>

<style>
  @font-face {
    font-family: 'VideoGameFont';
    src: url('https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/Video%20Game%20Font.otf') format('opentype');
    font-display: swap;
  }

  .projects-section {
    width: 100%;
    min-height: 100vh;
    padding: 65px 60px;
    background: #050112;
    background-size: 40px 40px, 40px 40px, 100% 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
  }

  .projects-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  /* Giant Heading Styles */
  :global(.giant-heading-wrapper) {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 40px 0 0 0;
  }

  :global(.giant-heading-container) {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: visible;
  }

  :global(.giant-heading-subtitle) {
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-primary);
    font-size: clamp(14px, 2vw, 18px);
    font-weight: 400;
    line-height: 1.4;
    text-align: center;
    margin: 0;
    max-width: 600px;
  }

  :global(.giant-heading-disperse) {
    font-family: var(--font-display) !important;
    font-size: clamp(80px, 15vw, 200px) !important;
    font-weight: 400 !important;
    color: white !important;
    line-height: 0.8 !important;
    letter-spacing: -0.02em !important;
    text-transform: uppercase !important;
    margin: 0 !important;
    width: 100% !important;
  }

  @media (max-width: 768px) {
    :global(.giant-heading-container) {
      justify-content: center;
    }

    :global(.giant-heading-disperse) {
      font-size: clamp(60px, 12vw, 120px) !important;
      justify-content: center !important;
    }
  }

  @media (max-width: 480px) {
    :global(.giant-heading-disperse) {
      font-size: clamp(50px, 10vw, 80px) !important;
    }
  }

  :global(.giant-heading-disperse span) {
    font-family: var(--font-display) !important;
    color: white !important;
  }

  .projects-content {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding-bottom: 100px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    gap: 80px;
  }

  /* Projects Images Section */
  :global(.projects-images-section) {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
  }

  .project-images {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Header Styles */
  .projects-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
  }

  .projects-title {
    color: #808080;
    font-family: var(--font-display);
    font-size: clamp(32px, 6vw, 48px);
    font-weight: 400;
    line-height: clamp(50px, 8vw, 70px);
    margin: 0;
  }

  .projects-description {
    width: 100%;
    max-width: 424px;
    color: #ffffff;
    font-family: var(--font-primary);
    font-size: clamp(16px, 2.5vw, 20px);
    font-weight: 500;
    line-height: clamp(24px, 3.5vw, 30px);
    margin: 0;
  }

  /* Projects List */
  :global(.projects-list) {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  :global(.project-item) {
    width: 100%;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.20);
    display: flex;
    flex-direction: column;
    gap: 54px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  /* Hover effects for clickable project items */
  :global(.project-item:hover .project-title) {
    color: #9D7FC1 !important;
    transition: color 0.3s ease;
  }

  :global(.project-item:hover .project-number) {
    color: #9D7FC1 !important;
    transition: color 0.3s ease;
  }

  /* Hover effect for FlipText inside project titles */
  :global(.project-item:hover .project-title .flip-text-container span) {
    color: #9D7FC1 !important;
    transition: color 0.3s ease;
  }

  :global(.project-number) {
    color: white;
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    transition: color 0.3s ease;
  }

  :global(.project-number.inactive) {
    color: rgba(255, 255, 255, 0.30);
  }

  /* Hover state for inactive numbers */
  :global(.project-item:hover .project-number.inactive) {
    color: #9D7FC1 !important;
  }

  :global(.project-content) {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 54px;
  }

  :global(.project-title-container) {
    width: 100%;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: clamp(20px, 4vw, 30px);
    flex-wrap: wrap;
  }

  :global(.project-title) {
    color: #ffffff;
    margin: 0;
    transition: color 0.3s ease;
    font-family: var(--font-display) !important;
    font-size: clamp(2rem, 6vw, 3.5rem) !important;
    font-weight: 900 !important;
    line-height: 0.9 !important;
  }

  :global(.project-title.inactive) {
    color: rgba(255, 255, 255, 0.30);
  }

  /* Hover state for inactive titles */
  :global(.project-item:hover .project-title.inactive) {
    color: #9D7FC1 !important;
  }


  /* Ensure FlipText inherits the color from project-title */
  .project-title :global(.flip-text-container) {
    color: inherit;
  }

  /* Override some Tailwind styles to make sure our transitions work */
  .project-title :global(.flip-text-container) span {
    transition-property: transform;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 300ms;
  }

  :global(.project-details) {
    width: 100%;
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 40px;
    opacity: 1;
    overflow: hidden;
    transition: all 0.4s ease;
  }

  :global(.project-info) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 21px;
    width: 100%;
    max-width: 100%;
  }

  :global(.project-tags) {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
  }

  :global(.tag) {
    padding: 8px 11px;
    border-radius: 924px;
    border: 0.55px solid rgba(255, 255, 255, 0.20);
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.05);
    font-family: "VideoGameFont", monospace;
    font-size: 12px;
    font-weight: 400;
    text-transform: uppercase;
    line-height: 16px;
    white-space: nowrap;
    display: inline-block;
    transition: all 0.2s ease;
  }

  :global(.tag:hover) {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.1);
  }

  :global(.project-description) {
    color: #cccccc;
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    margin: 0;
  }

  /* Project images now handled by cursor component */
  :global(.project-images) {
    display: none;
  }

  /* Collapsed State */
  :global(.project-item:not(.active) .project-details) {
    opacity: 0;
    max-height: 0;
    margin-top: -54px;
  }


  /* Read More Button Styles */
  :global(.read-more-btn) {
    margin-top: 16px;
    padding: 12px 24px;
    background: linear-gradient(135deg, #4523AE 0%, #6B46C1 100%);
    color: white;
    border: 2px solid white;
    border-radius: 0;
    font-family: 'VideoGameFont', monospace;
    font-size: 12px;
    font-weight: 400;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  :global(.read-more-btn:hover) {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(69, 35, 174, 0.3);
  }

  :global(.read-more-btn:active) {
    transform: translateY(0);
  }


  /* Responsive Design */
  @media (max-width: 991px) {
    /* Hide project numbers in mobile/tablet */
    :global(.project-number) {
      display: none;
    }

    /* Adjust project item layout without numbers */
    :global(.project-item) {
      flex-direction: column;
      gap: 30px;
    }
  }

  @media (max-width: 768px) {
    .projects-section {
      padding: 40px 20px;
    }

    .projects-header {
      flex-direction: column;
      gap: 20px;
    }

    .projects-description {
      max-width: 100%;
    }

    :global(.project-title-container) {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    :global(.project-details) {
      flex-direction: column;
      gap: 20px;
    }

    :global(.project-images) {
      display: none;
    }

    :global(.project-info) {
      width: 100%;
      max-width: 100%;
    }

  }

  @media (max-width: 480px) {
    .projects-content {
      gap: 40px;
      padding-bottom: 100px;
    }

    :global(.projects-list) {
      gap: 32px;
    }

    :global(.project-item) {
      gap: 30px;
    }

    :global(.project-content) {
      gap: 30px;
    }
  }

  /* Quick Projects Section Styles */
  .quick-projects-container {
    width: 100%;
    position: relative;
    margin-top: 80px;
    background: #050112;
    padding: 80px 0;
  }

  /* Quick Projects Text Styles */
  .quick-projects-text-container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 60px 60px 60px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .quick-projects-text-wrapper {
    width: 100%;
    max-width: 800px;
    text-align: center;
  }

  .quick-projects-subtitle {
    font-family: var(--font-display);
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 400;
    color: #9D7FC1;
    margin: 0 0 16px 0;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .quick-projects-description-text {
    font-family: var(--font-primary);
    font-size: clamp(16px, 2.5vw, 20px);
    font-weight: 400;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  /* Project Marquee Styles */
  :global(.project-marquee-wrapper) {
    width: 100%;
    overflow: hidden;
    position: relative;
    mask: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    -webkit-mask: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  :global(.project-marquee) {
    display: flex;
    animation: projectMarqueeScroll 50s linear infinite;
    will-change: transform;
  }

  :global(.project-set) {
    display: flex;
    gap: 2rem;
    flex-shrink: 0;
  }

  /* Project Card Marquee */
  :global(.project-card-marquee) {
    width: 320px;
    height: 400px;
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    cursor: pointer;
    transition: all 0.3s ease;
    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
  }

  :global(.project-card-marquee:hover) {
    /* Remove transform effect */
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }
  
  /* Make background image fully opaque and bright on hover with zoom effect */
  :global(.project-card-marquee:hover)::before {
    content: '';
    position: absolute;
    top: -5%;
    left: -5%;
    right: -5%;
    bottom: -5%;
    background: inherit;
    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
    opacity: 1;
    filter: brightness(1.1) contrast(1.05);
    transform: scale(1.1);
    z-index: -1;
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Base state for smooth transition */
  :global(.project-card-marquee)::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: inherit;
    background-size: cover !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
    opacity: 0;
    transform: scale(1);
    z-index: -1;
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Hide all content except visit button on hover */
  :global(.project-card-marquee:hover .project-card-content) {
    background: transparent;
    transition: background 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.project-card-marquee:hover .project-card-header),
  :global(.project-card-marquee:hover .project-card-body),
  :global(.project-card-marquee:hover .project-tags) {
    opacity: 0;
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.project-card-marquee:hover .project-visit-btn) {
    opacity: 1;
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.project-card-content) {
    padding: 24px;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.9) 0%,
      rgba(0, 0, 0, 0.7) 50%,
      transparent 100%
    );
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 100%;
    justify-content: flex-end;
    position: relative;
    z-index: 1;
    transition: background 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.project-card-header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.project-number) {
    color: rgba(255, 255, 255, 0.6);
    font-size: 14px;
    font-family: var(--font-primary);
    font-weight: 500;
  }

  :global(.project-type) {
    color: #9D7FC1;
    font-size: 12px;
    font-family: "VideoGameFont", monospace;
    font-weight: 400;
    text-transform: uppercase;
    padding: 4px 8px;
    background: rgba(157, 127, 193, 0.2);
    border-radius: 12px;
    border: 1px solid rgba(157, 127, 193, 0.3);
  }

  :global(.project-card-body) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  :global(.project-card-title) {
    color: white;
    font-size: 20px;
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.2;
