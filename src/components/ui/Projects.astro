---
// Projects.astro - Sección de proyectos con funcionalidad colapsable optimizada (Dark Mode)
import ProjectsIsland from './ProjectsIsland.tsx';
import { DitheringShader } from '../three/DitheringShader.tsx';
---

<section class="projects-section">
  <!-- DitheringShader Background - Invertido y rotado respecto a MyStack -->
  <div class="dithering-background">
    <DitheringShader
      client:visible
      width={1920}
      height={1080}
      colorBack="#000000"
      colorFront="#ffffff"
      shape="swirl"
      type="8x8"
      pxSize={4}
      speed={0.4}
    />
  </div>
  <div class="projects-container">
    <div class="projects-content">
      <!-- Header Section -->
      <div class="projects-header">
        <h2 class="projects-title">Projects</h2>
        <p class="projects-description">
          Showcasing innovative digital solutions and creative projects built with cutting-edge technologies
        </p>
      </div>

      <!-- Projects List - Optimized Island Component -->
      <ProjectsIsland client:load />

    </div>
  </div>
</section>

<style>
  .projects-section {
    width: 100%;
    min-height: 100vh;
    padding: 65px 60px;
    background:
      linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      #000000;
    background-size: 40px 40px, 40px 40px, 100% 100%;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
  }

  /* DitheringShader Background - Invertido respecto a MyStack */
  .dithering-background {
    position: absolute;
    top: -250px;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.12;
    pointer-events: none;
    z-index: 0;
    mix-blend-mode: screen;
    transform: rotate(180deg);
  }

  .projects-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    position: relative;
    z-index: 1;
  }

  .projects-content {
    width: 100%;
    padding-bottom: 200px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    gap: 80px;
  }

  /* Header Styles */
  .projects-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
  }

  .projects-title {
    color: #808080;
    font-family: var(--font-display);
    font-size: clamp(32px, 6vw, 48px);
    font-weight: 400;
    line-height: clamp(50px, 8vw, 70px);
    margin: 0;
  }

  .projects-description {
    width: 100%;
    max-width: 424px;
    color: #ffffff;
    font-family: var(--font-primary);
    font-size: clamp(16px, 2.5vw, 20px);
    font-weight: 500;
    line-height: clamp(24px, 3.5vw, 30px);
    margin: 0;
  }

  /* Projects List */
  :global(.projects-list) {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  :global(.project-item) {
    width: 100%;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.20);
    display: flex;
    flex-direction: column;
    gap: 54px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  :global(.project-number) {
    color: white;
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    transition: color 0.3s ease;
  }

  :global(.project-number.inactive) {
    color: rgba(255, 255, 255, 0.30);
  }

  :global(.project-content) {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 54px;
  }

  :global(.project-title-container) {
    width: 100%;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: clamp(20px, 4vw, 30px);
    flex-wrap: wrap;
  }

  :global(.project-title) {
    color: #ffffff;
    margin: 0;
    transition: color 0.3s ease;
  }

  :global(.project-title.inactive) {
    color: rgba(255, 255, 255, 0.30);
  }

  /* FlipText hover activation via parent - Solo en desktop */
  @media (min-width: 769px) {
    .project-item:hover .project-title :global(.flip-text-container) > div:first-child span {
      transform: translateY(-110%);
    }

    .project-item:hover .project-title :global(.flip-text-container) > div.absolute span {
      transform: translateY(0);
    }
  }

  /* Ensure FlipText inherits the color from project-title */
  .project-title :global(.flip-text-container) {
    color: inherit;
  }

  /* Override some Tailwind styles to make sure our transitions work */
  .project-title :global(.flip-text-container) span {
    transition-property: transform;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 300ms;
  }

  :global(.project-details) {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    opacity: 1;
    max-height: 200px;
    overflow: hidden;
    transition: all 0.4s ease;
  }

  :global(.project-info) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 21px;
    width: 60%;
    max-width: 60%;
  }

  :global(.project-tags) {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
  }

  :global(.tag) {
    padding: 8px 11px;
    border-radius: 924px;
    border: 0.55px solid rgba(255, 255, 255, 0.20);
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.05);
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 400;
    text-transform: uppercase;
    line-height: 16px;
    white-space: nowrap;
    display: inline-block;
    transition: all 0.2s ease;
  }

  :global(.tag:hover) {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.1);
  }

  :global(.project-description) {
    color: #cccccc;
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    margin: 0;
  }

  :global(.project-images) {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 140px;
    width: 40%;
    max-width: 40%;
    flex-shrink: 0;
  }

  /* Collapsed State */
  :global(.project-item:not(.active) .project-details) {
    opacity: 0;
    max-height: 0;
    margin-top: -54px;
  }

  /* Hover effects solo en desktop */
  @media (min-width: 769px) {
    :global(.project-item:not(.active):hover .project-details) {
      opacity: 1;
      max-height: 200px;
      margin-top: 0;
    }

    :global(.project-item:not(.active):hover .project-number) {
      color: white;
    }

    :global(.project-item:not(.active):hover .project-title) {
      color: #ffffff;
    }
  }

  /* Read More Button Styles */
  :global(.read-more-btn) {
    margin-top: 16px;
    padding: 12px 24px;
    background: linear-gradient(135deg, #4523AE 0%, #6B46C1 100%);
    color: white;
    border: none;
    border-radius: 8px;
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  :global(.read-more-btn:hover) {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(69, 35, 174, 0.3);
  }

  :global(.read-more-btn:active) {
    transform: translateY(0);
  }


  /* Responsive Design */
  @media (max-width: 768px) {
    .projects-section {
      padding: 40px 20px;
    }

    .projects-header {
      flex-direction: column;
      gap: 20px;
    }

    .projects-description {
      max-width: 100%;
    }

    :global(.project-title-container) {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    :global(.project-details) {
      flex-direction: column;
      gap: 20px;
    }

    :global(.project-images) {
      display: none;
    }

    :global(.project-info) {
      width: 100%;
      max-width: 100%;
    }

  }

  @media (max-width: 480px) {
    .projects-content {
      gap: 40px;
      padding-bottom: 100px;
    }

    :global(.projects-list) {
      gap: 32px;
    }

    :global(.project-item) {
      gap: 30px;
    }

    :global(.project-content) {
      gap: 30px;
    }
  }
</style>
