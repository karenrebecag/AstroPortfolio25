---
// CodeBlockCode.astro - Wrapper simplificado para uso directo de código
import CodeBlock from './CodeBlock.astro';

export interface Props {
  code: string;
  language?: string;
  theme?: string;
  className?: string;
}

const {
  code,
  language = 'javascript',
  theme = 'github-dark',
  className = '',
} = Astro.props;
---

<CodeBlock 
  code={code}
  language={language}
  theme={theme}
  className={className}
  showLineNumbers={false}
/>
