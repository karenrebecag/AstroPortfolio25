---
// AurinBestFeatures.astro - Best features section with dark theme
import { motion } from 'motion/react';
import { AnimatedAurinHeader, AnimatedAurinFeaturesGrid, AnimatedAurinSideContent, AnimatedAurinTipsSection } from './AnimatedAurinWrapper.tsx';
---

<!-- Aurin Best Features Section -->
<section class="aurin-best-features">
  <div class="features-container">
    
    <!-- Header Section -->
    <AnimatedAurinHeader client:visible>
      <div class="header-title">
        <div class="title-part-1 playfair-display-italic">LO MEJOR DE</div>
        <div class="title-part-2">AURIN</div>
      </div>
      <div class="header-description">
        Estas son las features relacionadas a notificaciones que adopté y ejecuté correctamente:
      </div>
    </AnimatedAurinHeader>

    <!-- Main Features Grid -->
    <AnimatedAurinFeaturesGrid client:visible>
      <motion.div 
        className="feature-card"
        whileHover={{ 
          backgroundColor: "#7A2CC8",
          y: -4,
          boxShadow: "0 12px 32px rgba(122, 44, 200, 0.3)"
        }}
        transition={{ duration: 0.05, ease: "easeOut" }}
        client:load
      >
        <div class="feature-content">
          <div class="feature-title">Notificaciones en tiempo real en la app</div>
          <div class="feature-tech">FIRESTORE LISTENERS</div>
        </div>
        <motion.div 
          className="feature-icon"
          whileHover={{ rotate: 5 }}
          transition={{ duration: 0.05, ease: "easeOut" }}
        >
          <div class="icon-circle">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9,11 12,14 22,4"></polyline>
              <path d="m21,3-6.5,18a.55.55,0,0,1-1,0L10,14,3,10.5a.55.55,0,0,1,0-1Z"></path>
            </svg>
          </div>
        </motion.div>
      </motion.div>

      <motion.div 
        className="feature-card"
        whileHover={{ 
          backgroundColor: "#7A2CC8",
          y: -4,
          boxShadow: "0 12px 32px rgba(122, 44, 200, 0.3)"
        }}
        transition={{ duration: 0.05, ease: "easeOut" }}
        client:load
      >
        <div class="feature-content">
          <div class="feature-title">Emails automáticos a usuarios involucrados</div>
          <div class="feature-tech">(Nodemailer + Gmail App Password)</div>
        </div>
        <motion.div 
          className="feature-icon"
          whileHover={{ rotate: 5 }}
          transition={{ duration: 0.05, ease: "easeOut" }}
        >
          <div class="icon-circle">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9,11 12,14 22,4"></polyline>
              <path d="m21,3-6.5,18a.55.55,0,0,1-1,0L10,14,3,10.5a.55.55,0,0,1,0-1Z"></path>
            </svg>
          </div>
        </motion.div>
      </motion.div>

      <motion.div 
        className="feature-card"
        whileHover={{ 
          backgroundColor: "#7A2CC8",
          y: -4,
          boxShadow: "0 12px 32px rgba(122, 44, 200, 0.3)"
        }}
        transition={{ duration: 0.05, ease: "easeOut" }}
        client:load
      >
        <div class="feature-content">
          <div class="feature-title">Sistema de cola con reintentos automáticos</div>
          <div class="feature-tech">MAXIMA FIABILIDAD</div>
        </div>
        <motion.div 
          className="feature-icon"
          whileHover={{ rotate: 5 }}
          transition={{ duration: 0.05, ease: "easeOut" }}
        >
          <div class="icon-circle">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9,11 12,14 22,4"></polyline>
              <path d="m21,3-6.5,18a.55.55,0,0,1-1,0L10,14,3,10.5a.55.55,0,0,1,0-1Z"></path>
            </svg>
          </div>
        </motion.div>
      </motion.div>

      <motion.div 
        className="feature-card"
        whileHover={{ 
          backgroundColor: "#7A2CC8",
          y: -4,
          boxShadow: "0 12px 32px rgba(122, 44, 200, 0.3)"
        }}
        transition={{ duration: 0.05, ease: "easeOut" }}
        client:load
      >
        <div class="feature-content">
          <div class="feature-title">Templates HTML profesionales</div>
          <div class="feature-tech">(Nodemailer)</div>
        </div>
        <motion.div 
          className="feature-icon"
          whileHover={{ rotate: 5 }}
          transition={{ duration: 0.05, ease: "easeOut" }}
        >
          <div class="icon-circle">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9,11 12,14 22,4"></polyline>
              <path d="m21,3-6.5,18a.55.55,0,0,1-1,0L10,14,3,10.5a.55.55,0,0,1,0-1Z"></path>
            </svg>
          </div>
        </motion.div>
      </motion.div>
    </AnimatedAurinFeaturesGrid>

    <!-- Side Content Section -->
    <AnimatedAurinSideContent client:visible>
      <!-- Code Block -->
      <div class="code-block">
        <div class="code-content">
          <span class="code-label">Tipos de notificaciones implementados:</span><br/>
          <span class="code-text">task_created - Nueva tarea asignada<br/>
          task_status_changed - Estado actualizado<br/>
          group_message - Mensaje en chat de tarea<br/>
          private_message - Mensaje directo<br/>
          time_log - Registro de tiempo añadido<br/>
          task_deleted - Tarea eliminada<br/>
          task_archived - Tarea archivada</span>
        </div>
      </div>

      <!-- Resources -->
      <div class="resources-section">
        <div class="resources-title">Recursos útiles:</div>
        <div class="resources-links">
          <a href="#" class="resource-link">Nodemailer Production Best Practices</a>
          <a href="#" class="resource-link">Email Queue Systems with Bull</a>
          <a href="#" class="resource-link">Gmail App Passwords Setup</a>
        </div>
      </div>
    </AnimatedAurinSideContent>

    <!-- Tips Section -->
    <AnimatedAurinTipsSection client:visible>
      <div class="tips-header">
        <h2 class="tips-title">Tips Prácticos</h2>
      </div>

      <div class="tips-grid">
        <motion.div 
          className="tip-card"
          whileHover={{ 
            backgroundColor: "#7A2CC8",
            y: -4,
            boxShadow: "0 12px 32px rgba(122, 44, 200, 0.3)"
          }}
          transition={{ duration: 0.05, ease: "easeOut" }}
          client:load
        >
          <div class="tip-content">
            <div class="tip-title">Organiza por Features, No por Tipos de Archivo</div>
            <div class="tip-description">En lugar de /components/, /hooks/, /utils/ separados, usa /features/tasks/, /features/messages/. Todo relacionado vive junto.</div>
          </div>
          <motion.div 
            className="tip-icon"
            whileHover={{ rotate: 5 }}
            transition={{ duration: 0.05, ease: "easeOut" }}
          >
            <div class="icon-circle">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,11 12,14 22,4"></polyline>
                <path d="m21,3-6.5,18a.55.55,0,0,1-1,0L10,14,3,10.5a.55.55,0,0,1,0-1Z"></path>
              </svg>
            </div>
          </motion.div>
        </motion.div>

        <motion.div 
          className="tip-card"
          whileHover={{ 
            backgroundColor: "#7A2CC8",
            y: -4,
            boxShadow: "0 12px 32px rgba(122, 44, 200, 0.3)"
          }}
          transition={{ duration: 0.05, ease: "easeOut" }}
          client:load
        >
          <div class="tip-content">
            <div class="tip-title">Documenta Decisiones Técnicas</div>
            <div class="tip-description">Un diagrama simple salva horas de debugging. Usa ADRs (Architecture Decision Records) para decisiones arquitectónicas importantes.</div>
          </div>
          <motion.div 
            className="tip-icon"
            whileHover={{ rotate: 5 }}
            transition={{ duration: 0.05, ease: "easeOut" }}
          >
            <div class="icon-circle">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,11 12,14 22,4"></polyline>
                <path d="m21,3-6.5,18a.55.55,0,0,1-1,0L10,14,3,10.5a.55.55,0,0,1,0-1Z"></path>
              </svg>
            </div>
          </motion.div>
        </motion.div>

        <motion.div 
          className="tip-card"
          whileHover={{ 
            backgroundColor: "#7A2CC8",
            y: -4,
            boxShadow: "0 12px 32px rgba(122, 44, 200, 0.3)"
          }}
          transition={{ duration: 0.05, ease: "easeOut" }}
          client:load
        >
          <div class="tip-content">
            <div class="tip-title">Automatiza Tests de Features Críticas</div>
            <div class="tip-description">Notificaciones, autenticación, drag & drop. Configura CI/CD con GitHub Actions desde el principio.</div>
          </div>
          <motion.div 
            className="tip-icon"
            whileHover={{ rotate: 5 }}
            transition={{ duration: 0.05, ease: "easeOut" }}
          >
            <div class="icon-circle">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,11 12,14 22,4"></polyline>
                <path d="m21,3-6.5,18a.55.55,0,0,1-1,0L10,14,3,10.5a.55.55,0,0,1,0-1Z"></path>
              </svg>
            </div>
          </motion.div>
        </motion.div>

        <motion.div 
          className="tip-card"
          whileHover={{ 
            backgroundColor: "#7A2CC8",
            y: -4,
            boxShadow: "0 12px 32px rgba(122, 44, 200, 0.3)"
          }}
          transition={{ duration: 0.05, ease: "easeOut" }}
          client:load
        >
          <div class="tip-content">
            <div class="tip-title">Usa Hooks Personalizados para Lógica de Negocio</div>
            <div class="tip-description">Crea hooks que sean reutilizables y testeables para isolar errores.</div>
          </div>
          <motion.div 
            className="tip-icon"
            whileHover={{ rotate: 5 }}
            transition={{ duration: 0.05, ease: "easeOut" }}
          >
            <div class="icon-circle">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,11 12,14 22,4"></polyline>
                <path d="m21,3-6.5,18a.55.55,0,0,1-1,0L10,14,3,10.5a.55.55,0,0,1,0-1Z"></path>
              </svg>
            </div>
          </motion.div>
        </motion.div>

        <motion.div 
          className="tip-card"
          whileHover={{ 
            backgroundColor: "#7A2CC8",
            y: -4,
            boxShadow: "0 12px 32px rgba(122, 44, 200, 0.3)"
          }}
          transition={{ duration: 0.05, ease: "easeOut" }}
          client:load
        >
          <div class="tip-content">
            <div class="tip-title">Prioriza Experiencia, No Solo Estética</div>
            <div class="tip-description">Micro-interactions con propósito, Loading states claros y significativos, Feedback instantáneo con optimistic updates</div>
          </div>
          <motion.div 
            className="tip-icon"
            whileHover={{ rotate: 5 }}
            transition={{ duration: 0.05, ease: "easeOut" }}
          >
            <div class="icon-circle">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,11 12,14 22,4"></polyline>
                <path d="m21,3-6.5,18a.55.55,0,0,1-1,0L10,14,3,10.5a.55.55,0,0,1,0-1Z"></path>
              </svg>
            </div>
          </motion.div>
        </motion.div>

        <motion.div 
          className="tip-card"
          whileHover={{ 
            backgroundColor: "#7A2CC8",
            y: -4,
            boxShadow: "0 12px 32px rgba(122, 44, 200, 0.3)"
          }}
          transition={{ duration: 0.05, ease: "easeOut" }}
          client:load
        >
          <div class="tip-content">
            <div class="tip-title">Implementa Actualizaciones Optimistas</div>
            <div class="tip-description">La UI responde al instante, sincronizas con backend después, y haces rollback si falla. Esto transforma la percepción de velocidad.</div>
          </div>
          <motion.div 
            className="tip-icon"
            whileHover={{ rotate: 5 }}
            transition={{ duration: 0.05, ease: "easeOut" }}
          >
            <div class="icon-circle">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,11 12,14 22,4"></polyline>
                <path d="m21,3-6.5,18a.55.55,0,0,1-1,0L10,14,3,10.5a.55.55,0,0,1,0-1Z"></path>
              </svg>
            </div>
          </motion.div>
        </motion.div>

        <motion.div 
          className="tip-card"
          whileHover={{ 
            backgroundColor: "#7A2CC8",
            y: -4,
            boxShadow: "0 12px 32px rgba(122, 44, 200, 0.3)"
          }}
          transition={{ duration: 0.05, ease: "easeOut" }}
          client:load
        >
          <div class="tip-content">
            <div class="tip-title">Aprovecha TypeScript</div>
            <div class="tip-description">Template literal types para rutas type-safe, operador satisfies para configs, generics para componentes reutilizables.</div>
          </div>
          <motion.div 
            className="tip-icon"
            whileHover={{ rotate: 5 }}
            transition={{ duration: 0.05, ease: "easeOut" }}
          >
            <div class="icon-circle">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9,11 12,14 22,4"></polyline>
                <path d="m21,3-6.5,18a.55.55,0,0,1-1,0L10,14,3,10.5a.55.55,0,0,1,0-1Z"></path>
              </svg>
            </div>
          </motion.div>
        </motion.div>
      </div>
    </AnimatedAurinTipsSection>

  </div>
</section>

<style>
  /* Aurin Best Features Section - Light Mode */
  :global(.aurin-best-features) {
    width: 100%;
    background: #151515;
    padding: 8rem 4.5rem;
    position: relative;
    transition: background 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark Mode - Main Section */
  :global(.dark-mode .aurin-best-features) {
    background: linear-gradient(to bottom, #050112 0%, #0a0820 100%);
  }

  .features-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 4rem;
    flex-wrap: wrap;
  }

  /* Header Section */
  .features-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 4rem;
    flex-wrap: wrap;
  }

  .header-title {
    display: flex;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 1.25rem;
  }

  :global(.title-part-1) {
    color: white;
    font-size: clamp(32px, 6vw, 64px);
    font-weight: 400;
    line-height: 1;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.title-part-2) {
    color: white;
    font-size: clamp(32px, 6vw, 64px);
    font-family: var(--font-display, 'Median', serif);
    font-weight: 400;
    line-height: 1;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.header-description) {
    width: 100%;
    max-width: 416px;
    color: #BBBBBB;
    font-size: clamp(16px, 2.5vw, 20px);
    font-family: var(--font-primary, 'InterTight', sans-serif);
    font-weight: 400;
    line-height: 1.4;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark Mode - Header Text */
  :global(.dark-mode .title-part-1) {
    color: #f0f4ff;
  }

  :global(.dark-mode .title-part-2) {
    color: #f0f4ff;
  }

  :global(.dark-mode .header-description) {
    color: #b8c4e6;
  }

  /* Main Features Grid */
  .main-features-grid {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  :global(.feature-card) {
    height: auto;
    min-height: 173px;
    padding: 2.75rem 3rem;
    background: #212121;
    border-radius: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark Mode - Feature Cards */
  :global(.dark-mode .feature-card) {
    background: #1a1b3a;
    border: 1px solid rgba(176, 196, 230, 0.1);
  }


  .feature-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  :global(.feature-title) {
    color: white;
    font-size: clamp(20px, 3vw, 32px);
    font-family: var(--font-display, 'Median', serif);
    font-weight: 400;
    line-height: 1.2;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.feature-tech) {
    color: #BBBBBB;
    font-size: clamp(14px, 1.4vw, 18px);
    font-family: var(--font-primary, 'InterTight', sans-serif);
    font-weight: 400;
    text-transform: uppercase;
    line-height: 1.2;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.feature-card.featured .feature-tech) {
    color: #EEEEEE;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark Mode - Feature Text */
  :global(.dark-mode .feature-title) {
    color: #f0f4ff;
  }

  :global(.dark-mode .feature-tech) {
    color: #b8c4e6;
  }

  :global(.dark-mode .feature-card.featured .feature-tech) {
    color: #d4e2ff;
  }

  .feature-icon {
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
  }

  :global(.icon-circle) {
    padding: 11px;
    border-radius: 50px;
    border: 1px solid #494949;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark Mode - Icons */
  :global(.dark-mode .icon-circle) {
    border-color: rgba(176, 196, 230, 0.3);
    color: #f0f4ff;
  }

  /* Side Content */
  .side-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  :global(.code-block) {
    padding: 2rem 1.5rem;
    background: rgba(27, 27, 27, 0.3);
    box-shadow: -2px 4px 10px rgba(145, 145, 145, 0.05);
    border-radius: 20px;
    border: 1px solid #404040;
    backdrop-filter: blur(12.5px);
    transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.code-content) {
    color: white;
    font-size: clamp(12px, 1.8vw, 16px);
    font-family: 'Source Code Pro', monospace;
    font-weight: 400;
    line-height: 1.4;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.code-label) {
    font-weight: 600;
  }

  /* Dark Mode - Code Block */
  :global(.dark-mode .code-block) {
    background: rgba(26, 27, 58, 0.4);
    border-color: rgba(176, 196, 230, 0.2);
    box-shadow: -2px 4px 10px rgba(5, 1, 18, 0.2);
  }

  :global(.dark-mode .code-content) {
    color: #e8f0ff;
  }

  .resources-section {
    text-align: right;
  }

  :global(.resources-title) {
    color: white;
    font-size: clamp(16px, 2.4vw, 20px);
    font-family: var(--font-primary, 'InterTight', sans-serif);
    font-weight: 700;
    line-height: 1.33;
    margin-bottom: 1rem;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.resources-links) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  :global(.resource-link) {
    color: white;
    font-size: clamp(16px, 2.4vw, 20px);
    font-family: var(--font-primary, 'InterTight', sans-serif);
    font-weight: 700;
    text-decoration: underline;
    line-height: 1.33;
    transition: color 0.3s ease;
  }

  :global(.resource-link:hover) {
    color: #7A2CC8;
  }

  /* Dark Mode - Resources */
  :global(.dark-mode .resources-title) {
    color: #f0f4ff;
  }

  :global(.dark-mode .resource-link) {
    color: #d4e2ff;
  }

  :global(.dark-mode .resource-link:hover) {
    color: #9b7ae8;
  }

  /* Tips Section */
  .tips-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  :global(.tips-title) {
    color: white;
    font-size: clamp(28px, 5vw, 48px);
    font-family: var(--font-display, 'Median', serif);
    font-weight: 400;
    line-height: 1.17;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.tips-grid) {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  :global(.tip-card) {
    height: auto;
    min-height: 173px;
    padding: 2.75rem 3rem;
    background: #212121;
    border-radius: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.tip-card:hover) {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  /* Dark Mode - Tips Section */
  :global(.dark-mode .tips-title) {
    color: #f0f4ff;
  }

  :global(.dark-mode .tip-card) {
    background: #1a1b3a;
    border: 1px solid rgba(176, 196, 230, 0.1);
  }

  :global(.dark-mode .tip-card:hover) {
    box-shadow: 0 8px 24px rgba(5, 1, 18, 0.4);
  }

  .tip-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  :global(.tip-title) {
    color: white;
    font-size: clamp(20px, 3vw, 32px);
