<script>
  // Dark mode handler for tip cards with inline styles
  document.addEventListener('DOMContentLoaded', () => {
    const applyDarkModeToTipCards = (isDark: boolean) => {
      const tipCards = document.querySelectorAll('.tip-card');
      
      tipCards.forEach((card) => {
        const element = card as HTMLElement;
        if (isDark) {
          // Dark mode styles - azulados
          element.style.backgroundColor = '#1a1b3a';
          element.style.border = '1px solid rgba(176, 196, 230, 0.1)';
        } else {
          // Light mode styles
          element.style.backgroundColor = '#212121';
          element.style.border = 'none';
        }
      });
    };

    const featureCards = document.querySelectorAll('.feature-card');
    featureCards.forEach((card) => {
      const element = card as HTMLElement;
      // Check if it has whileHover prop (Motion.dev card)
      const checkDarkMode = () => {
        const isDark = document.documentElement.classList.contains('dark-mode');
        if (isDark) {
          element.style.backgroundColor = '#1a1b3a';
          element.style.border = '1px solid rgba(176, 196, 230, 0.1)';
        } else {
          element.style.backgroundColor = '#212121';  
          element.style.border = 'none';
        }
      };
      
      // Apply initial state
      setTimeout(checkDarkMode, 100);
      
      // Listen for class changes on documentElement
      const observer = new MutationObserver(() => {
        checkDarkMode();
      });
      
      observer.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class']
      });
    });

    // Apply to tip cards 
    const checkInitialDarkMode = () => {
      const isDark = document.documentElement.classList.contains('dark-mode');
      applyDarkModeToTipCards(isDark);
    };

    // Listen for dark mode changes
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains('dark-mode');
      applyDarkModeToTipCards(isDark);
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class']
    });

    // Apply initial state with delay to ensure Motion.dev has rendered
    setTimeout(checkInitialDarkMode, 200);
  });
</script>
