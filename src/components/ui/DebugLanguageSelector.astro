---
const lang = 'en'; // Hardcoded for testing
---

<div style="position: fixed; top: 10px; right: 10px; z-index: 99999; background: red; padding: 20px;">
  <button
    id="debugLangBtn"
    style="background: yellow; border: 3px solid black; padding: 15px; font-size: 16px; cursor: pointer; z-index: 99999; position: relative;"
    onclick="console.log('DIRECT ONCLICK WORKS!'); alert('Button clicked!');"
  >
    🌍 DEBUG LANG
  </button>

  <div id="debugDropdown" style="display: none; background: blue; color: white; padding: 10px; margin-top: 5px;">
    <a href="/es" style="color: white; display: block;">🇪🇸 Español</a>
    <a href="/fr" style="color: white; display: block;">🇫🇷 Français</a>
  </div>
</div>

<script>
console.log('🔥 DEBUG SELECTOR LOADING...');

setTimeout(() => {
  const debugBtn = document.getElementById('debugLangBtn');
  const debugDropdown = document.getElementById('debugDropdown');

  console.log('🔍 Debug elements:', {debugBtn, debugDropdown});

  if (debugBtn) {
    console.log('✅ Debug button found, adding event listener...');

    debugBtn.addEventListener('click', function(e) {
      console.log('🎯 DEBUG CLICK EVENT FIRED!');

      if (debugDropdown.style.display === 'none') {
        debugDropdown.style.display = 'block';
        console.log('📂 Debug dropdown opened');
      } else {
        debugDropdown.style.display = 'none';
        console.log('📁 Debug dropdown closed');
      }
    });

    // Test direct manipulation
    debugBtn.style.border = '5px solid lime';
    debugBtn.innerHTML = '🌍 CLICK ME!';

    console.log('✅ Debug selector ready!');
  } else {
    console.error('❌ Debug button not found!');
  }
}, 100);

// Global click test
document.addEventListener('click', function(e) {
  console.log('🌐 GLOBAL CLICK DETECTED:', e.target);
});

// Try to hijack the existing button
setTimeout(() => {
  const existingBtn = document.getElementById('simpleLangToggle');
  console.log('🔍 Existing button search:', existingBtn);

  if (existingBtn) {
    console.log('📋 Existing button details:', {
      innerHTML: existingBtn.innerHTML,
      outerHTML: existingBtn.outerHTML,
      onclick: existingBtn.onclick
    });

    // Remove all existing event listeners and add our own
    existingBtn.onclick = null;
    existingBtn.replaceWith(existingBtn.cloneNode(true));

    const newBtn = document.getElementById('simpleLangToggle');
    newBtn.onclick = function() {
      console.log('🎯 HIJACKED BUTTON CLICKED!');
      alert('Hijacked button works!');
    };

    newBtn.style.border = '5px solid lime';
    newBtn.style.background = 'magenta';

    console.log('✅ Button hijacked successfully!');
  }
}, 500);
</script>