---
// ShareBar Component - Social Media Sharing Strip
import { ShareBarIsland } from './ShareBarIsland';
import { motion } from 'motion/react';
---

<motion.div 
  className="share-bar"
  initial={{ opacity: 0, y: 30 }}
  whileInView={{ opacity: 1, y: 0 }}
  viewport={{ once: true, margin: "-100px" }}
  transition={{ duration: 0.6, ease: "easeOut" }}
  client:load
>
  <ShareBarIsland client:visible />
</motion.div>

<style>
  .share-bar {
    position: relative;
    width: 100%;
    padding: 2rem 0;
    display: flex;
    justify-content: center;
    background-color: #fdfdfd;
    background-image: 
      linear-gradient(rgba(0, 0, 0, 0.020) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.020) 1px, transparent 1px);
    z-index: 50;
    transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark mode styles */
  :global(.dark-mode) .share-bar {
    background-color: #070316;
    background-image: 
      linear-gradient(rgba(112, 11, 108, 0.15) 1px, transparent 1px),
      linear-gradient(90deg, rgba(112, 11, 108, 0.15) 1px, transparent 1px);
  }

  /* ShareBar Island Styles */
  :global(.share-container) {
    width: calc(100% - 4rem);
    max-width: 600px;
    background: transparent;
    backdrop-filter: blur(25px);
    
    -webkit-backdrop-filter: blur(25px);
    border-radius: 50px;
    transition: all 0.3s cubic-bezier(0.4, 0.0, 0.2, 1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    overflow: hidden;
    padding: 1.5rem 2rem;
  }

  :global(.share-content) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  :global(.share-label) {
    font-family: var(--font-primary, 'InterTight', sans-serif);
    font-size: 0.9rem;
    font-weight: 500;
    color: #060314;
    white-space: nowrap;
  }

  :global(.share-buttons) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  :global(.share-btn) {
    background: none;
    border: none;
    padding: 0.75rem;
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #060314;
    position: relative;
  }

  :global(.share-btn:hover) {
    background: rgba(0, 0, 0, 0.05);
  }

  :global(.share-btn svg) {
    width: 18px;
    height: 18px;
    transition: color 0.2s ease;
  }

  /* Specific hover colors for each platform */
  :global(.copy-btn:hover) {
    background: rgba(99, 102, 241, 0.1) !important;
    color: #6366f1 !important;
  }

  :global(.twitter-btn:hover) {
    background: rgba(0, 0, 0, 0.1) !important;
    color: #000000 !important;
  }

  :global(.linkedin-btn:hover) {
    background: rgba(0, 119, 181, 0.1) !important;
    color: #0077b5 !important;
  }

  :global(.reddit-btn:hover) {
    background: rgba(255, 69, 0, 0.1) !important;
    color: #ff4500 !important;
  }

  :global(.threads-btn:hover) {
    background: rgba(0, 0, 0, 0.1) !important;
    color: #000000 !important;
  }

  :global(.whatsapp-btn:hover) {
    background: rgba(37, 211, 102, 0.1) !important;
    color: #25d366 !important;
  }

  /* Dark mode styles */
  :global(.dark-mode .share-container) {
    background: rgba(10, 8, 22, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  :global(.dark-mode .share-label) {
    color: #ffffff;
  }

  :global(.dark-mode .share-btn) {
    color: #ffffff;
  }

  :global(.dark-mode .share-btn:hover) {
    background: rgba(255, 255, 255, 0.1);
  }

  /* Responsive design */
  @media (max-width: 768px) {
    :global(.share-container) {
      width: calc(100% - 2rem);
      padding: 0.75rem 1.5rem;
    }

    :global(.share-content) {
      flex-direction: column;
      gap: 1rem;
    }

    :global(.share-buttons) {
      gap: 0.5rem;
    }

    :global(.share-btn) {
      padding: 0.6rem;
    }

    :global(.share-btn svg) {
      width: 16px;
      height: 16px;
    }
  }

  @media (max-width: 480px) {
    :global(.share-container) {
      width: calc(100% - 1rem);
      padding: 0.5rem 1rem;
    }

    :global(.share-label) {
      font-size: 0.8rem;
    }
  }

  .share-container {
    width: calc(100% - 4rem);
    max-width: 600px;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border-radius: 50px;
    transition: all 0.3s cubic-bezier(0.4, 0.0, 0.2, 1);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    overflow: hidden;
    padding: 1rem 2rem;
  }

  .share-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .share-label {
    font-family: var(--font-primary, 'InterTight', sans-serif);
    font-size: 0.9rem;
    font-weight: 500;
    color: #060314;
    white-space: nowrap;
  }

  .share-buttons {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .share-btn {
    background: none;
    border: none;
    padding: 0.75rem;
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #060314;
    position: relative;
  }

  .share-btn:hover {
    background: rgba(0, 0, 0, 0.05);
    transform: scale(1.1);
  }

  .share-btn:active {
    transform: scale(0.95);
  }

  .share-btn svg {
    width: 18px;
    height: 18px;
    transition: color 0.2s ease;
  }

  /* Specific hover colors for each platform */
  .share-btn:nth-child(1):hover { /* Copy Link */
    background: rgba(99, 102, 241, 0.1);
    color: #6366f1;
  }

  .share-btn:nth-child(2):hover { /* X/Twitter */
    background: rgba(0, 0, 0, 0.1);
    color: #000000;
  }

  .share-btn:nth-child(3):hover { /* LinkedIn */
    background: rgba(0, 119, 181, 0.1);
    color: #0077b5;
  }

  .share-btn:nth-child(4):hover { /* Reddit */
    background: rgba(255, 69, 0, 0.1);
    color: #ff4500;
  }

  .share-btn:nth-child(5):hover { /* Threads */
    background: rgba(0, 0, 0, 0.1);
    color: #000000;
  }

  .share-btn:nth-child(6):hover { /* WhatsApp */
    background: rgba(37, 211, 102, 0.1);
    color: #25d366;
  }

  /* Dark mode styles */
  :global(.dark-mode .share-container) {
    background: rgba(15, 0, 26, 0.85);
    border: 1px solid rgba(157, 127, 193, 0.2);
    transition: all 0.3s cubic-bezier(0.4, 0.0, 0.2, 1);
  }

  :global(.dark-mode .share-label) {
    color: #f8f4ff;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode .share-btn) {
    color: #e6d9f0;
    transition: all 0.2s ease;
  }

  :global(.dark-mode .share-btn:hover) {
    background: rgba(157, 127, 193, 0.15);
    color: #f8f4ff;
  }

  /* Responsive design */
  @media (max-width: 768px) {
    .share-container {
      width: calc(100% - 2rem);
      padding: 0.75rem 1.5rem;
    }

    .share-content {
      flex-direction: column;
      gap: 1rem;
    }

    .share-buttons {
      gap: 0.5rem;
    }

    .share-btn {
      padding: 0.6rem;
    }

    .share-btn svg {
      width: 16px;
      height: 16px;
    }
  }

  @media (max-width: 480px) {
    .share-container {
      width: calc(100% - 1rem);
      padding: 0.5rem 1rem;
    }

    .share-label {
      font-size: 0.8rem;
    }
  }
</style>

<script>
  // Share functionality
  const initShareBar = () => {
    const currentUrl = window.location.href;
    const pageTitle = document.title;
    const description = "Check out this amazing project by Karen Rebeca Ortiz - Aurin Task Manager";

    // Copy Link functionality
    const copyLinkBtn = document.getElementById('copyLinkBtn');
    copyLinkBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(currentUrl);
        
        // Visual feedback
        const originalTitle = copyLinkBtn.title;
        copyLinkBtn.title = 'Copied!';
        copyLinkBtn.style.background = 'rgba(34, 197, 94, 0.1)';
        copyLinkBtn.style.color = '#22c55e';
        
        setTimeout(() => {
          copyLinkBtn.title = originalTitle;
          copyLinkBtn.style.background = '';
          copyLinkBtn.style.color = '';
        }, 2000);
      } catch (err) {
        console.error('Failed to copy link:', err);
      }
    });

    // X/Twitter share
    const shareTwitterBtn = document.getElementById('shareTwitterBtn');
    shareTwitterBtn?.addEventListener('click', () => {
      const twitterUrl = `https://twitter.com/intent/tweet?url=${encodeURIComponent(currentUrl)}&text=${encodeURIComponent(pageTitle + ' - ' + description)}`;
      window.open(twitterUrl, '_blank', 'width=600,height=400');
    });

    // LinkedIn share
    const shareLinkedInBtn = document.getElementById('shareLinkedInBtn');
    shareLinkedInBtn?.addEventListener('click', () => {
      const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`;
      window.open(linkedInUrl, '_blank', 'width=600,height=400');
    });

    // Reddit share
    const shareRedditBtn = document.getElementById('shareRedditBtn');
    shareRedditBtn?.addEventListener('click', () => {
      const redditUrl = `https://reddit.com/submit?url=${encodeURIComponent(currentUrl)}&title=${encodeURIComponent(pageTitle)}`;
      window.open(redditUrl, '_blank', 'width=600,height=400');
    });

    // Threads share
    const shareThreadsBtn = document.getElementById('shareThreadsBtn');
    shareThreadsBtn?.addEventListener('click', () => {
      const threadsUrl = `https://threads.net/intent/post?text=${encodeURIComponent(pageTitle + ' - ' + description + ' ' + currentUrl)}`;
      window.open(threadsUrl, '_blank', 'width=600,height=400');
    });

    // WhatsApp share
    const shareWhatsAppBtn = document.getElementById('shareWhatsAppBtn');
    shareWhatsAppBtn?.addEventListener('click', () => {
      const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(pageTitle + ' - ' + description + ' ' + currentUrl)}`;
      window.open(whatsappUrl, '_blank');
    });
  };

  // Initialize when DOM is loaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initShareBar);
  } else {
    initShareBar();
  }
</script>
