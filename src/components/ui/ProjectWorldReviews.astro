---
// ProjectWorldReviews.astro - BounceCards style review component
// Displays reviews with bouncing animation and absolute positioning

import BounceReviewsIsland from './BounceReviewsIsland.tsx';
import type { Review } from '../../types/reviews';

export interface Props {
  className?: string;
  reviews?: Review[];
  containerWidth?: number;
  containerHeight?: number;
}

const { 
  className = "",
  reviews = [],
  containerWidth = 500,
  containerHeight = 500
} = Astro.props;

// Fallback reviews if none provided
const fallbackReviews: Review[] = [
  {
    id: "bounce-1",
    name: "Sarah Johnson",
    position: "CEO at TechStart",
    review: "Karen delivered an exceptional website that exceeded all our expectations. Her attention to detail and creative vision transformed our brand completely.",
    rating: 5,
    timestamp: new Date(),
    status: 'approved' as const
  },
  {
    id: "bounce-2",
    name: "Michael Chen",
    position: "Product Manager",
    review: "Working with Karen was a game-changer for our startup. She created a stunning UI/UX that our users absolutely love.",
    rating: 5,
    timestamp: new Date(),
    status: 'approved' as const
  },
  {
    id: "bounce-3",
    name: "Emily Rodriguez",
    position: "Creative Director",
    review: "Karen's motion design skills are incredible. She brought our static designs to life with beautiful animations.",
    rating: 5,
    timestamp: new Date(),
    status: 'approved' as const
  },
  {
    id: "bounce-4",
    name: "David Wilson",
    position: "CTO at InnovateHub",
    review: "The technical implementation was flawless. Karen's expertise in modern web technologies is outstanding.",
    rating: 5,
    timestamp: new Date(),
    status: 'approved' as const
  }
];

const reviewsData = reviews.length > 0 ? reviews : fallbackReviews;
---

<section class={`project-world-reviews ${className}`}>
  <div class="reviews-container">
    <!-- Title Section -->
    <div class="reviews-title">
      <div class="title-clients">Client's</div>
      <div class="title-reviews">reviews</div>
    </div>
    
    <BounceReviewsIsland 
      reviews={reviewsData}
      client:visible
    />
  </div>
</section>

<style>
  /* Light Mode Styles */
  :global(.project-world-reviews) {
    padding: 4rem 0;
    background-color: white;
    transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.reviews-container) {
    text-align: center;
    position: relative;
  }

  :global(.reviews-title) {
    margin-bottom: 3rem;
    position: relative;
    z-index: 10;
  }

  /* Header Section Styles */
  :global(.reviews-section__header) {
    position: relative;
    z-index: 15 !important;
    margin-bottom: 3rem;
  }

  :global(.reviews-section__title) {
    position: relative;
    z-index: 15 !important;
    margin-bottom: 1rem;
  }

  :global(.reviews-section__subtitle) {
    position: relative;
    z-index: 15 !important;
    color: rgba(8, 8, 8, 0.7);
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.title-clients) {
    display: inline;
    color: black;
    font-size: 64px;
    font-family: 'Playfair Display', serif;
    font-style: italic;
    margin-right: 20px;
    position: relative;
    z-index: 15;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.title-reviews) {
    display: inline;
    color: black;
    font-size: 64px;
    font-family: 'Inter', sans-serif;
    position: relative;
    z-index: 15;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark Mode Styles */
  :global(.dark-mode .project-world-reviews) {
    background: linear-gradient(to bottom, #050112 0%, #050112 100%);
  }

  :global(.dark-mode .title-clients) {
    color: #f8f4ff;
  }

  :global(.dark-mode .title-reviews) {
    color: #f8f4ff;
  }

  :global(.dark-mode .reviews-section__subtitle) {
    color: #b8c4e6;
  }

  /* Review Cards Z-Index Control */
  :global(.bounce-review-card) {
    position: relative;
    z-index: 5 !important;
  }

  :global(.review-card) {
    position: relative;
    z-index: 5 !important;
  }

  /* Ensure bounce cards container has lower z-index */
  :global(.bounce-cards-container) {
    position: relative;
    z-index: 1;
  }

  /* Additional Z-Index Overrides for Safety */
  :global(.reviews-section__header *) {
    position: relative;
    z-index: 15 !important;
  }

  /* Prevent any animated elements from covering text */
  :global(.reviews-container > *:not(.reviews-section__header)) {
    z-index: 5 !important;
  }

  @media (max-width: 768px) {
    :global(.title-clients),
    :global(.title-reviews) {
      font-size: 48px;
    }

    :global(.reviews-section__subtitle) {
      font-size: var(--text-base, 16px);
      padding: 0 1rem;
    }
  }

  @media (max-width: 480px) {
    :global(.title-clients),
    :global(.title-reviews) {
      font-size: 36px;
    }
    
    :global(.title-clients) {
      display: block;
      margin-right: 0;
      margin-bottom: 10px;
    }
    
    :global(.title-reviews) {
      display: block;
    }

    :global(.reviews-section__subtitle) {
      font-size: var(--text-sm, 14px);
      line-height: 1.5;
    }

    :global(.reviews-section__header) {
      padding: 0 0.5rem;
    }
  }
</style>
