---
import { Code } from 'astro:components';

export interface Props {
  code: string;
  language: string;
  title?: string;
  showLineNumbers?: boolean;
  className?: string;
}

const { 
  code, 
  language, 
  title, 
  showLineNumbers = false, 
  className = '' 
} = Astro.props;
---

<div class={`code-block-wrapper ${className}`}>
  {title && (
    <div class="code-block-header">
      <span class="code-block-title">{title}</span>
      <span class="code-block-language">{language}</span>
    </div>
  )}
  
  <div class="code-block-container">
    <Code 
      code={code} 
      lang={language}
      themes={{
        light: 'github-light',
        dark: 'github-dark'
      }}
      wrap={false}
    />
    
    <button 
      class="copy-button" 
      data-code={code}
      title="Copy code"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
        <path d="m4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
      </svg>
    </button>
  </div>
</div>

<style>
  .code-block-wrapper {
    margin: 1.5rem 0;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.1);
    transition: border-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode) .code-block-wrapper {
    border-color: rgba(255, 255, 255, 0.1);
  }

  .code-block-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    background: rgba(0, 0, 0, 0.05);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    transition: 
      background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
      border-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode) .code-block-header {
    background: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  .code-block-title {
    font-family: var(--font-primary);
    font-size: 14px;
    font-weight: 600;
    color: #1f2937;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode) .code-block-title {
    color: #ffffff;
  }

  .code-block-language {
    font-family: 'Courier New', monospace;
    font-size: 12px;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.dark-mode) .code-block-language {
    color: #9ca3af;
  }

  .code-block-container {
    position: relative;
  }

  .copy-button {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.5rem;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 6px;
    cursor: pointer;
    opacity: 0;
    transition: 
      opacity 0.3s ease,
      background-color 0.3s ease,
      transform 0.2s ease;
    color: #374151;
  }

  :global(.dark-mode) .copy-button {
    background: rgba(0, 0, 0, 0.8);
    border-color: rgba(255, 255, 255, 0.2);
    color: #d1d5db;
  }

  .code-block-container:hover .copy-button {
    opacity: 1;
  }

  .copy-button:hover {
    background: rgba(255, 255, 255, 1);
    transform: scale(1.05);
  }

  :global(.dark-mode) .copy-button:hover {
    background: rgba(0, 0, 0, 0.9);
  }

  .copy-button:active {
    transform: scale(0.95);
  }

  /* Override Astro Code component styles to remove default margins */
  .code-block-container :global(.astro-code) {
    margin: 0;
    border: none;
    border-radius: 0;
  }
</style>

<script>
  // Copy to clipboard functionality
  document.addEventListener('DOMContentLoaded', () => {
    const copyButtons = document.querySelectorAll('.copy-button');
    
    copyButtons.forEach(button => {
      button.addEventListener('click', async () => {
        const code = button.getAttribute('data-code');
        if (!code) return;
        
        try {
          await navigator.clipboard.writeText(code);
          
          // Visual feedback
          const originalHTML = button.innerHTML;
          button.innerHTML = `
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20,6 9,17 4,12"/>
            </svg>
          `;
          
          setTimeout(() => {
            button.innerHTML = originalHTML;
          }, 2000);
          
        } catch (err) {
          console.error('Failed to copy code:', err);
        }
      });
    });
  });
</script>
