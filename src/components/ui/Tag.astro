---
export interface Props {
  text: string;
  variant?: 'default' | 'outlined';
  size?: 'sm' | 'md';
}

const { text, variant = 'default', size = 'md' } = Astro.props;
---

<span class={`tag tag--${variant} tag--${size}`}>
  {text}
</span>

<style>
  .tag {
    display: inline-block;
    border-radius: 924px;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    text-transform: uppercase;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .tag--default {
    border: 0.55px solid rgba(17, 17, 17, 0.20);
    color: #151515;
    background: transparent;
  }

  .tag--outlined {
    border: 1px solid #151515;
    color: #151515;
    background: white;
  }

  .tag--sm {
    padding: 6px 9px;
    font-size: 10px;
    line-height: 14px;
  }

  .tag--md {
    padding: 8px 11px;
    font-size: 12px;
    line-height: 16px;
  }

  .tag:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }
</style>