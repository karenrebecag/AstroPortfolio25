---
// MyStack.astro
import MyStackIsland from './MyStackIsland.tsx';
import { DitheringShader } from '../three/DitheringShader.tsx';
---

<section class="my-stack-section">
  <!-- DitheringShader Background - Replicado del Footer con opacidad muy baja -->
  <div class="dithering-background">
    <DitheringShader
      client:visible
      width={1920}
      height={1080}
      colorBack="#ffffff"
      colorFront="#9D7FC1"
      shape="wave"
      type="8x8"
      pxSize={4}
      speed={0.3}
    />
  </div>
  
  <div class="container">
    <div class="title-wrapper">
      <h1 class="title">MY STACK</h1>
    </div>
    <!-- Island optimizado para 3D + Marquees -->
      <MyStackIsland client:visible />
    </motion.div>
  </div>
</section>

<style>
  .my-stack-section {
    width: 100%;
    background: white;
    background-image: 
      linear-gradient(rgba(0, 0, 0, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    position: relative;
    overflow: hidden;
  }

  /* DitheringShader Background con opacidad muy baja */
  .dithering-background {
    position: absolute;
    top: 180px;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.2;
    pointer-events: none;
    z-index: 0;
    mix-blend-mode: multiply;
  }

  @media (max-width: 768px) {
    .dithering-background {
      top: 0px;
    }
  }

  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 100%;
    position: relative;
    z-index: 1;
  }

  .title-wrapper {
    padding: 0px 60px 0px 60px;
    margin: 0 auto -100px auto;
    width: 100%;
    display: flex;
    justify-content: center;
    position: relative;
    z-index: 10;
  }

  /* Estilos globales para el Island */
  :global(.my-stack-island) {
    width: 100%;
    height: 100vh;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  :global(.stack-content-area) {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  :global(.model-3d-container) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    height: 800px;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.model-placeholder) {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(157, 127, 193, 0.1);
    border: 2px dashed rgba(157, 127, 193, 0.3);
    border-radius: 20px;
  }

  :global(.placeholder-content) {
    text-align: center;
    color: #9D7FC1;
  }

  :global(.placeholder-icon) {
    font-size: 48px;
    margin-bottom: 16px;
  }

  :global(.placeholder-text) {
    font-family: 'Median', sans-serif;
    font-size: 18px;
    font-weight: 600;
    margin: 0;
  }

  /* Estilos específicos para RingSphere 3D */
  :global(.ringsphere-background) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 5;
  }

  :global(.tech-marquees-wrapper) {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: end;
    z-index: 1;
  }

  :global(.tech-marquee-item) {
    width: 100%;
    height: 60px;
    display: flex;
    align-items: center;
    overflow: hidden;
    position: relative;
    opacity: 0.07;
    transition: opacity 0.3s ease-in-out;
  }

  :global(.tech-marquee-item:hover) {
    opacity: 0.2;
  }

  /* Estilos específicos para el texto de los marquees */
  :global(.tech-marquee-item .font-display) {
    font-family: 'Boysen', sans-serif !important;
    font-weight: 800 !important;
    font-size: 64px !important;
    letter-spacing: 0em;
  }

  .title {
    font-family: 'Median', sans-serif;
    font-weight: 900;
    font-size: 15vw;
    line-height: 1.2em;
    color: #060314;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    text-align: center;
    white-space: nowrap;
    width: 100%;
  }

  @media (max-width: 768px) {
    .my-stack-section {
      background-size: 20px 20px;
    }
    
    .title-wrapper {
      padding: 0px 30px 0px 30px;
      margin: 0 auto -80px auto;
      width: 100%;
      max-width: 100%;
    }

    :global(.my-stack-island) {
      height: 80vh;
    }

    :global(.model-3d-container) {
      width: 600px;
      height: 600px;
    }

    :global(.tech-marquees-wrapper) {
      height: 360px;
      gap: 10px;
    }
    
    :global(.tech-marquee-item) {
      height: 50px;
    }

    /* Marquees más pequeños en móviles */
    :global(.tech-marquee-item .font-display) {
      font-size: 48px !important;
    }

    .title {
      width: 100%;
      overflow: hidden;
      font-size: 15vw;
    }
  }
</style>
