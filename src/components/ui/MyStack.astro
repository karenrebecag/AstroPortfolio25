---
// MyStack.astro
import MyStackIsland from './MyStackIsland.tsx';
import { DitheringShader } from "../modules/Footer/shaders/DitheringShader";
import { TextDisperseBlack } from './TextDisperseBlack.tsx';
import { motion } from 'motion/react';
---

<section class="my-stack-section">
  <!-- DitheringShader Background - Replicado del Footer con opacidad muy baja -->
  <div class="dithering-background-container">
    <div class="dithering-background-wrapper">
      <div class="dithering-background">
        <DitheringShader
          client:visible
          width={1920}
          height={1080}
          colorBack="#ffffff"
          colorFront="#141223"
          shape="wave"
          type="8x8"
          pxSize={4}
          speed={0.3}
          style={{
            width: '100%',
            height: '100%',
            position: 'absolute',
            top: 0,
            left: 0
          }}
        />
      </div>
    </div>
  </div>
  
  <div class="container">
    <div class="title-wrapper">
      <motion.div
        className="title-container"
        initial={{ opacity: 0, y: 50 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true, margin: "-100px" }}
        transition={{ duration: 0.8, ease: "easeOut" }}
        client:idle
      >
        <TextDisperseBlack text="MY STACK" className="title-disperse-black" client:idle />
      </motion.div>
      
      <!-- Check my Stack Button -->
      <motion.div
        className="stack-button-container"
        initial={{ opacity: 0, y: 30 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true, margin: "-100px" }}
        transition={{ duration: 0.6, ease: "easeOut", delay: 0.4 }}
        client:idle
      >
        <button class="check-stack-btn" onclick="window.location.href='/resume#skills'">
          <span class="btn-text">Check my Stack</span>
          <svg class="btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7M17 7H7M17 7V17"/>
          </svg>
        </button>
      </motion.div>
    </div>
    <!-- Island optimizado para 3D + Marquees -->
    <MyStackIsland client:visible />
  </div>
</section>

<style>
  :global(.my-stack-section) {
    width: 100%;
    padding-top: 10vw;
    max-width: 100vw; /* Prevenir overflow horizontal */
    background: white;
    background-image: 
      linear-gradient(rgba(0, 0, 0, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    position: relative;
    overflow: hidden;
    box-sizing: border-box; /* Incluir padding y border en el width */
    transition: background 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), background-image 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* DitheringShader Background con opacidad muy baja */
  :global(.dithering-background-container) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
    transition: opacity 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .dithering-background-wrapper {
    width: 100%;
    max-width: 1800px;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .dithering-background {
    position: absolute;
    top: 180px;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.2;
    pointer-events: none;
    z-index: 0;
    mix-blend-mode: multiply;
  }

  /* Gradientes para el background DitheringShader en pantallas grandes */
  @media (min-width: 2560px) {
    .dithering-background-wrapper::before,
    .dithering-background-wrapper::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 120px;
      z-index: 1;
      pointer-events: none;
    }

    .dithering-background-wrapper::before {
      left: 0;
      background: linear-gradient(to right, white, transparent);
      transition: background 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .dithering-background-wrapper::after {
      right: 0;
      background: linear-gradient(to left, white, transparent);
      transition: background 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
  }

  @media (max-width: 768px) {
    .dithering-background {
      top: 0px;
    }
  }

  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 100%;
    position: relative;
    z-index: 1;
  }


  .title-wrapper {
    padding: 0px 60px 0px 60px;
    margin: 0 auto -100px auto;
    width: 100%;
    max-width: 1400px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 50; /* Aumentado significativamente */
    gap: 40px;
    pointer-events: none; /* Permitir que los clicks pasen a través del contenedor */
  }

  /* Estilos globales para el Island */
  :global(.my-stack-island) {
    width: 100%;
    height: 80vh;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  :global(.stack-content-area) {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  :global(.model-3d-container) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    height: 800px;
    max-width: 90vw; /* Prevenir overflow horizontal */
    max-height: 90vh; /* Prevenir overflow vertical */
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden; /* Asegurar que el contenido no se desborde */
  }

  /* Centrar todos los hijos del contenedor 3D */
  :global(.model-3d-container > *) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  :global(.model-placeholder) {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(157, 127, 193, 0.1);
    border: 2px dashed rgba(157, 127, 193, 0.3);
    border-radius: 20px;
  }

  :global(.placeholder-content) {
    text-align: center;
    color: #9D7FC1;
  }

  :global(.placeholder-icon) {
    font-size: 48px;
    margin-bottom: 16px;
  }

  :global(.placeholder-text) {
    font-family: 'Median', sans-serif;
    font-size: 18px;
    font-weight: 600;
    margin: 0;
  }

  /* Estilos específicos para Kirby 3D Model - centrado perfecto */
  :global(.kirby-3d-model) {
    position: relative; /* Cambio de absolute a relative para centrado automático */
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    z-index: 5;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.kirby-3d-container) {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    max-width: 100%;
    max-height: 100%;
  }

  /* Estilos específicos para el canvas de Three.js - centrado perfecto */
  :global(.kirby-3d-container canvas) {
    max-width: 100% !important;
    max-height: 100% !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: contain;
    display: block;
    box-sizing: border-box;
    margin: auto; /* Centrado automático */
  }

  /* Prevenir overflow en todos los elementos de la sección */
  .my-stack-section * {
    box-sizing: border-box;
  }

  .my-stack-section *,
  .my-stack-section *::before,
  .my-stack-section *::after {
    max-width: 100%;
  }

  :global(.kirby-loading) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: #9D7FC1;
    z-index: 10;
  }

  :global(.loading-spinner) {
    width: 40px;
    height: 40px;
    border: 4px solid rgba(157, 127, 193, 0.3);
    border-top: 4px solid #9D7FC1;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 16px auto;
  }

  :global(.kirby-loading p) {
    font-family: 'Median', sans-serif;
    font-size: 16px;
    font-weight: 600;
    margin: 0;
    color: #9D7FC1;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  :global(.tech-marquees-container) {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 480px;
    display: flex;
    justify-content: center;
    z-index: 1;
  }

  :global(.tech-marquees-wrapper-limited) {
    width: 100%;
    max-width: 1800px;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  :global(.tech-marquees-wrapper) {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: end;
    z-index: 1;
  }


  :global(.tech-marquee-item) {
    width: 100%;
    height: 60px;
    display: flex;
    align-items: center;
    overflow: hidden;
    position: relative;
    opacity: 0.07;
    transition: opacity 0.3s ease-in-out;
  }

  :global(.tech-marquee-item:hover) {
    opacity: 0.2;
  }

  /* Estilos específicos para el texto de los marquees */
  :global(.tech-marquee-item .font-display) {
    font-family: 'Boysen', sans-serif !important;
    font-weight: 800 !important;
    font-size: 64px !important;
    letter-spacing: 0em;
  }

  :global(.title-container) {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: auto; /* Permitir interacción con el título */
  }

  :global(.title-disperse-black) {
    font-family: var(--font-display) !important;
    font-size: clamp(80px, 15vw, 200px) !important;
    font-weight: 400 !important;
    color: #060314 !important;
    line-height: 0.8 !important;
    letter-spacing: -0.02em !important;
    text-transform: uppercase !important;
    margin: 0 !important;
    text-align: center !important;
    white-space: nowrap !important;
    width: 100% !important;
  }

  :global(.title-disperse-black span) {
    font-family: var(--font-display) !important;
    color: #060314 !important;
  }

  /* Check my Stack Button Styles */
  :global(.stack-button-container) {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    position: relative;
    z-index: 100; /* Muy alto para estar sobre todo */
  }

  .check-stack-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: linear-gradient(135deg, #4523AE 0%, #6B46C1 100%);
    color: white;
    border: none;
    border-radius: 25px;
    font-family: "VideoGameFont", monospace;
    font-size: 12px;
    font-weight: 400;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(69, 35, 174, 0.25);
    position: relative;
    z-index: 101; /* Aún más alto que el contenedor */
    overflow: hidden;
    pointer-events: auto; /* Asegurar que sea clickeable */
  }

  .check-stack-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.5s ease;
  }

  .check-stack-btn:hover::before {
    left: 100%;
  }

  .check-stack-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(69, 35, 174, 0.35);
    background: linear-gradient(135deg, #5a2cc5 0%, #7c5ce0 100%);
  }

  .check-stack-btn:active {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(69, 35, 174, 0.3);
  }

  .check-stack-btn .btn-text {
    color: white;
    line-height: 1;
    position: relative;
    z-index: 1;
  }

  .check-stack-btn .btn-icon {
    width: 14px;
    height: 14px;
    stroke: white;
    stroke-width: 2.5;
    transition: transform 0.3s ease;
    position: relative;
    z-index: 1;
  }

  .check-stack-btn:hover .btn-icon {
    transform: translate(2px, -2px);
  }

  @media (max-width: 768px) {
    .my-stack-section {
      background-size: 20px 20px;
    }
    
    .title-wrapper {
      padding: 0px 30px 0px 30px;
      margin: 0 auto -80px auto;
      width: 100%;
      max-width: 100%;
      gap: 30px;
    }

    .check-stack-btn {
      padding: 10px 16px;
      font-size: 11px;
      border-radius: 20px;
    }

    .check-stack-btn .btn-icon {
      width: 12px;
      height: 12px;
    }

    :global(.title-container) {
      justify-content: center;
    }

    :global(.title-disperse-black) {
      justify-content: center !important;
    }

    :global(.my-stack-island) {
      height: 80vh;
    }

    :global(.model-3d-container) {
      width: 350px;
      height: 350px;
      max-width: 90vw;
      max-height: 90vh;
    }

    :global(.tech-marquees-container) {
      height: 360px;
    }

    :global(.tech-marquees-wrapper) {
      height: 360px;
      gap: 10px;
    }
    
    :global(.tech-marquee-item) {
      height: 50px;
    }

    /* Marquees más pequeños en móviles */
    :global(.tech-marquee-item .font-display) {
      font-size: 48px !important;
    }

    :global(.title-disperse-black) {
      font-size: clamp(60px, 12vw, 120px) !important;
    }
  }

  /* Dark Mode Styles - Following Documentation Pattern */
  :global(.dark-mode .my-stack-section) {
    background-color: transparent;
    background-image:
      linear-gradient(to right, rgba(71,85,105,0.15) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(71,85,105,0.15) 1px, transparent 1px),
      radial-gradient(circle at 50% 60%, rgba(236,72,153,0.15) 0%, rgba(168,85,247,0.05) 40%, transparent 70%);
    background-size: 40px 40px, 40px 40px, 100% 100%;
    background-position: 0 0, 0 0, center;
    background-repeat: repeat, repeat, no-repeat;
  }

  /* Hide DitheringShader in dark mode */
  :global(.dark-mode .dithering-background-container) {
    opacity: 0;
    visibility: hidden;
  }

  /* Dark mode gradients for large screens */
  @media (min-width: 2560px) {
    :global(.dark-mode) .dithering-background-wrapper::before {
      background: linear-gradient(to right, #020009, transparent);
    }

    :global(.dark-mode) .dithering-background-wrapper::after {
      background: linear-gradient(to left, #020009, transparent);
    }
  }

  /* Title Dark Mode */
  :global(.dark-mode .title-disperse-black) {
    color: #f8f4ff !important;
  }

  :global(.dark-mode .title-disperse-black span) {
    color: #f8f4ff !important;
  }

  /* Button Dark Mode */
  :global(.dark-mode) .check-stack-btn {
    background: linear-gradient(135deg, #9D7FC1 0%, #d4a5ff 100%);
    box-shadow: 0 4px 15px rgba(157, 127, 193, 0.25);
  }

  :global(.dark-mode) .check-stack-btn:hover {
    background: linear-gradient(135deg, #b8a3ff 0%, #e6d9f0 100%);
    box-shadow: 0 6px 20px rgba(157, 127, 193, 0.35);
  }

  /* Placeholder Dark Mode */
  :global(.dark-mode .model-placeholder) {
    background: rgba(157, 127, 193, 0.15);
    border-color: rgba(157, 127, 193, 0.4);
  }

  :global(.dark-mode .placeholder-content) {
    color: #d4a5ff;
  }

  /* Loading Dark Mode */
  :global(.dark-mode .kirby-loading) {
    color: #d4a5ff;
  }

  :global(.dark-mode .loading-spinner) {
    border-color: rgba(157, 127, 193, 0.3);
    border-top-color: #d4a5ff;
  }

  :global(.dark-mode .kirby-loading p) {
    color: #d4a5ff;
  }
</style>
