---
// MyStack.astro
import MyStackIsland from './MyStackIsland.tsx';
import { DitheringShader } from '../three/DitheringShader.tsx';
import { TextDisperseBlack } from './TextDisperseBlack.tsx';
import { motion } from 'motion/react';
---

<section class="my-stack-section">
  <!-- DitheringShader Background - Replicado del Footer con opacidad muy baja -->
  <div class="dithering-background">
    <DitheringShader
      client:visible
      width={1920}
      height={1080}
      colorBack="#ffffff"
      colorFront="#141223"
      shape="wave"
      type="8x8"
      pxSize={4}
      speed={0.3}
    />
  </div>
  
  <div class="container">
    <div class="title-wrapper">
      <motion.div 
        className="title-container"
        initial={{ opacity: 0, y: 50 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true, margin: "-100px" }}
        transition={{ duration: 0.8, ease: "easeOut" }}
        client:load
      >
        <TextDisperseBlack text="MY STACK" className="title-disperse-black" client:load />
      </motion.div>
    </div>
    <!-- Island optimizado para 3D + Marquees -->
    <MyStackIsland client:visible />
  </div>
</section>

<style>
  .my-stack-section {
    width: 100%;
    max-width: 100vw; /* Prevenir overflow horizontal */
    background: white;
    background-image: 
      linear-gradient(rgba(0, 0, 0, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    position: relative;
    overflow: hidden;
    box-sizing: border-box; /* Incluir padding y border en el width */
  }

  /* DitheringShader Background con opacidad muy baja */
  .dithering-background {
    position: absolute;
    top: 180px;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.2;
    pointer-events: none;
    z-index: 0;
    mix-blend-mode: multiply;
  }

  @media (max-width: 768px) {
    .dithering-background {
      top: 0px;
    }
  }

  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 100%;
    position: relative;
    z-index: 1;
  }

  .title-wrapper {
    padding: 0px 60px 0px 60px;
    margin: 0 auto -100px auto;
    width: 100%;
    display: flex;
    justify-content: center;
    position: relative;
    z-index: 10;
  }

  /* Estilos globales para el Island */
  :global(.my-stack-island) {
    width: 100%;
    height: 80vh;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  :global(.stack-content-area) {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  :global(.model-3d-container) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 800px;
    height: 800px;
    max-width: 90vw; /* Prevenir overflow horizontal */
    max-height: 90vh; /* Prevenir overflow vertical */
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden; /* Asegurar que el contenido no se desborde */
  }

  /* Centrar todos los hijos del contenedor 3D */
  :global(.model-3d-container > *) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  :global(.model-placeholder) {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(157, 127, 193, 0.1);
    border: 2px dashed rgba(157, 127, 193, 0.3);
    border-radius: 20px;
  }

  :global(.placeholder-content) {
    text-align: center;
    color: #9D7FC1;
  }

  :global(.placeholder-icon) {
    font-size: 48px;
    margin-bottom: 16px;
  }

  :global(.placeholder-text) {
    font-family: 'Median', sans-serif;
    font-size: 18px;
    font-weight: 600;
    margin: 0;
  }

  /* Estilos específicos para Kirby 3D Model - centrado perfecto */
  :global(.kirby-3d-model) {
    position: relative; /* Cambio de absolute a relative para centrado automático */
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    z-index: 5;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.kirby-3d-container) {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    max-width: 100%;
    max-height: 100%;
  }

  /* Estilos específicos para el canvas de Three.js - centrado perfecto */
  :global(.kirby-3d-container canvas) {
    max-width: 100% !important;
    max-height: 100% !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: contain;
    display: block;
    box-sizing: border-box;
    margin: auto; /* Centrado automático */
  }

  /* Prevenir overflow en todos los elementos de la sección */
  .my-stack-section * {
    box-sizing: border-box;
  }

  .my-stack-section *,
  .my-stack-section *::before,
  .my-stack-section *::after {
    max-width: 100%;
  }

  :global(.kirby-loading) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: #9D7FC1;
    z-index: 10;
  }

  :global(.loading-spinner) {
    width: 40px;
    height: 40px;
    border: 4px solid rgba(157, 127, 193, 0.3);
    border-top: 4px solid #9D7FC1;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 16px auto;
  }

  :global(.kirby-loading p) {
    font-family: 'Median', sans-serif;
    font-size: 16px;
    font-weight: 600;
    margin: 0;
    color: #9D7FC1;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  :global(.tech-marquees-wrapper) {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: end;
    z-index: 1;
  }

  :global(.tech-marquee-item) {
    width: 100%;
    height: 60px;
    display: flex;
    align-items: center;
    overflow: hidden;
    position: relative;
    opacity: 0.07;
    transition: opacity 0.3s ease-in-out;
  }

  :global(.tech-marquee-item:hover) {
    opacity: 0.2;
  }

  /* Estilos específicos para el texto de los marquees */
  :global(.tech-marquee-item .font-display) {
    font-family: 'Boysen', sans-serif !important;
    font-weight: 800 !important;
    font-size: 64px !important;
    letter-spacing: 0em;
  }

  :global(.title-container) {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  @media (max-width: 768px) {
    :global(.title-container) {
      justify-content: flex-start;
    }
  }

  :global(.title-disperse-black) {
    font-family: var(--font-display) !important;
    font-size: 10.5vw !important;
    font-weight: 400 !important;
    color: #060314 !important;
    line-height: 0.9 !important;
    letter-spacing: -0.02em !important;
    text-transform: uppercase !important;
    margin: 0 !important;
    text-align: center !important;
    white-space: nowrap !important;
  }

  :global(.title-disperse-black span) {
    font-family: var(--font-display) !important;
    color: #060314 !important;
  }

  @media (max-width: 768px) {
    .my-stack-section {
      background-size: 20px 20px;
    }
    
    .title-wrapper {
      padding: 0px 30px 0px 30px;
      margin: 0 auto -80px auto;
      width: 100%;
      max-width: 100%;
    }

    :global(.my-stack-island) {
      height: 80vh;
    }

    :global(.model-3d-container) {
      width: min(500px, 90vw); /* Usar el menor entre 500px y 90% del viewport */
      height: min(500px, 60vh); /* Usar el menor entre 500px y 60% del viewport height */
      max-width: 90vw;
      max-height: 60vh;
    }

    :global(.tech-marquees-wrapper) {
      height: 360px;
      gap: 10px;
    }
    
    :global(.tech-marquee-item) {
      height: 50px;
    }

    /* Marquees más pequeños en móviles */
    :global(.tech-marquee-item .font-display) {
      font-size: 48px !important;
    }

    :global(.title-disperse-black) {
      font-size: 7.35vw !important; /* 30% reducción para móvil */
    }
  }
</style>
