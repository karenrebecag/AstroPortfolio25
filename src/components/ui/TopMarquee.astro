---
// TopMarquee - Lightweight marquee banner for header
import { getLangFromUrl } from '../../i18n/utils.js';
import { translations } from '../../i18n/translations.js';

// Detectar idioma de la URL actual
const lang = getLangFromUrl(Astro.url);
const t = translations[lang as keyof typeof translations] || translations.en;
---

<div class="top-marquee-container">
  <div class="top-marquee-wrapper">
    <div id="top-marquee" class="top-marquee">
      <span class="marquee-text">
        {t.topMarquee.text}
      </span>
      <span class="marquee-text">
        {t.topMarquee.text}
      </span>
    </div>
  </div>
</div>

<style>
  .top-marquee-container {
    width: 100%;
    height: 32px;
    background-color: #7754cd;
    overflow: hidden;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 101;
    display: flex;
    justify-content: center;
    transition: background 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark mode styles - Intense purple gradient */
  :global(.dark-mode) .top-marquee-container {
    background: linear-gradient(90deg, #160021 0%, #1b0027 50%, #3d005c 100%);
  }

  .top-marquee-wrapper {
    width: 100%;
    max-width: 1800px;
    height: 100%;
    overflow: hidden;
    position: relative;
  }

  .top-marquee {
    display: flex;
    white-space: nowrap;
    width: max-content;
    height: 100%;
    align-items: center;
    animation: marquee-scroll 120s linear infinite;
  }

  @keyframes marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .marquee-text {
    font-family: 'Boysen', var(--font-primary);
    font-size: 14px;
    font-weight: 400;
    color: white;
    letter-spacing: 0.5px;
    padding-right: 0;
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    contain: layout style;
    will-change: transform;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark mode text - Brighter white with subtle glow */
  :global(.dark-mode) .marquee-text {
    color: #f8f4ff;
    text-shadow: 0 0 8px rgba(255, 255, 255, 0.3);
  }

  /* Gradientes laterales para pantallas grandes */
  @media (min-width: 2560px) {
    .top-marquee-wrapper::before,
    .top-marquee-wrapper::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 120px;
      z-index: 2;
      pointer-events: none;
    }

    .top-marquee-wrapper::before {
      left: 0;
      background: linear-gradient(to right, #7256c6, transparent);
      transition: background 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .top-marquee-wrapper::after {
      right: 0;
      background: linear-gradient(to left, #7256c6, transparent);
      transition: background 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    /* Dark mode gradients - Darker purple tones */
    :global(.dark-mode) .top-marquee-wrapper::before {
      background: linear-gradient(to right, #3d005c, transparent);
    }

    :global(.dark-mode) .top-marquee-wrapper::after {
      background: linear-gradient(to left, #3d005c, transparent);
    }
  }

  @media (max-width: 768px) {
    .top-marquee-container {
      height: 28px;
    }
    
    .marquee-text {
      font-size: 12px;
    }
  }
</style>

