---
// GetInTouch.astro - Sección de contacto con formulario interactivo (Dark Mode)
import GetInTouchIsland from './GetInTouchIsland.tsx';
import { DitheringShader } from '../three/DitheringShader.tsx';
import { NoiseBackground } from './NoiseBackground.tsx';
---

<section id="contact" class="get-in-touch-section">
  <!-- Noise Background Effect -->
  <NoiseBackground opacity={0.08} speed={0.2} className="dark" client:load />
  
  <!-- DitheringShader Background - Igual que Projects pero con menor opacidad -->
  <div class="dithering-background">
    <DitheringShader
      client:visible
      width={1920}
      height={1080}
      colorBack="#000000"
      colorFront="#ffffff"
      shape="swirl"
      type="8x8"
      pxSize={4}
      speed={0.4}
    />
  </div>
  
  <!-- Top Decorative Border -->
  <div class="decorative-border top-border"></div>
  
  <!-- Bottom Decorative Border -->
  <div class="decorative-border bottom-border"></div>
  
  <!-- Main Content -->
  <div class="contact-container">
    <GetInTouchIsland client:load />
  </div>
</section>

<style>
  .get-in-touch-section {
    width: 100%;
    min-height: 100vh;
    background: #050112;
    position: relative;
    overflow: hidden;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  /* DitheringShader Background - Igual que Projects pero con menor opacidad */
  .dithering-background {
    position: absolute;
    left: 0;
    top: -100px;
    width: 100%;
    height: 100%;
    opacity: 0.08;
    pointer-events: none;
    z-index: 0;
    mix-blend-mode: screen;
    transform: rotate(180deg);
  }

  /* Decorative Borders */
  .decorative-border {
    position: absolute;
    width: 1296px;
    height: 94px;
    left: 50%;
    transform: translateX(-50%);
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-left: 1px solid rgba(17, 17, 17, 0.20);
    border-top: 1px solid rgba(17, 17, 17, 0.20);
    border-right: 1px solid rgba(17, 17, 17, 0.20);
    backdrop-filter: blur(8px);
  }

  .top-border {
    top: 0;
  }

  .bottom-border {
    bottom: 0;
    transform: translateX(-50%) rotate(180deg);
  }

  .contact-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 220px 72px 120px 72px;
    position: relative;
    z-index: 2;
  }

  /* Contact Form Styles */
  :global(.contact-form) {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 40px;
    position: relative;
  }

  /* Header Styles */
  :global(.contact-header) {
    width: 100%;
    max-width: fit-content;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  :global(.contact-subtitle) {
    color: #808080;
    font-size: 12px;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    text-transform: uppercase;
    line-height: 16px;
  }

  :global(.contact-title) {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    width: fit-content;
  }

  :global(.contact-title span) {
    color: white;
    font-size: clamp(60px, 8vw, 100px);
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 64px;
  }

  /* Form Container */
  :global(.contact-form-container) {
    width: 100%;
    max-width: 1296px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* Form Row */
  :global(.form-row) {
    display: flex;
    gap: 12px;
  }

  :global(.form-field) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  :global(.field-label) {
    color: white;
    font-size: 18px;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    line-height: 28px;
    display: flex;
    align-items: center;
  }

  :global(.field-label svg) {
    color: white;
    flex-shrink: 0;
    margin-right: 8px;
  }

  :global(.input-container) {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  :global(.field-input) {
    background: transparent;
    border: none;
    outline: none;
    color: rgba(255, 255, 255, 0.30);
    font-size: 16px;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    line-height: 24px;
    padding: 0;
  }

  :global(.field-input:focus) {
    color: white;
  }

  :global(.field-input::placeholder) {
    color: rgba(255, 255, 255, 0.30);
  }

  :global(.field-underline) {
    height: 1px;
    background: rgba(255, 255, 255, 0.15);
    transition: background 0.3s ease;
  }

  :global(.field-input.focused + .field-underline) {
    background: rgba(255, 255, 255, 0.5);
  }

  /* Interests Section */
  :global(.interests-section) {
    width: 821px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  :global(.interests-options) {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  :global(.interest-pill) {
    height: 44px;
    padding: 0 24px;
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.20);
    background: transparent;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  :global(.interest-pill.selected) {
    border-color: white;
  }

  :global(.interest-pill span) {
    color: white;
    font-size: 16px;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    line-height: 24px;
  }

  /* Budget Section */
  :global(.budget-section) {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  :global(.budget-options) {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  :global(.budget-pill) {
    height: 44px;
    padding: 0 24px;
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: transparent;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: white;
    font-size: 16px;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    line-height: 24px;
  }

  :global(.budget-pill.selected) {
    border-color: white;
    background: rgba(255, 255, 255, 0.1);
  }

  /* Message Section */
  :global(.message-section) {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  :global(.message-container) {
    min-height: 116px;
  }

  :global(.message-input) {
    width: 100%;
    min-height: 116px;
    background: transparent;
    border: none;
    outline: none;
    color: rgba(255, 255, 255, 0.30);
    font-size: 16px;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    line-height: 24px;
    resize: vertical;
    padding: 0;
  }

  :global(.message-input:focus) {
    color: white;
  }

  :global(.message-input::placeholder) {
    color: rgba(255, 255, 255, 0.30);
  }

  :global(.message-underline) {
    width: 100%;
    height: 1px;
    background: rgba(255, 255, 255, 0.15);
    transition: background 0.3s ease;
  }

  :global(.message-input.focused ~ .message-underline) {
    background: rgba(255, 255, 255, 0.5);
  }

  /* Attachment Section */
  :global(.attachment-section) {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  :global(.attachment-button) {
    display: flex;
    align-items: center;
    gap: 16px;
    cursor: pointer;
    padding: 16px 0;
    transition: all 0.3s ease;
  }

  :global(.attachment-button svg) {
    color: white;
    flex-shrink: 0;
    margin-right: 8px;
  }

  :global(.attachment-button span) {
    color: white;
    font-size: 16px;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    line-height: 24px;
  }

  :global(.file-input) {
    display: none;
  }

  :global(.attachment-preview) {
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
    font-family: 'Poppins', sans-serif;
  }

  /* Submit Section */
  :global(.submit-section) {
    width: 315px;
  }

  :global(.submit-button) {
    width: 100%;
    padding: 4px 4px 4px 24px;
    background: white;
    border: none;
    border-radius: 999px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  :global(.submit-button:hover) {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(255, 255, 255, 0.2);
  }

  :global(.submit-button span) {
    color: #0D0D0D;
    font-size: 16px;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    line-height: 24px;
  }

  :global(.submit-icon) {
    width: 48px;
    height: 48px;
    background: #0D0D0D;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Email Badge */
  :global(.email-badge) {
    position: absolute;
    top: 220px;
    right: 72px;
    padding: 10px 16px;
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.20);
    display: flex;
    align-items: center;
    gap: 8px;
    backdrop-filter: blur(8px);
    background: rgba(255, 255, 255, 0.05);
  }

  :global(.email-badge svg) {
    color: white;
    flex-shrink: 0;
    margin-right: 6px;
  }

  :global(.email-badge span) {
    color: white;
    font-size: 14px;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    line-height: 20px;
  }

  /* Responsive Design */
  @media (max-width: 1440px) {
    .decorative-border {
      width: 90%;
    }

    .contact-container {
      padding: 160px 40px 80px 40px;
    }

    :global(.email-badge) {
      right: 40px;
    }
  }

  @media (max-width: 768px) {
    .decorative-border {
      width: 95%;
      height: 60px;
    }

    .contact-container {
      padding: 120px 20px 60px 20px;
    }

    :global(.contact-header) {
      width: 100%;
    }

    :global(.contact-title span) {
      font-size: clamp(40px, 12vw, 60px);
      line-height: 1.1;
    }

    :global(.form-row) {
      flex-direction: column;
      gap: 32px;
    }

    :global(.interests-section) {
      width: 100%;
    }

    :global(.interests-options),
    :global(.budget-options) {
      justify-content: flex-start;
    }

    :global(.email-badge) {
      position: static;
      margin-top: 20px;
      align-self: flex-start;
    }

    :global(.submit-section) {
      width: 100%;
      max-width: 315px;
    }
  }

  @media (max-width: 480px) {
    :global(.interest-pill),
    :global(.budget-pill) {
      font-size: 14px;
      padding: 0 16px;
      height: 40px;
    }

    :global(.contact-title) {
      flex-direction: column;
      gap: 8px;
      align-items: flex-start;
    }
  }
</style>
