---
// GetInTouch.astro - Sección de contacto con formulario interactivo (Dark Mode)
import GetInTouchIsland from './GetInTouchIsland.tsx';
import { DitheringShader } from '../three/DitheringShader.tsx';
import { NoiseBackground } from './NoiseBackground.tsx';
import ReviewsIsland from './ReviewsIsland.tsx';
---

<section id="contact" class="get-in-touch-section">
  <!-- Noise Background Effect -->
  <NoiseBackground opacity={0.08} speed={0.2} className="dark" client:load />
  
  <!-- DitheringShader Background - Igual que Projects pero con menor opacidad -->
  <div class="dithering-background">
    <DitheringShader
      client:visible
      width={1920}
      height={1800}
      colorBack="#000000"
      colorFront="#ffffff"
      shape="swirl"
      type="8x8"
      pxSize={4}
      speed={0.4}
    />
  </div>
  

  
  <!-- Main Content -->
  <div class="contact-container">
    <GetInTouchIsland client:load />
  </div>
  
  <!-- Reviews Section -->
  <div class="reviews-container">
    <ReviewsIsland client:visible />
  </div>
</section>

<style>
  .get-in-touch-section {
    width: 100%;
    min-height: 100vh;
    background: #050112;
    position: relative;
    overflow: hidden;
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  /* DitheringShader Background - Igual que Projects pero con menor opacidad */
  .dithering-background {
    position: absolute;
    left: 0;
    top: -100px;
    width: 100%;
    height: 100%;
    opacity: 0.08;
    pointer-events: none;
    z-index: 0;
    mix-blend-mode: screen;
    transform: rotate(180deg);
  }

  /* Decorative Borders */
  .decorative-border {
    position: absolute;
    width: 1296px;
    height: 94px;
    left: 50%;
    transform: translateX(-50%);
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-left: 1px solid rgba(17, 17, 17, 0.20);
    border-top: 1px solid rgba(17, 17, 17, 0.20);
    border-right: 1px solid rgba(17, 17, 17, 0.20);
    backdrop-filter: blur(8px);
  }

  .top-border {
    top: 0;
  }

  .bottom-border {
    bottom: 0;
    transform: translateX(-50%) rotate(180deg);
  }

  .contact-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 220px 72px 120px 72px;
    position: relative;
    z-index: 2;
  }

  /* Contact Form Styles */
  :global(.contact-form) {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 40px;
    position: relative;
  }

  /* Header Styles */
  :global(.contact-header) {
    width: 100%;
    max-width: fit-content;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  :global(.contact-subtitle) {
    color: #808080;
    font-size: 12px;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    text-transform: uppercase;
    line-height: 16px;
  }

  :global(.contact-title) {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    width: fit-content;
  }

  :global(.contact-title span) {
    color: white;
    font-size: clamp(60px, 8vw, 100px);
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 64px;
  }

  /* Form Container */
  :global(.contact-form-container) {
    width: 100%;
    max-width: 1296px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* Align last two sections to the right */
  :global(.contact-form-container > .attachment-section),
  :global(.contact-form-container > .submit-section) {
    align-self: flex-end;
  }

  /* Form Row */
  :global(.form-row) {
    display: flex;
    gap: 12px;
  }

  :global(.form-field) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  :global(.field-label) {
    color: white;
    font-size: 18px;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    line-height: 28px;
    display: flex;
    align-items: center;
  }

  :global(.field-label svg) {
    color: white;
    flex-shrink: 0;
    margin-right: 8px;
  }

  :global(.input-container) {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  :global(.field-input) {
    background: transparent;
    border: none;
    outline: none;
    color: rgba(255, 255, 255, 0.30);
    font-size: 16px;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    line-height: 24px;
    padding: 0;
  }

  :global(.field-input:focus) {
    color: white;
  }

  :global(.field-input::placeholder) {
    color: rgba(255, 255, 255, 0.30);
  }

  :global(.field-underline) {
    height: 1px;
    background: rgba(255, 255, 255, 0.15);
    transition: background 0.3s ease;
  }

  :global(.field-input.focused + .field-underline) {
    background: rgba(255, 255, 255, 0.5);
  }

  /* Interests Section */
  :global(.interests-section) {
    width: 821px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  :global(.interests-options) {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  :global(.interest-pill) {
    height: 44px;
    padding: 0 24px;
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.20);
    background: transparent;
    display: flex;
    justify-content: center;
    align-items: center;
    color: white;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  :global(.interest-pill.selected) {
    border-color: white;
  }

  :global(.interest-pill span) {
    color: white;
    font-size: 16px;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    line-height: 24px;
  }

  /* Budget Section */
  :global(.budget-section) {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  :global(.budget-options) {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  :global(.budget-pill) {
    height: 44px;
    padding: 0 24px;
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: transparent;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: white;
    font-size: 16px;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    line-height: 24px;
  }

  :global(.budget-pill.selected) {
    border-color: white;
    background: rgba(255, 255, 255, 0.1);
  }

  /* Message Section */
  :global(.message-section) {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  :global(.message-container) {
    min-height: 116px;
  }

  :global(.message-input) {
    width: 100%;
    min-height: 116px;
    background: transparent;
    border: none;
    outline: none;
    color: rgba(255, 255, 255, 0.30);
    font-size: 16px;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    line-height: 24px;
    resize: vertical;
    padding: 0;
  }

  :global(.message-input:focus) {
    color: white;
  }

  :global(.message-input::placeholder) {
    color: rgba(255, 255, 255, 0.30);
  }

  :global(.message-underline) {
    width: 100%;
    height: 1px;
    background: rgba(255, 255, 255, 0.15);
    transition: background 0.3s ease;
  }

  :global(.message-input.focused ~ .message-underline) {
    background: rgba(255, 255, 255, 0.5);
  }

  /* Attachment Section */
  :global(.attachment-section) {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-end;
  }

  :global(.attachment-button) {
    display: flex;
    align-items: center;
    gap: 16px;
    cursor: pointer;
    padding: 16px 0;
    transition: all 0.3s ease;
  }

  :global(.attachment-button svg) {
    color: white;
    flex-shrink: 0;
    margin-right: 8px;
  }

  :global(.attachment-button span) {
    color: white;
    font-size: 16px;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    line-height: 24px;
  }

  :global(.file-input) {
    display: none;
  }

  :global(.attachment-preview) {
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
    font-family: 'Poppins', sans-serif;
  }

  /* Attachment Tag Styles */
  :global(.attachment-tag) {
    margin-top: 12px;
  }

  :global(.attachment-tag-content) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    backdrop-filter: blur(8px);
    max-width: 300px;
  }

  :global(.attachment-icon) {
    color: #9D7FC1;
    flex-shrink: 0;
  }

  :global(.attachment-info) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  :global(.attachment-name) {
    color: white;
    font-size: 14px;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.attachment-size) {
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
  }

  :global(.remove-attachment-btn) {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.3);
    border-radius: 6px;
    padding: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  :global(.remove-attachment-btn:hover) {
    background: rgba(239, 68, 68, 0.2);
    border-color: rgba(239, 68, 68, 0.5);
  }

  :global(.remove-attachment-btn svg) {
    color: #ef4444;
  }

  :global(.file-specs) {
    margin-top: 8px;
  }

  :global(.file-specs span) {
    color: rgba(255, 255, 255, 0.5);
    font-size: 12px;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
  }

  /* Submit Section */
  :global(.submit-section) {
    width: 315px;
    display: flex;
    justify-content: flex-end;
  }

  :global(.submit-button) {
    width: 100%;
    padding: 4px 4px 4px 24px;
    background: white;
    border: none;
    border-radius: 999px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  :global(.submit-button:hover) {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(255, 255, 255, 0.2);
  }

  :global(.submit-button:disabled) {
    cursor: not-allowed !important;
    opacity: 0.7;
  }

  :global(.animate-spin) {
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  :global(.submit-button span) {
    color: #0D0D0D;
    font-size: 16px;
    font-family: 'Poppins', sans-serif;
    font-weight: 500;
    line-height: 24px;
  }

  :global(.submit-icon) {
    width: 48px;
    height: 48px;
    background: #0D0D0D;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Email Badge */
  :global(.email-badge) {
    position: absolute;
    top: 220px;
    right: 72px;
    padding: 10px 16px;
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.20);
    display: flex;
    align-items: center;
    gap: 8px;
    backdrop-filter: blur(8px);
    background: rgba(255, 255, 255, 0.05);
  }

  :global(.email-badge svg) {
    color: white;
    flex-shrink: 0;
    margin-right: 6px;
  }

  :global(.email-badge span) {
    color: white;
    font-size: 14px;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    line-height: 20px;
  }

  /* Reviews Section */
  .reviews-container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0px 2rem 0 2rem;
    position: relative;
    z-index: 2;
  }

  /* Reviews Marquee */
  :global(.reviews-marquee-wrapper) {
    width: 100%;
    overflow: hidden;
    position: relative;
    mask: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    -webkit-mask: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  :global(.reviews-marquee) {
    display: flex;
    animation: marqueeScroll 60s linear infinite;
    will-change: transform;
  }

  :global(.reviews-set) {
    display: flex;
    gap: 2rem;
    flex-shrink: 0;
  }

  /* Review Card Marquee */
  :global(.review-card-marquee) {
    width: 400px;
    flex-shrink: 0;
    padding: 0px 0px 80px 0px;

  }

  :global(.card-inner) {
    position: relative;
    border: 2px solid transparent;
    border-radius: 45px;
    padding: 2.5rem;
    background: linear-gradient(135deg, #141020 0%, rgb(30, 26, 32) 50%, #141020 100%);
    background-clip: padding-box;
  }

  /* Gradient border */
  :global(.gradient-border) {
    position: absolute;
    inset: -2px;
    border-radius: 45px;
    background: linear-gradient(71deg, #333333, #ffffff, #333333);
    z-index: -1;
  }

  /* Profile Section */
  :global(.profile-section) {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  :global(.profile-pic) {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid #ffffff;
    flex-shrink: 0;
  }

  :global(.profile-pic img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  :global(.reviewer-name) {
    font-family: var(--font-display); /* Median */
    font-size: 1.5rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.02em;
  }

  /* Review Description */
  :global(.review-description) {
    font-family: var(--font-primary); /* InterTight */
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    max-width: 100%;
  }

  /* Marquee Animation */
  @keyframes marqueeScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Reduce motion for accessibility */
  @media (prefers-reduced-motion: reduce) {
    :global(.reviews-marquee) {
      animation: none;
    }
    
    :global(.reviews-marquee-wrapper) {
      overflow-x: auto;
      scroll-behavior: smooth;
    }
    
    :global(.reviews-marquee) {
      justify-content: flex-start;
      gap: 2rem;
    }
  }

  /* Responsive Design */
  @media (max-width: 1440px) {
    .decorative-border {
      width: 90%;
    }

    .contact-container {
      padding: 160px 40px 80px 40px;
    }

    :global(.email-badge) {
      right: 40px;
    }

    .reviews-container {
      padding: 20px 1rem 0 1rem;
    }
  }

  @media (max-width: 768px) {
    .decorative-border {
      width: 95%;
      height: 60px;
    }

    .contact-container {
      padding: 120px 20px 60px 20px;
    }

    :global(.contact-header) {
      width: 100%;
    }

    :global(.contact-title span) {
      font-size: clamp(40px, 12vw, 60px);
      line-height: 1.1;
    }

    :global(.form-row) {
      flex-direction: column;
      gap: 32px;
    }

    :global(.interests-section) {
      width: 100%;
    }

    :global(.interests-options),
    :global(.budget-options) {
      justify-content: flex-start;
    }

    :global(.email-badge) {
      position: static;
      margin-top: 20px;
      align-self: flex-start;
    }

    :global(.submit-section) {
      width: 100%;
      max-width: 315px;
      align-self: center !important;
    }

    :global(.attachment-section) {
      align-self: center !important;
    }

    .reviews-container {
      padding: 40px 1rem 0 1rem;
    }

    :global(.review-card-marquee) {
      width: 350px;
    }

    :global(.reviews-set) {
      gap: 1.5rem;
    }

    :global(.reviews-marquee) {
      animation-duration: 45s;
    }

    :global(.card-inner) {
      padding: 2rem;
    }

    :global(.reviewer-name) {
      font-size: 1.25rem;
    }

    :global(.review-description) {
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    :global(.interest-pill),
    :global(.budget-pill) {
      font-size: 14px;
      padding: 0 16px;
      height: 40px;
    }

    :global(.contact-title) {
      flex-direction: column;
      gap: 8px;
      align-items: flex-start;
    }

    :global(.review-card-marquee) {
      width: 300px;
    }

    :global(.reviews-set) {
      gap: 1rem;
    }

    :global(.reviews-marquee) {
      animation-duration: 35s;
    }

    :global(.card-inner) {
      padding: 1.5rem;
    }

    :global(.profile-pic) {
      width: 50px;
      height: 50px;
    }

    :global(.profile-section) {
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }

    :global(.reviewer-name) {
      font-size: 1.1rem;
    }

    :global(.review-description) {
      font-size: 0.85rem;
    }
  }
</style>
