---
// ClickBubble.astro - Bubble de "Click" en pixel art que aparece al hacer hover
import styles from './ClickBubble.module.css';

const { 
  clickBubble, 
  bubbleContainer, 
  bubbleText, 
  bubbleTail, 
  show, 
  primary, 
  success 
} = styles;
---

<div id="click-bubble" class={clickBubble}>
  <div class={bubbleContainer}>
    <div class={bubbleText}>CLICK</div>
    <div class={bubbleTail}></div>
  </div>
</div>

<script define:vars={{ clickBubble, show, primary, success }}>
  // Create a map of the imported style classes
  const styleClasses = {
    clickBubble,
    show,
    primary,
    success,
    default: '' // For the default case
  };

  // Detectar si es dispositivo táctil
  const isTouchDevice = () => {
    return 'ontouchstart' in window || 
           navigator.maxTouchPoints > 0 || 
           window.matchMedia('(hover: none) and (pointer: coarse)').matches;
  };

  // Solo inicializar en dispositivos no táctiles
  if (!isTouchDevice()) {
    const bubble = document.getElementById('click-bubble');
    
    if (bubble) {
      let currentX = 0;
      let currentY = 0;
      let targetX = 0;
      let targetY = 0;
      let isVisible = false;
      let hideTimeout = null;

      // Función para interpolar suavemente la posición
      const lerp = (start, end, factor) => {
        return start + (end - start) * factor;
      };

      // Función para actualizar posición del bubble
      const updateBubblePosition = () => {
        currentX = lerp(currentX, targetX, 0.2);
        currentY = lerp(currentY, targetY, 0.2);

        bubble.style.left = `${currentX}px`;
        bubble.style.top = `${currentY}px`;

        requestAnimationFrame(updateBubblePosition);
      };

      // Función para mostrar el bubble
      const showBubble = (x, y, variant = 'default') => {
        if (hideTimeout) {
          clearTimeout(hideTimeout);
          hideTimeout = null;
        }

        targetX = x;
        targetY = y;
        
        // Aplicar variante de color usando las clases del módulo
        bubble.className = `${styleClasses.clickBubble} ${styleClasses[variant] || ''}`;
        
        // Mostrar con delay para suavizar la aparición
        setTimeout(() => {
          if (!isVisible) {
            isVisible = true;
            bubble.classList.add(styleClasses.show);
          }
        }, 50);
      };

      // Función para ocultar el bubble
      const hideBubble = () => {
        if (hideTimeout) {
          clearTimeout(hideTimeout);
        }
        
        hideTimeout = setTimeout(() => {
          if (isVisible) {
            isVisible = false;
            bubble.classList.remove(styleClasses.show);
            // Reset variant by setting class back to the base
            bubble.className = styleClasses.clickBubble;
          }
        }, 100);
      };

      // Función para actualizar posición del bubble mientras se mueve el mouse
      const updateBubbleOnMove = (x, y) => {
        if (isVisible) {
          targetX = x;
          targetY = y;
        }
      };

      // Función para determinar la variante según el tipo de elemento
      const getElementVariant = (element) => {
        if (element.matches('button[type="submit"], .btn-primary, .primary-button')) {
          return 'primary';
        }
        if (element.matches('.btn-success, .success-button')) {
          return 'success';
        }
        return 'default';
      };

      // Función para agregar efectos hover a elementos interactivos
      const addBubbleEffects = () => {
        const interactiveSelectors = [
          'a', 'button', '[role="button"]', 'input[type="submit"]', '.clickable',
          '.realism-button', '.magnetic-button', '.main-button', '.secondary-button',
          '.btn', '.btn-primary', '.btn-secondary', '.button', '.link',
          '.card', '.project-card', '.service-card', '.review-card',
          '.nav-link', '.menu-item', '.header-link',
          'input', 'textarea', 'select', 'label[for]',
          '[style*="cursor: pointer"]', '[style*="cursor:pointer"]',
          '[data-clickable]', '[data-interactive]', '[data-link]',
          '.flip-text-container', '.experience-card', '.skill-card',
          '.social-link', '.contact-link', '.download-link',
          '.hover\\:scale-', '.hover\\:bg-', '.hover\\:text-',
          '[whiletap]', '[whilehover]',
          'svg[role="button"]', '.icon[role="button"]', '.clickable-icon'
        ];
        
        const interactiveElements = document.querySelectorAll(interactiveSelectors.join(', '));

        interactiveElements.forEach((element) => {
          if (element.classList.contains('bubble-attached')) {
            return;
          }
          element.classList.add('bubble-attached');
          
          const isClickable = (
            element.tagName === 'A' ||
            element.tagName === 'BUTTON' ||
            element.type === 'submit' ||
            element.getAttribute('role') === 'button' ||
            element.onclick ||
            element.getAttribute('href') ||
            window.getComputedStyle(element).cursor === 'pointer' ||
            element.classList.contains('clickable') ||
            element.classList.contains('magnetic-button') ||
            element.classList.contains('realism-button')
          );
          
          if (isClickable) {
            element.addEventListener('mouseenter', (e) => {
              const variant = getElementVariant(element);
              showBubble(e.clientX, e.clientY, variant);
            });
            
            element.addEventListener('mouseleave', () => {
              hideBubble();
            });

            element.addEventListener('mousemove', (e) => {
              updateBubbleOnMove(e.clientX, e.clientY);
            });
          }
        });
      };

      updateBubblePosition();

      const initializeBubbleEffects = () => {
        addBubbleEffects();
        setTimeout(() => {
          addBubbleEffects();
        }, 1000);
      };

      initializeBubbleEffects();
      
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeBubbleEffects);
      }
      
      window.addEventListener('load', () => {
        setTimeout(initializeBubbleEffects, 500);
      });

      const observer = new MutationObserver((mutations) => {
        let shouldReapply = false;
        
        mutations.forEach((mutation) => {
          if (mutation.type === 'childList' && mutation.addedNodes.length > 0) {
            mutation.addedNodes.forEach((node) => {
              if (node.nodeType === Node.ELEMENT_NODE) {
                shouldReapply = true;
              }
            });
          }
        });
        
        if (shouldReapply) {
          setTimeout(() => {
            addBubbleEffects();
          }, 100);
        }
      });

      observer.observe(document.body, {
        childList: true,
        subtree: true,
        attributes: false,
        characterData: false
      });

      window.addEventListener('beforeunload', () => {
        observer.disconnect();
        if (hideTimeout) {
          clearTimeout(hideTimeout);
        }
      });
    }
  }
</script>
