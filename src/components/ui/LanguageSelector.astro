---
import { getLangFromUrl, useTranslatedPath, languageOptions } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
const currentLanguage = languageOptions.find(l => l.code === lang);
---

<div class="language-selector">
  <button class="selector-trigger" aria-label="Select language" id="languageToggle">
    <span class="current-lang">
      <span class="flag">{currentLanguage?.flag}</span>
      <span class="lang-code">{lang.toUpperCase()}</span>
    </span>
    <svg class="chevron" viewBox="0 0 20 20" width="16" height="16">
      <path d="M5.23 7.21L10 12l4.77-4.79" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <div class="selector-dropdown" id="languageDropdown">
    {languageOptions.map((language) => (
      <a
        href={useTranslatedPath(language.code, Astro.url.pathname)}
        class={`language-option ${lang === language.code ? 'active' : ''}`}
        hreflang={language.code}
        data-lang={language.code}
      >
        <span class="flag">{language.flag}</span>
        <div class="details">
          <span class="name">{language.name}</span>
          <span class="market">{language.market}</span>
          <span class="growth" data-growth={language.growth}>
            {language.growth}
          </span>
        </div>
      </a>
    ))}
  </div>
</div>

<style>
.language-selector {
  position: relative;
  display: inline-block;
  z-index: 1000;
}

.selector-trigger {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border: 1px solid rgba(204, 204, 204, 0.3);
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  cursor: pointer;
  transition: all 0.2s ease;
  font-family: var(--font-display);
  font-size: 14px;
  color: #131019;
}

.selector-trigger:hover {
  border-color: #060314;
  background: rgba(255, 255, 255, 0.95);
  transform: translateY(-1px);
}

.current-lang {
  display: flex;
  align-items: center;
  gap: 6px;
}

.flag {
  font-size: 16px;
}

.lang-code {
  font-weight: 600;
  letter-spacing: 0.5px;
}

.chevron {
  transition: transform 0.2s ease;
  color: #131019;
}

.selector-trigger.open .chevron {
  transform: rotate(180deg);
}

.selector-dropdown {
  position: absolute;
  top: calc(100% + 8px);
  right: 0;
  min-width: 280px;
  background: white;
  border: 1px solid rgba(204, 204, 204, 0.2);
  border-radius: 8px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.12);
  opacity: 0;
  visibility: hidden;
  transform: translateY(-10px);
  pointer-events: none;
  transition: all 0.2s ease;
  backdrop-filter: blur(15px);
  max-height: 350px;
  overflow-y: auto;
  z-index: 1001;
  display: none;
}

.selector-dropdown.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: all;
  display: block;
}

.language-option {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  color: #131019;
  text-decoration: none;
  transition: all 0.2s ease;
  border-bottom: 1px solid rgba(204, 204, 204, 0.1);
}

.language-option:last-child {
  border-bottom: none;
}

.language-option:hover {
  background: rgba(247, 248, 249, 0.8);
  transform: translateX(4px);
}

.language-option.active {
  background: rgba(6, 3, 20, 0.05);
  border-left: 3px solid #060314;
}

.language-option .flag {
  font-size: 18px;
  min-width: 20px;
}

.details {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
}

.name {
  font-weight: 600;
  font-size: 14px;
  font-family: var(--font-display);
}

.market {
  font-size: 12px;
  opacity: 0.7;
  color: #666;
}

.growth {
  font-size: 11px;
  font-weight: 600;
  padding: 2px 6px;
  border-radius: 4px;
  display: inline-block;
  width: fit-content;
}

.growth[data-growth*="+"] {
  color: #10b981;
  background: rgba(16, 185, 129, 0.1);
}

.growth[data-growth="Stable"] {
  color: #6366f1;
  background: rgba(99, 102, 241, 0.1);
}


/* Mobile responsive */
@media (max-width: 768px) {
  .selector-dropdown {
    left: 0;
    right: auto;
    min-width: 250px;
  }

  .language-option {
    padding: 14px 16px;
  }

  .selector-trigger {
    padding: 10px 12px;
  }
}

/* Smooth scrolling for dropdown */
.selector-dropdown {
  scrollbar-width: thin;
  scrollbar-color: rgba(204, 204, 204, 0.5) transparent;
}

.selector-dropdown::-webkit-scrollbar {
  width: 4px;
}

.selector-dropdown::-webkit-scrollbar-track {
  background: transparent;
}

.selector-dropdown::-webkit-scrollbar-thumb {
  background: rgba(204, 204, 204, 0.5);
  border-radius: 2px;
}

.selector-dropdown::-webkit-scrollbar-thumb:hover {
  background: rgba(204, 204, 204, 0.7);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const toggle = document.getElementById('languageToggle');
  const dropdown = document.getElementById('languageDropdown');

  if (!toggle || !dropdown) {
    console.error('Language selector elements not found');
    return;
  }

  let isOpen = false;

  function openDropdown() {
    console.log('Opening dropdown');
    isOpen = true;
    toggle!.classList.add('open');
    dropdown!.classList.add('show');
    dropdown!.style.display = 'block';
  }

  function closeDropdown() {
    console.log('Closing dropdown');
    isOpen = false;
    toggle!.classList.remove('open');
    dropdown!.classList.remove('show');
  }

  // Simple click handler
  toggle!.addEventListener('click', function(e) {
    console.log('Toggle clicked, current state:', isOpen);
    e.preventDefault();
    e.stopPropagation();

    if (isOpen) {
      closeDropdown();
    } else {
      openDropdown();
    }
  });

  // Close when clicking outside
  document.addEventListener('click', function(e) {
    const target = e.target as Node;
    if (isOpen && target && !toggle!.contains(target) && !dropdown!.contains(target)) {
      closeDropdown();
    }
  });

  // Language option clicks
  dropdown!.addEventListener('click', function(e) {
    const target = e.target as Element;
    if (target) {
      const option = target.closest('.language-option');
      if (option) {
        console.log('Language option clicked');
        closeDropdown();
      }
    }
  });

  console.log('Language selector initialized');
});
</script>