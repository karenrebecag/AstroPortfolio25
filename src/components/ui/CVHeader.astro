---
// CV Header component - Dark mode variation
import MainButton from './MainButton.astro';
import LanguageSelectorWrapper from './LanguageSelectorWrapper.astro';
import { getLangFromUrl, t, languageOptions, useTranslatedPath } from '../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
---

<div class="cv-header-wrapper" id="cvHeaderWrapper">
  <header class="cv-header" id="cvMainHeader">
    <div class="cv-logo">KAREN ORTIZ</div>
    
    <nav class="cv-nav">
      <a href="#summary">Summary</a>
      <a href="#experience">Experience</a>
      <a href="#projects">Projects</a>
      <a href="#skills">Skills</a>
      <a href="#education">Education</a>
    </nav>
    
    <div class="cv-header-actions-wrapper">
      <div class="cv-contact-btn-wrapper">
        <MainButton text={t('nav.contact', lang)} href="#contact" />
      </div>
      <LanguageSelectorWrapper />
    </div>
    
    <button class="cv-menu-btn" id="cvMenuBtn">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </header>
</div>

<div class="cv-mobile-menu" id="cvMobileMenu">
  <div class="cv-mobile-menu-content">
    <!-- Close Button -->
    <button class="cv-mobile-close-btn" id="cvMobileCloseBtn">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x">
        <path d="m18 6-12 12"/>
        <path d="m6 6 12 12"/>
      </svg>
    </button>
    
    <nav class="cv-mobile-nav">
      <a href="#summary">Summary</a>
      <a href="#experience">Experience</a>
      <a href="#projects">Projects</a>
      <a href="#skills">Skills</a>
      <a href="#education">Education</a>
      <button class="cv-mobile-contact-btn">{t('nav.contact', lang)}</button>

      <!-- Mobile Language Selector -->
      <div class="cv-mobile-language-section">
        <div class="cv-mobile-language-title">Language / Idioma</div>
        <div class="cv-mobile-language-list">
          {languageOptions.map((language) => (
            <a
              href={useTranslatedPath(language.code, Astro.url.pathname)}
              class={`cv-mobile-language-option ${lang === language.code ? 'active' : ''}`}
            >
              <span class="flag">{language.flag}</span>
              <span class="name">{language.name}</span>
            </a>
          ))}
        </div>
      </div>
    </nav>
  </div>
</div>

<style>
  .cv-header-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: #0b0717;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: all 0.3s ease;
  }

  .cv-header-wrapper.scrolled {
    background: #0b0717;
    box-shadow: 0 4px 32px rgba(0, 0, 0, 0.3);
  }

  .cv-header-wrapper.hiding {
    pointer-events: none;
  }

  .cv-header-wrapper.hidden {
    pointer-events: none;
  }

  .cv-header-wrapper:hover {
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
  }

  .cv-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 24px;
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .cv-header {
      padding: 25px 16px;
    }
  }

  .cv-logo {
    color: #ffffff;
    font-family: var(--font-display); /* Median font */
    font-size: clamp(17px, 3.5vw, 28px);
    transition: color 0.3s ease, transform 0.2s ease;
    cursor: pointer;
    font-weight: 400;
  }

  .cv-logo:hover {
    color: #cccccc;
    transform: scale(1.05);
  }

  .cv-nav {
    display: flex;
    gap: 32px;
  }

  .cv-nav a {
    color: #cccccc;
    font-family: var(--font-display); /* Median font */
    text-decoration: none;
    font-size: clamp(11px, 2.1vw, 17px);
    transition: color 0.3s ease, transform 0.2s ease;
    position: relative;
    font-weight: 400;
  }

  .cv-nav a:hover {
    color: #ffffff;
    transform: translateY(-2px);
  }

  .cv-nav a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: #ffffff;
    transition: width 0.3s ease;
  }

  .cv-nav a:hover::after {
    width: 100%;
  }

  .cv-header-actions-wrapper {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .cv-contact-btn-wrapper {
    display: flex;
    align-items: center;
    scale: 0.7;
    transform-origin: center;
  }

  .cv-menu-btn {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .cv-menu-btn:hover {
    transform: scale(1.1);
  }

  .cv-menu-btn span {
    width: 20px;
    height: 2px;
    background: #ffffff;
    transition: all 0.3s ease;
  }

  .cv-menu-btn:hover span {
    background: #cccccc;
  }

  .cv-mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background:#7537c3;
    backdrop-filter: blur(20px);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .cv-mobile-menu.open {
    opacity: 1;
    visibility: visible;
  }

  .cv-mobile-menu-content {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
    width: 100%;
  }

  .cv-mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 32px;
    text-align: center;
    transform: translateY(30px);
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .cv-mobile-menu.open .cv-mobile-nav {
    transform: translateY(0);
  }

  .cv-mobile-nav a {
    color: #ffffff;
    font-family: var(--font-display); /* Median font */
    text-decoration: none;
    font-size: clamp(18px, 4vw, 24px);
    font-weight: 300;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    position: relative;
    opacity: 0;
    transform: translateY(20px);
  }

  .cv-mobile-menu.open .cv-mobile-nav a {
    opacity: 1;
    transform: translateY(0);
  }

  .cv-mobile-nav a:nth-child(1) { transition-delay: 0.1s; }
  .cv-mobile-nav a:nth-child(2) { transition-delay: 0.2s; }
  .cv-mobile-nav a:nth-child(3) { transition-delay: 0.3s; }
  .cv-mobile-nav a:nth-child(4) { transition-delay: 0.4s; }
  .cv-mobile-nav a:nth-child(5) { transition-delay: 0.5s; }

  .cv-mobile-nav a:hover {
    color: #f7f4ff;
    transform: scale(1.05);
    text-shadow: 0 0 20px rgba(69, 35, 174, 0.5);
  }

  .cv-mobile-nav a::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #ffffff, transparent);
    transition: width 0.4s ease;
  }

  .cv-mobile-nav a:hover::after {
    width: 100%;
  }

  .cv-mobile-contact-btn {
    background: transparent;
    border: 2px solid #ffffff;
    color: #ffffff;
    padding: 12px 24px;
    font-family: var(--font-display); /* Median font */
    font-size: clamp(14px, 3vw, 16px);
    cursor: pointer;
    transition: color 0.1s ease, transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    overflow: hidden;
    margin-top: 24px;
    border-radius: 4px;
    opacity: 0;
    transform: translateY(20px);
  }

  .cv-mobile-menu.open .cv-mobile-contact-btn {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.6s;
  }

  .cv-mobile-contact-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: white;
    transition: left 0.3s ease;
    z-index: -1;
  }

  .cv-mobile-contact-btn:hover::before {
    left: 0;
  }

  .cv-mobile-contact-btn:hover {
    color: #000000 !important;
    transform: scale(1.05);
    box-shadow: 0 8px 25px rgba(69, 35, 174, 0.3);
    transition: color 0.1s ease, transform 0.3s ease, box-shadow 0.3s ease !important;
  }

  /* Specific pseudo-element styling for text color on hover */
  .cv-mobile-contact-btn:hover::before ~ * {
    color: #000000 !important;
  }

  /* Alternative approach with higher specificity */
  .cv-mobile-menu .cv-mobile-nav .cv-mobile-contact-btn:hover {
    color: #000000 !important;
    position: relative;
    z-index: 1;
    transition: color 0.1s ease !important;
  }

  /* Additional specificity for the hover text color */
  .cv-mobile-menu .cv-mobile-nav .cv-mobile-contact-btn:hover {
    color: #000000 !important;
  }

  /* CV Mobile Language Selector Styles */
  .cv-mobile-language-section {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.3s ease;
    transition-delay: 0.6s;
  }

  .cv-mobile-menu.open .cv-mobile-language-section {
    opacity: 1;
    transform: translateY(0);
  }

  .cv-mobile-language-title {
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-display);
    font-size: 12px;
    text-align: center;
    margin-bottom: 16px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .cv-mobile-language-list {
    max-height: 200px;
    overflow-y: auto;
    padding: 8px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);

    /* Custom scrollbar for mobile */
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.3) transparent;
  }

  .cv-mobile-language-list::-webkit-scrollbar {
    width: 4px;
  }

  .cv-mobile-language-list::-webkit-scrollbar-track {
    background: transparent;
  }

  .cv-mobile-language-list::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 2px;
  }

  .cv-mobile-language-option {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    color: white;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.2s ease;
    font-family: var(--font-display);
    font-size: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .cv-mobile-language-option:last-child {
    border-bottom: none;
  }

  .cv-mobile-language-option:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateX(4px);
  }

  .cv-mobile-language-option.active {
    background: rgba(255, 255, 255, 0.15);
    color: #ffffff;
    font-weight: 500;
  }

  .cv-mobile-language-option .flag {
    font-size: 18px;
    line-height: 1;
  }

  .cv-mobile-language-option .name {
    flex: 1;
    font-weight: 400;
  }

  /* Close Button Styles */
  .cv-mobile-close-btn {
    position: absolute;
    top: 24px;
    right: 24px;
    background: none;
    border: none;
    color: #ffffff;
    cursor: pointer;
    padding: 8px;
    border-radius: 50%;
    transition: all 0.3s ease;
    opacity: 0;
    transform: rotate(-90deg) scale(0.8);
    z-index: 10;
  }

  .cv-mobile-menu.open .cv-mobile-close-btn {
    opacity: 1;
    transform: rotate(0deg) scale(1);
    transition-delay: 0.3s;
  }

  .cv-mobile-close-btn:hover {
    background: rgba(69, 35, 174, 0.2);
    transform: rotate(90deg) scale(1.1);
    color: #4523AE;
  }

  .cv-mobile-close-btn:active {
    transform: rotate(90deg) scale(0.95);
  }

  .cv-mobile-close-btn svg {
    width: 24px;
    height: 24px;
    transition: all 0.2s ease;
  }

  @media (max-width: 480px) {
    .cv-mobile-close-btn {
      top: 16px;
      right: 16px;
      padding: 6px;
    }
    
    .cv-mobile-close-btn svg {
      width: 20px;
      height: 20px;
    }
  }

  @media (max-width: 1200px) {
    .cv-nav {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .cv-header-actions-wrapper {
      display: none;
    }

    .cv-menu-btn {
      display: flex;
    }
  }
</style>

<script>
  import { animate } from 'motion';

  document.addEventListener('DOMContentLoaded', () => {
    // Header scroll behavior
    const headerWrapper = document.querySelector('.cv-header-wrapper');
    let lastScrollY = window.scrollY;
    let isScrolling = false;

    const handleScroll = () => {
      if (!isScrolling) {
        window.requestAnimationFrame(() => {
          const currentScrollY = window.scrollY;
          const scrollDifference = currentScrollY - lastScrollY;
          
          if (!headerWrapper) return;

          // Add scrolled class when scrolled down
          if (currentScrollY > 80) {
            headerWrapper.classList.add('scrolled');
          } else {
            headerWrapper.classList.remove('scrolled');
          }

          // Hide/show logic
          if (scrollDifference > 8 && currentScrollY > 150) {
            // Scrolling down - hide header
            if (!headerWrapper.classList.contains('hiding') && !headerWrapper.classList.contains('hidden')) {
              headerWrapper.classList.add('hiding');
              
              const hideAnimation = animate(
                headerWrapper,
                { 
                  transform: 'translateY(-100%)',
                  opacity: 0
                },
                { 
                  duration: 0.4,
                  ease: [0.23, 1, 0.32, 1],
                  onComplete: () => {
                    headerWrapper.classList.add('hidden');
                    headerWrapper.classList.remove('hiding');
                  }
                }
              );
            }
          } else if (scrollDifference < -3 || currentScrollY < 100) {
            // Scrolling up - show header
            if (headerWrapper.classList.contains('hiding') || headerWrapper.classList.contains('hidden')) {
              headerWrapper.classList.remove('hiding');
              headerWrapper.classList.remove('hidden');
              
              const showAnimation = animate(
                headerWrapper,
                {
                  transform: 'translateY(0%)',
                  opacity: 1
                },
                {
                  duration: 0.5,
                  ease: [0.23, 1, 0.32, 1]
                }
              );
            }
          }

          lastScrollY = currentScrollY;
          isScrolling = false;
        });
      }
      isScrolling = true;
    };

    window.addEventListener('scroll', handleScroll, { passive: true });

    // Mobile menu functionality - using classes instead of IDs to avoid Astro scope issues
    const allMenuBtns = document.querySelectorAll('.cv-menu-btn');
    const allMobileMenus = document.querySelectorAll('.cv-mobile-menu');
    const menuBtn = allMenuBtns[0]; // Keep reference for logging
    const mobileMenu = allMobileMenus[0]; // Keep reference for logging
    const mobileNav = document.querySelector('.cv-mobile-nav');
    const navLinks = document.querySelectorAll('.cv-mobile-nav a');
    const contactBtn = document.querySelector('.cv-mobile-contact-btn');

    console.log('CV Mobile menu elements found:');
    console.log('menuBtn:', menuBtn);
    console.log('mobileMenu:', mobileMenu);
    console.log('mobileNav:', mobileNav);
    console.log('navLinks:', navLinks.length);
    console.log('contactBtn:', contactBtn);
    
    let isOpen = false;

    const openMenu = () => {
      isOpen = true;
      mobileMenu?.classList.add('open');

      // Block body scrolling
      document.body.style.overflow = 'hidden';
      document.body.style.position = 'fixed';
      document.body.style.width = '100%';
      
      // Reset initial states
      if (mobileNav) (mobileNav as HTMLElement).style.transform = 'translateY(30px)';
      navLinks.forEach(link => {
        (link as HTMLElement).style.opacity = '0';
        (link as HTMLElement).style.transform = 'translateY(20px)';
      });
      if (contactBtn) {
        (contactBtn as HTMLElement).style.opacity = '0';
        (contactBtn as HTMLElement).style.transform = 'translateY(20px)';
      }

      // Animate navigation container
      if (mobileNav) {
        animate(mobileNav, 
          { transform: 'translateY(0px)' }, 
          { duration: 0.4, delay: 0.1 }
        );
      }

      // Stagger animate nav links
      navLinks.forEach((link, index) => {
        animate(link, 
          { opacity: 1, transform: 'translateY(0px)' }, 
          { duration: 0.3, delay: 0.2 + (index * 0.1) }
        );
      });

      // Animate contact button
      if (contactBtn) {
        animate(contactBtn, 
          { opacity: 1, transform: 'translateY(0px)' }, 
          { duration: 0.3, delay: 0.6 }
        );
      }
    };

    const closeMenu = () => {
      isOpen = false;
      
      // Animate close button first
      const closeBtn = document.querySelector('.cv-mobile-close-btn');
      if (closeBtn) {
        animate(closeBtn, 
          { opacity: 0, transform: 'rotate(-90deg) scale(0.8)' }, 
          { duration: 0.2 }
        );
      }
      
      // Reverse animations with stagger
      navLinks.forEach((link, index) => {
        animate(link, 
          { opacity: 0, transform: 'translateY(-20px)' }, 
          { duration: 0.2, delay: index * 0.05 }
        );
      });

      if (contactBtn) {
        animate(contactBtn, 
          { opacity: 0, transform: 'translateY(-20px)' }, 
          { duration: 0.2, delay: 0.1 }
        );
      }

      if (mobileNav) {
        animate(mobileNav, 
          { transform: 'translateY(30px)' }, 
          { duration: 0.3, delay: 0.2 }
        );
      }

      // Remove class after animation
      setTimeout(() => {
        mobileMenu?.classList.remove('open');

        // Restore body scrolling
        document.body.style.overflow = '';
        document.body.style.position = '';
        document.body.style.width = '';
      }, 500);
    };

    // Add event listeners to ALL menu buttons since there might be duplicates
    console.log(`Found ${allMenuBtns.length} CV menu buttons, adding event listeners to all...`);

    allMenuBtns.forEach((btn, index) => {
      console.log(`Adding event listeners to CV menu button ${index}...`);

      btn.addEventListener('click', (e) => {
        console.log(`CV CLICK EVENT DETECTED on button ${index}! Current isOpen state:`, isOpen);
        e.preventDefault();
        e.stopPropagation();
        if (isOpen) {
          console.log('Closing CV menu...');
          closeMenu();
        } else {
          console.log('Opening CV menu...');
          openMenu();
        }
      });

      btn.addEventListener('touchstart', (e) => {
        console.log(`CV TOUCHSTART EVENT DETECTED on button ${index}!`);
      });

      btn.addEventListener('mousedown', (e) => {
        console.log(`CV MOUSEDOWN EVENT DETECTED on button ${index}!`);
      });
    });

    if (allMenuBtns.length === 0) {
      console.error('No CV menu buttons found!');
    }
    
    // Close button functionality
    const cvMobileCloseBtn = document.querySelector('.cv-mobile-close-btn');
    cvMobileCloseBtn?.addEventListener('click', () => {
      if (isOpen) {
        closeMenu();
      }
    });
    
    // Close menu when clicking on links or contact button
    mobileMenu?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target && (target.tagName === 'A' || target.classList.contains('cv-mobile-contact-btn'))) {
        closeMenu();
      }
    });

    // Close menu when clicking outside content
    mobileMenu?.addEventListener('click', (e) => {
      if (e.target === mobileMenu) {
        closeMenu();
      }
    });

    // Close menu on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeMenu();
      }
    });

    // Smooth scroll to sections
    const smoothScrollToSection = (targetId: string) => {
      const targetElement = document.getElementById(targetId.replace('#', ''));
      if (targetElement) {
        const headerHeight = 80; // Account for fixed header
        const targetPosition = (targetElement as HTMLElement).offsetTop - headerHeight;
        
        window.scrollTo({
          top: targetPosition,
          behavior: 'smooth'
        });
      }
    };

    // Add smooth scroll to all navigation links
    document.querySelectorAll('.cv-nav a, .cv-mobile-nav a').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const href = (e.target as HTMLAnchorElement).getAttribute('href');
        if (href && href.startsWith('#')) {
          smoothScrollToSection(href);
          if (isOpen) closeMenu();
        }
      });
    });
  });
</script>
