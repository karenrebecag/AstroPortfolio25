---
// CV Header component - Dark mode variation
import MainButton from './MainButton.astro';
---

<div class="cv-header-wrapper" id="cvHeaderWrapper">
  <header class="cv-header" id="cvMainHeader">
    <div class="cv-logo">KAREN ORTIZ</div>
    
    <nav class="cv-nav">
      <a href="#summary">Summary</a>
      <a href="#experience">Experience</a>
      <a href="#projects">Projects</a>
      <a href="#skills">Skills</a>
      <a href="#education">Education</a>
    </nav>
    
    <div class="cv-contact-btn-wrapper">
      <MainButton text="Contact Me" href="#contact" />
    </div>
    
    <button class="cv-menu-btn" id="cvMenuBtn">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </header>
</div>

<div class="cv-mobile-menu" id="cvMobileMenu">
  <div class="cv-mobile-menu-content">
    <!-- Close Button -->
    <button class="cv-mobile-close-btn" id="cvMobileCloseBtn">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x">
        <path d="m18 6-12 12"/>
        <path d="m6 6 12 12"/>
      </svg>
    </button>
    
    <nav class="cv-mobile-nav">
      <a href="#summary">Summary</a>
      <a href="#experience">Experience</a>
      <a href="#projects">Projects</a>
      <a href="#skills">Skills</a>
      <a href="#education">Education</a>
      <button class="cv-mobile-contact-btn">Contact Me</button>
    </nav>
  </div>
</div>

<style>
  .cv-header-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: #0b0717;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: all 0.3s ease;
  }

  .cv-header-wrapper.scrolled {
    background: #0b0717;
    box-shadow: 0 4px 32px rgba(0, 0, 0, 0.3);
  }

  .cv-header-wrapper.hiding {
    pointer-events: none;
  }

  .cv-header-wrapper.hidden {
    pointer-events: none;
  }

  .cv-header-wrapper:hover {
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
  }

  .cv-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 24px;
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .cv-header {
      padding: 8px 16px;
    }
  }

  .cv-logo {
    color: #ffffff;
    font-family: var(--font-display); /* Median font */
    font-size: clamp(17px, 3.5vw, 28px);
    transition: color 0.3s ease, transform 0.2s ease;
    cursor: pointer;
    font-weight: 400;
  }

  .cv-logo:hover {
    color: #cccccc;
    transform: scale(1.05);
  }

  .cv-nav {
    display: flex;
    gap: 32px;
  }

  .cv-nav a {
    color: #cccccc;
    font-family: var(--font-display); /* Median font */
    text-decoration: none;
    font-size: clamp(11px, 2.1vw, 17px);
    transition: color 0.3s ease, transform 0.2s ease;
    position: relative;
    font-weight: 400;
  }

  .cv-nav a:hover {
    color: #ffffff;
    transform: translateY(-2px);
  }

  .cv-nav a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: #ffffff;
    transition: width 0.3s ease;
  }

  .cv-nav a:hover::after {
    width: 100%;
  }

  .cv-contact-btn-wrapper {
    display: flex;
    align-items: center;
    scale: 0.7;
    transform-origin: center;
  }

  .cv-menu-btn {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .cv-menu-btn:hover {
    transform: scale(1.1);
  }

  .cv-menu-btn span {
    width: 20px;
    height: 2px;
    background: #ffffff;
    transition: all 0.3s ease;
  }

  .cv-menu-btn:hover span {
    background: #cccccc;
  }

  .cv-mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background:#7537c3;
    backdrop-filter: blur(20px);
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .cv-mobile-menu.open {
    opacity: 1;
    visibility: visible;
  }

  .cv-mobile-menu-content {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
    width: 100%;
  }

  .cv-mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 32px;
    text-align: center;
    transform: translateY(30px);
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .cv-mobile-menu.open .cv-mobile-nav {
    transform: translateY(0);
  }

  .cv-mobile-nav a {
    color: #ffffff;
    font-family: var(--font-display); /* Median font */
    text-decoration: none;
    font-size: clamp(18px, 4vw, 24px);
    font-weight: 300;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    position: relative;
    opacity: 0;
    transform: translateY(20px);
  }

  .cv-mobile-menu.open .cv-mobile-nav a {
    opacity: 1;
    transform: translateY(0);
  }

  .cv-mobile-nav a:nth-child(1) { transition-delay: 0.1s; }
  .cv-mobile-nav a:nth-child(2) { transition-delay: 0.2s; }
  .cv-mobile-nav a:nth-child(3) { transition-delay: 0.3s; }
  .cv-mobile-nav a:nth-child(4) { transition-delay: 0.4s; }
  .cv-mobile-nav a:nth-child(5) { transition-delay: 0.5s; }

  .cv-mobile-nav a:hover {
    color: #f7f4ff;
    transform: scale(1.05);
    text-shadow: 0 0 20px rgba(69, 35, 174, 0.5);
  }

  .cv-mobile-nav a::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #ffffff, transparent);
    transition: width 0.4s ease;
  }

  .cv-mobile-nav a:hover::after {
    width: 100%;
  }

  .cv-mobile-contact-btn {
    background: transparent;
    border: 2px solid #ffffff;
    color: #ffffff;
    padding: 12px 24px;
    font-family: var(--font-display); /* Median font */
    font-size: clamp(14px, 3vw, 16px);
    cursor: pointer;
    transition: color 0.1s ease, transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
    overflow: hidden;
    margin-top: 24px;
    border-radius: 4px;
    opacity: 0;
    transform: translateY(20px);
  }

  .cv-mobile-menu.open .cv-mobile-contact-btn {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.6s;
  }

  .cv-mobile-contact-btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: white;
    transition: left 0.3s ease;
    z-index: -1;
  }

  .cv-mobile-contact-btn:hover::before {
    left: 0;
  }

  .cv-mobile-contact-btn:hover {
    color: #000000 !important;
    transform: scale(1.05);
    box-shadow: 0 8px 25px rgba(69, 35, 174, 0.3);
    transition: color 0.1s ease, transform 0.3s ease, box-shadow 0.3s ease !important;
  }

  /* Specific pseudo-element styling for text color on hover */
  .cv-mobile-contact-btn:hover::before ~ * {
    color: #000000 !important;
  }

  /* Alternative approach with higher specificity */
  .cv-mobile-menu .cv-mobile-nav .cv-mobile-contact-btn:hover {
    color: #000000 !important;
    position: relative;
    z-index: 1;
    transition: color 0.1s ease !important;
  }

  /* Additional specificity for the hover text color */
  .cv-mobile-menu .cv-mobile-nav .cv-mobile-contact-btn:hover {
    color: #000000 !important;
  }

  /* Close Button Styles */
  .cv-mobile-close-btn {
    position: absolute;
    top: 24px;
    right: 24px;
    background: none;
    border: none;
    color: #ffffff;
    cursor: pointer;
    padding: 8px;
    border-radius: 50%;
    transition: all 0.3s ease;
    opacity: 0;
    transform: rotate(-90deg) scale(0.8);
    z-index: 10;
  }

  .cv-mobile-menu.open .cv-mobile-close-btn {
    opacity: 1;
    transform: rotate(0deg) scale(1);
    transition-delay: 0.3s;
  }

  .cv-mobile-close-btn:hover {
    background: rgba(69, 35, 174, 0.2);
    transform: rotate(90deg) scale(1.1);
    color: #4523AE;
  }

  .cv-mobile-close-btn:active {
    transform: rotate(90deg) scale(0.95);
  }

  .cv-mobile-close-btn svg {
    width: 24px;
    height: 24px;
    transition: all 0.2s ease;
  }

  @media (max-width: 480px) {
    .cv-mobile-close-btn {
      top: 16px;
      right: 16px;
      padding: 6px;
    }
    
    .cv-mobile-close-btn svg {
      width: 20px;
      height: 20px;
    }
  }

  @media (max-width: 768px) {
    .cv-nav,
    .cv-contact-btn-wrapper {
      display: none;
    }
    
    .cv-menu-btn {
      display: flex;
    }
  }
</style>

<script>
  import { animate } from 'motion';

  document.addEventListener('DOMContentLoaded', () => {
    // Header scroll behavior
    const headerWrapper = document.getElementById('cvHeaderWrapper');
    let lastScrollY = window.scrollY;
    let isScrolling = false;

    const handleScroll = () => {
      if (!isScrolling) {
        window.requestAnimationFrame(() => {
          const currentScrollY = window.scrollY;
          const scrollDifference = currentScrollY - lastScrollY;
          
          if (!headerWrapper) return;

          // Add scrolled class when scrolled down
          if (currentScrollY > 80) {
            headerWrapper.classList.add('scrolled');
          } else {
            headerWrapper.classList.remove('scrolled');
          }

          // Hide/show logic
          if (scrollDifference > 8 && currentScrollY > 150) {
            // Scrolling down - hide header
            if (!headerWrapper.classList.contains('hiding') && !headerWrapper.classList.contains('hidden')) {
              headerWrapper.classList.add('hiding');
              
              const hideAnimation = animate(
                headerWrapper,
                { 
                  transform: 'translateY(-100%)',
                  opacity: 0
                },
                { 
                  duration: 0.4,
                  ease: [0.23, 1, 0.32, 1],
                  onComplete: () => {
                    headerWrapper.classList.add('hidden');
                    headerWrapper.classList.remove('hiding');
                  }
                }
              );
            }
          } else if (scrollDifference < -3 || currentScrollY < 100) {
            // Scrolling up - show header
            if (headerWrapper.classList.contains('hiding') || headerWrapper.classList.contains('hidden')) {
              headerWrapper.classList.remove('hiding');
              headerWrapper.classList.remove('hidden');
              
              const showAnimation = animate(
                headerWrapper,
                {
                  transform: 'translateY(0%)',
                  opacity: 1
                },
                {
                  duration: 0.5,
                  ease: [0.23, 1, 0.32, 1]
                }
              );
            }
          }

          lastScrollY = currentScrollY;
          isScrolling = false;
        });
      }
      isScrolling = true;
    };

    window.addEventListener('scroll', handleScroll, { passive: true });

    // Mobile menu functionality
    const menuBtn = document.getElementById('cvMenuBtn');
    const mobileMenu = document.getElementById('cvMobileMenu');
    const mobileNav = document.querySelector('.cv-mobile-nav');
    const navLinks = document.querySelectorAll('.cv-mobile-nav a');
    const contactBtn = document.querySelector('.cv-mobile-contact-btn');
    
    let isOpen = false;

    const openMenu = () => {
      isOpen = true;
      mobileMenu?.classList.add('open');
      
      // Reset initial states
      if (mobileNav) (mobileNav as HTMLElement).style.transform = 'translateY(30px)';
      navLinks.forEach(link => {
        (link as HTMLElement).style.opacity = '0';
        (link as HTMLElement).style.transform = 'translateY(20px)';
      });
      if (contactBtn) {
        (contactBtn as HTMLElement).style.opacity = '0';
        (contactBtn as HTMLElement).style.transform = 'translateY(20px)';
      }

      // Animate navigation container
      if (mobileNav) {
        animate(mobileNav, 
          { transform: 'translateY(0px)' }, 
          { duration: 0.4, delay: 0.1 }
        );
      }

      // Stagger animate nav links
      navLinks.forEach((link, index) => {
        animate(link, 
          { opacity: 1, transform: 'translateY(0px)' }, 
          { duration: 0.3, delay: 0.2 + (index * 0.1) }
        );
      });

      // Animate contact button
      if (contactBtn) {
        animate(contactBtn, 
          { opacity: 1, transform: 'translateY(0px)' }, 
          { duration: 0.3, delay: 0.6 }
        );
      }
    };

    const closeMenu = () => {
      isOpen = false;
      
      // Animate close button first
      const closeBtn = document.getElementById('cvMobileCloseBtn');
      if (closeBtn) {
        animate(closeBtn, 
          { opacity: 0, transform: 'rotate(-90deg) scale(0.8)' }, 
          { duration: 0.2 }
        );
      }
      
      // Reverse animations with stagger
      navLinks.forEach((link, index) => {
        animate(link, 
          { opacity: 0, transform: 'translateY(-20px)' }, 
          { duration: 0.2, delay: index * 0.05 }
        );
      });

      if (contactBtn) {
        animate(contactBtn, 
          { opacity: 0, transform: 'translateY(-20px)' }, 
          { duration: 0.2, delay: 0.1 }
        );
      }

      if (mobileNav) {
        animate(mobileNav, 
          { transform: 'translateY(30px)' }, 
          { duration: 0.3, delay: 0.2 }
        );
      }

      // Remove class after animation
      setTimeout(() => {
        mobileMenu?.classList.remove('open');
      }, 500);
    };

    menuBtn?.addEventListener('click', () => {
      if (isOpen) {
        closeMenu();
      } else {
        openMenu();
      }
    });
    
    // Close button functionality
    const cvMobileCloseBtn = document.getElementById('cvMobileCloseBtn');
    cvMobileCloseBtn?.addEventListener('click', () => {
      if (isOpen) {
        closeMenu();
      }
    });
    
    // Close menu when clicking on links or contact button
    mobileMenu?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target && (target.tagName === 'A' || target.classList.contains('cv-mobile-contact-btn'))) {
        closeMenu();
      }
    });

    // Close menu when clicking outside content
    mobileMenu?.addEventListener('click', (e) => {
      if (e.target === mobileMenu) {
        closeMenu();
      }
    });

    // Close menu on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeMenu();
      }
    });

    // Smooth scroll to sections
    const smoothScrollToSection = (targetId: string) => {
      const targetElement = document.getElementById(targetId.replace('#', ''));
      if (targetElement) {
        const headerHeight = 80; // Account for fixed header
        const targetPosition = targetElement.offsetTop - headerHeight;
        
        window.scrollTo({
          top: targetPosition,
          behavior: 'smooth'
        });
      }
    };

    // Add smooth scroll to all navigation links
    document.querySelectorAll('.cv-nav a, .cv-mobile-nav a').forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const href = (e.target as HTMLAnchorElement).getAttribute('href');
        if (href && href.startsWith('#')) {
          smoothScrollToSection(href);
          if (isOpen) closeMenu();
        }
      });
    });
  });
</script>
