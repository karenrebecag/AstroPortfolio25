---
// ProfileCardWrapper.astro
// Astro wrapper component for ProfileCard React island
// Following Astro best practices for islands architecture

import ProfileCard from './ProfileCard.tsx';

interface Props {
  variant?: 'default' | 'compact' | 'minimal';
  showBio?: boolean;
  bio?: string;
  animated?: boolean;
  className?: string;
}

const { 
  variant = 'default',
  showBio = true,
  bio = "Full Stack Developer passionate about creating exceptional web experiences with modern technologies.",
  animated = true,
  className = ''
} = Astro.props;
---

<!-- ProfileCard Island Wrapper -->
<!-- Uses client:visible for performance optimization -->
<!-- Only hydrates when component enters viewport -->

<div class="profile-card-wrapper">
  <ProfileCard
    client:visible
    variant={variant}
    showBio={showBio}
    bio={bio}
    animated={animated}
    className={className}
  />
</div>

<style>
  .profile-card-wrapper {
    /* Container styles */
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  /* Loading fallback styles */
  .profile-card-wrapper:not(:defined) {
    /* Skeleton loading state */
    width: 320px;
    height: 400px;
    background: linear-gradient(
      90deg,
      #f0f0f0 25%,
      #e0e0e0 50%,
      #f0f0f0 75%
    );
    background-size: 200% 100%;
    animation: loading 1.5s infinite;
    border-radius: 24px;
    margin: 0 auto;
  }
  
  @keyframes loading {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }
  
  /* Dark mode skeleton */
  @media (prefers-color-scheme: dark) {
    .profile-card-wrapper:not(:defined) {
      background: linear-gradient(
        90deg,
        #2d3748 25%,
        #1a202c 50%,
        #2d3748 75%
      );
      background-size: 200% 100%;
    }
  }
</style>
