---

<div class="projects-dropdown-wrapper">
  <ProjectsDropdownPortal 
    projects={projects}
    client:idle
  />
</div>

<style>
  .projects-dropdown-wrapper {
    display: flex;
    align-items: center;
    position: relative;
  }

  /* Hide on mobile - only show on desktop */
  @media (max-width: 1200px) {
    .projects-dropdown-wrapper {
      display: none;
    }
  }
</style>
