---
// MainButton component - Realistic Design with Magnetic Effect
export interface Props {
  text?: string;
  href?: string;
}

const { text = "Read More", href } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<div class="realism-button-wrapper">
  <Tag class="realism-button group" href={href}>
    <!-- Glow behind button -->
    <div class="button-glow"></div>

    <!-- Bottom-left green blob -->
    <div class="button-blob"></div>

    <!-- Inner content -->
    <div class="button-content">
      <span class="button-text">{text}</span>
      
      <!-- Inner glow layer -->
      <div class="inner-glow"></div>
    </div>
  </Tag>
</div>

<style>
  .realism-button-wrapper {
    position: relative;
    display: inline-block;
    opacity: 0;
    transform: translateY(20px);
    animation: fadeInUp 0.6s ease-out 0.1s forwards;
    transition: transform 0.2s ease-out;
  }

  .realism-button {
    position: relative;
    padding: 2px;
    border-radius: 16px;
    border: none;
    cursor: pointer;
    background: radial-gradient(circle 80px at 80% -10%, #ffffff, #181b1b);
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    font-size: clamp(16px, 2.8vw, 22px);
    overflow: visible;
    text-decoration: none;
    display: inline-block;
  }

  /* Ensure links behave like buttons */
  a.realism-button {
    color: inherit;
  }

  a.realism-button:visited {
    color: inherit;
  }

  .button-glow {
    position: absolute;
    top: 0;
    right: 0;
    width: 65%;
    height: 60%;
    border-radius: 120px;
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.22);
    transition: all 0.3s ease-out;
    z-index: -1;
  }

  /* Dark mode - Very subtle pink tint to glow */
  :global(.dark-mode) .button-glow {
    box-shadow: 0 0 20px rgba(255, 245, 250, 0.22);
  }

  .button-blob {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 50px;
    height: 50%;
    border-radius: 17px;
    background: radial-gradient(circle 60px at 0% 100%, #3fff75, rgba(0, 255, 128, 0.31), transparent);
    box-shadow: -2px 9px 40px rgba(0, 255, 45, 0.25);
    transition: all 0.3s ease-out;
    z-index: 1;
  }

  /* Dark mode - Pink blob instead of green */
  :global(.dark-mode) .button-blob {
    background: radial-gradient(circle 60px at 0% 100%, #ff75c3, rgba(255, 128, 192, 0.31), transparent);
    box-shadow: -2px 9px 40px rgba(255, 45, 150, 0.25);
  }

  .button-content {
    position: relative;
    padding: clamp(12px, 2.2vw, 16px) clamp(20px, 4vw, 28px);
    border-radius: 14px;
    color: white;
    background: radial-gradient(circle 80px at 80% -50%, #777777, #0f1111);
    z-index: 10;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    overflow: hidden;
  }

  .button-text {
    font-family: var(--font-display);
    font-weight: 500;
    text-shadow: 0px 2px 8px rgba(0, 0, 0, 0.6);
    letter-spacing: -0.025em;
    position: relative;
    z-index: 2;
  }

  .inner-glow {
    position: absolute;
    inset: 0;
    border-radius: 14px;
    background: radial-gradient(circle 60px at 0% 100%, rgba(0, 225, 255, 0.1), rgba(0, 0, 255, 0.067), transparent);
    z-index: 1;
    transition: opacity 0.3s ease;
  }

  /* Dark mode - Pink inner glow instead of cyan */
  :global(.dark-mode) .inner-glow {
    background: radial-gradient(circle 60px at 0% 100%, rgba(255, 150, 225, 0.1), rgba(255, 100, 200, 0.067), transparent);
  }

  /* Hover Effects */
  .realism-button:hover .button-glow {
    box-shadow: 0 0 40px rgba(255, 255, 255, 0.38);
  }

  /* Dark mode hover - Subtle pink tint intensified */
  :global(.dark-mode) .realism-button:hover .button-glow {
    box-shadow: 0 0 40px rgba(255, 240, 245, 0.38);
  }

  .realism-button:hover .button-blob {
    width: 90px;
    box-shadow: -4px 1px 45px rgba(0, 255, 45, 0.38);
  }

  /* Dark mode hover - Pink blob intensified */
  :global(.dark-mode) .realism-button:hover .button-blob {
    box-shadow: -4px 1px 45px rgba(255, 45, 150, 0.38);
  }

  .realism-button:hover .button-content {
    transform: scale(1.09);
  }

  .realism-button:hover .inner-glow {
    opacity: 1.5;
    background: radial-gradient(circle 80px at 0% 100%, rgba(0, 225, 255, 0.15), rgba(0, 0, 255, 0.1), transparent);
  }

  /* Dark mode hover - Pink inner glow intensified */
  :global(.dark-mode) .realism-button:hover .inner-glow {
    background: radial-gradient(circle 80px at 0% 100%, rgba(255, 150, 225, 0.15), rgba(255, 100, 200, 0.1), transparent);
  }

  .realism-button:hover .button-text {
    text-shadow: 0px 2px 12px rgba(0, 0, 0, 0.8);
  }

  /* Active state */
  .realism-button:active {
    transform: scale(0.98);
    transition: all 0.1s ease-out;
  }

  .realism-button:active .button-content {
    transform: scale(1.08);
  }

  /* Focus state for accessibility */
  .realism-button:focus-visible {
    outline: 2px solid rgba(63, 255, 117, 0.5);
    outline-offset: 4px;
  }

  /* Dark mode focus - Pink outline */
  :global(.dark-mode) .realism-button:focus-visible {
    outline: 2px solid rgba(255, 117, 200, 0.5);
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .realism-button {
      font-size: clamp(14px, 3.5vw, 18px);
    }
    
    .button-content {
      padding: clamp(10px, 2.5vw, 14px) clamp(16px, 4.5vw, 22px);
    }
    
    .button-blob {
      width: 40px;
    }
    
    .realism-button:hover .button-blob {
      width: 70px;
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .realism-button-wrapper {
      animation: none;
      opacity: 1;
      transform: none;
    }
    
    .realism-button,
    .button-glow,
    .button-blob,
    .button-content,
    .inner-glow {
      transition: none;
    }
    
    .realism-button:hover .button-content {
      transform: none;
    }
  }

  /* Enhanced glow effects for better visibility */
  .realism-button::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 18px;
    background: linear-gradient(45deg, 
      rgba(255, 255, 255, 0.1), 
      transparent, 
      rgba(63, 255, 117, 0.1));
    z-index: -2;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  /* Dark mode - Pink gradient border */
  :global(.dark-mode) .realism-button::before {
    background: linear-gradient(45deg, 
      rgba(255, 245, 250, 0.1), 
      transparent, 
      rgba(255, 117, 200, 0.1));
  }

  .realism-button:hover::before {
    opacity: 1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const buttons = document.querySelectorAll('.realism-button-wrapper');
    
    buttons.forEach(button => {
      // Magnetic effect
      button.addEventListener('mouseenter', function(e) {
        const mouseEvent = e as MouseEvent;
        const rect = button.getBoundingClientRect();
        const x = mouseEvent.clientX - rect.left;
        const y = mouseEvent.clientY - rect.top;
        
        (button as HTMLElement).style.transform = `translate(${x * 0.1}px, ${y * 0.1}px)`;
      });
      
      button.addEventListener('mouseleave', function() {
        (button as HTMLElement).style.transform = 'translate(0px, 0px)';
      });

      // Smooth scrolling for anchor links
      const link = button.querySelector('.realism-button') as HTMLAnchorElement;
      if (link && link.href && link.href.includes('#')) {
        link.addEventListener('click', function(e) {
          const href = link.getAttribute('href');
          if (href && href.startsWith('#')) {
            e.preventDefault();
            
            const targetId = href.substring(1);
            const targetElement = document.getElementById(targetId);
            
            if (targetElement) {
              targetElement.scrollIntoView({
                behavior: 'smooth',
                block: 'start',
                inline: 'nearest'
              });
            }
          }
        });
      }
    });
  });
</script>
