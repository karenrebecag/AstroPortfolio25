---
// ReviewCardsStack.astro - Stack of three review cards with overlapping layout
// Following Astro best practices and responsive design principles

import SingleCardReview from './SingleCardReview.astro';

export interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

// Three different reviews with varied rotations for stack effect
const reviewsData = [
  {
    review: "A rebrand is not typically done in a chaotic, archaic industry like ours, so their work has really set us apart. 10/10 for Hub's team.",
    author: "B. Gordon",
    position: "CEO & Founder, Archin Studio",
    avatar: undefined,
    rotation: -8
  },
  {
    review: "Karen's design engineering approach transformed our entire user experience. The attention to detail and technical execution exceeded all expectations.",
    author: "M. Rodriguez",
    position: "Product Manager, TechFlow",
    avatar: undefined,
    rotation: 2
  },
  {
    review: "Working with Karen was a game-changer for our startup. Her ability to bridge design and development saved us months of iteration.",
    author: "S. Chen",
    position: "CTO, InnovateLab",
    avatar: undefined,
    rotation: -3
  }
];
---

<div class={`review-cards-stack ${className}`}>
  <!-- Card 1 - Back (leftmost, lowest z-index) -->
  <div class="card-position card-back">
    <SingleCardReview 
      review={reviewsData[0].review}
      author={reviewsData[0].author}
      position={reviewsData[0].position}
      avatar={reviewsData[0].avatar}
      rotation={reviewsData[0].rotation}
    />
  </div>

  <!-- Card 2 - Middle -->
  <div class="card-position card-middle">
    <SingleCardReview 
      review={reviewsData[1].review}
      author={reviewsData[1].author}
      position={reviewsData[1].position}
      avatar={reviewsData[1].avatar}
      rotation={reviewsData[1].rotation}
    />
  </div>

  <!-- Card 3 - Front (rightmost, highest z-index) -->
  <div class="card-position card-front">
    <SingleCardReview 
      review={reviewsData[2].review}
      author={reviewsData[2].author}
      position={reviewsData[2].position}
      avatar={reviewsData[2].avatar}
      rotation={reviewsData[2].rotation}
    />
  </div>
</div>

<style>
  .review-cards-stack {
    position: relative;
    width: 100%;
    max-width: 900px;
    height: clamp(320px, 40vw, 400px);
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto;
  }

  .card-position {
    position: absolute;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94), 
                z-index 0.1s ease,
                opacity 0.3s ease;
    will-change: transform;
    cursor: pointer;
  }

  /* Card Back - Leftmost */
  .card-back {
    left: clamp(-20px, 2vw, 20px);
    top: clamp(30px, 4vw, 40px);
    z-index: 1;
    transform: scale(0.92);
    opacity: 0.8;
  }

  /* Card Middle - Center */
  .card-middle {
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) scale(0.96);
    z-index: 2;
    opacity: 0.88;
  }

  /* Card Front - Rightmost */
  .card-front {
    right: clamp(-20px, 2vw, 20px);
    top: clamp(-20px, -2vw, -10px);
    z-index: 3;
    transform: scale(1);
    opacity: 1;
  }

  /* Individual Card Hover Effects - Each card gets highest z-index on hover */
  .card-back:hover {
    z-index: 10;
    transform: scale(1.05) translateY(-10px);
    opacity: 1;
  }

  .card-middle:hover {
    z-index: 10;
    transform: translate(-50%, -50%) scale(1.05) translateY(-10px);
    opacity: 1;
  }

  .card-front:hover {
    z-index: 10;
    transform: scale(1.05) translateY(-10px);
    opacity: 1;
  }

  /* Subtle stack hover effect (when hovering the container but not individual cards) */
  .review-cards-stack:hover .card-back:not(:hover) {
    transform: scale(0.94) translateX(-15px);
    opacity: 0.75;
  }

  .review-cards-stack:hover .card-middle:not(:hover) {
    transform: translate(-50%, -50%) scale(0.98);
    opacity: 0.85;
  }

  .review-cards-stack:hover .card-front:not(:hover) {
    transform: scale(1.02) translateX(15px);
    opacity: 0.95;
  }

  /* Tablet Responsive (768px and below) */
  @media (max-width: 768px) {
    .review-cards-stack {
      max-width: 600px;
      height: clamp(280px, 35vw, 320px);
    }

    .card-back {
      left: clamp(-10px, 1vw, 10px);
      top: clamp(25px, 3vw, 30px);
      transform: scale(0.88);
    }

    .card-middle {
      transform: translate(-50%, -50%) scale(0.93);
    }

    .card-front {
      right: clamp(-10px, 1vw, 10px);
      top: clamp(-15px, -1.5vw, -10px);
      transform: scale(0.96);
    }

    /* Individual card hover effects on tablet */
    .card-back:hover {
      z-index: 10;
      transform: scale(1.02) translateY(-8px);
      opacity: 1;
    }

    .card-middle:hover {
      z-index: 10;
      transform: translate(-50%, -50%) scale(1.02) translateY(-8px);
      opacity: 1;
    }

    .card-front:hover {
      z-index: 10;
      transform: scale(1.02) translateY(-8px);
      opacity: 1;
    }

    /* Reduced stack hover effects on tablet */
    .review-cards-stack:hover .card-back:not(:hover) {
      transform: scale(0.9) translateX(-10px);
      opacity: 0.7;
    }

    .review-cards-stack:hover .card-middle:not(:hover) {
      transform: translate(-50%, -50%) scale(0.95);
      opacity: 0.8;
    }

    .review-cards-stack:hover .card-front:not(:hover) {
      transform: scale(0.98) translateX(10px);
      opacity: 0.9;
    }
  }

  /* Mobile Responsive (480px and below) */
  @media (max-width: 480px) {
    .review-cards-stack {
      max-width: 350px;
      height: clamp(240px, 30vw, 280px);
      /* Stack vertically on mobile for better readability */
      flex-direction: column;
      gap: 1rem;
      position: static;
    }

    .card-position {
      position: static;
      transform: none !important;
      opacity: 1 !important;
      width: 100%;
      max-width: 320px;
    }

    .card-back,
    .card-middle,
    .card-front {
      left: auto;
      right: auto;
      top: auto;
      transform: none;
      z-index: auto;
      opacity: 1;
    }

    /* Individual card hover effects on mobile (subtle) */
    .card-back:hover,
    .card-middle:hover,
    .card-front:hover {
      transform: scale(1.02);
      opacity: 1;
      z-index: 10;
    }

    /* Disable stack hover effects on mobile */
    .review-cards-stack:hover .card-back:not(:hover),
    .review-cards-stack:hover .card-middle:not(:hover),
    .review-cards-stack:hover .card-front:not(:hover) {
      transform: none;
      opacity: 1;
    }

    /* Add subtle stagger animation on mobile */
    .card-back {
      animation-delay: 0.1s;
    }

    .card-middle {
      animation-delay: 0.2s;
    }

    .card-front {
      animation-delay: 0.3s;
    }
  }

  /* Extra small mobile (360px and below) */
  @media (max-width: 360px) {
    .review-cards-stack {
      max-width: 300px;
      gap: 0.75rem;
    }

    .card-position {
      max-width: 280px;
    }
  }

  /* Accessibility - Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .card-position {
      transition: none;
    }

    .card-back:hover,
    .card-middle:hover,
    .card-front:hover {
      transform: none;
      z-index: 10; /* Still allow z-index change for readability */
    }

    .review-cards-stack:hover .card-back:not(:hover),
    .review-cards-stack:hover .card-middle:not(:hover),
    .review-cards-stack:hover .card-front:not(:hover) {
      transform: none;
    }

    .card-back,
    .card-middle,
    .card-front {
      animation: none;
    }
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .card-back,
    .card-middle {
      opacity: 1;
    }
  }

  /* Focus management for accessibility */
  .card-position:focus-within {
    z-index: 10;
    transform: scale(1.05) !important;
    opacity: 1 !important;
  }
</style>
