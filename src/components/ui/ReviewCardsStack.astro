---
// ReviewCardsStack.astro - Stack of three review cards with overlapping layout
// Following Astro best practices and responsive design principles

import SingleCardReview from './SingleCardReview.astro';

export interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

// Four different reviews with varied rotations, colors, and fonts for stack effect
const reviewsData = [
  {
    review: "A rebrand is not typically done in a chaotic, archaic industry like ours, so their work has really set us apart. 10/10 for Hub's team.",
    author: "B. Gordon",
    position: "CEO & Founder, Archin Studio",
    avatar: undefined,
    rotation: -15,
    backgroundColor: "#C0D645",
    textColor: "#000000",
    fontFamily: "font-display" // Median
  },
  {
    review: "Karen's design engineering approach transformed our entire user experience. The attention to detail and technical execution exceeded all expectations.",
    author: "M. Rodriguez",
    position: "Product Manager, TechFlow",
    avatar: undefined,
    rotation: 8,
    backgroundColor: "#151515",
    textColor: "#FFFFFF",
    fontFamily: "font-secondary" // Boysen
  },
  {
    review: "Working with Karen was a game-changer for our startup. Her ability to bridge design and development saved us months of iteration.",
    author: "S. Chen",
    position: "CTO, InnovateLab",
    avatar: undefined,
    rotation: -12,
    backgroundColor: "#EEEEEE",
    textColor: "#333333",
    fontFamily: "font-primary" // Inter Tight
  },
  {
    review: "The 3D animations and WebGL implementations Karen delivered were absolutely stunning. Her technical expertise in modern web technologies is exceptional.",
    author: "A. Thompson",
    position: "Creative Director, PixelForge",
    avatar: undefined,
    rotation: 18,
    backgroundColor: "#FFFFFF",
    textColor: "#000000",
    fontFamily: "font-game" // Video Game Font
  }
];
---

<div class={`review-cards-stack ${className}`}>
  <!-- Card 1 - Back (leftmost, lowest z-index) -->
  <div class="card-position card-back" 
       style={`--card-bg: ${reviewsData[0].backgroundColor}; --card-text: ${reviewsData[0].textColor}; transform: translateY(-50%) scale(0.85) rotate(${reviewsData[0].rotation}deg);`}>
    <div class={`card-content ${reviewsData[0].fontFamily}`}>
      <SingleCardReview 
        review={reviewsData[0].review}
        author={reviewsData[0].author}
        position={reviewsData[0].position}
        avatar={reviewsData[0].avatar}
        rotation={0}
      />
    </div>
  </div>

  <!-- Card 2 - Middle -->
  <div class="card-position card-middle" 
       style={`--card-bg: ${reviewsData[1].backgroundColor}; --card-text: ${reviewsData[1].textColor}; transform: translateY(-50%) scale(0.9) rotate(${reviewsData[1].rotation}deg);`}>
    <div class={`card-content ${reviewsData[1].fontFamily}`}>
      <SingleCardReview 
        review={reviewsData[1].review}
        author={reviewsData[1].author}
        position={reviewsData[1].position}
        avatar={reviewsData[1].avatar}
        rotation={0}
      />
    </div>
  </div>

  <!-- Card 3 - Second Front -->
  <div class="card-position card-second-front" 
       style={`--card-bg: ${reviewsData[2].backgroundColor}; --card-text: ${reviewsData[2].textColor}; transform: translateY(-50%) scale(0.95) rotate(${reviewsData[2].rotation}deg);`}>
    <div class={`card-content ${reviewsData[2].fontFamily}`}>
      <SingleCardReview 
        review={reviewsData[2].review}
        author={reviewsData[2].author}
        position={reviewsData[2].position}
        avatar={reviewsData[2].avatar}
        rotation={0}
      />
    </div>
  </div>

  <!-- Card 4 - Front (rightmost, highest z-index) -->
  <div class="card-position card-front" 
       style={`--card-bg: ${reviewsData[3].backgroundColor}; --card-text: ${reviewsData[3].textColor}; transform: translateY(-50%) scale(1) rotate(${reviewsData[3].rotation}deg);`}>
    <div class={`card-content ${reviewsData[3].fontFamily}`}>
      <SingleCardReview 
        review={reviewsData[3].review}
        author={reviewsData[3].author}
        position={reviewsData[3].position}
        avatar={reviewsData[3].avatar}
        rotation={0}
      />
    </div>
  </div>
</div>

<style>
  .review-cards-stack {
    position: relative;
    width: 100%;
    max-width: 1400px;
    height: clamp(350px, 45vw, 450px);
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto;
  }

  .card-position {
    position: absolute;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94), 
                z-index 0.1s ease,
                opacity 0.3s ease;
    will-change: transform;
    cursor: pointer;
  }

  /* Card Back - Leftmost */
  .card-back {
    left: clamp(-120px, -8vw, -100px);
    top: 50%;
    z-index: 1;
    opacity: 1;
  }

  /* Card Middle - Left Center */
  .card-middle {
    left: clamp(8%, 12%, 16%);
    top: 50%;
    z-index: 2;
    opacity: 1;
  }

  /* Card Second Front - Right Center */
  .card-second-front {
    right: clamp(8%, 12%, 16%);
    top: 50%;
    z-index: 3;
    opacity: 1;
  }

  /* Card Front - Rightmost */
  .card-front {
    right: clamp(-120px, -8vw, -100px);
    top: 50%;
    z-index: 4;
    opacity: 1;
  }

  /* Card Content Styling */
  .card-content {
    background-color: var(--card-bg);
    color: var(--card-text);
    border-radius: 16px;
    padding: 1rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    border: 2px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Override SingleCardReview styles */
  .card-content :global(.review-card) {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }

  .card-content :global(.review-text),
  .card-content :global(.author-name),
  .card-content :global(.author-position) {
    color: inherit !important;
  }

  .card-middle:hover {
    z-index: 10;
    transform: translateY(-60%) scale(1.05) rotate(8deg);
    opacity: 1;
  }

  .card-second-front:hover {
    z-index: 10;
    transform: translateY(-60%) scale(1.05) rotate(-12deg);
    opacity: 1;
  }

  .card-front:hover {
    z-index: 10;
    transform: translateY(-60%) scale(1.05) rotate(18deg);
    opacity: 1;
  }

  /* Subtle stack hover effect (when hovering the container but not individual cards) */
  .review-cards-stack:hover .card-back:not(:hover) {
    transform: translateY(-50%) scale(0.82) rotate(-15deg) translateX(-15px);
    opacity: 0.65;
  }

  .review-cards-stack:hover .card-middle:not(:hover) {
    transform: translateY(-50%) scale(0.87) rotate(8deg) translateX(-8px);
    opacity: 0.75;
  }

  .review-cards-stack:hover .card-second-front:not(:hover) {
    transform: translateY(-50%) scale(0.92) rotate(-12deg) translateX(8px);
    opacity: 0.85;
  }

  .review-cards-stack:hover .card-front:not(:hover) {
    transform: translateY(-50%) scale(0.97) rotate(18deg) translateX(15px);
    opacity: 0.95;
  }

  /* Tablet Responsive (768px and below) */
  @media (max-width: 768px) {
    .review-cards-stack {
      max-width: 800px;
      height: clamp(280px, 35vw, 320px);
    }

    .card-back {
      left: clamp(-60px, -4vw, -40px);
      top: 50%;
    }

    .card-middle {
      left: clamp(15%, 18%, 22%);
      top: 50%;
    }

    .card-second-front {
      right: clamp(15%, 18%, 22%);
      top: 50%;
    }

    .card-front {
      right: clamp(-60px, -4vw, -40px);
      top: 50%;
    }

    /* Individual card hover effects on tablet */
    .card-back:hover {
      z-index: 10;
      transform: translateY(-60%) scale(1.02) rotate(-15deg);
      opacity: 1;
    }

    .card-middle:hover {
      z-index: 10;
      transform: translateY(-60%) scale(1.02) rotate(8deg);
      opacity: 1;
    }

    .card-second-front:hover {
      z-index: 10;
      transform: translateY(-60%) scale(1.02) rotate(-12deg);
      opacity: 1;
    }

    .card-front:hover {
      z-index: 10;
      transform: translateY(-60%) scale(1.02) rotate(18deg);
      opacity: 1;
    }

    /* Reduced stack hover effects on tablet */
    .review-cards-stack:hover .card-back:not(:hover) {
      transform: translateY(-50%) scale(0.8) rotate(-15deg) translateX(-10px);
      opacity: 0.65;
    }

    .review-cards-stack:hover .card-middle:not(:hover) {
      transform: translateY(-50%) scale(0.85) rotate(8deg) translateX(-5px);
      opacity: 0.75;
    }

    .review-cards-stack:hover .card-second-front:not(:hover) {
      transform: translateY(-50%) scale(0.9) rotate(-12deg) translateX(5px);
      opacity: 0.85;
    }

    .review-cards-stack:hover .card-front:not(:hover) {
      transform: translateY(-50%) scale(0.95) rotate(18deg) translateX(10px);
      opacity: 0.9;
    }
  }

  /* Mobile Responsive (480px and below) */
  @media (max-width: 480px) {
    .review-cards-stack {
      max-width: 350px;
      height: clamp(240px, 30vw, 280px);
      /* Stack vertically on mobile for better readability */
      flex-direction: column;
      gap: 1rem;
      position: static;
    }

    .card-position {
      position: static;
      transform: none !important;
      opacity: 1 !important;
      width: 100%;
      max-width: 320px;
    }

    .card-back,
    .card-middle,
    .card-second-front,
    .card-front {
      left: auto;
      right: auto;
      top: auto;
      transform: none;
      z-index: auto;
      opacity: 1;
    }

    /* Individual card hover effects on mobile (subtle) */
    .card-back:hover,
    .card-middle:hover,
    .card-second-front:hover,
    .card-front:hover {
      transform: scale(1.02);
      opacity: 1;
      z-index: 10;
    }

    /* Disable stack hover effects on mobile */
    .review-cards-stack:hover .card-back:not(:hover),
    .review-cards-stack:hover .card-middle:not(:hover),
    .review-cards-stack:hover .card-second-front:not(:hover),
    .review-cards-stack:hover .card-front:not(:hover) {
      transform: none;
      opacity: 1;
    }

    /* Add subtle stagger animation on mobile */
    .card-back {
      animation-delay: 0.1s;
    }

    .card-middle {
      animation-delay: 0.2s;
    }

    .card-second-front {
      animation-delay: 0.3s;
    }

    .card-front {
      animation-delay: 0.4s;
    }
  }

  /* Extra small mobile (360px and below) */
  @media (max-width: 360px) {
    .review-cards-stack {
      max-width: 300px;
      gap: 0.75rem;
    }

    .card-position {
      max-width: 280px;
    }
  }

  /* Accessibility - Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .card-position {
      transition: none;
    }

    .card-back:hover,
    .card-middle:hover,
    .card-second-front:hover,
    .card-front:hover {
      transform: none;
      z-index: 10; /* Still allow z-index change for readability */
    }

    .review-cards-stack:hover .card-back:not(:hover),
    .review-cards-stack:hover .card-middle:not(:hover),
    .review-cards-stack:hover .card-second-front:not(:hover),
    .review-cards-stack:hover .card-front:not(:hover) {
      transform: none;
    }

    .card-back,
    .card-middle,
    .card-second-front,
    .card-front {
      animation: none;
    }
  }

  /* High contrast mode support */
  @media (prefers-contrast: high) {
    .card-back,
    .card-middle,
    .card-second-front {
      opacity: 1;
    }
  }

  /* Focus management for accessibility */
  .card-position:focus-within {
    z-index: 10;
    transform: scale(1.05) !important;
    opacity: 1 !important;
  }
</style>
