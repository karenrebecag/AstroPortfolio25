---
import { BGPattern } from './bg-pattern.tsx';
---

<div class="white-background-wrapper">
  <div class="bg-container light-pattern">
    <BGPattern
      client:load
      variant="vertical-lines"
      mask="fade-edges"
      size={32}
      fill="rgba(0, 0, 0, 0.08)"
    />
  </div>
  <div class="bg-container dark-pattern">
    <BGPattern
      client:load
      variant="vertical-lines"
      mask="fade-edges"
      size={32}
      fill="rgba(157, 127, 193, 0.12)"
    />
  </div>
  <div class="content">
    <slot />
  </div>
</div>

<style>
  .white-background-wrapper {
    position: relative;
    width: 100%;
    background-color: #ffffff;
    min-height: 100vh;
    transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark Mode Background */
  :global(.dark-mode) .white-background-wrapper {
    background-color: #0a1628;
  }

  .bg-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .light-pattern {
    opacity: 1;
  }

  .dark-pattern {
    opacity: 0;
  }

  :global(.dark-mode) .light-pattern {
    opacity: 0;
  }

  :global(.dark-mode) .dark-pattern {
    opacity: 1;
  }

  .content {
    position: relative;
    z-index: 1;
  }
</style>