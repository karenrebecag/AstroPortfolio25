---
import { BGPattern } from './bg-pattern.tsx';

interface Props {
  lightOpacity?: number;
  darkOpacity?: number;
}

const {
  lightOpacity = 0,
  darkOpacity = 0.18
} = Astro.props;

const lightFill = `rgba(0, 0, 0, ${lightOpacity})`;
const darkFill = `rgba(157, 127, 193, ${darkOpacity})`;
---

<div class="white-background-wrapper">
  <div class="bg-container light-pattern">
    <BGPattern
      client:load
      variant="vertical-lines"
      mask="fade-edges"
      size={32}
      fill={lightFill}
    />
  </div>
  <div class="bg-container dark-pattern">
    <BGPattern
      client:load
      variant="vertical-lines"
      mask="fade-edges"
      size={32}
      fill={darkFill}
    />
  </div>
  <div class="content">
    <slot />
  </div>
</div>

<style>
  .white-background-wrapper {
    position: relative;
    width: 100%;
    background-color: #ffffff;
    min-height: auto;
    height: auto;
    transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dark Mode Background */
  :global(.dark-mode) .white-background-wrapper {
    background-color: #050b15;
  }

  .bg-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .light-pattern {
    display: block;
  }

  .dark-pattern {
    display: none;
  }

  :global(.dark-mode) .light-pattern {
    display: none;
  }

  :global(.dark-mode) .dark-pattern {
    display: block;
  }

  .content {
    position: relative;
    z-index: 1;
  }
</style>