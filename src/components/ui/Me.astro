---
// Me.astro - About section component
import MainButton from './MainButton.astro';
import SecondaryButton from './SecondaryButton.astro';
import { Number } from './Number.tsx';
import CubeBackground from '../three/CubeBackground.tsx';
import GlobeBackground from '../three/GlobeBackground.tsx';
import { TextDisperseBlack } from './TextDisperseBlack.tsx';
import ExperienceMarqueeIsland from './ExperienceMarqueeIsland.tsx';
import ExperienceSlider from './ExperienceSlider.tsx';
import { motion } from 'motion/react';
import { AnimatedMeHeader, AnimatedMeSection, AnimatedMeElement, AnimatedMeStats, AnimatedMeButton } from './AnimatedMeWrapper.tsx';

const experienceData = [
  {
    id: "01",
    title: "UX/UI & Frontend Developer",
    company: "OPINATOR (Madrid, Spain)",
    description: "Led the UX/UI redesign of OPINATOR's live forms WebApp, collaborating with a team of five to enhance user experience, accessibility, and developer workflows.",
    highlight: "Designed a modular design system with Figma and implemented frontend with React, boosting form response rates by 30%.",
    image: "https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/fe0d8274-c12e-461f-8052-73525d0ecd0d.webp"
  },
  {
    id: "02",
    title: "UX/UI & Webflow Developer",
    company: "AURIN × ANCIENT TECH Partnership",
    description: "Led a collaborative four-month UX engineering project between Aurin and Ancient Tech to design and develop Ancient's main web platform in Webflow, while working directly for Aurin.",
    highlight: "Built an AI-driven interactive hero banner with WebGL animations through this strategic partnership, enhancing engagement and visual appeal.",
    image: "https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/Ancient.png"
  },
  {
    id: "03",
    title: "Design Engineer & Fullstack Developer",
    company: "AURIN (SODIO) (Cuernavaca, México)",
    description: "Designed mobile and web UX/UI for MonexOne and web apps like Inglesindividual, Galicia MX, Dentol MX, and Fintpay Banking, while leading fullstack development and AI automations.",
    highlight: "Developed Aurin Task Manager with Next.js, Firestore, Clerk, and AI-powered task summaries, streamlining team workflows with temporary dynamic links.",
    image: "https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/Aurin.jpeg"
  },
  {
    id: "04",
    title: "Senior UX/UI Designer",
    company: "ATHENIS AI (LATAM & EU)",
    description: "Led UX/UI design for an AI-driven educational platform, creating intuitive interfaces and component libraries to enhance user engagement and developer efficiency.",
    highlight: "Crafted a Figma-to-React component library for Login and Dashboard, improving handoff efficiency by 25%.",
    image: "https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/AthenisAI.jpeg"
  },
  {
    id: "05",
    title: "Founder & Design Engineer",
    company: "WEBCRAFTERS (Mexico City)",
    description: "Founded WebCrafters, a UX/UI and Web Art agency, delivering custom web applications with AI-driven features, 3D animations, and scalable architectures.",
    highlight: "Led design and deployment of visually stunning web solutions with Three.js and AI integrations, serving diverse industries.",
    image: "https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/WebCrafters.jpeg"
  }
];
---

<!-- Storytelling Scroll Container -->
<div class="storytelling-scroll-container">
  <div class="story-grid w-full max-w-[1400px] mx-auto px-15 grid lg:grid-cols-2 gap-12">

    <!-- Left Column: 3D Cube - Visible on desktop, hidden on mobile -->
    <AnimatedMeHeader client:visible>
      <div class="w-full aspect-square relative overflow-hidden rounded-lg" style="min-height: 400px; max-height: 600px;">
        <!-- Cube 3D Background -->
        <CubeBackground client:visible className="cube-3d-container" />
      </div>
    </AnimatedMeHeader>
    
    <!-- Right Column: Scrolling Content -->
    <div class="scrolling-content-column">
      
      <!-- Content Section 1: Introduction -->
      <AnimatedMeSection client:visible delay={0.1}>
        <div class="relative z-10">
          <div class="relative">
            <!-- Purple circle positioned behind the heading -->
            <AnimatedMeElement client:visible delay={0.2} direction="right">
              <div class="me-purple-circle bg-[#D9CCFF] rounded-full absolute -top-4 -left-8 -z-10"></div>
            </AnimatedMeElement>
            <AnimatedMeElement client:visible delay={0.25}>
              <h2 class="me-hero-title text-hero font-median mb-2 relative z-10">
                <span class="me-hero-text-dark">karen ortiz,</span> <span class="text-[#7350cc]">Design<br />Engineer</span>
              </h2>
            </AnimatedMeElement>
          </div>
          <AnimatedMeElement client:visible delay={0.3}>
            <h3 class="me-heading-lg text-heading-lg me-heading-text-dark font-secondary font-bold">
              Based in Mexico City
            </h3>
          </AnimatedMeElement>
          <AnimatedMeElement client:visible delay={0.35}>
            <p class="me-body-lg text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary mt-6">
              That is where I come in. A lover of words, a wrangler of copy. Here to create copy that not only reflects 
              who you are and what you stand for, but words that truly land with those that read them.
            </p>
          </AnimatedMeElement>
        </div>
      </AnimatedMeSection>

      <!-- Content Section 2: Experience -->
      <AnimatedMeSection client:visible delay={0.15}>
        <div class="relative z-10">
          <AnimatedMeElement client:visible delay={0.4}>
            <h2 class="me-section-title text-hero font-median mb-6">
              <span class="text-[#7350cc]">5+ Years</span><br />
              <span class="me-section-text-dark">Creating Digital</span><br />
              <span class="me-section-text-dark">Experiences</span>
            </h2>
          </AnimatedMeElement>
          <AnimatedMeElement client:visible delay={0.45}>
            <p class="me-body-lg text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary mb-8">
              From UI/UX design to full-stack development, I've worked with companies across the globe, 
              creating seamless digital experiences that merge aesthetics with functionality.
            </p>
          </AnimatedMeElement>
          <AnimatedMeButton client:visible delay={0.5}>
            <div class="flex items-start gap-9 button-container-me">
              <div class="realism-button-wrapper" data-astro-cid-rjz7vswu="" style="transform: translate(0px, 0px);">
                <a href="https://www.linkedin.com/in/karen-rebeca-ortiz-b5a860282/" target="_blank" rel="noopener noreferrer" class="realism-button group" data-astro-cid-rjz7vswu="true" data-cursor-text="Go there!">
                  <div class="button-glow" data-astro-cid-rjz7vswu=""></div>
                  <div class="button-blob" data-astro-cid-rjz7vswu=""></div>
                  <div class="button-content" data-astro-cid-rjz7vswu="">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-linkedin" style="color: white; margin-right: 8px;">
                      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                      <rect width="4" height="12" x="2" y="9"/>
                      <circle cx="4" cy="4" r="2"/>
                    </svg>
                    <span class="button-text" data-astro-cid-rjz7vswu="">Connect</span>
                    <!-- Inner glow layer -->
                    <div class="inner-glow" data-astro-cid-rjz7vswu=""></div>
                  </div>
                </a>
              </div>
            </div>
          </AnimatedMeButton>
        </div>
      </AnimatedMeSection>

      <!-- Content Section 3: Stats -->
      <AnimatedMeSection client:visible delay={0.2}>
        <div class="relative z-10">
          <AnimatedMeElement client:visible delay={0.55}>
            <h2 class="me-section-title text-hero font-median mb-8">
              <span class="me-section-text-dark">Numbers That</span><br />
              <span class="text-[#7350cc]">Speak Volumes</span>
            </h2>
          </AnimatedMeElement>
          
          <!-- Stats Grid -->
          <div class="grid grid-cols-3 gap-8 mb-8">
            <AnimatedMeStats client:visible delay={0.6}>
              <div class="text-center">
                <div class="me-stats-number text-display me-stats-text-dark font-secondary mb-2">
                  <Number value={8} delay={500} client:visible />
                </div>
                <div class="me-body-sm text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary">Award winner</div>
              </div>
            </AnimatedMeStats>
            
            <AnimatedMeStats client:visible delay={0.65}>
              <div class="text-center">
                <div class="me-stats-number flex items-center justify-center text-display me-stats-text-dark font-secondary mb-2">
                  <Number value={1} delay={700} client:visible />
                  <span>.2k</span>
                </div>
                <div class="me-body-sm text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary">Worldwide clients</div>
              </div>
            </AnimatedMeStats>
            
            <AnimatedMeStats client:visible delay={0.7}>
              <div class="text-center">
                <div class="me-stats-number flex items-center justify-center text-display me-stats-text-dark font-secondary mb-2">
                  <Number value={3} delay={900} client:visible />
                  <span>.5k</span>
                </div>
                <div class="me-body-sm text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary">Jobs completed</div>
              </div>
            </AnimatedMeStats>
          </div>
          
          <AnimatedMeElement client:visible delay={0.75}>
            <p class="me-body-md text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary">
              Every project is an opportunity to push boundaries and create something extraordinary.
            </p>
          </AnimatedMeElement>
        </div>
      </AnimatedMeSection>

      <!-- Content Section 4: Philosophy -->
      <AnimatedMeSection client:visible delay={0.25}>
        <div class="relative z-10">
          <AnimatedMeElement client:visible delay={0.8}>
            <h2 class="me-section-title text-hero font-median mb-6">
              <span class="me-section-text-dark">Design Is Not Just</span><br />
              <span class="text-[#7350cc]">What It Looks Like</span><br />
              <span class="me-section-text-dark">It's How It Works</span>
            </h2>
          </AnimatedMeElement>
          <AnimatedMeElement client:visible delay={0.85}>
            <p class="me-body-lg text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary mb-6">
              I believe in creating digital experiences that are not only visually stunning but also 
              functionally exceptional. Every pixel serves a purpose, every interaction tells a story.
            </p>
          </AnimatedMeElement>
          <AnimatedMeElement client:visible delay={0.9}>
            <p class="me-body-md text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary">
              Ready to bring your vision to life? Let's create something extraordinary together.
            </p>
          </AnimatedMeElement>
        </div>
      </AnimatedMeSection>

    </div>
  </div>
</div>

<!-- Globe Section - Above Experience Cards -->
<div class="globe-section">
  <div class="globe-title-wrapper">
    <motion.div
      className="globe-title-container"
      initial={{ opacity: 0, y: 50 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true, margin: "-100px" }}
      transition={{ duration: 0.8, ease: "easeOut" }}
      client:idle
    >
      <div class="globe-title-text-wrapper">
        <TextDisperseBlack text="GLOBAL IMPACT" className="globe-title-disperse" client:idle />
      </div>
    </motion.div>
  </div>
  <div class="globe-container">
    <GlobeBackground client:visible className="globe-3d-container" />
  </div>
</div>

<!-- Experience Cards Section - Dual System: Marquee (Desktop) + Slider (Mobile) -->
<div class="experience-container cards-section">
  <!-- Text Above Experience Cards -->
  <div class="experience-text-container">
    <motion.div
      className="experience-text-wrapper"
      initial={{ opacity: 0, y: 30 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true, margin: "-100px" }}
      transition={{ duration: 0.8, ease: "easeOut" }}
      client:idle
    >
      <p class="experience-description-text">
        I've collaborated with clients worldwide to create efficient, 
        impactful digital products that drive real business results.
      </p>
    </motion.div>
  </div>
  
  <!-- Desktop: Marquee Infinito (visible en vp >= 768px) -->
  <div class="experience-marquee-desktop">
    <div class="experience-marquee-container">
      <div class="experience-marquee-wrapper-limited">
        <ExperienceMarqueeIsland client:visible />
      </div>
    </div>
  </div>
  
  <!-- Mobile: Slider Manual (visible en vp < 768px) -->
  <div class="experience-slider-mobile">
    <ExperienceSlider experienceData={experienceData} client:visible />
  </div>
</div>

<style>
  /* Storytelling Scroll Container */
  :global(.storytelling-scroll-container) {
    background: #f9f9f9;
    padding-top: 20rem;
    position: relative;
    transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr; /* Two column layout on desktop */
    gap: 3rem;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 3.75rem;
  }

  /* Left Column: Sticky Image */
  .sticky-image-column {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
  }

  /* Cube 3D Container */
  .cube-3d-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    overflow: hidden;
    background: linear-gradient(135deg, #f9f9f9 0%, #e8e8e8 100%);
    z-index: 1;
  }

  /* Right Column: Scrolling Content */
  .scrolling-content-column {
    display: flex;
    flex-direction: column;
    gap: 15rem;
  }

  .content-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    padding: 2rem 0;
  }

  /* Grid pattern overlay */
  :global(.storytelling-scroll-container)::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      linear-gradient(rgba(0, 0, 0, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.02) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
    z-index: 1;
    transition: background-image 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .story-grid {
    position: relative;
    z-index: 2;
  }

  /* Me Section Title Styles */
  :global(.me-hero-title) {
    font-size: clamp(48px, 8vw, 96px);
    line-height: 0.75;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.me-section-title) {
    font-size: clamp(36px, 6vw, 72px);
    line-height: 0.9;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.me-heading-lg) {
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.23;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.me-body-lg) {
    font-size: 20px;
    line-height: 1.5;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.me-body-md) {
    font-size: 18px;
    line-height: 1.5;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.me-body-sm) {
    font-size: 16px;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.me-stats-number) {
    font-size: 48px;
    line-height: 56px;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.me-purple-circle) {
    width: 244px;
    height: 238px;
    transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* New classes for hardcoded text colors */
  :global(.me-hero-text-dark) {
    color: #080808;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.me-heading-text-dark) {
    color: #080808;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.me-section-text-dark) {
    color: #080808;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.me-stats-text-dark) {
    color: #080808;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .globe-container {
    position: absolute;
    top: 70%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    max-width: 780px; /* 600px * 1.3 = 780px */
    height: 780px; /* 600px * 1.3 = 780px */
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 10;
    transition: filter 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .story-grid {
      gap: 2rem;
      padding: 0 2rem;
    }
  }

  @media (max-width: 768px) {
    .story-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 0 1.5rem;
      text-align: center;
    }

    .sticky-image-column {
      display: none;
    }

    .sticky-image {
      order: -1;
      max-width: 300px;
      margin: 0 auto;
    }

    .story-content {
      order: 1;
    }

    .content-section {
      min-height: 60vh;
    }
  }

  .me-section {
    position: relative;
    z-index: 2;
  }

  /* Contenedor principal del contenido */
  .main-content-container {
    width: 100%;
    max-width: 1400px;
    padding: 120px 60px;
    position: relative;
    z-index: 2;
  }

  /* Solo los elementos internos ocultos - mantenemos estructura de columnas */
  .profile-section,
  .description-section,
  .stats-section,
  .buttons-section,
  .image-section {
    opacity: 0;
    transform: translateY(60px);
  }

  .secondary-btn {
    background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 50%, #000000 100%);
    box-shadow: 0px 4px 200px rgba(255, 255, 255, 0.05);
  }

  .main-btn {
    background: 
      linear-gradient(47deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.30) 100%),
      url('https://pub-2e7dc04d482146c59f472ab28fba09a9.r2.dev/MePortfolio.png');
    background-size: cover;
    background-position: center;
    box-shadow: 0px 4px 200px rgba(255, 255, 255, 0.05);
  }

  .btn-text {
    text-shadow: 0px 2px 4px rgba(0, 0, 0, 0.8);
  }


  .counter {
    transition: all 0.3s ease;
  }

  /* Split text styles */
  .split-char {
    display: inline-block;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .split-char.animate {
    opacity: 1;
    transform: translateY(0);
  }

  .split-word {
    display: inline-block;
    overflow: hidden;
  }

  /* Animation styles */
  [data-animate] {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  [data-animate="fade-left"] {
    opacity: 0;
    transform: translateX(30px);
    transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  [data-animate="fade-right"] {
    opacity: 0;
    transform: translateX(-30px);
    transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  [data-animate].animate {
    opacity: 1;
    transform: translateY(0);
  }

  [data-animate="fade-left"].animate {
    opacity: 1;
    transform: translateX(0);
  }

  [data-animate="fade-right"].animate {
    opacity: 1;
    transform: translateX(0);
  }

  /* Globe Section Styles */
  :global(.globe-section) {
    width: 100%;
    background: #f9f9f9;
    padding: 0px 60px 0px 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    /* min-height: 50vh; */
  }

  .globe-container {
    position: absolute;
    top: 70%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    max-width: 780px; /* 600px * 1.3 = 780px */
    height: 780px; /* 600px * 1.3 = 780px */
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 10;
  }

  .globe-3d-container {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background: linear-gradient(135deg, #f9f9f9 0%, #e8e8e8 100%);
  }

  /* Grid pattern overlay for globe section */
  :global(.globe-section)::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      linear-gradient(rgba(0, 0, 0, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.02) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
    z-index: 1;
    transition: background-image 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Globe Title Styles - Behind Globe */
  .globe-title-wrapper {
    padding: 200px 60px 510px 60px;
    width: 100%;
    display: flex;
    margin-top: 100px;
    justify-content: center;
    position: relative;
    z-index: 1;
    overflow: hidden; /* Prevent horizontal overflow */
  }

  .globe-title-container {
    width: 100%;
    max-width: 1400px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden; /* Prevent content overflow */
  }

  /* Wrapper para limitar el texto al viewport */
  .globe-title-text-wrapper {
    width: 100%;
    max-width: 100vw;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0 20px; /* Padding interno para evitar que toque los bordes */
    box-sizing: border-box;
  }

  :global(.globe-title-disperse) {
    font-family: var(--font-display) !important;
    font-size: clamp(40px, 8vw, 120px) !important; /* Tamaño más conservador */
    font-weight: 400 !important;
    color: #060314 !important;
    line-height: 0.8 !important;
    letter-spacing: -0.02em !important;
    text-transform: uppercase !important;
    margin: 0 !important;
    text-align: center !important;
    white-space: nowrap !important;
    width: fit-content !important;
    max-width: calc(100vw - 40px) !important; /* Considerar padding lateral */
    transform-origin: center !important;
    will-change: transform !important;
  }

  :global(.globe-title-disperse span) {
    font-family: var(--font-display) !important;
    color: #060314 !important;
  }

