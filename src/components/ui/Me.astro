---
// Me.astro - About section component
import MainButton from './MainButton.astro';
import SecondaryButton from './SecondaryButton.astro';
import { Number } from './Number.tsx';
import CubeBackground from '../three/CubeBackground.tsx';
import GlobeBackground from '../three/GlobeBackground.tsx';
import { TextDisperseBlack } from './TextDisperseBlack.tsx';
import ExperienceMarqueeIsland from './ExperienceMarqueeIsland.tsx';
import { motion } from 'motion/react';

const experienceData = [
  {
    id: "01",
    title: "UX/UI & Frontend Developer",
    company: "OPINATOR (Madrid, Spain)",
    description: "Led the UX/UI redesign of OPINATOR's live forms WebApp, collaborating with a team of five to enhance user experience, accessibility, and developer workflows.",
    highlight: "Designed a modular design system with Figma and implemented frontend with React, boosting form response rates by 30%.",
    image: "/images/EnterprisesLogos/ExperienceCards/Opinator.webp"
  },
  {
    id: "02",
    title: "UX/UI & Webflow Developer",
    company: "ANCIENT TECH (Houston, Texas & LATAM)",
    description: "Directed a four-month UX engineering process to design and develop Ancient Tech's main web platform in Webflow, emphasizing intuitive user interactions.",
    highlight: "Built an AI-driven interactive hero banner with WebGL animations, enhancing engagement and visual appeal.",
    image: "/images/EnterprisesLogos/ExperienceCards/Ancient.png"
  },
  {
    id: "03",
    title: "Design Engineer & Fullstack Developer",
    company: "AURIN (SODIO) (Cuernavaca, México)",
    description: "Designed mobile and web UX/UI for MonexOne and web apps like Inglesindividual, Galicia MX, Dentol MX, and Fintpay Banking, while leading fullstack development and AI automations.",
    highlight: "Developed Aurin Task Manager with Next.js, Firestore, Clerk, and AI-powered task summaries, streamlining team workflows with temporary dynamic links.",
    image: "/images/EnterprisesLogos/ExperienceCards/Aurin.webp"
  },
  {
    id: "04",
    title: "Senior UX/UI Designer",
    company: "ATHENIS AI (LATAM & EU)",
    description: "Led UX/UI design for an AI-driven educational platform, creating intuitive interfaces and component libraries to enhance user engagement and developer efficiency.",
    highlight: "Crafted a Figma-to-React component library for Login and Dashboard, improving handoff efficiency by 25%.",
    image: "/images/EnterprisesLogos/ExperienceCards/AthenisAI.webp"
  },
  {
    id: "05",
    title: "Founder & Design Engineer",
    company: "WEBCRAFTERS (Mexico City)",
    description: "Founded WebCrafters, a UX/UI and Web Art agency, delivering custom web applications with AI-driven features, 3D animations, and scalable architectures.",
    highlight: "Led design and deployment of visually stunning web solutions with Three.js and AI integrations, serving diverse industries.",
    image: "/images/EnterprisesLogos/ExperienceCards/WebCrafters.webp"
  }
];
---

<!-- Storytelling Scroll Container -->
<div class="storytelling-scroll-container">
  <div class="story-grid w-full max-w-[1400px] mx-auto px-15 grid lg:grid-cols-2 gap-12">
    
    <!-- Left Column: 3D Cube -->
    <div class="sticky-image-column sticky top-0 h-screen flex items-center rounded-2xl">
      <div class="w-full aspect-square relative overflow-hidden rounded-lg">
        <!-- Cube 3D Background -->
        <CubeBackground client:visible className="cube-3d-container" />
      </div>
    </div>
    
    <!-- Right Column: Scrolling Content -->
    <div class="scrolling-content-column">
      
      <!-- Content Section 1: Introduction -->
      <div class="content-section">
        <div class="relative z-10">
          <div class="relative">
            <!-- Purple circle positioned behind the heading -->
            <div class="w-[244px] h-[238px] bg-[#D9CCFF] rounded-full absolute -top-4 -left-8 -z-10"></div>
            <h2 class="text-hero font-median mb-2 relative z-10" style="font-size: clamp(48px, 8vw, 96px); line-height: 0.75;">
              <span class="text-[#080808]">karen ortiz,</span> <span class="text-[#7350cc]">Design<br />Engineer</span>
            </h2>
          </div>
          <h3 class="text-heading-lg text-[#080808] font-secondary font-bold" style="font-size: clamp(28px, 4vw, 44px); line-height: 1.23;">
            Based in Mexico City
          </h3>
          <p class="text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary mt-6" style="font-size: 20px; line-height: 1.5;">
            That is where I come in. A lover of words, a wrangler of copy. Here to create copy that not only reflects 
            who you are and what you stand for, but words that truly land with those that read them.
          </p>
        </div>
      </div>

      <!-- Content Section 2: Experience -->
      <div class="content-section">
        <div class="relative z-10">
          <h2 class="text-hero font-median mb-6" style="font-size: clamp(36px, 6vw, 72px); line-height: 0.9;">
            <span class="text-[#7350cc]">5+ Years</span><br />
            <span class="text-[#080808]">Creating Digital</span><br />
            <span class="text-[#080808]">Experiences</span>
          </h2>
          <p class="text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary mb-8" style="font-size: 20px; line-height: 1.5;">
            From UI/UX design to full-stack development, I've worked with companies across the globe, 
            creating seamless digital experiences that merge aesthetics with functionality.
          </p>
          <div class="flex items-start gap-9">
            <MainButton text="Get In Touch" />
          </div>
        </div>
      </div>

      <!-- Content Section 3: Stats -->
      <div class="content-section">
        <div class="relative z-10">
          <h2 class="text-hero font-median mb-8" style="font-size: clamp(36px, 6vw, 72px); line-height: 0.9;">
            <span class="text-[#080808]">Numbers That</span><br />
            <span class="text-[#7350cc]">Speak Volumes</span>
          </h2>
          
          <!-- Stats Grid -->
          <div class="grid grid-cols-3 gap-8 mb-8">
            <div class="text-center">
              <div class="text-display text-[#080808] font-secondary mb-2" style="font-size: 48px; line-height: 56px;">
                <Number value={8} delay={500} client:load />
              </div>
              <div class="text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary" style="font-size: 16px;">Award winner</div>
            </div>
            
            <div class="text-center">
              <div class="flex items-center justify-center text-display text-[#080808] font-secondary mb-2" style="font-size: 48px; line-height: 56px;">
                <Number value={1} delay={700} client:load />
                <span>.2k</span>
              </div>
              <div class="text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary" style="font-size: 16px;">Worldwide clients</div>
            </div>
            
            <div class="text-center">
              <div class="flex items-center justify-center text-display text-[#080808] font-secondary mb-2" style="font-size: 48px; line-height: 56px;">
                <Number value={3} delay={900} client:load />
                <span>.5k</span>
              </div>
              <div class="text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary" style="font-size: 16px;">Jobs completed</div>
            </div>
          </div>
          
          <p class="text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary" style="font-size: 18px; line-height: 1.5;">
            Every project is an opportunity to push boundaries and create something extraordinary.
          </p>
        </div>
      </div>

      <!-- Content Section 4: Philosophy -->
      <div class="content-section">
        <div class="relative z-10">
          <h2 class="text-hero font-median mb-6" style="font-size: clamp(36px, 6vw, 72px); line-height: 0.9;">
            <span class="text-[#080808]">Design Is Not Just</span><br />
            <span class="text-[#7350cc]">What It Looks Like</span><br />
            <span class="text-[#080808]">It's How It Works</span>
          </h2>
          <p class="text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary mb-6" style="font-size: 20px; line-height: 1.5;">
            I believe in creating digital experiences that are not only visually stunning but also 
            functionally exceptional. Every pixel serves a purpose, every interaction tells a story.
          </p>
          <p class="text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary" style="font-size: 18px; line-height: 1.5;">
            Ready to bring your vision to life? Let's create something extraordinary together.
          </p>
        </div>
      </div>

    </div>
  </div>
</div>

<!-- Globe Section - Above Experience Cards -->
<div class="globe-section">
  <div class="globe-title-wrapper">
    <motion.div 
      className="globe-title-container"
      initial={{ opacity: 0, y: 50 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true, margin: "-100px" }}
      transition={{ duration: 0.8, ease: "easeOut" }}
      client:load
    >
      <TextDisperseBlack text="GLOBAL IMPACT" className="globe-title-disperse" client:load />
    </motion.div>
  </div>
  <div class="globe-container">
    <GlobeBackground client:visible className="globe-3d-container" />
  </div>
</div>

<!-- Experience Cards Section - Marquee Infinito -->
<div class="experience-container cards-section">
  <ExperienceMarqueeIsland client:visible />
</div>

<style>
  /* Storytelling Scroll Container */
  .storytelling-scroll-container {
    background: #f9f9f9;
    position: relative;
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 3.75rem;
  }

  /* Left Column: Sticky Image */
  .sticky-image-column {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
  }

  /* Cube 3D Container */
  .cube-3d-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    overflow: hidden;
    background: linear-gradient(135deg, #f9f9f9 0%, #e8e8e8 100%);
    z-index: 1;
  }

  /* Right Column: Scrolling Content */
  .scrolling-content-column {
    display: flex;
    flex-direction: column;
  }

  .content-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    padding: 2rem 0;
  }

  /* Grid pattern overlay */
  .storytelling-scroll-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      linear-gradient(rgba(0, 0, 0, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.02) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
    z-index: 1;
  }

  .story-grid {
    position: relative;
    z-index: 2;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .story-grid {
      gap: 2rem;
      padding: 0 2rem;
    }
  }

  @media (max-width: 768px) {
    .story-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 0 1.5rem;
      text-align: center;
    }
    
    .sticky-image {
      order: -1;
      max-width: 300px;
      margin: 0 auto;
    }
    
    .story-content {
      order: 1;
    }
  }

  .me-section {
    position: relative;
    z-index: 2;
  }

  /* Contenedor principal del contenido */
  .main-content-container {
    width: 100%;
    max-width: 1400px;
    padding: 120px 60px;
    position: relative;
    z-index: 2;
  }

  /* Solo los elementos internos ocultos - mantenemos estructura de columnas */
  .profile-section,
  .description-section,
  .stats-section,
  .buttons-section,
  .image-section {
    opacity: 0;
    transform: translateY(60px);
  }

  .secondary-btn {
    background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 50%, #000000 100%);
    box-shadow: 0px 4px 200px rgba(255, 255, 255, 0.05);
  }

  .main-btn {
    background: 
      linear-gradient(47deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.30) 100%),
      url('/images/MainImage.webp');
    background-size: cover;
    background-position: center;
    box-shadow: 0px 4px 200px rgba(255, 255, 255, 0.05);
  }

  .btn-text {
    text-shadow: 0px 2px 4px rgba(0, 0, 0, 0.8);
  }


  .counter {
    transition: all 0.3s ease;
  }

  /* Split text styles */
  .split-char {
    display: inline-block;
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .split-char.animate {
    opacity: 1;
    transform: translateY(0);
  }

  .split-word {
    display: inline-block;
    overflow: hidden;
  }

  /* Animation styles */
  [data-animate] {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  [data-animate="fade-left"] {
    opacity: 0;
    transform: translateX(30px);
    transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  [data-animate="fade-right"] {
    opacity: 0;
    transform: translateX(-30px);
    transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  [data-animate].animate {
    opacity: 1;
    transform: translateY(0);
  }

  [data-animate="fade-left"].animate {
    opacity: 1;
    transform: translateX(0);
  }

  [data-animate="fade-right"].animate {
    opacity: 1;
    transform: translateX(0);
  }

  /* Globe Section Styles */
  .globe-section {
    width: 100%;
    background: #f9f9f9;
    padding: 0px 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    min-height: 50vh;
  }

  .globe-container {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    max-width: 780px; /* 600px * 1.3 = 780px */
    height: 780px; /* 600px * 1.3 = 780px */
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 10;
  }

  .globe-3d-container {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    background: linear-gradient(135deg, #f9f9f9 0%, #e8e8e8 100%);
  }

  /* Grid pattern overlay for globe section */
  .globe-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      linear-gradient(rgba(0, 0, 0, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 0, 0, 0.02) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
    z-index: 1;
  }

  /* Globe Title Styles - Behind Globe */
  .globe-title-wrapper {
    padding: 0px 60px 560px 60px;
    width: 100%;
    display: flex;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .globe-title-container {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
  }

  :global(.globe-title-disperse) {
    font-family: var(--font-display) !important;
    font-size: 10.5vw !important;
    font-weight: 400 !important;
    color: #060314 !important;
    line-height: 0.9 !important;
    letter-spacing: -0.02em !important;
    text-transform: uppercase !important;
    margin: 0 !important;
    text-align: center !important;
    white-space: nowrap !important;
  }

  :global(.globe-title-disperse span) {
    font-family: var(--font-display) !important;
    color: #060314 !important;
  }

  /* Experience Cards Styles - Marquee Infinito */
  .experience-container {
    width: 100%;
    position: relative;
    margin-top: 0;
    background: #f9f9f9;
    padding: 80px 0;
  }

  /* Experience Marquee Styles */
  :global(.experience-marquee-wrapper) {
    width: 100%;
    overflow: hidden;
    position: relative;
    mask: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    -webkit-mask: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  :global(.experience-marquee) {
    display: flex;
    animation: experienceMarqueeScroll 45s linear infinite;
    will-change: transform;
  }



  :global(.experience-set) {
    display: flex;
    gap: 2rem;
    flex-shrink: 0;
  }

  /* Experience Card Marquee */
  :global(.experience-card-marquee) {
    width: 390px;
    min-height: 268px;
    padding: 20px;
    background: white;
    border: 1px solid rgba(74, 36, 181, 0.15);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 12px;
    transition: all 0.3s ease;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
  }

  :global(.experience-header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  :global(.experience-number) {
    color: #1B1B1B;
    font-size: 1.05rem; /* 16.8px */
    font-family: var(--font-primary);
    font-weight: 500;
    line-height: 1.4rem; /* 22.4px */
    word-wrap: break-word;
  }

  :global(.experience-image) {
    width: 2.5rem; /* 40px */
    height: 2.5rem; /* 40px */
    border-radius: 0.5rem; /* 8px */
    object-fit: cover;
    background: white;
    padding: 0.25rem; /* 4px */
    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.1);
  }

  :global(.experience-content) {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    width: 100%;
  }

  :global(.experience-title) {
    width: 100%;
    color: black;
    font-size: 1.05rem; /* 16.8px */
    font-family: var(--font-primary);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.4rem; /* 22.4px */
    word-wrap: break-word;
  }

  :global(.experience-company) {
    width: 100%;
    color: #1B1B1B;
    font-size: 0.79rem; /* 12.6px */
    font-family: var(--font-primary);
    font-weight: 500;
    line-height: 1.14rem; /* 18.2px */
    word-wrap: break-word;
  }

  :global(.experience-description) {
    align-self: stretch;
    flex: 1;
  }

  :global(.description-normal) {
    color: #1B1B1B;
    font-size: 0.79rem; /* 12.6px */
    font-family: var(--font-primary);
    font-weight: 500;
    line-height: 1.14rem; /* 18.2px */
    word-wrap: break-word;
  }

  :global(.description-highlight) {
    color: #4A24B5;
    font-size: 0.79rem; /* 12.6px */
    font-family: var(--font-primary);
    font-weight: 500;
    line-height: 1.14rem; /* 18.2px */
    word-wrap: break-word;
  }

  /* Marquee Animation */
  @keyframes experienceMarqueeScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Reduce motion for accessibility */
  @media (prefers-reduced-motion: reduce) {
    :global(.experience-marquee) {
      animation: none;
    }
    
    :global(.experience-marquee-wrapper) {
      overflow-x: auto;
      scroll-behavior: smooth;
    }
    
    :global(.experience-marquee) {
      justify-content: flex-start;
      gap: 2rem;
    }
  }

  /* Responsive styles for globe section */
  @media (max-width: 1024px) {
    .globe-section {
      padding: 60px 40px;
      min-height: 80vh;
    }
    
    .globe-container {
      max-width: 650px; /* 500px * 1.3 = 650px */
      height: 650px; /* 500px * 1.3 = 650px */
    }
  }

  @media (max-width: 768px) {
    .globe-section {
      padding: 40px 20px;
      min-height: 70vh;
    }
    
    .globe-container {
      max-width: 520px; /* 400px * 1.3 = 520px */
      height: 520px; /* 400px * 1.3 = 520px */
    }

    .globe-title-wrapper {
      padding: 0px 30px 0px 30px;
    }

    .globe-title-container {
      justify-content: flex-start;
    }

    :global(.globe-title-disperse) {
      font-size: 7.35vw !important; /* 30% reducción para móvil */
    }
  }

  @media (max-width: 480px) {
    .globe-section {
      padding: 30px 15px;
      min-height: 60vh;
    }
    
    .globe-container {
      max-width: 390px; /* 300px * 1.3 = 390px */
      height: 390px; /* 300px * 1.3 = 390px */
    }
  }

  /* Responsive styles for experience marquee */
  @media (max-width: 768px) {
    .experience-container {
      padding: 60px 0;
    }

    :global(.experience-card-marquee) {
      width: 320px;
      min-height: 250px;
    }

    :global(.experience-set) {
      gap: 1.5rem;
    }

    :global(.experience-marquee) {
      animation-duration: 35s;
    }

 
    :global(.experience-number) {
      font-size: 0.875rem; /* 14px */
      line-height: 1.225rem; /* 19.6px */
    }

    :global(.experience-title) {
      font-size: 0.875rem; /* 14px */
      line-height: 1.225rem; /* 19.6px */
    }

    :global(.experience-company) {
      font-size: 0.7rem; /* 11.2px */
      line-height: 1.05rem; /* 16.8px */
    }

    :global(.description-normal),
    :global(.description-highlight) {
      font-size: 0.7rem; /* 11.2px */
      line-height: 1.05rem; /* 16.8px */
    }
  }

  @media (max-width: 480px) {
    .experience-container {
      padding: 40px 0;
    }

    :global(.experience-card-marquee) {
      width: 280px;
      min-height: 230px;
    }

    :global(.experience-set) {
      gap: 1rem;
    }

    :global(.experience-marquee) {
      animation-duration: 30s;
    }

  
    :global(.experience-number) {
      font-size: 0.79rem; /* 12.6px */
      line-height: 1.05rem; /* 16.8px */
    }

    :global(.experience-title) {
      font-size: 0.79rem; /* 12.6px */
      line-height: 1.05rem; /* 16.8px */
    }

    :global(.experience-company) {
      font-size: 0.61rem; /* 9.8px */
      line-height: 0.875rem; /* 14px */
    }

    :global(.description-normal),
    :global(.description-highlight) {
      font-size: 0.61rem; /* 9.8px */
      line-height: 0.875rem; /* 14px */
    }
  }
</style>

<script>
  // Simple scroll initialization - el efecto funciona con CSS puro
  document.addEventListener('DOMContentLoaded', () => {
    // Scroll initialized
  });
  
  // Re-initialize para transiciones de Astro
  document.addEventListener('astro:page-load', () => {
    // Scroll re-initialized
  });
</script>
