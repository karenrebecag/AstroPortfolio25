<script>
  // Simple scroll initialization - el efecto funciona con CSS puro
  document.addEventListener('DOMContentLoaded', () => {
    initializeGlobalTitleResize();
  });

  // Re-initialize para transiciones de Astro
  document.addEventListener('astro:page-load', () => {
    initializeGlobalTitleResize();
  });

  function initializeGlobalTitleResize() {
    const globeTitle = document.querySelector('.globe-title-disperse') as HTMLElement;
    const titleWrapper = document.querySelector('.globe-title-text-wrapper') as HTMLElement;

    if (!globeTitle || !titleWrapper) return;

    function adjustTitleSize() {
      if (!globeTitle || !titleWrapper) return;
      
      const wrapperWidth = titleWrapper.offsetWidth;
      const titleWidth = globeTitle.scrollWidth;

      if (titleWidth > wrapperWidth) {
        // Calcular el factor de escala necesario
        const scaleFactor = (wrapperWidth - 40) / titleWidth; // 40px de margen de seguridad
        const minScale = 0.6; // Escala mínima para mantener legibilidad
        const finalScale = Math.max(scaleFactor, minScale);

        // Aplicar transform scale en lugar de cambiar font-size
        globeTitle.style.transform = `scale(${finalScale})`;
        globeTitle.style.transformOrigin = 'center';
      } else {
        // Resetear si el texto cabe naturalmente
        globeTitle.style.transform = 'scale(1)';
      }
    }

    // Ejecutar al cargar
    setTimeout(adjustTitleSize, 100);

    // Ejecutar en resize
    let resizeTimeout: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(adjustTitleSize, 150);
    });
  }
</script>
