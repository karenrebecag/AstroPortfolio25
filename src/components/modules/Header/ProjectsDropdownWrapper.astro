---
// ProjectsDropdownWrapper.astro - Wrapper for Projects Dropdown
import ProjectsDropdownPortal from '../../ui/ProjectsDropdownPortal.tsx';
import { getProjects } from '../../../lib/cms';

const { lang = 'en' } = Astro.props;

// Fetch projects from Payload CMS
const cmsProjects = await getProjects(false, lang);

// Transform CMS projects to match the dropdown format
const projects = cmsProjects.map((project, index) => ({
  id: index + 1,
  title1: project.homepageTitle1 || project.title.split(' ')[0] || 'Project',
  title2: project.homepageTitle2 || project.title.split(' ').slice(1).join(' ') || '',
  description: project.homepageDescription || 'No description available',
  tags: project.homepageTags?.map(t => t.tag) || [],
  slug: project.slug
}));
---

<div class="projects-dropdown-wrapper">
  <ProjectsDropdownPortal 
    projects={projects}
    client:idle
  />
</div>

<style>
  .projects-dropdown-wrapper {
    display: flex;
    align-items: center;
    position: relative;
  }

  /* Hide on mobile - only show on desktop */
  @media (max-width: 1200px) {
    .projects-dropdown-wrapper {
      display: none;
    }
  }
</style>
