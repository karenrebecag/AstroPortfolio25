---
import { getLangFromUrl, languageOptions } from '../../../i18n/utils.js';
import LanguageSelectorPortal from '../../ui/LanguageSelectorPortal.tsx';
import styles from './LanguageSelectorWrapper.module.css';

const lang = getLangFromUrl(Astro.url);
---

<div class={styles['language-selector-wrapper']}>
  <LanguageSelectorPortal
    currentLang={lang}
    languages={languageOptions}
    client:idle
  />
</div>
