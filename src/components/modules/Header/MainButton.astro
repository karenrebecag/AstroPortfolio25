---
import styles from './MainButton.module.css';
// MainButton component - Realistic Design with Magnetic Effect
export interface Props {
  text?: string;
  href?: string;
}

const { text = "Read More", href } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<div class={styles['realism-button-wrapper']}>
  <Tag class={`${styles['realism-button']} group`} href={href}>
    <!-- Glow behind button -->
    <div class={styles['button-glow']}></div>

    <!-- Bottom-left green blob -->
    <div class={styles['button-blob']}></div>

    <!-- Inner content -->
    <div class={styles['button-content']}>
      <span class={styles['button-text']}>{text}</span>
      
      <!-- Inner glow layer -->
      <div class={styles['inner-glow']}></div>
    </div>
  </Tag>
</div>


<script>
  document.addEventListener('DOMContentLoaded', function() {
    const buttons = document.querySelectorAll('[class*="realism-button-wrapper"]');
    
    buttons.forEach(button => {
      // Magnetic effect
      button.addEventListener('mouseenter', function(e) {
        const mouseEvent = e as MouseEvent;
        const rect = button.getBoundingClientRect();
        const x = mouseEvent.clientX - rect.left;
        const y = mouseEvent.clientY - rect.top;
        
        (button as HTMLElement).style.transform = `translate(${x * 0.1}px, ${y * 0.1}px)`;
      });
      
      button.addEventListener('mouseleave', function() {
        (button as HTMLElement).style.transform = 'translate(0px, 0px)';
      });

      // Smooth scrolling for anchor links
      const link = button.querySelector('[class*="realism-button"]') as HTMLAnchorElement;
      if (link && link.href && link.href.includes('#')) {
        link.addEventListener('click', function(e) {
          const href = link.getAttribute('href');
          if (href && href.startsWith('#')) {
            e.preventDefault();
            
            const targetId = href.substring(1);
            const targetElement = document.getElementById(targetId);
            
            if (targetElement) {
              targetElement.scrollIntoView({
                behavior: 'smooth',
                block: 'start',
                inline: 'nearest'
              });
            }
          }
        });
      }
    });
  });
</script>
