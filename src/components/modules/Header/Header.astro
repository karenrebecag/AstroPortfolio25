---
// Simplified header component
import TopMarquee from './TopMarquee.astro';
import MainButton from './MainButton.astro';
import LanguageSelectorWrapper from './LanguageSelectorWrapper.astro';
import ProjectsDropdownWrapper from './ProjectsDropdownWrapper.astro';
import { BGPattern } from '../../ui/WhiteBackgroundTexture/bg-pattern.tsx';
import { getLangFromUrl, t, languageOptions, useTranslatedPath } from '../../../i18n/utils.js';
import { getProjects } from '../../../lib/cms';
import { getHeaderBackgroundFill } from '../../../config/backgroundPatterns';
import styles from './Header.module.css';

// Accept lang from props, fallback to URL detection
const { lang: propLang } = Astro.props;
const lang = propLang || getLangFromUrl(Astro.url);

// Check if there are projects available
const projects = await getProjects(false, lang);
const hasProjects = projects.length > 0;
---

<TopMarquee lang={lang} />

<div class={styles['header-wrapper']} id="headerWrapper">
  <div class={`${styles['bg-container']} ${styles['light-pattern']}`}>
    <BGPattern
      client:load
      variant="vertical-lines"
      mask="none"
      size={32}
      fill={getHeaderBackgroundFill.light()}
    />
  </div>
  <div class={`${styles['bg-container']} ${styles['dark-pattern']}`}>
    <BGPattern
      client:load
      variant="vertical-lines"
      mask="none"
      size={32}
      fill={getHeaderBackgroundFill.dark()}
    />
  </div>
  <header class={styles['header']} id="mainHeader">
    <a href="/" class={styles['logo']} id="logoBtn">KAREN ORTIZ</a>
    
    <nav class={styles['nav']}>
      <a href="#about">{t('nav.about', lang)}</a>
      <a href="#services">{t('nav.services', lang)}</a>
      {hasProjects ? (
        <button type="button" id="projectsNavLink" class={styles['nav-button']}>{t('nav.projects', lang)}</button>
      ) : (
        <a href="#projects" id="projectsNavLink">{t('nav.projects', lang)}</a>
      )}
      <a href="#reviews">{t('nav.reviews', lang)}</a>
    </nav>
    
    <div class={styles['header-actions-wrapper']}>
      <div class={styles['contact-btn-wrapper']}>
        <a href="#contact" class={styles['contact-link']}>
          <MainButton text={t('nav.contact', lang)} />
        </a>
      </div>
      <LanguageSelectorWrapper />
      {hasProjects && <ProjectsDropdownWrapper lang={lang} />}
    </div>
    
    <button class={styles['menu-btn']} id="menuBtn" aria-label="Open navigation menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </header>
</div>

<div class={styles['mobile-menu']} id="mobileMenu">
  <div class={styles['mobile-menu-content']}>
    <!-- Close Button -->
    <button class={styles['mobile-close-btn']} id="mobileCloseBtn" aria-label="Close navigation menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x">
        <path d="m18 6-12 12"/>
        <path d="m6 6 12 12"/>
      </svg>
    </button>
    
    <nav class={styles['mobile-nav']}>
      <a href="#about">{t('nav.about', lang)}</a>
      <a href="#services">{t('nav.services', lang)}</a>
      <a href="#projects">{t('nav.projects', lang)}</a>
      <a href="#reviews">{t('nav.reviews', lang)}</a>
      <a href="#contact" class={styles['mobile-contact-btn']}>{t('nav.contact', lang)}</a>

      <!-- Mobile Language Selector -->
      <div class={styles['mobile-language-section']}>
        <div class={styles['mobile-language-title']}>Language / Idioma</div>
        <div class={styles['mobile-language-list']}>
          {languageOptions.map((language) => (
            <a
              href={useTranslatedPath(language.code, Astro.url.pathname)}
              class={`${styles['mobile-language-option']} ${lang === language.code ? styles['active'] : ''}`}
            >
              <span class={styles['flag']}>{language.flag}</span>
              <span class={styles['name']}>{language.name}</span>
            </a>
          ))}
        </div>
      </div>
    </nav>
  </div>
</div>



<script>

  document.addEventListener('DOMContentLoaded', () => {
    // Header elements
    const headerWrapper = document.querySelector('[id="headerWrapper"]');
    const mainHeader = document.querySelector('[id="mainHeader"]');
    const logoElement = document.querySelector('[id="logoBtn"]');
    const navLinks = document.querySelectorAll('[id="mainHeader"] nav a');
    const navButtons = document.querySelectorAll('[id="mainHeader"] .nav-button');
    const menuBtnSpans = document.querySelectorAll('[id="menuBtn"] span');
    const lightPattern = headerWrapper?.querySelector('[class*="light-pattern"]');
    const darkPattern = headerWrapper?.querySelector('[class*="dark-pattern"]');
    
    // Dark mode styles function
    const applyDarkMode = (isDark: boolean) => {
      // Pattern switching
      if (lightPattern && darkPattern) {
        if (isDark) {
          (lightPattern as HTMLElement).style.opacity = '0';
          (darkPattern as HTMLElement).style.opacity = '1';
        } else {
          (lightPattern as HTMLElement).style.opacity = '1';
          (darkPattern as HTMLElement).style.opacity = '0';
        }
      }

      // Header wrapper background
      if (headerWrapper) {
        if (isDark) {
          (headerWrapper as HTMLElement).style.background = 'rgba(5, 11, 21, 0.85)';
          (headerWrapper as HTMLElement).style.backdropFilter = 'blur(20px)';
          (headerWrapper as HTMLElement).style.WebkitBackdropFilter = 'blur(20px)';
          (headerWrapper as HTMLElement).style.borderBottom = '1px solid rgba(157, 127, 193, 0.2)';
          (headerWrapper as HTMLElement).style.boxShadow = '0 8px 32px rgba(69, 35, 174, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.05)';
        } else {
          (headerWrapper as HTMLElement).style.background = 'rgba(255, 255, 255, 0.95)';
          (headerWrapper as HTMLElement).style.backdropFilter = 'blur(15px)';
          (headerWrapper as HTMLElement).style.WebkitBackdropFilter = 'blur(15px)';
          (headerWrapper as HTMLElement).style.borderBottom = '1px solid rgba(204, 204, 204, 0.2)';
          (headerWrapper as HTMLElement).style.boxShadow = '';
        }
      }

      // Logo
      if (logoElement) {
        if (isDark) {
          (logoElement as HTMLElement).style.color = '#ffffff';
          (logoElement as HTMLElement).style.textShadow = '0 0 20px rgba(157, 127, 193, 0.3)';
        } else {
          (logoElement as HTMLElement).style.color = '#060314';
          (logoElement as HTMLElement).style.textShadow = '';
        }
      }

      // Navigation links
      navLinks.forEach(link => {
        if (isDark) {
          (link as HTMLElement).style.color = '#ffffff';
          (link as HTMLElement).style.textShadow = '0 0 10px rgba(255, 255, 255, 0.1)';
        } else {
          (link as HTMLElement).style.color = '#131019';
          (link as HTMLElement).style.textShadow = '';
        }
      });

      // Navigation buttons
      navButtons.forEach(button => {
        if (isDark) {
          (button as HTMLElement).style.color = '#ffffff';
          (button as HTMLElement).style.textShadow = '0 0 10px rgba(255, 255, 255, 0.1)';
        } else {
          (button as HTMLElement).style.color = '#131019';
          (button as HTMLElement).style.textShadow = '';
        }
      });

      // Menu button spans
      menuBtnSpans.forEach(span => {
        if (isDark) {
          (span as HTMLElement).style.background = '#ffffff';
        } else {
          (span as HTMLElement).style.background = '#060314';
        }
      });
    };

    // Check initial dark mode state
    const checkInitialDarkMode = () => {
      // Check both localStorage and DOM class for consistency
      const savedTheme = localStorage.getItem('portfolio-theme');
      const isDarkFromStorage = savedTheme === 'dark';
      const isDarkFromDOM = document.documentElement.classList.contains('dark-mode');
      
      // Use storage value if available, otherwise use DOM class
      const isDark = isDarkFromStorage || isDarkFromDOM;
      applyDarkMode(isDark);

      // Ensure DOM class matches storage
      if (isDarkFromStorage && !isDarkFromDOM) {
        document.documentElement.classList.add('dark-mode');
        document.documentElement.classList.remove('light-mode');
      } else if (!isDarkFromStorage && isDarkFromDOM) {
        document.documentElement.classList.add('light-mode');
        document.documentElement.classList.remove('dark-mode');
      }
    };

    // Listen for dark mode changes from HeaderDarkModeToggle
    window.addEventListener('darkModeChange', (event: Event) => {
      const customEvent = event as CustomEvent;
      applyDarkMode(customEvent.detail.isDark);
    });

    // Check initial state after a short delay to ensure toggle has loaded
    setTimeout(checkInitialDarkMode, 100);

    // Header scroll behavior
    let lastScrollY = window.scrollY;
    let ticking = false;

    const handleScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const currentScrollY = window.scrollY;
          const scrollDifference = currentScrollY - lastScrollY;
          
          if (!headerWrapper) return;

          // Add scrolled class when scrolled down with smooth transition
          if (currentScrollY > 80) {
            headerWrapper.classList.add('scrolled');
          } else {
            headerWrapper.classList.remove('scrolled');
          }

          // Always show header at the very top
          if (currentScrollY < 10) {
            if (headerWrapper.classList.contains('hidden')) {
              headerWrapper.classList.remove('hidden');
              (headerWrapper as HTMLElement).style.display = '';
              (headerWrapper as HTMLElement).style.transition = 'transform 0.3s ease-out, opacity 0.3s ease-out';
              (headerWrapper as HTMLElement).style.transform = 'translateY(0)';
              (headerWrapper as HTMLElement).style.opacity = '1';
            }
          }
          // Hide/show logic for scrolling
          else if (scrollDifference > 8 && currentScrollY > 100) {
            // Scrolling down - hide header
            if (!headerWrapper.classList.contains('hidden')) {
              headerWrapper.classList.add('hidden');
              (headerWrapper as HTMLElement).style.transition = 'transform 0.3s ease-in, opacity 0.3s ease-in';
              (headerWrapper as HTMLElement).style.transform = 'translateY(-100%)';
              (headerWrapper as HTMLElement).style.opacity = '0';
            }
          } else if (scrollDifference < -5) {
            // Scrolling up - show header
            if (headerWrapper.classList.contains('hidden')) {
              headerWrapper.classList.remove('hidden');
              (headerWrapper as HTMLElement).style.display = '';
              (headerWrapper as HTMLElement).style.transition = 'transform 0.3s ease-out, opacity 0.3s ease-out';
              (headerWrapper as HTMLElement).style.transform = 'translateY(0)';
              (headerWrapper as HTMLElement).style.opacity = '1';
            }
          }

          lastScrollY = currentScrollY;
          ticking = false;
        });
        ticking = true;
      }
    };

    // Throttled scroll listener
    window.addEventListener('scroll', handleScroll, { passive: true });

    // Mobile menu functionality
    const allMenuBtns = document.querySelectorAll('[id="menuBtn"]');
    const mobileMenu = document.querySelector('[id="mobileMenu"]');
    const mobileNav = document.querySelector('[id="mobileMenu"] nav');
    const mobileNavLinks = document.querySelectorAll('[id="mobileMenu"] nav a');
    const contactBtn = mobileNav?.querySelector('a[href="#contact"]');

    let isOpen = false;

    const openMenu = () => {
      isOpen = true;
      mobileMenu?.classList.add('open');

      // Block body scrolling
      document.body.style.overflow = 'hidden';
      document.body.style.position = 'fixed';
      document.body.style.width = '100%';

      
      // Reset initial states
      if (mobileNav) (mobileNav as HTMLElement).style.transform = 'translateY(30px)';
      mobileNavLinks.forEach(link => {
        const linkEl = link as HTMLElement;
        linkEl.style.opacity = '0';
        linkEl.style.transform = 'translateY(20px)';
      });
      if (contactBtn) {
        (contactBtn as HTMLElement).style.opacity = '0';
        (contactBtn as HTMLElement).style.transform = 'translateY(20px)';
      }

      // Animate with CSS transitions - elements will animate due to CSS transitions
      setTimeout(() => {
        if (mobileNav) (mobileNav as HTMLElement).style.transform = 'translateY(0px)';
        mobileNavLinks.forEach((link, index) => {
          const linkEl = link as HTMLElement;
          setTimeout(() => {
            linkEl.style.opacity = '1';
            linkEl.style.transform = 'translateY(0px)';
          }, 100 + (index * 100));
        });
        if (contactBtn) {
          setTimeout(() => {
            (contactBtn as HTMLElement).style.opacity = '1';
            (contactBtn as HTMLElement).style.transform = 'translateY(0px)';
          }, 500);
        }
      }, 100);
    };

    const closeMenu = () => {
      isOpen = false;

      // Reverse animations with CSS transitions
      mobileNavLinks.forEach((link, index) => {
        const linkEl = link as HTMLElement;
        setTimeout(() => {
          linkEl.style.opacity = '0';
          linkEl.style.transform = 'translateY(-20px)';
        }, index * 50);
      });

      if (contactBtn) {
        setTimeout(() => {
          (contactBtn as HTMLElement).style.opacity = '0';
          (contactBtn as HTMLElement).style.transform = 'translateY(-20px)';
        }, 100);
      }

      if (mobileNav) {
        setTimeout(() => {
          (mobileNav as HTMLElement).style.transform = 'translateY(30px)';
        }, 200);
      }

      // Remove class after animation
      setTimeout(() => {
        mobileMenu?.classList.remove('open');

        // Restore body scrolling
        document.body.style.overflow = '';
        document.body.style.position = '';
        document.body.style.width = '';
      }, 500);
    };

    // Add event listeners to ALL menu buttons
    allMenuBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (isOpen) {
          closeMenu();
        } else {
          openMenu();
        }
      });
    });
    
    // Close button functionality
    const mobileCloseBtn = document.querySelector('[id="mobileCloseBtn"]');
    mobileCloseBtn?.addEventListener('click', () => {
      if (isOpen) {
        closeMenu();
      }
    });
    
    // Close menu when clicking on links or contact button
    // REMOVED: This was interfering with smooth scroll functionality
    // The closeMenu() is now handled in the individual link click handlers below

    // Close menu when clicking outside content
    mobileMenu?.addEventListener('click', (e) => {
      if (e.target === mobileMenu) {
        closeMenu();
      }
    });

    // Close menu on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeMenu();
      }
    });

    // Smooth scroll functionality
    const smoothScrollTo = (targetId: string) => {
      let target = document.getElementById(targetId);
      
      // If target not found, wait a bit for components to load and try again
      if (!target) {
        setTimeout(() => {
          target = document.getElementById(targetId);
          if (target) {
            const headerHeight = (headerWrapper as HTMLElement)?.offsetHeight || 0;
            const targetPosition = (target as HTMLElement).offsetTop - headerHeight - 20; // 20px extra offset
            
            window.scrollTo({
              top: targetPosition,
              behavior: 'smooth'
            });
          }
        }, 100);
        return;
      }
      
      const headerHeight = (headerWrapper as HTMLElement)?.offsetHeight || 0;
      const targetPosition = (target as HTMLElement).offsetTop - headerHeight - 20; // 20px extra offset
      
      window.scrollTo({
        top: targetPosition,
        behavior: 'smooth'
      });
    };

    // Logo scroll to top
    const logoBtn = document.querySelector('[id="logoBtn"]');
    logoBtn?.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });

    // Desktop navigation links
    const desktopNavLinks = document.querySelectorAll('[id="mainHeader"] nav a');
    desktopNavLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        const href = link.getAttribute('href');
        if (href && href.startsWith('#')) {
          const targetId = href.substring(1);
          smoothScrollTo(targetId);
        }
      });
    });

    // Mobile navigation links - scroll functionality
    const mobileScrollLinks = document.querySelectorAll('[id="mobileMenu"] nav a:not([href^="/"])');
    mobileScrollLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        
        // Only handle anchor links (section navigation)
        if (href && href.startsWith('#')) {
          e.preventDefault();
          e.stopPropagation();
          
          const targetId = href.substring(1);
          
          // Close menu first
          closeMenu();
          
          // Wait for menu close animation and body scroll restoration
          setTimeout(() => {
            // Ensure body scroll is restored
            document.body.style.overflow = '';
            document.body.style.position = '';
            document.body.style.width = '';
            
            // Find the target element (check after menu closes in case it's dynamically loaded)
            let target = document.getElementById(targetId);
            
            // If target not found, try to find it by waiting a bit more
            if (!target) {
              console.warn(`Target element #${targetId} not found, retrying...`);
              setTimeout(() => {
                target = document.getElementById(targetId);
                if (target) {
                  const headerHeight = (headerWrapper as HTMLElement)?.offsetHeight || 0;
                  const targetPosition = target.offsetTop - headerHeight - 20;
                  
                  window.scrollTo({
                    top: targetPosition,
                    behavior: 'smooth'
                  });
                } else {
                  console.error(`Target element #${targetId} still not found after retry`);
                }
              }, 200);
              return;
            }
            
            // Scroll to target
            const headerHeight = (headerWrapper as HTMLElement)?.offsetHeight || 0;
            const targetPosition = target.offsetTop - headerHeight - 20;
            
            window.scrollTo({
              top: targetPosition,
              behavior: 'smooth'
            });
          }, 550); // Wait for full menu close animation (500ms) + 50ms buffer
        }
        // Language links and external links will work normally
      });
    });

    // Contact button link
    const contactLink = document.querySelector('[href="#contact"]');
    contactLink?.addEventListener('click', (e) => {
      e.preventDefault();
      smoothScrollTo('contact');
    });

    // Projects dropdown functionality
    const projectsNavLink = document.querySelector('#projectsNavLink');
    let projectsDropdownTrigger: HTMLButtonElement | null = null;
    let isProjectsDropdownOpen = false;
    
    // Wait for the ProjectsDropdownPortal to load and find its trigger
    const findProjectsDropdownTrigger = () => {
      projectsDropdownTrigger = document.querySelector('[data-projects-dropdown-trigger]');
      return projectsDropdownTrigger !== null;
    };
    
    // Monitor dropdown state changes
    const monitorDropdownState = () => {
      const dropdownPortal = document.querySelector('#projects-dropdown-portal');
      if (dropdownPortal) {
        const observer = new MutationObserver(() => {
          const dropdown = dropdownPortal.querySelector('div[style*="opacity"]') as HTMLElement;
          const isOpen = dropdown && dropdown.style.opacity !== '0' && dropdown.style.opacity !== '';
          
          if (isOpen !== isProjectsDropdownOpen) {
            isProjectsDropdownOpen = !!isOpen;
            if (projectsNavLink) {
              if (isOpen) {
                projectsNavLink.classList.add('dropdown-open');
              } else {
                projectsNavLink.classList.remove('dropdown-open');
              }
            }
          }
        });
        
        observer.observe(dropdownPortal, {
          childList: true,
          subtree: true,
          attributes: true,
          attributeFilter: ['style']
        });
      }
    };
    
    // Try to find the trigger immediately, then retry if not found
    if (!findProjectsDropdownTrigger()) {
      // Retry after a short delay to allow React component to mount
      setTimeout(() => {
        if (findProjectsDropdownTrigger()) {
          monitorDropdownState();
        }
      }, 100);
    } else {
      monitorDropdownState();
    }
    
    projectsNavLink?.addEventListener('click', (e) => {
      e.preventDefault();
      
      // Try to find the trigger if we haven't found it yet
      if (!projectsDropdownTrigger) {
        findProjectsDropdownTrigger();
      }
      
      if (projectsDropdownTrigger) {
        // Trigger the dropdown
        projectsDropdownTrigger.click();
      }
      // Removed fallback scroll - now it's only a dropdown trigger
    });
  });
</script>
