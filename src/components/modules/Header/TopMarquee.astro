---
// TopMarquee - CSS Marquee pattern for header
// Features: IntersectionObserver pause, dynamic speed calculation
import styles from './TopMarquee.module.css';
import { getLangFromUrl } from '../../../i18n/utils.js';
import { translations } from '../../../i18n/translations.js';
import { getTopMarqueeServices } from '../../../lib/cms';

const lang = getLangFromUrl(Astro.url);
const t = translations[lang as keyof typeof translations] || translations.en;

const servicesFromCMS = await getTopMarqueeServices(lang);

const marqueeItems = servicesFromCMS.length > 0
  ? servicesFromCMS.map(service => service.text)
  : t.topMarquee.text.split(' • ').filter(Boolean);
---

<div data-css-marquee class={styles.marquee}>
  <div data-css-marquee-list class={styles.marqueeList}>
    {marqueeItems.map((item) => (
      <div class={styles.marqueeItem}>
        <span class={styles.marqueeText}>{item}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 50 50"
          fill="none"
          class={styles.marqueeStar}
          aria-hidden="true"
        >
          <path
            d="M17.6777 32.3223C12.9893 27.6339 6.63041 25 0 25C6.63041 25 12.9893 22.3661 17.6777 17.6777C22.3661 12.9893 25 6.63041 25 0C25 6.63041 27.6339 12.9893 32.3223 17.6777C37.0107 22.3661 43.3696 25 50 25C43.3696 25 37.0107 27.6339 32.3223 32.3223C27.6339 37.0107 25 43.3696 25 50C25 43.3696 22.3661 37.0107 17.6777 32.3223Z"
            fill="currentColor"
          />
        </svg>
      </div>
    ))}
  </div>
</div>

<script>
  function initTopMarquee() {
    const PIXELS_PER_SECOND = 50;
    const marquees = document.querySelectorAll<HTMLElement>('[data-css-marquee]');

    // Duplicate list for seamless loop
    marquees.forEach(marquee => {
      const list = marquee.querySelector('[data-css-marquee-list]');
      if (list && !marquee.querySelector('[data-css-marquee-list]:nth-child(2)')) {
        const duplicate = list.cloneNode(true) as HTMLElement;
        marquee.appendChild(duplicate);
      }
    });

    // IntersectionObserver for performance (pause when out of view)
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          const lists = entry.target.querySelectorAll<HTMLElement>('[data-css-marquee-list]');
          lists.forEach(list => {
            list.style.animationPlayState = entry.isIntersecting ? 'running' : 'paused';
          });
        });
      },
      { threshold: 0 }
    );

    // Calculate duration and observe
    marquees.forEach(marquee => {
      const lists = marquee.querySelectorAll<HTMLElement>('[data-css-marquee-list]');
      lists.forEach(list => {
        const duration = list.offsetWidth / PIXELS_PER_SECOND;
        list.style.animationDuration = `${duration}s`;
        list.style.animationPlayState = 'paused';
      });
      observer.observe(marquee);
    });
  }

  document.addEventListener('DOMContentLoaded', initTopMarquee);
</script>


