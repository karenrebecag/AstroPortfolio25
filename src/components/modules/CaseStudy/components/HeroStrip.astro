---
import type { Author } from '../types/caseStudy'

interface Props {
  title: string
  mainTag: string
  publishedDate: string
  author: Author
  featuredImage?: string
}

const { title, mainTag, publishedDate, author, featuredImage } = Astro.props
---

<section class="hero-strip">
  <div class="container">
    <!-- Tag + Date + Author Info wrapper -->
    <div style="display: flex; flex-direction: column; justify-content: flex-start; align-items: center; gap: 16px;">
      <!-- Tag and Date Row -->
      <div style="display: flex; justify-content: center; align-items: center; gap: 16px;">
        <span class="tag-badge">
          {mainTag}
        </span>
        <p class="published-date">
          {publishedDate}
        </p>
        <div style="color: #E9E9E9; font-size: 14px; line-height: 16px;">/</div>
      </div>

      <!-- Title -->
      <h1>
        {title}
      </h1>

      <!-- Author Info -->
      <div class="meta-info">
        <img
          src={author.avatar}
          alt={author.name}
          class="author-avatar"
        />
        <div style="display: flex; justify-content: flex-start; align-items: center; gap: 8px;">
          <span class="author-info-text">Post by</span>
          <span class="author-name">{author.name}</span>
        </div>
      </div>
    </div>
  </div>
</section>
