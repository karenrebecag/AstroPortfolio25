---
import type { ProcessStep } from '../types/caseStudy'

interface Props {
  title?: string
  subtitle?: string
  steps: ProcessStep[]
}

const { title = "Process Workflow", subtitle, steps = [] } = Astro.props
---

<section class="process-strip">
  <div class="container">
    <!-- Section Header -->
    <div class="section-header">
      <h2>
        {title}
      </h2>
      {subtitle && (
        <p class="subtitle">
          {subtitle}
        </p>
      )}
    </div>

    <!-- Process Steps Grid -->
    <div class="steps-grid">
      {steps.map((step) => (
        <div class="process-card">
          <!-- Step Number Badge -->
          <div class="step-number">
            {step.number}
          </div>

          <!-- Step Content -->
          <h3 class="step-title">
            {step.title}
          </h3>

          <p class="step-description">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
