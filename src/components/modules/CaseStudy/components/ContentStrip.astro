---
import type { ContentBlock, ImageContent, QuoteContent, ImageGridContent } from '../types/caseStudy'

interface Props {
  description: string
  content: ContentBlock[]
}

const { description, content } = Astro.props

// Helper to check content type
const isImageContent = (content: any): content is ImageContent => {
  return content && typeof content === 'object' && 'src' in content && 'alt' in content
}

const isQuoteContent = (content: any): content is QuoteContent => {
  return content && typeof content === 'object' && 'quote' in content
}

const isImageGridContent = (content: any): content is ImageGridContent => {
  return content && typeof content === 'object' && 'images' in content
}
---

<section class="content-strip">
  <div class="container">
    <!-- Description -->
    <div class="description">
      <p>
        {description}
      </p>
    </div>

    <!-- Content Blocks -->
    <div style="margin-bottom: 2rem;">
      {content.map((block) => {
        // Heading Block
        if (block.type === 'heading' && typeof block.content === 'string') {
          return (
            <h2>
              {block.content}
            </h2>
          )
        }

        // Text Block
        if (block.type === 'text' && typeof block.content === 'string') {
          return (
            <p>
              {block.content}
            </p>
          )
        }

        // Image Block
        if (block.type === 'image' && isImageContent(block.content)) {
          return (
            <figure>
              <img
                src={block.content.src}
                alt={block.content.alt}
              />
              {block.content.caption && (
                <figcaption>
                  {block.content.caption}
                </figcaption>
              )}
            </figure>
          )
        }

        // Quote Block
        if (block.type === 'quote' && isQuoteContent(block.content)) {
          return (
            <blockquote>
              <p>
                "{block.content.quote}"
              </p>
              <cite>
                — {block.content.author}
                {block.content.role && `, ${block.content.role}`}
              </cite>
            </blockquote>
          )
        }

        // Image Grid Block
        if (block.type === 'imageGrid' && isImageGridContent(block.content)) {
          return (
            <div class="image-grid">
              {block.content.images.map((img) => (
                <figure>
                  <img
                    src={img.src}
                    alt={img.alt}
                  />
                  {img.caption && (
                    <figcaption>
                      {img.caption}
                    </figcaption>
                  )}
                </figure>
              ))}
            </div>
          )
        }

        return null
      })}
    </div>
  </div>
</section>
