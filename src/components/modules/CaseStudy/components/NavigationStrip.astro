---
import type { RelatedPost } from '../types/caseStudy'

interface Props {
  previousPost?: RelatedPost
  nextPost?: RelatedPost
}

const { previousPost, nextPost } = Astro.props
---

<section class="navigation-strip">
  <div class="container">
    <div class="nav-grid">
      <!-- Previous Post -->
      {previousPost && (
        <a
          href={`/case-studies/${previousPost.slug}`}
          class="nav-card"
        >
          <div class="flex items-center gap-4">
            <svg style="width: 1.5rem; height: 1.5rem; color: #c084fc;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            <div class="flex-1">
              <p class="nav-label">Previous</p>
              <h3 class="nav-title">
                {previousPost.title}
              </h3>
              {previousPost.description && (
                <p class="nav-description">
                  {previousPost.description}
                </p>
              )}
              {previousPost.tag && (
                <span class="nav-tag">
                  {previousPost.tag}
                </span>
              )}
            </div>
          </div>
        </a>
      )}

      <!-- Next Post -->
      {nextPost && (
        <a
          href={`/case-studies/${nextPost.slug}`}
          class="nav-card"
        >
          <div class="flex items-center gap-4">
            <div class="flex-1">
              <p class="nav-label">Next</p>
              <h3 class="nav-title">
                {nextPost.title}
              </h3>
              {nextPost.description && (
                <p class="nav-description">
                  {nextPost.description}
                </p>
              )}
              {nextPost.tag && (
                <span class="nav-tag">
                  {nextPost.tag}
                </span>
              )}
            </div>
            <svg style="width: 1.5rem; height: 1.5rem; color: #c084fc;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </div>
        </a>
      )}
    </div>

    <!-- Back to All Projects Link -->
    <div class="back-link">
      <a href="/case-studies">
        <svg style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        View All Projects
      </a>
    </div>
  </div>
</section>
