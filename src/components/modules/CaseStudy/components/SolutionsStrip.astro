---
import type { Solution, Achievement, FinalThoughts } from '../types/caseStudy'

interface Props {
  title?: string
  solutions: Solution[]
  achievements?: Achievement[]
  finalThoughts?: FinalThoughts
  tags?: string[]
}

const {
  title = "Solutions & Results",
  solutions = [],
  achievements = [],
  finalThoughts,
  tags = []
} = Astro.props
---

<section class="solutions-strip">
  <div class="container">
    <!-- Section Title -->
    <h2>
      {title}
    </h2>

    <!-- Solutions Accordion/Dropdowns -->
    {solutions.length > 0 && (
      <div class="solutions-accordion">
        {solutions.map((solution, index) => (
          <details class="solution-item" open={index === 0}>
            <summary>
              <div class="flex items-center justify-between">
                <h3>
                  {solution.title}
                </h3>
                <svg class="arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 1.5rem; height: 1.5rem;">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </div>
            </summary>
            <div class="solution-content">
              <p>
                {solution.description}
              </p>
            </div>
          </details>
        ))}
      </div>
    )}

    <!-- Achievements -->
    {achievements.length > 0 && (
      <div class="achievements-grid">
        <div style="display: flex; flex-direction: column;">
          <div style="padding: 25px 50px; border-bottom: 1px rgba(192.50, 192.50, 192.50, 0.23) solid; text-align: center;">
            <div style="color: #DADADA; font-size: 64px; font-family: 'Inter Tight', sans-serif; font-weight: 700; text-transform: uppercase; line-height: 70px;">
              LOGROS
            </div>
          </div>
          {achievements.map((achievement) => (
            <div style="display: flex; padding: 0 50px; border-bottom: 1px rgba(192.50, 192.50, 192.50, 0.23) solid; gap: 30px;">
              <div class="achievement-number">
                {achievement.number}
              </div>
              <div class="achievement-description">
                {achievement.description}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Final Thoughts -->
    {finalThoughts && (
      <div class="final-thoughts">
        <h3>
          {finalThoughts.title}
        </h3>
        <div style="margin-top: 1rem;">
          {finalThoughts.paragraphs.map((paragraph) => (
            <p>
              {paragraph}
            </p>
          ))}
        </div>
      </div>
    )}

    <!-- Tags -->
    {tags.length > 0 && (
      <div class="tags-container">
        {tags.map((tag) => (
          <span class="tag">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>
</section>
