---
import styles from './ProcessWorkflowWrapper.module.css';
import { ProcessWorkflow } from './ProcessWorkflow.tsx';
import type { WorkflowStep } from './ProcessWorkflow.tsx';
import AnimatedComponent from '@/components/ui/AnimatedComponent.tsx';

export interface Props {
    title: string;
    subtitle: string;
    steps: WorkflowStep[];
}

const { title, subtitle, steps } = Astro.props;
---
<AnimatedComponent client:visible>
    <div class={styles.wrapper}>
        <div class={styles.titleSection}>
            <h2 class={styles.title}>{title}</h2>
            <p class={styles.subtitle}>{subtitle}</p>
        </div>
        <ProcessWorkflow steps={steps} client:visible />
    </div>
</AnimatedComponent>
