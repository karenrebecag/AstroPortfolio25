---
import ProcessWorkflowStatic from './ProcessWorkflowStatic.astro';

export interface WorkflowStep {
    step: number;
    description: string;
}

export interface Props {
    title: string;
    subtitle: string;
    steps: WorkflowStep[];
}

const { title, subtitle, steps } = Astro.props;
---
<ProcessWorkflowStatic title={title} subtitle={subtitle} steps={steps} />
