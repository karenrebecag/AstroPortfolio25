---
import styles from './FinalThoughts.module.css';
import PostNavigation from './PostNavigation.astro';
import type { Props as PostNavProps } from './PostNavigation.astro';
import AnimatedComponent from '@/components/ui/AnimatedComponent.tsx';

export interface Props {
  title?: string;
  tags?: string[];
  nav?: PostNavProps;
}

const {
    title = "Final Thoughts.",
    tags = [],
    nav
} = Astro.props;
---
<AnimatedComponent client:visible>
    <section class={styles.section}>
        <h2 class={styles.title}>{title}</h2>

        {tags && tags.length > 0 && (
            <div class={styles.tagsContainer}>
                <span class={styles.tagLabel}>Tags:</span>
                {tags.map(tag => (
                    <span class={styles.badge}>{tag}</span>
                ))}
            </div>
        )}

        {nav && <PostNavigation {...nav} />}
    </section>
</AnimatedComponent>
