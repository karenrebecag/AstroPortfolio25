---
import styles from './FinalAchievements.module.css';

export interface AchievementItem {
  description: string;
}

export interface Props {
  title: string;
  achievements: AchievementItem[];
}

const { title, achievements } = Astro.props;
---

<section class={styles.section}>
    <div class={styles.container}>
        <div class={styles.titleWrapper}>
            <h2 class={styles.title}>{title}</h2>
        </div>
        <div class={styles.itemsWrapper}>
            {achievements.map((item, index) => (
                <div class={styles.item}>
                    <div class={styles.numberWrapper}>
                        <span class={styles.number}>{index + 1}</span>
                    </div>
                    <div class={styles.descriptionWrapper}>
                        <p class={styles.description}>{item.description}</p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
