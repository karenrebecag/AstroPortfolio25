---
// SpaceInvaders.astro - Astro wrapper for the Space Invaders Easter Egg
import { SpaceInvadersIsland } from './SpaceInvadersIsland';

export interface Props {
  onExit: () => void;
}

const { onExit } = Astro.props;
---

<div class="space-invaders-wrapper">
  <SpaceInvadersIsland onExit={onExit} client:visible />
</div>

<style>
  .space-invaders-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
