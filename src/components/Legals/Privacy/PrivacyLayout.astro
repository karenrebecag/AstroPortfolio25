---
export interface Props {
	title: string;
	lang: string;
	privacyData: any;
}

const { title, lang, privacyData } = Astro.props;

import Layout from '../../../layouts/Layout.astro';
import HeaderPill from '../../modules/Header/HeaderPill.astro';
import { DarkModeContainer } from '../../ui/DarkModeContainer.tsx';
import ShareBar from '../../modules/ShareBar/ShareBar.astro';
import PrivacySection from './PrivacySection.astro';
import WhiteBackground from '../../ui/WhiteBackgroundTexture/WhiteBackground.astro';
import '../../../styles/global.css';
---

<Layout title={title} lang={lang}>
	<HeaderPill />

	<DarkModeContainer client:load>
		<WhiteBackground>
			<!-- Main Content Sections -->
			<main class="main-content" id="main-content">
				<PrivacySection privacyData={privacyData} />
				<!-- Share Bar Section -->
				<ShareBar />
			</main>
		</WhiteBackground>
	</DarkModeContainer>
</Layout>

<style>
	/* Main Content Layout */
	.main-content {
		width: 100%;
		padding: 0;
		transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	/* Dark Mode Styles */
	:global(.dark-mode) {
		color-scheme: dark;
	}

	/* Main Content Dark Mode */
	:global(.dark-mode .main-content) {
		color: #f0f4ff;
	}

	/* Smooth transitions for theme switching */
	:global(.main-content),
	:global(body),
	:global(html) {
		transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}
</style>
