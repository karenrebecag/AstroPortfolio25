---
export interface Props {
	privacyData: any;
}

const { privacyData } = Astro.props;

import { TextDisperseBlack } from '../../ui/TextDisperseBlack';
import { InView } from '../../ui/InView';
import PrivacyHighlights from './PrivacyHighlights.astro';
import PrivacyDetails from './PrivacyDetails.astro';
---

<section class="content-section privacy-section" id="privacy-policy">
	<div class="section-container">
		<div class="section-header">
			<h2 class="section-title" id="privacy-message">
				<TextDisperseBlack client:idle text={privacyData.title} />
			</h2>
			<div class="section-label">{privacyData.subtitle}</div>
		</div>

		<InView client:idle
			variants={{
				hidden: { opacity: 0, y: 30, filter: "blur(2px)" },
				visible: { opacity: 1, y: 0, filter: "blur(0px)" },
			}}
			viewOptions={{ margin: "0px 0px -100px 0px" }}
			transition={{ duration: 0.6, ease: [0.25, 0.46, 0.45, 0.94] }}
		>
			<div class="content-grid">
				<div class="content-main">
					<p class="content-description">
						{privacyData.description}
					</p>

					<PrivacyHighlights sections={privacyData.sections} />
					<PrivacyDetails details={privacyData.details} />
				</div>
			</div>
		</InView>
	</div>
</section>

<style>
	.content-section {
		padding: 6rem 2rem;
		border-bottom: 1px solid #f0f0f0;
		
		background-size: 20px 20px;
		position: relative;
		transition: background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), border-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94), background-image 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	.privacy-section {
		padding-top: 8rem;
	}

	.content-section:last-child {
		border-bottom: none;
	}

	.section-container {
		max-width: 1200px;
		margin: 0 auto;
		width: 100%;
	}

	/* Section Headers */
	.section-header {
		margin-bottom: 4rem;
		text-align: center;
	}

	:global(.section-title) {
		font-family: var(--font-display, 'Median', serif);
		font-size: clamp(2.5rem, 6vw, 4rem);
		font-weight: 400;
		line-height: 0.9;
		margin-bottom: 1rem;
		color: #1B1B1B;
	}

	:global(.section-label) {
		font-family: var(--font-primary, 'InterTight', sans-serif);
		font-size: 0.875rem;
		font-weight: 500;
		color: #666;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	/* Content Grid Layout */
	.content-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 4rem;
		align-items: start;
	}

	.content-main {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	:global(.content-description) {
		font-family: var(--font-primary, 'InterTight', sans-serif);
		font-size: 1.125rem;
		line-height: 1.6;
		color: #333;
		margin: 0;
	}

	/* Responsive Design */
	@media (max-width: 768px) {
		.content-section {
			padding: 5.6rem 1.4rem;
		}

		.privacy-section {
			padding-top: 11.2rem;
		}

		.content-grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.section-header {
			margin-bottom: 3rem;
		}
	}

	@media (max-width: 480px) {
		.content-section {
			padding: 4.2rem 1.4rem;
		}

		.privacy-section {
			padding-top: 11.2rem;
		}

		.section-title {
			font-size: clamp(2rem, 8vw, 3rem);
		}
	}


	:global(.dark-mode .section-title) {
		color: #f0f4ff;
	}

	:global(.dark-mode .section-label) {
		color: #b8c4e6;
	}

	:global(.dark-mode .content-description) {
		color: #e5e5e5;
	}

	/* Smooth transitions for theme switching */
	:global(.content-section),
	:global(.section-title),
	:global(.section-label),
	:global(.content-description) {
		transition:
			background-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			border-color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			box-shadow 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}
</style>
