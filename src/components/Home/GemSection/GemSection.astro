---
import styles from './GemSection.module.css';
import SilkBackground from './three/SilkBackground.tsx';
import GemBackground from './three/GemBackground.tsx';
import SoftSkillsSlider from './SoftSkillsSlider.tsx';
import { motion, transform } from 'motion/react';
import { getLangFromUrl } from '../../../i18n/utils.js';
import { translations } from '../../../i18n/translations.js';

// Detectar idioma de la URL actual
const lang = getLangFromUrl(Astro.url);
const t = translations[lang as keyof typeof translations] || translations.en;
const softSkillsData = t.aboutMe.skills;
---

<section class={styles['gem-section']} data-gem-section style="content-visibility: auto; contain-intrinsic-size: 0 800px; contain: layout paint;">

  <!-- Gem 3D Background - moved outside gem-container for proper stacking -->
  <GemBackground client:visible className={styles['gem-background']} />

  <div class={styles['gem-container']}>

    <!-- Desktop: Cards Container con scroll horizontal (visible en vp >= 768px) -->
    <div class={styles['skills-container-desktop']}>
      <div class={styles['skills-container-wrapper']} data-skills-wrapper>
        <div class={styles['skills-scroll']} data-skills-scroll>
          {softSkillsData.map((skill) => (
            <div class={styles['skill-card']} data-skill-card>
              <SilkBackground client:visible className={styles['skill-card-silk-bg']} data-silk-bg />
              <div class={styles['skill-header']}>
                <div class={styles['skill-number']}>{skill.id}</div>
              </div>
              <div class={styles['skill-content']}>
                <div class={styles['skill-title']}>{skill.title}</div>
              </div>
              <div class={styles['skill-description']}>
                <span class={styles['description-normal']}>{skill.description}</span>
                <span class={styles['description-highlight']}>{skill.highlight}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Mobile: Slider Manual (visible en vp < 768px) -->
    <div class={styles['skills-container-mobile']}>
      <SoftSkillsSlider softSkillsData={softSkillsData} client:visible />
    </div>


    <!-- Large ABOUT ME Text -->
    <motion.div
      className={styles['soft-skills-title-container']}
      initial={{ opacity: 0, y: 50 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true, margin: "-100px" }}
      transition={{ duration: 0.8, ease: "easeOut" }}
      client:idle
    >
      <h2
        class={styles['soft-skills-title-normal']}
        data-title="about-me"
      >
        {t.aboutMe.title}
      </h2>
    </motion.div>

  </div>
</section>

<script>
  import { scroll } from 'motion';
  import { observeDarkMode } from '../../../utils/darkMode';

  // Performance optimization: track scroll animation state
  let scrollCleanup: (() => void) | null = null;
  let isScrollActive = false;

  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', () => {
    const gemSection = document.querySelector('[data-gem-section]');
    const skillsScroll = document.querySelector('[data-skills-scroll]');
    const titleElement = document.querySelector('[data-title="about-me"]');

    // Apply dark mode styles - only for title and card backgrounds
    // SilkBackground component handles its own dark mode visibility
    const applyDarkMode = (isDark: boolean) => {
      // Update title color
      if (titleElement) {
        (titleElement as HTMLElement).style.transition = 'color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        (titleElement as HTMLElement).style.color = isDark ? '#f8f4ff' : '#000000';
      }

      // Update card backgrounds (NOT silk background - that's handled in React component)
      const skillCards = document.querySelectorAll('[data-skill-card]');
      skillCards.forEach(card => {
        const cardElement = card as HTMLElement;

        // Add smooth transition
        cardElement.style.transition = 'all 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94)';

        if (isDark) {
          // Dark mode: transparent background with purple border
          cardElement.style.background = 'transparent';
          cardElement.style.backgroundImage = 'none';
          cardElement.style.border = '1px solid rgb(123, 111, 178)';
        } else {
          // Light mode: show fallback image background
          cardElement.style.background = "url('https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/SilkCardFallback.jpeg')";
          cardElement.style.backgroundSize = 'cover';
          cardElement.style.backgroundPosition = 'center';
          cardElement.style.backgroundRepeat = 'no-repeat';
          cardElement.style.border = '1px solid rgba(74, 36, 181, 0.3)';
        }
      });
    };

    // Observe dark mode changes using centralized utility
    const cleanupDarkMode = observeDarkMode(applyDarkMode);

    // Performance optimization: Intersection Observer for scroll animation
    // Only activate scroll animation when section is near viewport
    if (gemSection && skillsScroll) {
      const scrollObserver = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting && !isScrollActive) {
            // Activate scroll animation when visible
            const scrollWidth = skillsScroll.scrollWidth - skillsScroll.clientWidth;

            if (scrollWidth > 0) {
              scrollCleanup = scroll(
                (progress: number) => {
                  skillsScroll.scrollLeft = progress * scrollWidth;
                },
                {
                  target: gemSection,
                  offset: ["start center", "end center"]
                }
              );
              isScrollActive = true;
            }
          } else if (!entry.isIntersecting && isScrollActive) {
            // Deactivate scroll animation when not visible
            if (scrollCleanup) {
              scrollCleanup();
              scrollCleanup = null;
            }
            isScrollActive = false;
          }
        },
        {
          rootMargin: '200px', // Start before fully visible
          threshold: 0
        }
      );

      scrollObserver.observe(gemSection);

      // Cleanup function for scroll observer
      const cleanupScrollObserver = () => {
        scrollObserver.disconnect();
        if (scrollCleanup) {
          scrollCleanup();
          scrollCleanup = null;
        }
      };

      // Combined cleanup
      window.addEventListener('beforeunload', () => {
        cleanupDarkMode();
        cleanupScrollObserver();
      });
    } else {
      // Fallback cleanup if elements not found
      window.addEventListener('beforeunload', cleanupDarkMode);
    }
  });
</script>
