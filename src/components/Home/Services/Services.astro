---
// Services.astro - Sección de servicios con funcionalidad colapsable optimizada
import ServicesIsland from './components/ServicesIsland.tsx';
import { TextDisperseBlack } from '../../ui/TextDisperseBlack.tsx';
import { motion } from 'motion/react';
import { getLangFromUrl } from '../../../i18n/utils.js';
import { translations } from '../../../i18n/translations.js';

// Detectar idioma de la URL actual
const lang = getLangFromUrl(Astro.url);
const t = translations[lang as keyof typeof translations] || translations.en;
---

<section class="services-section">
  
  <div class="services-container">
    <!-- Giant Heading with TextDisperse -->
    <div class="giant-heading-wrapper">
      <motion.div
        className="giant-heading-container"
        initial={{ opacity: 0, y: 50 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true, margin: "-100px" }}
        transition={{ duration: 0.8, ease: "easeOut" }}
        client:idle
      >
        <h2 class="sr-only">Services</h2>
        <TextDisperseBlack text={t.services.title} className="giant-heading-disperse-black" client:idle />
      </motion.div>
      
      <motion.p
        className="services-subtitle font-primary text-center mx-auto max-w-[600px] m-0 leading-relaxed"
        style={{ fontSize: 'clamp(14px, 2vw, 18px)' }}
        initial={{ opacity: 0, y: 20 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true, margin: "-100px" }}
        transition={{ duration: 0.6, delay: 0.4, ease: "easeOut" }}
        client:idle
      >
        {t.services.subtitle}
      </motion.p>
    </div>
    
    <div class="services-content">
      

      <!-- Services List - Optimized Island Component with scroll animation -->
      <motion.div
        initial={{ opacity: 0, y: 40 }}
        whileInView={{ opacity: 1, y: 0 }}
        viewport={{ once: true, margin: "-100px" }}
        transition={{ duration: 0.7, delay: 0.3, ease: "easeOut" }}
        client:visible
      >
        <ServicesIsland client:visible lang={lang} />
      </motion.div>

    </div>
  </div>
</section>

<style>
  :global(.services-section) {
    width: 100%;
    min-height: 100vh;
    padding: 65px 60px;
   
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
  }

  .services-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  /* Giant Heading Styles */
  :global(.giant-heading-wrapper) {
    width: 100%;
    display: flex;
    margin-bottom: 80px;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 40px 0 0 0;
  }

  :global(.giant-heading-container) {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: visible;
  }

  :global(.giant-heading-disperse-black) {
    font-family: var(--font-display) !important;
    font-size: clamp(80px, 15vw, 200px) !important;
    font-weight: 400 !important;
    color: #000000 !important;
    line-height: 0.8 !important;
    letter-spacing: -0.02em !important;
    text-transform: uppercase !important;
    margin: 0 !important;
    width: 100% !important;
  }

  @media (max-width: 768px) {
    :global(.giant-heading-container) {
      justify-content: center;
    }
    
    :global(.giant-heading-disperse-black) {
      font-size: clamp(60px, 12vw, 120px) !important;
      justify-content: center !important;
    }
  }

  @media (max-width: 480px) {
    :global(.giant-heading-disperse-black) {
      font-size: clamp(50px, 10vw, 80px) !important;
      line-height: 0.8 !important;
    }
  }

  :global(.giant-heading-disperse-black span) {
    font-family: var(--font-display) !important;
    color: #000000 !important;
  }

  .services-content {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding-bottom: 200px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    gap: 80px;
  }

  /* Services Images Section */
  :global(.services-images-section) {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
  }

  .project-images {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Header Styles */
  .services-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;

  }

  :global(.services-title) {
    color: #808080;
    font-family: var(--font-display);
    font-size: clamp(32px, 6vw, 48px);
    font-weight: 400;
    line-height: clamp(50px, 8vw, 70px);
    margin: 0;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.services-description) {
    width: 100%;
    max-width: 424px;
    color: #111111;
    font-family: var(--font-primary);
    font-size: clamp(16px, 2.5vw, 20px);
    font-weight: 500;
    line-height: clamp(24px, 3.5vw, 30px);
    margin: 0;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Services List */
  :global(.services-list) {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }

  :global(.service-item) {
    width: 100%;
    padding: 80px 20px;
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(5px);
    border: 1px solid rgb(255, 255, 255);
    border-radius: 20px;
    display: flex;
    flex-direction: row;
    gap: 54px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  /* Hover effects for clickable service items */
  :global(.service-item:hover .service-title) {
    color: #434343 !important;
    transition: color 0.3s ease;
  }

  :global(.service-item:hover .service-number) {
    color: #434343 !important;
    transition: color 0.3s ease;
  }

  /* Hover effect for FlipText inside service titles */
  :global(.service-item:hover .service-title .flip-text-container span) {
    color: #434343 !important;
    transition: color 0.3s ease;
  }

  :global(.service-number) {
    color: black;
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    transition: color 0.3s ease;
  }

  :global(.service-number.inactive) {
    color: rgba(17, 17, 17, 0.30);
  }

  /* Hover state for inactive numbers */
  :global(.service-item:hover .service-number.inactive) {
    color: #434343 !important;
  }

  :global(.service-content) {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: ;
  }

  :global(.service-title-container) {
    width: 100%;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: clamp(20px, 4vw, 30px);
    flex-wrap: wrap;
  }

  :global(.service-title) {
    color: #111111;
    margin: 0;
    transition: color 0.3s ease;
    font-family: var(--font-display) !important;
    font-size: clamp(2rem, 6vw, 3.5rem) !important;
    font-weight: 900 !important;
    line-height: 0.9 !important;
  }

  :global(.service-title.inactive) {
    color: rgba(17, 17, 17, 0.30);
  }

  /* Hover state for inactive titles */
  :global(.service-item:hover .service-title.inactive) {
    color: #434343 !important;
  }


  /* Ensure FlipText inherits the color from service-title */
  .service-title :global(.flip-text-container) {
    color: inherit;
  }

  /* Override some Tailwind styles to make sure our transitions work */
  .service-title :global(.flip-text-container) span {
    transition-property: transform;
    transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    transition-duration: 300ms;
  }

  :global(.service-details) {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    opacity: 1;
    max-height: 400px;
    overflow: hidden;
    transition: all 0.4s ease;
  }

  :global(.service-info) {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 60%;
    max-width: 60%;
  }

  :global(.service-tags) {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
    padding: 12px 0;
  }

  :global(.tag) {
    padding: 8px 11px;
    border-radius: 924px;
    border: 0.55px solid rgba(17, 17, 17, 0.20);
    background: linear-gradient(135deg, #4523AE 0%, #6B46C1 100%);
    color: #ffffff;
    font-family: "VideoGameFont", monospace;
    font-size: 12px;
    font-weight: 400;
    text-transform: uppercase;
    line-height: 16px;
    white-space: nowrap;
    display: inline-block;
    transition: all 0.2s ease;
  }

  :global(.tag:hover) {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  :global(.service-description) {
    color: #808080;
    font-family: var(--font-primary);
    font-size: 14px;
    font-weight: 400;
    line-height: 20px;
    margin: 0;
  }

  /* Technologies Section */
  :global(.service-technologies) {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  :global(.tech-title) {
    color: #111111;
    font-family: var(--font-secondary);
    font-size: 13px;
    font-weight: 600;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  :global(.tech-tags) {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  :global(.tech-tag) {
    padding: 6px 10px;
    border-radius: 924px;
    background: rgba(69, 35, 174, 0.08);
    border: 0.5px solid rgba(69, 35, 174, 0.15);
    color: #4523AE;
    font-family: var(--font-primary);
    font-size: 11px;
    font-weight: 500;
    line-height: 14px;
    white-space: nowrap;
    display: inline-block;
    transition: all 0.2s ease;
  }

  :global(.tech-tag:hover) {
    background: rgba(69, 35, 174, 0.12);
    transform: translateY(-1px);
  }

  /* Example Project Section */
  :global(.service-example) {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  :global(.example-title) {
    color: #111111;
    font-family: var(--font-secondary);
    font-size: 13px;
    font-weight: 600;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  :global(.example-text) {
    color: #666666;
    font-family: var(--font-primary);
    font-size: 13px;
    font-weight: 400;
    line-height: 18px;
    margin: 0;
    font-style: italic;
  }

  :global(.service-images) {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 140px;
    width: 40%;
    max-width: 40%;
    flex-shrink: 0;
  }

  /* Collapsed State */
  :global(.service-item:not(.active) .service-details) {
    opacity: 0;
    max-height: 0;
    margin-top: -54px;
  }



  /* Responsive Design */
  @media (max-width: 991px) {
    /* Service titles more responsive for tablets and mobile */
    :global(.service-title) {
      font-size: clamp(1.5rem, 8vw, 2.5rem) !important;
    }

    /* Hide service numbers in mobile/tablet */
    :global(.service-number) {
      display: none;
    }

    /* Adjust service item layout without numbers */
    :global(.service-item) {
      flex-direction: column;
      gap: 30px;
    }
  }

  @media (max-width: 768px) {
    .services-section {
      padding: 40px 20px;
    }

    .services-header {
 

    }

    .services-description {
      max-width: 100%;
    }

    /* Further adjust service titles for mobile */
    :global(.service-title) {
      font-size: clamp(1.2rem, 10vw, 2rem) !important;
      line-height: 0.8 !important;
    }

    :global(.service-title-container) {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    :global(.service-details) {
      flex-direction: column;
      gap: 20px;
    }

    :global(.service-images) {
      display: none;
    }

    :global(.service-info) {
      width: 100%;
      max-width: 100%;
    }

    :global(.service-details) {
      max-height: 500px;
    }

  }

  @media (max-width: 480px) {
    .services-content {
      gap: 40px;
      padding-bottom: 100px;
    }

    :global(.services-list) {
      gap: 32px;
    }

    :global(.service-item) {
      gap: 30px;
    }

    :global(.service-content) {
      gap: 30px;
    }

    /* Extra small mobile optimization */
    :global(.service-title) {
      font-size: clamp(1rem, 12vw, 1.8rem) !important;
      line-height: 0.75 !important;
    }
  }

  /* Services subtitle class */
  :global(.services-subtitle) {
    color: rgba(0, 0, 0, 0.7);
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Screen reader only class for accessibility */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Dark Mode Styles - Following Documentation Pattern */
  :global(.dark-mode .services-section) {
    background-color: transparent;
    background-image:
      linear-gradient(to right, rgba(71,85,105,0.15) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(71,85,105,0.15) 1px, transparent 1px),
      radial-gradient(circle at 50% 60%, rgba(236,72,153,0.15) 0%, rgba(168,85,247,0.05) 40%, transparent 70%);
    background-size: 40px 40px, 40px 40px, 100% 100%;
    background-position: 0 0, 0 0, center;
    background-repeat: repeat, repeat, no-repeat;
  }

  :global(.dark-mode .services-subtitle) {
    color: #e6d9f0;
  }

  :global(.dark-mode .giant-heading-disperse-black) {
    color: #f8f4ff !important;
  }

  :global(.dark-mode .giant-heading-disperse-black span) {
    color: #f8f4ff !important;
  }

  :global(.dark-mode .services-title) {
    color: #e6d9f0;
  }

  :global(.dark-mode .services-description) {
    color: #f8f4ff;
  }

  /* Service Items Dark Mode */
  :global(.dark-mode .service-item) {
    border-top-color: rgba(157, 127, 193, 0.2);
  }

  :global(.dark-mode .service-number) {
    color: #f8f4ff;
  }

  :global(.dark-mode .service-number.inactive) {
    color: rgba(157, 127, 193, 0.4);
  }

  :global(.dark-mode .service-title) {
    color: #f8f4ff;
  }

  :global(.dark-mode .service-title.inactive) {
    color: rgba(157, 127, 193, 0.4);
  }

  /* Hover states Dark Mode */
  :global(.dark-mode .service-item:hover .service-title) {
    color: #ffffff !important;
  }

  :global(.dark-mode .service-item:hover .service-number) {
    color: #ffffff !important;
  }

  :global(.dark-mode .service-item:hover .service-title.inactive) {
    color: #ffffff !important;
  }

  :global(.dark-mode .service-item:hover .service-number.inactive) {
    color: #ffffff !important;
  }

  :global(.dark-mode .service-item:hover .service-title .flip-text-container span) {
    color: #ffffff !important;
  }

  /* Service Details Dark Mode */
  :global(.dark-mode .service-description) {
    color: #e6d9f0;
  }

  :global(.dark-mode .tech-title) {
    color: #f8f4ff;
  }

  :global(.dark-mode .tech-tag) {
    background: rgba(157, 127, 193, 0.15);
    border-color: rgba(157, 127, 193, 0.3);
    color: #d4a5ff;
  }

  :global(.dark-mode .tech-tag:hover) {
    background: rgba(157, 127, 193, 0.25);
  }

  :global(.dark-mode .example-title) {
    color: #f8f4ff;
  }

  :global(.dark-mode .example-text) {
    color: #e6d9f0;
  }

  /* Tags remain with original purple gradient - they look good in dark mode */
</style>

