---
// LeftMarqueeBanner - Large animated text moving from right to left
import styles from './LeftMarqueeBanner.module.css';
import { t } from '../../../i18n/utils.js';

const { lang = 'en' } = Astro.props;
---

<!-- Wrapper para prevenir layout shift -->
<div class={styles['left-marquee-container']}>
  <div class={styles['left-marquee-wrapper']}>
    <div
      id="left-marquee"
      class="whitespace-nowrap font-display font-bold select-none text-right"
      style="background: linear-gradient(90deg, #b190ff, #7449ff); background-clip: text; -webkit-background-clip: text; color: transparent; width: max-content; text-shadow: 0px 4px 8px rgba(59, 2, 111, 0.3); line-height: 1; will-change: transform; contain: layout style paint;"
    >
      <span class="marquee-content">
        {t('banner.leftMarquee', lang)}
      </span>
      <span class="marquee-content">
        {t('banner.leftMarquee', lang)}
      </span>
      <span class="marquee-content">
        {t('banner.leftMarquee', lang)}
      </span>
      <span class="marquee-content">
        {t('banner.leftMarquee', lang)}
      </span>
      <span class="marquee-content">
        {t('banner.leftMarquee', lang)}
      </span>
      <span class="marquee-content">
        {t('banner.leftMarquee', lang)}
      </span>
    </div>
  </div>
</div>

<style>
  /* Base font-size and height for all viewports */
  #left-marquee {
    font-size: clamp(163px, 32.6vw, 326px);
    height: clamp(163px, 32.6vw, 326px);
  }

  /* Mobile viewport adjustments - 30% larger font-size and more spacing */
  @media (max-width: 767px) {
    #left-marquee {
      font-size: clamp(212px, 42.4vw, 424px); /* 30% increase from base clamp */
      height: clamp(212px, 42.4vw, 424px);
      letter-spacing: 0.05em; /* More separation between letters */
    }

    .marquee-content {
      padding: 0 2rem; /* More spacing between repeated content */
    }
  }

  /* Dark mode styles - Intense neon illumination stroke text */
  :global(.dark-mode) #left-marquee {
    background: none !important;
    background-clip: unset !important;
    -webkit-background-clip: unset !important;
    color: transparent !important;
    -webkit-text-stroke: 1px #d51da4;
    -webkit-text-fill-color: transparent;
    text-shadow:
      /* Core white illumination */
      0 0 2px rgba(255, 255, 255, 1),
      0 0 5px rgba(255, 255, 255, 0.9),
      0 0 10px rgba(255, 255, 255, 0.8),
      /* Purple neon illumination layers */
      0 0 20px rgba(157, 127, 193, 1),
      0 0 40px rgba(157, 127, 193, 0.9),
      0 0 60px rgba(157, 127, 193, 0.8),
      0 0 80px rgba(157, 127, 193, 0.7),
      0 0 100px rgba(157, 127, 193, 0.6),
      0 0 120px rgba(157, 127, 193, 0.5);
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    filter: brightness(1.2) saturate(1.3)
            drop-shadow(0 0 40px rgba(157, 127, 193, 0.15))
            drop-shadow(0 0 80px rgba(157, 127, 193, 0.08))
            drop-shadow(0 0 120px rgba(157, 127, 193, 0.04));
  }

  /* Hover effect - Maximum neon illumination with flicker */
  :global(.dark-mode) :global(.left-marquee-wrapper):hover #left-marquee {
    -webkit-text-stroke: 1px rgba(157, 127, 193, 1);
    text-shadow:
      /* Intense core illumination */
      0 0 3px rgba(255, 255, 255, 1),
      0 0 8px rgba(255, 255, 255, 1),
      0 0 15px rgba(255, 255, 255, 0.9),
      /* Maximum purple neon illumination */
      0 0 25px rgba(157, 127, 193, 1),
      0 0 50px rgba(157, 127, 193, 1),
      0 0 75px rgba(157, 127, 193, 0.9),
      0 0 100px rgba(157, 127, 193, 0.8),
      0 0 125px rgba(157, 127, 193, 0.7),
      0 0 150px rgba(157, 127, 193, 0.6),
      0 0 175px rgba(157, 127, 193, 0.5);
    filter: brightness(1.5) saturate(1.5)
            drop-shadow(0 0 60px rgba(157, 127, 193, 0.25))
            drop-shadow(0 0 120px rgba(157, 127, 193, 0.15))
            drop-shadow(0 0 180px rgba(157, 127, 193, 0.08));
    animation: intensePurpleFlicker 1.8s ease-in-out infinite alternate;
  }

  /* Intense purple flicker animation - realistic neon effect */
  @keyframes intensePurpleFlicker {
    0%, 18%, 22%, 25%, 53%, 57%, 100% {
      text-shadow:
        0 0 7px #fff,
        0 0 10px #fff,
        0 0 21px #fff,
        0 0 42px #0fa,
        0 0 82px #0fa,
        0 0 92px #0fa,
        0 0 102px #0fa,
        0 0 151px #0fa;
      filter: brightness(10) saturate(1.5);
    }
    20%, 24%, 55% {
      text-shadow:
        /* Dimmed flicker state */
        0 0 1px rgba(255, 255, 255, 0.6),
        0 0 3px rgba(255, 255, 255, 0.4),
        0 0 8px rgba(157, 127, 193, 0.6),
        0 0 15px rgba(157, 127, 193, 0.4),
        0 0 25px rgba(193, 127, 127, 0.3);
      filter: brightness(0.8) saturate(0.8);
    }
  }

  /* Performance optimizations */
  :global(.dark-mode) #left-marquee {
    /* GPU acceleration for smooth animations */
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  /* Accessibility: Respect user's motion preferences */
  @media (prefers-reduced-motion: reduce) {
    :global(.dark-mode) :global(.left-marquee-wrapper):hover #left-marquee {
      animation: none !important;
    }
  }

  /* 🍎 Safari-Only Fallback - Dark mode simple solo para Safari, Chromium mantiene efectos neon */
  @supports (-webkit-appearance: none) and (not (background: paint(something))) {
    :global(.dark-mode) #left-marquee {
      /* Anular efectos complejos solo en Safari */
      background: linear-gradient(90deg, #b190ff, #7449ff) !important;
      background-clip: text !important;
      -webkit-background-clip: text !important;
      color: transparent !important;
      -webkit-text-stroke: none !important;
      -webkit-text-fill-color: transparent !important;
      text-shadow: 0px 4px 8px rgba(59, 2, 111, 0.3) !important;
      filter: none !important;
      animation: none !important;
      transition: none !important;

      /* Mantener optimizaciones de performance */
      -webkit-transform: translate3d(0, 0, 0);
      transform: translate3d(0, 0, 0);
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
    }

    /* Anular hover effects solo en Safari */
    :global(.dark-mode) :global(.left-marquee-wrapper):hover #left-marquee {
      background: linear-gradient(90deg, #b190ff, #7449ff) !important;
      background-clip: text !important;
      -webkit-background-clip: text !important;
      color: transparent !important;
      -webkit-text-stroke: none !important;
      -webkit-text-fill-color: transparent !important;
      text-shadow: 0px 4px 8px rgba(59, 2, 111, 0.3) !important;
      filter: none !important;
      animation: none !important;
    }
  }

  /* Gradientes laterales para pantallas grandes */
  @media (min-width: 2560px) {
    /* Dark mode gradients */
    :global(.dark-mode) :global(.left-marquee-wrapper)::before {
      background: linear-gradient(to right, #050112, transparent) !important;
    }

    :global(.dark-mode) :global(.left-marquee-wrapper)::after {
      background: linear-gradient(to left, #050112, transparent) !important;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  // Animación infinita fluida del marquee izquierdo con aceleración en scroll usando GSAP
  async function initLeftMarquee() {
    const leftMarquee = document.getElementById('left-marquee');
    if (!leftMarquee) return;

    const leftContent = leftMarquee.querySelectorAll('.marquee-content');
    if (leftContent.length === 0) return;

    // Dynamically import Observer to avoid ESM/CommonJS issues
    let Observer: any;
    try {
      const module = await import('gsap/Observer');
      Observer = module.Observer;
      gsap.registerPlugin(Observer);
    } catch (error) {
      console.warn('[LeftMarqueeBanner] Failed to load Observer:', error);
      return;
    }

    // Configurar animación infinita con GSAP
    const tl = gsap.timeline({
      repeat: -1,
      defaults: { ease: 'none' }
    });

    // Calcular ancho total del contenido
    const firstElement = leftContent[0] as HTMLElement;
    const contentWidth = firstElement.getBoundingClientRect().width;

    // Animar de 0 a -contentWidth (movimiento hacia la IZQUIERDA)
    tl.to(leftMarquee, {
      x: -contentWidth,
      duration: contentWidth / 60, // 60px por segundo = velocidad base
      ease: 'none'
    });

    // Observer para aceleración en scroll
    Observer.create({
      onChangeY(self: { deltaY: number }) {
        let factor = 1.5; // Factor de aceleración

        if (self.deltaY < 0) {
          // Scroll hacia arriba: reducir velocidad
          factor *= -0.5;
        }

        // Aplicar aceleración temporal con GSAP
        gsap.timeline({
          defaults: { ease: 'none' }
        })
          .to(tl, { timeScale: factor * 2, duration: 0.2, overwrite: true })
          .to(tl, { timeScale: 1, duration: 1 }, '+=0.3');
      }
    });
  }

  // Iniciar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLeftMarquee);
  } else {
    initLeftMarquee();
  }
</script>
