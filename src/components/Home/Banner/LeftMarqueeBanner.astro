---
// LeftMarqueeBanner - Large animated text moving from right to left with scroll direction
import styles from './MarqueeBanner.module.css';
import { t } from '../../../i18n/utils.js';

const { lang = 'en' } = Astro.props;
---

<div class={`${styles.marqueeContainer} ${styles.left}`}>
  <div
    id="left-marquee"
    data-marquee-scroll-direction-target
    data-marquee-direction="left"
    data-marquee-status="normal"
    data-marquee-speed="20"
    data-marquee-scroll-speed="8"
    data-marquee-duplicate="3"
    class={`${styles.marqueeAdvanced} ${styles.marqueeWrapper}`}
  >
    <div data-marquee-scroll-target class={styles.marqueeScroll}>
      <div data-marquee-collection-target class={styles.marqueeCollection}>
        <div class={styles.marqueeItem}>
          <p class={`${styles.marqueeText} font-display font-bold`}>
            {t('banner.leftMarquee', lang)}
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { initMarqueeAdvanced, cleanupMarquees } from '../../../utils/initMarquee';

  function init() { initMarqueeAdvanced('left-marquee'); }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  document.addEventListener('astro:before-preparation', cleanupMarquees, { once: true });
</script>
