---
// Banner component with Marquees
import styles from './Banner.module.css';
import BannerMarqueesWrapper from './BannerMarqueesWrapper.astro';
import MainButton from '../../modules/Header/MainButton.astro';
import SecondaryButton from '../../ui/SecondaryButton.astro';
import { t } from '../../../i18n/utils.js';

const { lang = 'en' } = Astro.props;
---

<div class={`${styles.bannerContainer} w-full h-screen overflow-hidden relative flex flex-col justify-end items-center`} id="bannerContainer">
  <h1 class={styles.srOnly}>Karen Ortiz - Design Engineer Portfolio</h1>

  <!-- Dark mode overlay gradient -->
  <div class={styles.darkOverlay} id="darkOverlay"></div>

  <BannerMarqueesWrapper lang={lang} />
  <div class={styles.bannerImageContainer}>
    <img
      id="banner-image"
      src="https://pub-2e7dc04d482146c59f472ab28fba09a9.r2.dev/MePortfolio.png"
      data-light-src="https://pub-2e7dc04d482146c59f472ab28fba09a9.r2.dev/MePortfolio.png"
      data-dark-src="https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/MePortfolioDark.png"
      alt="Karen Rebeca Ortiz - Design Engineer Portfolio"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      width="520"
      height="537"
    />
  </div>
  <div class={`${styles.bannerButtonsWrapper} banner-buttons`}>
    <SecondaryButton text={t('banner.projectsButton', lang)} />
    <MainButton text={t('banner.resumeButton', lang)} href="/resume" />
  </div>
</div>


<script>
  // Dark mode handler — only image src swap (styles handled by CSS module)
  const swapBannerImage = (isDark: boolean) => {
    const bannerImage = document.getElementById('banner-image') as HTMLImageElement | null;
    if (!bannerImage) return;

    const src = bannerImage.getAttribute(isDark ? 'data-dark-src' : 'data-light-src');
    if (src) bannerImage.src = src;
  };

  const onDarkModeChange = ((event: CustomEvent) => {
    swapBannerImage(event.detail.isDark);
  }) as EventListener;

  function init() {
    swapBannerImage(document.documentElement.classList.contains('dark-mode'));
  }

  window.addEventListener('darkModeChange', onDarkModeChange);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // Cleanup on Astro page navigation
  document.addEventListener('astro:before-preparation', () => {
    window.removeEventListener('darkModeChange', onDarkModeChange);
  }, { once: true });
</script>
