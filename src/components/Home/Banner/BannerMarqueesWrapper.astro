---
// BannerMarqueesWrapper - Container for stacked marquees positioned behind banner content
import styles from './BannerMarqueesWrapper.module.css';
import LeftMarqueeBanner from './LeftMarqueeBanner.astro';
import RightMarqueeBanner from './RightMarqueeBanner.astro';

const { lang = 'en' } = Astro.props;
---

<div class={styles.marqueeContainer}>
  <div class={styles.marqueeRight}>
    <RightMarqueeBanner lang={lang} />
  </div>
  <div class={styles.marqueeLeft}>
    <LeftMarqueeBanner lang={lang} />
  </div>
</div>
