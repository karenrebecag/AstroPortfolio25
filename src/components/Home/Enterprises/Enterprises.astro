---
import { Image } from 'astro:assets';
import styles from './Enterprises.module.css';

const logos = [
  { src: 'https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/AncientLogo-1.png', alt: 'Ancient', width: 132, height: 44 },
  { src: 'https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/AthenisAILogo.png', alt: 'Athenis AI', width: 132, height: 44 },
  { src: 'https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/OpinatorLogo.png', alt: 'Opinator', width: 132, height: 44 },
  { src: 'https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/SodioWhite.png', alt: 'Sodio', width: 53, height: 18 },
  { src: 'https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/SpilLogo.png', alt: 'Spil', width: 53, height: 18 },
  { src: 'https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/WebCraftersLogo.png', alt: 'WebCrafters', width: 132, height: 44 },
  { src: 'https://pub-3ed7c563bcaa4c7c8ed703c87bbc1631.r2.dev/ZoekLogo.png', alt: 'Zoek', width: 53, height: 18 }
];

// Duplicar array para el efecto de loop infinito
const duplicatedLogos = logos.concat(logos);
---

<section class={styles.enterprises}>
  <div class={styles.enterprisesContainer}>
    <div class={styles.enterprisesWrapper}>
      <div class={styles.container}>
        <h2 class={styles.title}>Trusted by Leading Brands to Deliver Exceptional Design Solutions</h2>
        <div class={styles.slider}>
          {duplicatedLogos.map((logo, index) => (
            <Image
              src={logo.src}
              alt={logo.alt}
              width={logo.width}
              height={logo.height}
              class={styles.logo}
              loading="lazy"
              decoding="async"
              format="webp"
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>


