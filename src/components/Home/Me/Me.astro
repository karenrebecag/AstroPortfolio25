              </div>
            </div>
          </AnimatedMeButton>
        </div>
      </AnimatedMeSection>

      <!-- Content Section 3: Stats -->
      <AnimatedMeSection client:visible delay={0.2}>
        <div class="relative z-10">
          <AnimatedMeElement client:visible delay={0.55}>
            <h2 class={`${styles['me-section-title']} me-section-title text-hero font-median mb-8`}>
              <span class={`${styles['me-section-text-dark']} me-section-text-dark`}>Numbers That</span><br />
              <span class="text-[#7350cc]">Speak Volumes</span>
            </h2>
          </AnimatedMeElement>
                    
          <AnimatedMeElement client:visible delay={0.75}>
