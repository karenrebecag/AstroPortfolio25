                </div>
                <div class={`${styles['me-body-sm']} me-body-sm text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary`}>Worldwide clients</div>
              </div>
            </AnimatedMeStats>
            
            <AnimatedMeStats client:visible delay={0.7}>
              <div class="text-center">
                <div class={`${styles['me-stats-number']} me-stats-number flex items-center justify-center text-display ${styles['me-stats-text-dark']} me-stats-text-dark font-secondary mb-2`}>
