--- 
// Me.astro - About section component
import MainButton from '../../modules/Header/MainButton.astro';
import SecondaryButton from '../../ui/SecondaryButton.astro';
import { Number } from '../../ui/Number.tsx';
import CubeBackground from './CubeBackground.tsx';
import GlobeBackground from './ExperienceSlider/GlobeBackground.tsx';
import { TextDisperseBlack } from '../../ui/TextDisperseBlack.tsx';
import ExperienceMarqueeIsland from './ExperienceSlider/ExperienceMarqueeIsland.tsx';
import ExperienceSlider from './ExperienceSlider/ExperienceSlider.tsx';
import { motion } from 'motion/react';
import { AnimatedMeHeader, AnimatedMeSection, AnimatedMeElement, AnimatedMeStats, AnimatedMeButton } from './AnimatedMeWrapper.tsx';
import styles from './Me.module.css';
import { getLangFromUrl, t } from '../../../i18n/utils.js';
import { getExperiences } from '../../../lib/cms';
import { experienceData as fallbackExperienceData } from '../../../data/experienceData';

const lang = getLangFromUrl(Astro.url);
const meTranslations = t('me', lang);

// Fetch experiences from CMS
const experiencesFromCMS = await getExperiences(lang);

// Transform CMS data or use fallback
const experienceData = experiencesFromCMS.length > 0
  ? experiencesFromCMS.map((exp, index) => ({
      id: (index + 1).toString().padStart(2, '0'),
      title: exp.title,
      company: exp.company,
      description: exp.descriptionNormal,
      highlight: exp.descriptionHighlight,
      image: exp.mainCompanyImage?.url || '',
      resumeAnchor: exp.href
    }))
  : fallbackExperienceData;
---

<!-- Storytelling Scroll Container -->
<div class={`${styles['storytelling-scroll-container']} storytelling-scroll-container`}>
  <div class={styles['story-grid']}>

    <!-- Left Column: 3D Cube - Visible on desktop, hidden on mobile -->
    <div class={styles['cube-column-desktop']}>
      <AnimatedMeHeader client:visible={{rootMargin: "200px"}}>
        <div class="w-full aspect-square relative overflow-hidden rounded-lg" style="min-height: 400px; max-height: 600px;">
          <!-- Cube 3D Background -->
          <CubeBackground client:visible={{rootMargin: "200px"}} className={styles['cube-3d-container']} />
        </div>
      </AnimatedMeHeader>
    </div>
    
    <!-- Right Column: Scrolling Content -->
    <div class={styles['scrolling-content-column']}>

      <!-- Content Section 1: Introduction -->
      <AnimatedMeSection client:visible={{rootMargin: "100px"}} delay={0.1}>
        <div class={`${styles['section-content']} relative z-10`}>
          <div class="relative">
            <!-- Purple circle positioned behind the heading -->
            <AnimatedMeElement client:visible delay={0.2} direction="right">
              <div class={`me-purple-circle bg-[#D9CCFF] rounded-full absolute -top-4 -left-8 -z-10`}></div>
            </AnimatedMeElement>
            <AnimatedMeElement client:visible delay={0.25}>
              <h2 class={`me-hero-title text-hero font-median relative z-10 ${styles['me-hero-text']}`}>
                {meTranslations.hero.name}, <strong class="text-[#7350cc] font-semibold">{meTranslations.hero.role}</strong>
              </h2>
            </AnimatedMeElement>
          </div>
          <AnimatedMeElement client:visible delay={0.3}>
            <h3 class={`${styles['me-heading-lg']} me-heading-lg text-heading-lg ${styles['me-heading-text-dark']} me-heading-text-dark font-secondary font-bold`}>
              {meTranslations.hero.location}
            </h3>
          </AnimatedMeElement>
          <AnimatedMeElement client:visible delay={0.35}>
            <p class={`${styles['me-body-lg']} me-body-lg text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary`}>
              {meTranslations.hero.intro}
            </p>
          </AnimatedMeElement>
        </div>
      </AnimatedMeSection>

      <!-- Content Section 2: Experience -->
      <AnimatedMeSection client:visible delay={0.15}>
        <div class={`${styles['section-content']} relative z-10`}>
          <AnimatedMeElement client:visible delay={0.4}>
            <div class={`${styles['section-heading']}`}>
              <h2 class={`me-section-title text-hero font-median text-[#7350cc]`}>{meTranslations.experience.years}</h2>
              <h3 class={`${styles['me-section-subtitle']} me-section-subtitle font-median ${styles['me-section-text-dark']} me-section-text-dark`}>{meTranslations.experience.title1}</h3>
              <h3 class={`${styles['me-section-subtitle']} me-section-subtitle font-median ${styles['me-section-text-dark']} me-section-text-dark`}>{meTranslations.experience.title2}</h3>
            </div>
          </AnimatedMeElement>
          <AnimatedMeElement client:visible delay={0.45}>
            <p class={`${styles['me-body-lg']} me-body-lg text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary`}>
              {meTranslations.experience.description}
            </p>
          </AnimatedMeElement>
          <AnimatedMeButton client:visible delay={0.5}>
            <div class="flex items-start gap-9 button-container-me">
              <MainButton 
                text={meTranslations.experience.connectButton}
                href="https://www.linkedin.com/in/karen-rebeca-ortiz-b5a860282/"
              />
            </div>
          </AnimatedMeButton>
        </div>
      </AnimatedMeSection>

      <!-- Content Section 3: Stats -->
      <AnimatedMeSection client:visible delay={0.2}>
        <div class={`${styles['section-content']} relative z-10`}>
          <AnimatedMeElement client:visible delay={0.55}>
            <div class={`${styles['section-heading']}`}>
              <h2 class={`${styles['me-section-title']} me-section-title text-hero font-median ${styles['me-section-text-dark']} me-section-text-dark`}>{meTranslations.stats.title1}</h2>
              <h3 class={`${styles['me-section-subtitle']} me-section-subtitle font-median text-[#7350cc]`}>{meTranslations.stats.title2}</h3>
            </div>
          </AnimatedMeElement>
                    
          <AnimatedMeElement client:visible delay={0.75}>
            <p class={`${styles['me-body-md']} me-body-md text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary`}>
              {meTranslations.stats.description}
            </p>
          </AnimatedMeElement>

          <!-- Stats Grid -->
          <div class="grid grid-cols-3 gap-6">
            <AnimatedMeStats client:visible delay={0.6}>
              <div class="text-center">
                <div class={`${styles['me-stats-number']} me-stats-number ${styles['me-stats-text-dark']} me-stats-text-dark text-display font-primary font-extrabold mb-2`}>
                  <Number value={4} delay={500} className="font-primary font-extrabold" client:visible />
                </div>
                <div class={`${styles['me-body-sm']} me-body-sm text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary`}>{meTranslations.stats.awards}</div>
              </div>
            </AnimatedMeStats>
            
            <AnimatedMeStats client:visible delay={0.65}>
              <div class="text-center">
                <div class={`${styles['me-stats-number']} me-stats-number flex items-center justify-center ${styles['me-stats-text-dark']} me-stats-text-dark text-display font-primary font-extrabold mb-2`}>
                  <span class="font-primary font-extrabold text-[#7350cc] mr-1">+</span>
                  <Number value={30} delay={700} className="font-primary font-extrabold" client:visible />
                </div>
                <div class={`${styles['me-body-sm']} me-body-sm text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary`}>{meTranslations.stats.clients}</div>
              </div>
            </AnimatedMeStats>
            
            <AnimatedMeStats client:visible delay={0.7}>
              <div class="text-center">
                <div class={`${styles['me-stats-number']} me-stats-number flex items-center justify-center ${styles['me-stats-text-dark']} me-stats-text-dark text-display font-primary font-extrabold mb-2`}>
                  <span class="font-primary font-extrabold text-[#7350cc] mr-1">+</span>
                  <Number value={10} delay={900} className="font-primary font-extrabold" client:visible />
                </div>
                <div class={`${styles['me-body-sm']} me-body-sm text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary`}>{meTranslations.stats.countries}</div>
              </div>
            </AnimatedMeStats>
          </div>

        </div>
      </AnimatedMeSection>

      <!-- Content Section 4: Philosophy -->
      <AnimatedMeSection client:visible delay={0.25}>
        <div class={`${styles['section-content']} relative z-10`}>
          <AnimatedMeElement client:visible delay={0.8}>
            <div class={`${styles['section-heading']}`}>
              <h2 class={`${styles['me-section-title']} me-section-title text-hero font-median ${styles['me-section-text-dark']} me-section-text-dark`}>{meTranslations.philosophy.title1}</h2>
              <h3 class={`${styles['me-section-subtitle']} me-section-subtitle font-median text-[#7350cc]`}>{meTranslations.philosophy.title2}</h3>
              <h3 class={`${styles['me-section-subtitle']} me-section-subtitle font-median ${styles['me-section-text-dark']} me-section-text-dark`}>{meTranslations.philosophy.title3}</h3>
            </div>
          </AnimatedMeElement>
          <AnimatedMeElement client:visible delay={0.85}>
            <p class={`${styles['me-body-lg']} me-body-lg text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary`}>
              {meTranslations.philosophy.description1}
            </p>
          </AnimatedMeElement>
          <AnimatedMeElement client:visible delay={0.9}>
            <p class={`${styles['me-body-md']} me-body-md text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary`}>
              {meTranslations.philosophy.description2}
            </p>
          </AnimatedMeElement>
        </div>
      </AnimatedMeSection>

    </div>
  </div>
</div>

<!-- Globe Section - Above Experience Cards -->
<div class={`${styles['globe-section']} globe-section`}>
  <div class={styles['globe-title-wrapper']}>
    <motion.div
      className={styles['globe-title-container']}
      initial={{ opacity: 0, y: 50 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true, margin: "-100px" }}
      transition={{ duration: 0.8, ease: "easeOut" }}
      client:idle={{timeout: 500}}
    >
      <div class={`${styles['globe-title-text-wrapper']} globe-title-text-wrapper`}>
        <TextDisperseBlack text={meTranslations.globe.title} className={`${styles['globe-title-disperse']} globe-title-disperse`} client:idle={{timeout: 500}} />
      </div>
    </motion.div>
  </div>
  <div class={styles['globe-container']}>
    <GlobeBackground client:visible={{rootMargin: "300px"}} className={styles['globe-3d-container']} />
  </div>
</div>

<!-- Experience Cards Section - Dual System: Marquee (Desktop) + Slider (Mobile) -->
<div class={`${styles['experience-container']} experience-container ${styles['cards-section']}`}>
  <!-- Text Above Experience Cards -->
  <div class={styles['experience-text-container']}>
    <motion.div
      className={styles['experience-text-wrapper']}
      initial={{ opacity: 0, y: 30 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true, margin: "-100px" }}
      transition={{ duration: 0.8, ease: "easeOut" }}
      client:idle={{timeout: 500}}
    >
      <p class={`${styles['experience-description-text']} experience-description-text`}>
        {meTranslations.globe.description}
      </p>
    </motion.div>
  </div>
  
  <!-- Desktop: Marquee Infinito (visible en vp >= 768px) -->
  <div class={styles['experience-marquee-desktop']}>
    <div class={styles['experience-marquee-container']}>
      <div class={styles['experience-marquee-wrapper-limited']}>
        <ExperienceMarqueeIsland experienceData={experienceData} client:visible={{rootMargin: "400px"}} />
      </div>
    </div>
  </div>

  <!-- Mobile: Slider Manual (visible en vp < 768px) -->
  <div class={styles['experience-slider-mobile']}>
    <ExperienceSlider experienceData={experienceData} client:visible={{rootMargin: "400px"}} />
  </div>
</div>

