            </p>
          </AnimatedMeElement>

          <!-- Stats Grid -->
          <div class="grid grid-cols-3 gap-8 mb-8">
            <AnimatedMeStats client:visible delay={0.6}>
              <div class="text-center">
                <div class={`${styles['me-stats-number']} me-stats-number text-display ${styles['me-stats-text-dark']} me-stats-text-dark font-secondary mb-2`}>
                  <Number value={8} delay={500} client:visible />
                </div>
                <div class={`${styles['me-body-sm']} me-body-sm text-body-lg font-medium text-[rgba(8,8,8,0.6)] font-primary`}>Award winner</div>
              </div>
            </AnimatedMeStats>
            
            <AnimatedMeStats client:visible delay={0.65}>
              <div class="text-center">
                <div class={`${styles['me-stats-number']} me-stats-number flex items-center justify-center text-display ${styles['me-stats-text-dark']} me-stats-text-dark font-secondary mb-2`}>
                  <Number value={1} delay={700} client:visible />
