---
import styles from './LetMeIntroduce.module.css';
---

<section class={styles.letmeintroduce}>
  <div class={styles.letmeContainer}>
    <img class={styles.letmeHeroImage} src="https://pub-2e7dc04d482146c59f472ab28fba09a9.r2.dev/MePortfolio.png" alt="Introduction" />
  </div>
</section>

<script type="module">
  import { scroll } from 'motion';
  import styles from './LetMeIntroduce.module.css'; // Import styles to access modularized class name

  // Wait for DOM to be ready
  document.addEventListener('DOMContentLoaded', () => {
    const heroImage = document.querySelector(`.${styles.letmeHeroImage}`); // Use modularized class name
    
    if (heroImage) {
      // Create scroll offset animation for hero image
      scroll(
        (progress: number) => {
          const yOffset = progress * 100; 
          (heroImage as HTMLElement).style.transform = `translateY(-${yOffset}px)`;
        },
        {
          target: heroImage,
          offset: ["start end", "end start"]
        }
      );
    }
  });
</script>