---
// Marquees.astro
import MarqueesIsland from './MarqueesIsland.tsx';
import { getLangFromUrl } from '../../../i18n/utils.js';

const lang = getLangFromUrl(Astro.url);
---

<section class="marquees-section">
  <div class="marquees-section-container">
    <div class="marquees-section-wrapper">
      <MarqueesIsland client:visible lang={lang} />
    </div>
  </div>
</section>

<style>
  :global(.marquees-section) {
    width: 100%;
    overflow: hidden;
    position: relative;
    /* Performance optimization: defer rendering until visible */
    content-visibility: auto;
    contain-intrinsic-size: 0 200px;
    contain: layout paint;
  }

  .marquees-section-container {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .marquees-section-wrapper {
    width: 100%;
    max-width: 1800px;
    position: relative;
    overflow: hidden;
  }

  /* Gradientes laterales para pantallas grandes */
  @media (min-width: 2560px) {
    .marquees-section-wrapper::before,
    .marquees-section-wrapper::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: 120px;
      z-index: 10;
      pointer-events: none;
    }

    .marquees-section-wrapper::before {
      left: 0;
      background: linear-gradient(to right, #FEFEFE, transparent);
      transition: background 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .marquees-section-wrapper::after {
      right: 0;
      background: linear-gradient(to left, #FEFEFE, transparent);
      transition: background 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
  }

  /* Main Marquee Text Styles - Global for dark mode compatibility */
  :global(.main-marquee-text) {
    color: #ffffff;
    transition: color 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  :global(.marquees-container) {
    position: relative;
    width: 100%;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10rem 0;
  }

  :global(.marquee-wrapper) {
    position: absolute;
    width: 200%;
    height: 80px;
    display: flex;
    align-items: center;
    transform-origin: center;
    overflow: hidden;
  }

  :global(.first-marquee) {
    background: #7256c6;
    transform: rotate(5deg);
    z-index: 1;
  }

  :global(.second-marquee) {
    background: #000000;
    transform: rotate(-5deg);
    z-index: 2;
  }

  @media (max-width: 768px) {
    .marquees-section {
      background-size: 20px 20px;
    }
    
    :global(.marquees-container) {
      height: 150px;
    }
    
    :global(.marquee-wrapper) {
      height: 60px;
      width: 300%;
    }
    
    :global(.first-marquee) {
      transform: rotate(5deg);
    }

    :global(.second-marquee) {
      transform: rotate(-5deg);
    }
  }

  /* Accessibility: Respect user's motion preferences */
  @media (prefers-reduced-motion: reduce) {
    :global(.marquee-wrapper) {
      animation: none;
    }
    
    :global(.marquees-container) {
      /* Provide static fallback when motion is reduced */
      overflow: hidden;
    }
  }


  /* Dark mode gradients for large screens */
  @media (min-width: 2560px) {
    :global(.dark-mode) .marquees-section-wrapper::before {
      background: linear-gradient(to right, linear-gradient(135deg, #07001e 0%, #2c20a6 100%), transparent);
    }

    :global(.dark-mode) .marquees-section-wrapper::after {
      background: linear-gradient(to left, linear-gradient(135deg, #07001e 0%, #2c20a6 100%), transparent);
    }
  }

  /* Marquee backgrounds with enhanced contrast for dark mode */
  :global(.dark-mode .first-marquee) {
    background: #9D7FC1; /* Purple brand color for better contrast */
  }

  :global(.dark-mode .second-marquee) {
    background: #4523AE; /* Darker purple for variety */
  }

  /* Main marquee text dark mode - Keep white for good contrast against colored backgrounds */
  :global(.dark-mode .main-marquee-text) {
    color: #ffffff; /* Keep white text on colored marquee backgrounds */
  }
</style>
