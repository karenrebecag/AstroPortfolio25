---
// No props needed - static footer
---

<footer class="resume-footer">
  <div class="footer-container">
    <!-- Contact & Social Links -->
    <div class="footer-content">
      <div class="footer-section">
        <h3 class="footer-title">Get In Touch</h3>
        <p class="footer-description">
          Ready to collaborate? Let's create something amazing together.
        </p>
        <div class="social-links">
          <a href="https://www.linkedin.com/in/karen-rebeca-ortiz-b5a860282" target="_blank" rel="noopener noreferrer" class="social-link">
            LinkedIn
          </a>
          <a href="https://github.com/karenrebecag" target="_blank" rel="noopener noreferrer" class="social-link">
            GitHub
          </a>
          <a href="https://www.instagram.com/karenrebeca.og/" target="_blank" rel="noopener noreferrer" class="social-link">
            Instagram
          </a>
          <a href="https://dribbble.com/krog11" target="_blank" rel="noopener noreferrer" class="social-link">
            Dribbble
          </a>
        </div>
      </div>
      
      <!-- Professional Info -->
      <div class="footer-section">
        <h3 class="footer-title">Karen Rebeca Ortiz</h3>
        <p class="footer-subtitle">Design Engineer</p>
        <div class="footer-links">
          <a href="/" class="footer-link">Portfolio</a>
          <a href="/privacy" class="footer-link">Privacy Policy</a>
          <a href="mailto:karen.ortizg@yahoo.com" class="footer-link">Contact</a>
        </div>
      </div>
    </div>
    
    <!-- Copyright -->
    <div class="footer-bottom">
      <p class="copyright">
        © {new Date().getFullYear()} Karen Rebeca Ortiz. All rights reserved.
      </p>
      <p class="availability">
        Available for freelance & full-time opportunities
      </p>
    </div>
  </div>
</footer>

<style>
  /* Resume Footer Styles */
  .resume-footer {
    background: transparent;
    color: #ffffff;
    padding: 4rem 0 2rem 0;
    position: relative;
    z-index: 10;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .footer-content {
    display: grid;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }

  .footer-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #ffffff;
    font-family: var(--font-secondary);
  }

  .footer-subtitle {
    font-size: 1rem;
    color: #cccccc;
    font-weight: 500;
  }

  .footer-description {
    color: #cccccc;
    line-height: 1.6;
    max-width: 300px;
  }

  .social-links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .social-link {
    color: #9D7FC1;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .social-link:hover {
    color: #B794F6;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-link {
    color: #cccccc;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer-link:hover {
    color: #ffffff;
  }

  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid #333333;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      text-align: left;
    }
  }

  .copyright {
    font-size: 0.875rem;
    color: #cccccc;
  }

  .availability {
    font-size: 0.875rem;
    color: #9D7FC1;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .footer-container {
      padding: 0 1rem;
    }
    
    .resume-footer {
      padding: 3rem 0 1.5rem 0;
    }
  }
</style>
