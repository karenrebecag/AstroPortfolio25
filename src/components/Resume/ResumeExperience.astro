---
export interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;

// Experience content by language
const experienceContent = {
  en: {
    title: "Work Experience",
    experiences: [
      {
        position: "Frontend Developer",
        company: "Tech Innovations Inc.",
        location: "Remote",
        period: "2022 - Present",
        description: "Led the development of responsive web applications using React and TypeScript. Collaborated with design teams to implement pixel-perfect UI components and optimize user experiences.",
        achievements: [
          "Increased application performance by 40% through code optimization",
          "Built and maintained a comprehensive design system",
          "Mentored 3 junior developers",
          "Implemented automated testing resulting in 95% code coverage"
        ],
        technologies: ["React", "TypeScript", "Next.js", "Tailwind CSS", "Jest"]
      },
      {
        position: "UI/UX Designer & Developer",
        company: "Creative Solutions Ltd.",
        location: "Mexico City, MX",
        period: "2021 - 2022",
        description: "Designed and developed user interfaces for web and mobile applications. Conducted user research and usability testing to improve product experiences.",
        achievements: [
          "Redesigned main product interface, increasing user engagement by 60%",
          "Created design system used across 5 different products",
          "Reduced development time by 30% through component standardization",
          "Led UX workshops for cross-functional teams"
        ],
        technologies: ["Figma", "Adobe XD", "React", "CSS3", "JavaScript"]
      },
      {
        position: "Junior Frontend Developer",
        company: "StartUp Hub",
        location: "Guadalajara, MX",
        period: "2020 - 2021",
        description: "Developed and maintained web applications for various clients. Learned modern frontend technologies and best practices while contributing to multiple projects.",
        achievements: [
          "Successfully delivered 15+ client projects on time",
          "Implemented responsive designs for mobile-first approach",
          "Collaborated with backend team to integrate RESTful APIs",
          "Participated in code reviews and agile development processes"
        ],
        technologies: ["HTML5", "CSS3", "JavaScript", "Bootstrap", "Git"]
      }
    ]
  },
  es: {
    title: "Experiencia Laboral",
    experiences: [
      {
        position: "Desarrolladora Frontend",
        company: "Tech Innovations Inc.",
        location: "Remoto",
        period: "2022 - Presente",
        description: "Lideré el desarrollo de aplicaciones web responsivas usando React y TypeScript. Colaboré con equipos de diseño para implementar componentes UI pixel-perfect y optimizar experiencias de usuario.",
        achievements: [
          "Incrementé el rendimiento de aplicaciones en un 40% a través de optimización de código",
          "Construí y mantuve un sistema de diseño integral",
          "Mentoré a 3 desarrolladores junior",
          "Implementé testing automatizado resultando en 95% de cobertura de código"
        ],
        technologies: ["React", "TypeScript", "Next.js", "Tailwind CSS", "Jest"]
      },
      {
        position: "Diseñadora y Desarrolladora UI/UX",
        company: "Creative Solutions Ltd.",
        location: "Ciudad de México, MX",
        period: "2021 - 2022",
        description: "Diseñé y desarrollé interfaces de usuario para aplicaciones web y móviles. Realicé investigación de usuarios y pruebas de usabilidad para mejorar experiencias de producto.",
        achievements: [
          "Rediseñé la interfaz principal del producto, incrementando el engagement de usuarios en 60%",
          "Creé sistema de diseño usado en 5 productos diferentes",
          "Reduje tiempo de desarrollo en 30% a través de estandarización de componentes",
          "Lideré talleres de UX para equipos multifuncionales"
        ],
        technologies: ["Figma", "Adobe XD", "React", "CSS3", "JavaScript"]
      },
      {
        position: "Desarrolladora Frontend Junior",
        company: "StartUp Hub",
        location: "Guadalajara, MX",
        period: "2020 - 2021",
        description: "Desarrollé y mantuve aplicaciones web para varios clientes. Aprendí tecnologías frontend modernas y mejores prácticas mientras contribuía a múltiples proyectos.",
        achievements: [
          "Entregué exitosamente 15+ proyectos de clientes a tiempo",
          "Implementé diseños responsivos con enfoque mobile-first",
          "Colaboré con el equipo backend para integrar APIs RESTful",
          "Participé en revisiones de código y procesos de desarrollo ágil"
        ],
        technologies: ["HTML5", "CSS3", "JavaScript", "Bootstrap", "Git"]
      }
    ]
  },
  fr: {
    title: "Expérience Professionnelle",
    experiences: [
      {
        position: "Développeuse Frontend",
        company: "Tech Innovations Inc.",
        location: "Télétravail",
        period: "2022 - Présent",
        description: "J'ai dirigé le développement d'applications web responsives utilisant React et TypeScript. J'ai collaboré avec les équipes de design pour implémenter des composants UI pixel-perfect et optimiser les expériences utilisateur.",
        achievements: [
          "Augmenté les performances des applications de 40% grâce à l'optimisation du code",
          "Construit et maintenu un système de design complet",
