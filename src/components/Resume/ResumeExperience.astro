        location: "Mexico City, MX",
        period: "2021 - 2022",
        description: "J'ai conçu et développé des interfaces utilisateur pour des applications web et mobiles. J'ai mené des recherches utilisateur et des tests d'utilisabilité pour améliorer les expériences produit.",
        achievements: [
          "Redesigné l'interface principale du produit, augmentant l'engagement utilisateur de 60%",
          "Créé un système de design utilisé dans 5 produits différents",
          "Réduit le temps de développement de 30% grâce à la standardisation des composants",
          "Dirigé des ateliers UX pour les équipes transversales"
        ],
        technologies: ["Figma", "Adobe XD", "React", "CSS3", "JavaScript"]
      },
      {
        position: "Développeuse Frontend Junior",
        company: "StartUp Hub",
        location: "Guadalajara, MX",
        period: "2020 - 2021",
        description: "J'ai développé et maintenu des applications web pour divers clients. J'ai appris les technologies frontend modernes et les meilleures pratiques tout en contribuant à plusieurs projets.",
        achievements: [
          "Livré avec succès 15+ projets clients à temps",
          "Implémenté des designs responsifs avec approche mobile-first",
          "Collaboré avec l'équipe backend pour intégrer des APIs RESTful",
          "Participé aux revues de code et processus de développement agile"
        ],
        technologies: ["HTML5", "CSS3", "JavaScript", "Bootstrap", "Git"]
      }
    ]
  }
};

const content = experienceContent[lang as keyof typeof experienceContent] || experienceContent.en;
---

<section class="resume-experience">
  <div class="experience-container">
    <!-- Section Title -->
    <div class="section-header">
      <h2 class="section-title">{content.title}</h2>
      <div class="title-line"></div>
    </div>
    
    <!-- Experience Timeline -->
    <div class="experience-timeline">
      {content.experiences.map((experience, index) => (
        <div class="experience-item" data-index={index}>
          <div class="timeline-marker">
            <div class="timeline-dot"></div>
            {index < content.experiences.length - 1 && (
              <div class="timeline-line"></div>
            )}
          </div>
          
          <div class="experience-content">
            <div class="experience-header">
              <div class="experience-main">
                <h3 class="experience-position">{experience.position}</h3>
                <div class="experience-company">
                  <span class="company-name">{experience.company}</span>
                  <span class="company-location">{experience.location}</span>
                </div>
              </div>
              <div class="experience-period">{experience.period}</div>
            </div>
            
            <p class="experience-description">
              {experience.description}
            </p>
            
            <div class="achievements">
              <h4 class="achievements-title">Key Achievements:</h4>
              <ul class="achievements-list">
                {experience.achievements.map((achievement) => (
                  <li class="achievement-item">{achievement}</li>
                ))}
              </ul>
            </div>
            
            <div class="technologies">
              <div class="technologies-title">Technologies:</div>
              <div class="tech-tags">
                {experience.technologies.map((tech) => (
                  <span class="tech-tag">{tech}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .resume-experience {
    padding: 5rem 0;
    position: relative;
  }

  .experience-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Section Header */
  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 700;
    color: #ffffff;
    font-family: var(--font-secondary);
    margin-bottom: 1rem;
  }

  .title-line {
    width: 60px;
    height: 3px;
    background: linear-gradient(135deg, #9D7FC1, #B794F6);
    margin: 0 auto;
    border-radius: 2px;
  }

  /* Timeline */
  .experience-timeline {
    position: relative;
    max-width: 800px;
    margin: 0 auto;
  }

  .experience-item {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    margin-bottom: 3rem;
    position: relative;
  }

  .experience-item:last-child {
    margin-bottom: 0;
  }

  /* Timeline Marker */
  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    flex-shrink: 0;
  }

  .timeline-dot {
    width: 16px;
    height: 16px;
    background: linear-gradient(135deg, #9D7FC1, #B794F6);
    border-radius: 50%;
    position: relative;
    z-index: 10;
  }

  .timeline-line {
    width: 2px;
    height: 100px;
    background: linear-gradient(to bottom, #9D7FC1, transparent);
    margin-top: 1rem;
  }

  /* Experience Content */
  .experience-content {
    flex: 1;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(157, 127, 193, 0.2);
    border-radius: 1rem;
    padding: 2rem;
    transition: all 0.3s ease;
  }

  .experience-content:hover {
    border-color: rgba(157, 127, 193, 0.4);
    background: rgba(0, 0, 0, 0.4);
  }

  .experience-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .experience-position {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    font-family: var(--font-secondary);
    margin-bottom: 0.5rem;
  }

  .experience-company {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .company-name {
    color: #9D7FC1;
    font-weight: 600;
  }

  .company-location {
    color: #cccccc;
    font-size: 0.875rem;
  }

  .experience-period {
    color: #B794F6;
    font-weight: 600;
    font-size: 0.875rem;
    text-align: right;
    flex-shrink: 0;
  }

  .experience-description {
    color: #cccccc;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  /* Achievements */
  .achievements {
    margin-bottom: 1.5rem;
  }

  .achievements-title {
    color: #ffffff;
    font-weight: 600;
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .achievements-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .achievement-item {
    color: #cccccc;
    font-size: 0.875rem;
    line-height: 1.5;
    position: relative;
    padding-left: 1rem;
  }

  .achievement-item::before {
    content: "▪";
    color: #9D7FC1;
    position: absolute;
    left: 0;
  }

  /* Technologies */
  .technologies {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .technologies-title {
    color: #ffffff;
    font-weight: 600;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-tag {
    background: rgba(157, 127, 193, 0.2);
    color: #9D7FC1;
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    font-size: 0.75rem;
    font-weight: 500;
    border: 1px solid rgba(157, 127, 193, 0.3);
  }

  /* Mobile Optimizations */
  @media (max-width: 768px) {
    .resume-experience {
      padding: 3rem 0;
    }
    
    .experience-container {
      padding: 0 1rem;
    }
    
    .section-header {
      margin-bottom: 3rem;
    }
    
    .experience-item {
      gap: 1rem;
      margin-bottom: 2rem;
    }
    
    .experience-content {
      padding: 1.5rem;
    }
    
    .experience-header {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .experience-period {
      text-align: left;
    }
    
    .timeline-line {
      height: 80px;
    }
  }

  /* Animation */
  .experience-item {
    animation: slideInLeft 0.6s ease-out forwards;
    opacity: 0;
    transform: translateX(-30px);
  }

  .experience-item:nth-child(1) { animation-delay: 0.1s; }
  .experience-item:nth-child(2) { animation-delay: 0.3s; }
  .experience-item:nth-child(3) { animation-delay: 0.5s; }

  @keyframes slideInLeft {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>
